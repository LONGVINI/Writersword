<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AssemblyName>Writersword.Dialogues</AssemblyName>
		<RootNamespace>Writersword</RootNamespace>
		<!-- SDK автоматически включает все *.cs и *.axaml из папки проекта -->
		<!-- Явные Include не нужны — они создают дубликаты (NETSDK1022) -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\*.resx" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
		<PackageReference Include="Serilog" Version="4.3.2-dev-02419" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Core лежит в Src/ — два уровня вверх от Src/Modules/Dialogues/ -->
		<ProjectReference Include="..\..\Writersword.Core.csproj" />
	</ItemGroup>

</Project>