<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.StatusBar"
             xmlns:converters="using:Writersword.Modules.TextEditor.Converters"
             xmlns:loc="using:Writersword.Src.Modules.TextEditor.Resources"
             xmlns:sb="using:Writersword.Modules.TextEditor.Views.StatusBar"
             x:Class="Writersword.Modules.TextEditor.Views.StatusBar.EditorStatusBarView"
             x:DataType="vm:StatusBarViewModel"
             Height="30">

	<UserControl.Styles>
		<!-- Кнопка режима — обычное состояние -->
		<Style Selector="Button.ViewModeBtn">
			<Setter Property="Background"   Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding"      Value="6 2"/>
			<Setter Property="FontSize"     Value="11"/>
			<Setter Property="Foreground"   Value="{DynamicResource StatusBarForeground}"/>
			<Setter Property="CornerRadius" Value="2"/>
			<Setter Property="Cursor"       Value="Hand"/>
		</Style>
		<!-- Активный режим -->
		<Style Selector="Button.ViewModeBtn.Active">
			<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="Button.ViewModeBtn:pointerover">
			<Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
		</Style>
	</UserControl.Styles>

	<Border Background="{DynamicResource StatusBarBackground}"
            BorderBrush="{DynamicResource StatusBarBorder}"
            BorderThickness="0 1 0 0">

		<Grid ColumnDefinitions="* Auto">

			<!-- Левая часть: статистика -->
			<StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="8 0"
                        VerticalAlignment="Center">

				<StackPanel Orientation="Horizontal" Spacing="4">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Status_Page}"
                               FontSize="11"
                               Foreground="{DynamicResource StatusBarForeground}"/>
					<TextBlock FontSize="11" Foreground="{DynamicResource StatusBarForeground}">
						<TextBlock.Text>
							<MultiBinding StringFormat="{}{0} / {1}">
								<Binding Path="CurrentPage"/>
								<Binding Path="PageCount"/>
							</MultiBinding>
						</TextBlock.Text>
					</TextBlock>
				</StackPanel>

				<Separator Width="1" Height="12" Background="{DynamicResource StatusBarSeparator}"/>

				<StackPanel Orientation="Horizontal" Spacing="4">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Status_Words}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
					<TextBlock Text="{Binding WordCount}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
				</StackPanel>

				<Separator Width="1" Height="12" Background="{DynamicResource StatusBarSeparator}"/>

				<StackPanel Orientation="Horizontal" Spacing="4">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Status_Chars}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
					<TextBlock Text="{Binding CharCount}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
				</StackPanel>

				<Separator Width="1" Height="12" Background="{DynamicResource StatusBarSeparator}"/>

				<StackPanel Orientation="Horizontal" Spacing="4">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Status_Paragraphs}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
					<TextBlock Text="{Binding ParagraphCount}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
				</StackPanel>

				<Separator Width="1" Height="12" Background="{DynamicResource StatusBarSeparator}"/>

				<TextBlock Text="{Binding Language}"
                           FontSize="11"
                           Foreground="{DynamicResource StatusBarForeground}"
                           VerticalAlignment="Center"/>

				<Border IsVisible="{Binding IsSpellCheckActive}"
                        Background="{DynamicResource AccentDefaultBrush}"
                        CornerRadius="2" Padding="4 1">
					<TextBlock Text="{x:Static loc:TextEditorStrings.SpellCheck_Active}"
                               FontSize="10" Foreground="White"/>
				</Border>

				<Border IsVisible="{Binding IsReadOnly}"
                        Background="{DynamicResource WarningColor}"
                        CornerRadius="2" Padding="4 1">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Editor_ReadOnly}"
                               FontSize="10" Foreground="White"/>
				</Border>

			</StackPanel>

			<!-- Правая часть: кнопки режимов + зум -->
			<StackPanel Grid.Column="1"
						Orientation="Horizontal"
						Spacing="2"
						Margin="0 0 8 0"
						MinWidth="260"
						VerticalAlignment="Center">

				<!-- Кнопки режимов -->
				<Button Classes="ViewModeBtn"
                        Classes.Active="{Binding IsPageMode}"
                        Command="{Binding SetPageModeCommand}"
                        ToolTip.Tip="Страница">📄</Button>

				<Button Classes="ViewModeBtn"
                        Classes.Active="{Binding IsDraftMode}"
                        Command="{Binding SetDraftModeCommand}"
                        ToolTip.Tip="Черновик">📝</Button>

				<Button Classes="ViewModeBtn"
                        Classes.Active="{Binding IsWebMode}"
                        Command="{Binding SetWebModeCommand}"
                        ToolTip.Tip="Веб">🌐</Button>

				<Button Classes="ViewModeBtn"
                        Classes.Active="{Binding IsReadingMode}"
                        Command="{Binding SetReadingModeCommand}"
                        ToolTip.Tip="Чтение">📖</Button>

				<Separator Width="1" Height="12"
                           Background="{DynamicResource StatusBarSeparator}"
                           Margin="4 0"/>

				<!-- Зум -->
				<TextBox Name="ZoomTextBox"
						 FontSize="12"
						 Foreground="{DynamicResource StatusBarForeground}"
						 Background="Transparent"
						 BorderThickness="0"
						 BorderBrush="Transparent"
						 Padding="0"
						 Width="38"
						 Height="18"
						 VerticalAlignment="Center"
						 VerticalContentAlignment="Center"
						 TextAlignment="Center"
						 Margin="0 0 4 0"
						 Text="{Binding ZoomPercent, Mode=OneWay, StringFormat={}{0}%}"/>

				<sb:ZoomSlider Minimum="25"
							   Maximum="500"
							   Value="{Binding Zoom,
                   Converter={x:Static converters:ZoomPercentConverter.Instance},
                   Mode=TwoWay}"
							   VerticalAlignment="Center"/>
			</StackPanel>

		</Grid>
	</Border>

</UserControl>