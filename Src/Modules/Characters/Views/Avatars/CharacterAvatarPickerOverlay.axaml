<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Characters.ViewModels.Avatars"
             xmlns:res="using:Writersword.Src.Modules.Characters.Resources"
             x:Class="Writersword.Modules.Characters.Views.Avatars.CharacterAvatarPickerOverlay"
             x:DataType="vm:CharacterAvatarPickerViewModel"
             IsVisible="False">

	<!-- Выбор аватара: оформление и поведение — как у редактора цвета и окна
	     настроек карточки: скрим на модуль (клик не закрывает), центральная
	     панель BgBase со скруглением 16 и тенью. Раньше это было отдельное
	     системное окно (CharacterAvatarPickerWindow) — теперь оверлей внутри
	     модуля. Результат выбора отдаётся через ShowAsync (code-behind). -->

	<Grid>
		<!-- Скрим: затемняет и блокирует модуль. Клик НЕ закрывает. -->
		<Border Background="#F2000000" PointerPressed="OnScrimPressed"/>

		<!-- Внешний Border несёт тень, внутренний — фон и клип по скруглению:
		     секционные заголовки и скрим-контент доходят до краёв панели,
		     ClipToBounds на одном контроле с тенью подрезал бы саму тень. -->
		<Border HorizontalAlignment="Center" VerticalAlignment="Center"
		        Margin="24" Width="560" MaxHeight="640"
		        CornerRadius="16">
			<Border.Effect>
				<DropShadowEffect BlurRadius="32" OffsetX="0" OffsetY="12" Opacity="0.55" Color="#000000"/>
			</Border.Effect>

			<Border Background="{DynamicResource BgBaseBrush}"
			        BorderBrush="{DynamicResource BorderDefaultBrush}"
			        BorderThickness="1"
			        CornerRadius="16"
			        ClipToBounds="True">
			<Panel>
				<Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

					<!-- Заголовок + крестик -->
					<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,12,0">
						<TextBlock Grid.Column="0"
						           Text="{x:Static res:CharactersStrings.AvatarPicker_Title}"
						           FontSize="16" FontWeight="SemiBold"
						           Foreground="{DynamicResource TextPrimaryBrush}"
						           VerticalAlignment="Center"/>
						<Button Grid.Column="1" Content="✕"
						        Command="{Binding CancelCommand}"
						        Background="Transparent" BorderThickness="0"
						        Foreground="{DynamicResource TextSecondaryBrush}"
						        FontSize="14" Padding="6,2"/>
					</Grid>

					<!-- Поиск -->
					<Border Grid.Row="1" Padding="12,10,12,6">
						<TextBox Text="{Binding SearchQuery}"
								 PlaceholderText="{x:Static res:CharactersStrings.AvatarPicker_SearchPlaceholder}"
								 Padding="8,6"/>
					</Border>

					<!-- Статус + кнопка управления -->
					<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,0,12,6">
						<TextBlock Text="{Binding StatusMessage}"
								   VerticalAlignment="Center"
								   FontSize="11"
								   Foreground="{DynamicResource AccentBrush}"
								   IsVisible="{Binding StatusMessage,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<Button Grid.Column="1"
								Content="{x:Static res:CharactersStrings.AvatarPicker_ManagePacks}"
								Command="{Binding OpenManagerCommand}"
								Padding="8,4" FontSize="11"/>
					</Grid>

					<!-- Основной контент -->
					<ScrollViewer Grid.Row="3" x:Name="MainScroll">
						<StackPanel Spacing="0">

							<!-- Проектные аватарки -->
							<StackPanel IsVisible="{Binding HasProjectAvatars}" Margin="0,0,0,8">
								<Border Padding="12,6,12,4" Background="{DynamicResource BgPanelBrush}">
									<TextBlock Text="{x:Static res:CharactersStrings.AvatarPicker_InProject}"
											   FontSize="11" FontWeight="SemiBold"
											   Foreground="{DynamicResource TextSecondaryBrush}"/>
								</Border>
								<ItemsControl ItemsSource="{Binding ProjectAvatars}" Margin="8,4">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="vm:CharacterAvatarPickerItemViewModel">
											<Button Command="{Binding SelectCommand}"
													Background="Transparent"
													BorderThickness="0" Padding="0"
													Margin="4"
													ToolTip.Tip="{Binding ToolTip}"
													Cursor="Hand">
												<Button.Styles>
													<Style Selector="Button:pointerover /template/ ContentPresenter">
														<Setter Property="Background" Value="Transparent"/>
													</Style>
												</Button.Styles>
												<Border Width="68" Height="68" CornerRadius="34"
														ClipToBounds="True"
														Background="{DynamicResource BgPanelBrush}">
													<Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
												</Border>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>

							<!-- Паки -->
							<ItemsControl ItemsSource="{Binding VisiblePacks}">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="vm:CharacterAvatarPackSectionViewModel">
										<StackPanel Margin="0,0,0,8">
											<Border Padding="12,6,12,4"
													Background="{DynamicResource BgPanelBrush}">
												<TextBlock Text="{Binding DisplayName}"
														   FontSize="11" FontWeight="SemiBold"
														   Foreground="{DynamicResource TextSecondaryBrush}"/>
											</Border>
											<ItemsControl ItemsSource="{Binding Items}" Margin="8,4">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<WrapPanel Orientation="Horizontal"/>
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate DataType="vm:CharacterAvatarPickerItemViewModel">
														<Button Command="{Binding SelectCommand}"
																Background="Transparent"
																BorderThickness="0" Padding="0"
																Margin="4"
																ToolTip.Tip="{Binding ToolTip}"
																Cursor="Hand">
															<Button.Styles>
																<Style Selector="Button:pointerover /template/ ContentPresenter">
																	<Setter Property="Background" Value="Transparent"/>
																</Style>
																<!-- Ободок при наведении -->
																<Style Selector="Button:pointerover Border.avatar-frame">
																	<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
																	<Setter Property="BorderThickness" Value="2"/>
																</Style>
															</Button.Styles>
															<Border Classes="avatar-frame"
																	Width="68" Height="68" CornerRadius="34"
																	ClipToBounds="True"
																	Background="{DynamicResource BgPanelBrush}">
																<Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
															</Border>
														</Button>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

						</StackPanel>
					</ScrollViewer>

					<!-- Нижняя навигация по пакам -->
					<Border Grid.Row="4"
							BorderBrush="{DynamicResource BorderDefaultBrush}"
							BorderThickness="0,1,0,0"
							IsVisible="{Binding HasPacks}"
							Padding="4">
						<ScrollViewer HorizontalScrollBarVisibility="Auto"
									  VerticalScrollBarVisibility="Disabled">
							<ItemsControl ItemsSource="{Binding Packs}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="4"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="vm:CharacterAvatarPackSectionViewModel">
										<Button Background="Transparent" BorderThickness="0"
												Padding="4" ToolTip.Tip="{Binding DisplayName}">
											<Button.Styles>
												<Style Selector="Button:pointerover /template/ ContentPresenter">
													<Setter Property="Background" Value="Transparent"/>
												</Style>
											</Button.Styles>
											<Border Width="36" Height="36" CornerRadius="18"
													ClipToBounds="True"
													Background="{DynamicResource BgPanelBrush}">
												<Panel>
													<Image Source="{Binding IconBitmap}" Stretch="UniformToFill"
														   IsVisible="{Binding IconBitmap,
                                                       Converter={x:Static ObjectConverters.IsNotNull}}"/>
													<TextBlock Text="{Binding DisplayName[0]}"
															   HorizontalAlignment="Center"
															   VerticalAlignment="Center"
															   FontSize="14" FontWeight="Bold"
															   Foreground="{DynamicResource TextSecondaryBrush}"
															   IsVisible="{Binding IconBitmap,
                                                           Converter={x:Static ObjectConverters.IsNull}}"/>
												</Panel>
											</Border>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Border>

					<!-- Нижняя панель. Кнопка удаления аватара показывается, только
                         когда вызвавшая сторона передала действие удаления
                         (у персонажа есть аватар) — видимость ставит code-behind. -->
					<Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,*,Auto"
						  Margin="12,8,12,12" ColumnSpacing="8">
						<Button Grid.Column="0"
								Content="{x:Static res:CharactersStrings.Button_UploadAvatar}"
								Command="{Binding UploadCommand}"
								Padding="12,6"/>
						<Button Grid.Column="1" x:Name="DeleteAvatarButton"
								Content="{x:Static res:CharactersStrings.Button_DeleteAvatar}"
								Click="OnDeleteAvatarClick"
								IsVisible="False"
								Padding="12,6"/>
						<Button Grid.Column="3"
								Content="{x:Static res:CharactersStrings.AvatarPicker_Cancel}"
								Command="{Binding CancelCommand}"
								Padding="12,6"/>
					</Grid>

				</Grid>

				<!-- Слот оверлея менеджера паков -->
				<ContentControl x:Name="OverlaySlot" IsVisible="False"/>

			</Panel>
			</Border>
		</Border>
	</Grid>
</UserControl>
