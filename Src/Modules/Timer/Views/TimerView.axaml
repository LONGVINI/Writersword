<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Timer.ViewModels"
             xmlns:loc="using:Writersword.Modules.Timer.Resources"
             x:Class="Writersword.Modules.Timer.Views.TimerView"
             x:DataType="vm:TimerViewModel"
             Background="{DynamicResource BgSurfaceBrush}"
             Tag="Timer">
	<Border Padding="10">
		<StackPanel Spacing="10" HorizontalAlignment="Center">
			<TextBlock Text="{x:Static loc:TimerStrings.Title}"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"/>
			<TextBlock Text="{Binding DisplayTime}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentDefaultBrush}"
                       HorizontalAlignment="Center"/>
			<StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
				<Button Content="▶"
                        Command="{Binding StartCommand}"
                        Background="#28A745"
                        Foreground="White"
                        Width="40"
                        Height="30"
                        FontSize="14"
                        ToolTip.Tip="{x:Static loc:TimerStrings.Tooltip_Start}"/>
				<Button Content="⏸"
                        Command="{Binding StopCommand}"
                        Background="#FFC107"
                        Foreground="White"
                        Width="40"
                        Height="30"
                        FontSize="14"
                        ToolTip.Tip="{x:Static loc:TimerStrings.Tooltip_Stop}"/>
				<Button Content="⏹"
                        Command="{Binding ResetCommand}"
                        Background="#DC3545"
                        Foreground="White"
                        Width="40"
                        Height="30"
                        FontSize="14"
                        ToolTip.Tip="{x:Static loc:TimerStrings.Tooltip_Reset}"/>
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>