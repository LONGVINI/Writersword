<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Synonyms.ViewModels"
             xmlns:loc="using:Writersword.Modules.Synonyms.Resources"
             x:Class="Writersword.Modules.Synonyms.Views.SynonymsView"
             x:DataType="vm:SynonymsViewModel"
             Tag="Synonyms">
	<Border Padding="10"
            Background="{DynamicResource BgSurfaceBrush}">
		<StackPanel Spacing="10">
			<TextBlock Text="{x:Static loc:SynonymsStrings.DisplayName}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
			<TextBox Text="{Binding SearchText}"
                     Watermark="{x:Static loc:SynonymsStrings.SearchWatermark}"
                     Background="{DynamicResource BgPanelBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource AccentDefaultBrush}"
                     BorderThickness="1"/>
			<ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
				<ItemsControl ItemsSource="{Binding Synonyms}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="{DynamicResource BgPanelBrush}"
                                    Padding="8,4"
                                    Margin="0,2"
                                    CornerRadius="3"
                                    Cursor="Hand">
								<TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"/>
								<Border.Styles>
									<Style Selector="Border:pointerover">
										<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
									</Style>
								</Border.Styles>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</StackPanel>
	</Border>
</UserControl>