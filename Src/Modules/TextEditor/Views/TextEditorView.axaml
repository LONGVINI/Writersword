<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels"
             xmlns:toolbar="using:Writersword.Modules.TextEditor.Views.Toolbar"
             xmlns:statusbar="using:Writersword.Modules.TextEditor.Views.StatusBar"
             xmlns:doc="using:Writersword.Modules.TextEditor.Views.Document"
             xmlns:converters="using:Writersword.Modules.TextEditor.Converters"
             x:Class="Writersword.Modules.TextEditor.Views.TextEditorView"
             x:DataType="vm:TextEditorViewModel">

	<Grid RowDefinitions="Auto Auto * Auto">

		<!-- Строка 0: Ribbon -->
		<toolbar:RibbonView Grid.Row="0"
                            DataContext="{Binding Ribbon}"/>

		<!-- Строка 1: Линейка (только в Page-режиме) -->
		<Border Grid.Row="1"
                Height="20"
                Background="{DynamicResource RulerBackground}"
                BorderBrush="{DynamicResource RulerBorder}"
                BorderThickness="0 0 0 1"
                IsVisible="{Binding DocumentViewModel.ViewMode,
                    Converter={x:Static converters:ViewModePageConverter.Instance}}"/>

		<!-- Строка 2: Рабочая область -->
		<ScrollViewer Name="DocumentScrollViewer"
                      Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{Binding DocumentViewModel.CanvasSettings.CanvasBackgroundColor,
                          Converter={x:Static converters:HexColorConverter.Instance}}">

			<Panel>

				<!-- Page-режим -->
				<ItemsControl Name="PageItemsControl"
                              ItemsSource="{Binding DocumentViewModel.Paragraphs}"
                              Margin="40 20"
                              IsVisible="{Binding DocumentViewModel.ViewMode,
                                  Converter={x:Static converters:ViewModePageConverter.Instance}}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="0"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.Template>
						<ControlTemplate>
							<Border Background="{Binding DocumentViewModel.CanvasSettings.PageBackgroundColor,
                                        Converter={x:Static converters:HexColorConverter.Instance}}"
                                    Width="{Binding DocumentViewModel.PageSettings,
                                        Converter={x:Static converters:PageWidthConverter.Instance}}"
                                    Padding="{Binding DocumentViewModel.PageSettings,
                                        Converter={x:Static converters:PageMarginsConverter.Instance}}"
                                    BoxShadow="0 2 8 0 #40000000"
                                    HorizontalAlignment="Center">
								<ItemsPresenter/>
							</Border>
						</ControlTemplate>
					</ItemsControl.Template>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<doc:EditorParagraphView/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Draft-режим -->
				<ItemsControl Name="DraftItemsControl"
                              ItemsSource="{Binding DocumentViewModel.Paragraphs}"
                              Margin="20 12"
                              IsVisible="{Binding DocumentViewModel.ViewMode,
                                  Converter={x:Static converters:ViewModeDraftConverter.Instance}}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="0"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<doc:EditorParagraphView/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</Panel>
		</ScrollViewer>

		<!-- Строка 3: Строка состояния -->
		<statusbar:EditorStatusBarView Grid.Row="3"
                                       DataContext="{Binding StatusBar}"/>

	</Grid>

</UserControl>