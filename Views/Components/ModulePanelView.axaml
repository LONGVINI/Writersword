<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.ViewModels.Components"
             x:Class="Writersword.Views.Components.ModulePanelView"
             x:DataType="vm:ModulePanelViewModel"
             x:Name="ModulePanelViewRoot">

	<!-- Панель модулей -->
	<Border Background="#1E1E1E"
            BorderBrush="#3E3E42"
            BorderThickness="1,0,0,0"
            Width="250">

		<DockPanel>

			<!-- Заголовок панели -->
			<Border DockPanel.Dock="Top"
                    Background="#2D2D30"
                    Padding="12,8"
                    BorderBrush="#3E3E42"
                    BorderThickness="0,0,0,1">
				<TextBlock Text="Modules"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CCCCCC"/>
			</Border>

			<!-- Список модулей -->
			<ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

				<ItemsControl ItemsSource="{Binding AvailableModules}"
                              Margin="0,8,0,0">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Vertical" Spacing="2"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<!-- Элемент модуля как Button -->
							<Button Background="Transparent"
                                    Padding="8,6"
                                    HorizontalContentAlignment="Stretch"
                                    BorderThickness="0"
                                    Command="{Binding #ModulePanelViewRoot.DataContext.ToggleModuleCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Description}">

								<Grid ColumnDefinitions="Auto,*,Auto">

									<!-- Иконка модуля -->
									<TextBlock Grid.Column="0"
                                               Text="{Binding Icon}"
                                               FontSize="16"
                                               Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

									<!-- Название модуля -->
									<TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               FontSize="12"
                                               Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

									<!-- Чекбокс (активен/неактивен) -->
									<CheckBox Grid.Column="2"
                                              IsChecked="{Binding IsActive}"
                                              IsEnabled="{Binding CanToggle}"
                                              VerticalAlignment="Center"/>

								</Grid>

								<!-- Hover эффект -->
								<Button.Styles>
									<Style Selector="Button:pointerover">
										<Setter Property="Background" Value="#2D2D30"/>
									</Style>
								</Button.Styles>

							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</ScrollViewer>

		</DockPanel>

	</Border>

</UserControl>