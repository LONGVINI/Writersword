<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:doc="using:Writersword.Modules.TextEditor.Document"
             xmlns:views="using:Writersword.Mobile.Views"
             x:Class="Writersword.Mobile.Views.ReaderView">

	<!-- Книга занимает экран целиком, худ лежит поверх неё в той же ячейке.
	     Ни один орган управления не отнимает у книги места: по высоте вьюпорта
	     считается масштаб, которым лист вписывается в экран, и панель, двигающая
	     границу, двигала бы вместе с ней и буквы. -->
	<Grid>

		<!-- Горизонтальная прокрутка выключена, и это не про полосу, а про замер.
		     Контейнер с «Auto» меряет содержимое бесконечной шириной, а канвас на
		     бесконечность отвечает запасными 800 точками — шире телефонного экрана.
		     Отсюда бралось пустое поле справа, в которое уезжала книга. С
		     «Disabled» канвас меряется шириной вьюпорта, и ехать становится
		     некуда: колонка чтения и так считается по этой ширине. -->
		<ScrollViewer x:Name="Scroll"
		              HorizontalScrollBarVisibility="Disabled"
		              VerticalScrollBarVisibility="Auto">
			<doc:DocumentCanvas x:Name="PageCanvas" HorizontalAlignment="Stretch"/>
		</ScrollViewer>

		<TextBlock x:Name="EmptyBlock"
		           Text="Книга не открыта. Скачайте её на вкладке «Хранилище», потом откройте отсюда."
		           FontSize="14"
		           Opacity="0.7"
		           TextWrapping="Wrap"
		           TextAlignment="Center"
		           HorizontalAlignment="Center"
		           VerticalAlignment="Center"
		           Margin="32"/>

		<!-- Предупреждение о том, что книгу правят на другом устройстве.
		     Сверху и поверх книги: читатель должен знать, что текст под рукой
		     вот-вот устареет, но мешать чтению это не должно. -->
		<Border x:Name="ForeignBanner"
		        VerticalAlignment="Top"
		        IsVisible="False"
		        ZIndex="11"
		        Background="{DynamicResource BgPanelBrush}"
		        BorderBrush="{DynamicResource AccentDefaultBrush}"
		        BorderThickness="0,0,0,2"
		        Padding="12,8">
			<TextBlock x:Name="ForeignBlock"
			           FontSize="12"
			           TextWrapping="Wrap"
			           Foreground="{DynamicResource TextPrimaryBrush}"/>
		</Border>

		<views:ReaderHud x:Name="Hud" ZIndex="10"/>

	</Grid>
</UserControl>
