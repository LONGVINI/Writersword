<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Writersword.Mobile.Views.StorageView">

	<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
			<Button x:Name="RefreshButton" Content="Обновить" Padding="14,8"/>
			<Button x:Name="DownloadButton" Content="Скачать" Padding="14,8" IsEnabled="False"/>
		</StackPanel>

		<TextBlock Grid.Row="1"
		           x:Name="StatusBlock"
		           Text="Не подключено. Заполните вкладку «Подключение»."
		           FontSize="12"
		           TextWrapping="Wrap"
		           Opacity="0.75"
		           Margin="0,0,0,8"/>

		<!-- Списка два: что лежит в хранилище и что уже скачано на телефон.
		     Разделены намеренно — иначе непонятно, доступна книга без сети
		     или только числится на сервере. -->
		<Grid Grid.Row="2" RowDefinitions="Auto,*,Auto,140">

			<TextBlock Grid.Row="0"
			           Text="В хранилище"
			           FontWeight="SemiBold"
			           Margin="0,0,0,4"/>

			<Border Grid.Row="1"
			        BorderBrush="#33000000"
			        BorderThickness="1"
			        CornerRadius="6">
				<ListBox x:Name="RemoteList" Background="Transparent">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Margin="4,6">
								<TextBlock Text="{Binding Name}" FontSize="15"/>
								<TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.7"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Border>

			<TextBlock Grid.Row="2"
			           Text="На телефоне"
			           FontWeight="SemiBold"
			           Margin="0,12,0,4"/>

			<Border Grid.Row="3"
			        BorderBrush="#33000000"
			        BorderThickness="1"
			        CornerRadius="6">
				<ListBox x:Name="LocalList" Background="Transparent">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Margin="4,6">
								<TextBlock Text="{Binding Name}" FontSize="14"/>
								<TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.7"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Border>

		</Grid>

		<TextBlock Grid.Row="3"
		           x:Name="PathBlock"
		           FontSize="10"
		           TextWrapping="Wrap"
		           Opacity="0.6"
		           Margin="0,8,0,0"/>

	</Grid>
</UserControl>
