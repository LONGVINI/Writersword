		<AvaloniaXaml Remove="Src\Modules\Timer\**\*.axaml" />
		<AvaloniaXaml Remove="Src\Modules\Dialogues\**\*.axaml" />
		<AvaloniaXaml Remove="Src\Modules\Poetry\**\*.axaml" />
		<AvaloniaXaml Remove="Src\Modules\Statistics\**\*.axaml" />
		<AvaloniaXaml Remove="Src\Modules\GameEconomy\**\*.axaml" />
		<AvaloniaXaml Remove="Src\Modules\Music\**\*.axaml" />
		<AvaloniaXaml Remove="Src\Modules\Timeline\**\*.axaml" />

		<EmbeddedResource Remove="Src\Modules\Characters\Resources\*.resx" />
		<EmbeddedResource Remove="Src\Modules\TextEditor\Resources\*.resx" />
		<EmbeddedResource Remove="Src\Modules\Notes\Resources\*.resx" />
