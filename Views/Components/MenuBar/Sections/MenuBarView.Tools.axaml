<MenuItem xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:vm="using:Writersword.ViewModels.Components.MenuBar"
          xmlns:loc="using:Writersword.Resources.Localization"
          x:Class="Writersword.Views.Components.MenuBar.Sections.MenuBarTools"
          x:DataType="vm:MenuBarViewModel"
          Header="{x:Static loc:Strings.Menu_Tools}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          FontSize="13"
          Padding="10,6,10,6">

	<MenuItem x:Name="HotKey_Tools_Statistics"
              Header="{x:Static loc:Strings.Menu_Tools_Statistics}"
              IsEnabled="False"/>

	<Separator/>

	<!-- Находит всё, что лежит вне файла проекта, и укладывает копии внутрь.
	     Без этого проект уезжает к другому человеку неполным: картинки из
	     библиотеки и общих папок остаются на машине автора. -->
	<MenuItem x:Name="HotKey_Tools_PrepareForSharing"
              Header="Подготовить к передаче…"
              Command="{Binding PrepareForSharingCommand}"
              IsEnabled="{Binding HasActiveTab}"/>

	<!-- Удаляет из проекта файлы, на которые не осталось ссылок. -->
	<MenuItem x:Name="HotKey_Tools_CompactProject"
              Header="Сжать проект"
              Command="{Binding CompactProjectCommand}"
              IsEnabled="{Binding HasActiveTab}"/>

	<Separator/>

	<!-- Подключение к удалённому хранилищу: адрес, учётные данные и
	     мастер-пароль шифрования. Открытый проект не нужен — настройки
	     общие для всей программы. -->
	<MenuItem x:Name="HotKey_Tools_Sync"
              Header="Синхронизация…"
              Command="{Binding OpenSyncSettingsCommand}"/>

	<!-- Кто ещё держит открытые книги. Отдельным пунктом от настроек: те
	     заполняют один раз и забывают, а сюда заглядывают по ходу работы. -->
	<MenuItem x:Name="HotKey_Tools_Devices"
              Header="Устройства…"
              Command="{Binding OpenDevicesCommand}"/>

	<!-- Ручная отправка. Обычно не нужна — координатор отправляет сам, —
	     но пригодится, когда автоматика приостановлена из-за расхождения. -->
	<MenuItem x:Name="HotKey_Tools_SyncPush"
              Header="Отправить в хранилище"
              Command="{Binding PushToStorageCommand}"
              IsEnabled="{Binding HasActiveTab}"/>

	<!-- Забрать серверную версию. Локальная перед заменой уходит в копию
	     рядом с проектом — потерять работу этим действием нельзя. -->
	<MenuItem x:Name="HotKey_Tools_SyncPull"
              Header="Забрать из хранилища"
              Command="{Binding PullFromStorageCommand}"
              IsEnabled="{Binding HasActiveTab}"/>

</MenuItem>