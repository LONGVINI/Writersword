<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Writersword.Modules.TextEditor.Resources"
             x:Class="Writersword.Modules.TextEditor.Views.Dialogs.TabSettingsOverlay">

	<UserControl.Styles>
		<Style Selector="TextBlock.FieldLabel">
			<Setter Property="FontSize"          Value="12"/>
			<Setter Property="FontWeight"        Value="SemiBold"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Margin"            Value="0 0 0 4"/>
		</Style>
		<Style Selector="RadioButton.Option">
			<Setter Property="FontSize"          Value="12"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Margin"            Value="0 1"/>
		</Style>
		<Style Selector="TextBox.Value">
			<Setter Property="FontSize"          Value="12"/>
			<Setter Property="Padding"           Value="8 5"/>
			<Setter Property="CornerRadius"      Value="6"/>
		</Style>
		<Style Selector="Button.DialogAccent">
			<Setter Property="Background"        Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="BorderThickness"   Value="0"/>
			<Setter Property="CornerRadius"      Value="6"/>
			<Setter Property="Padding"           Value="18 8"/>
			<Setter Property="Foreground"        Value="White"/>
			<Setter Property="FontWeight"        Value="SemiBold"/>
			<Setter Property="Cursor"            Value="Hand"/>
		</Style>
		<Style Selector="Button.DialogPlain">
			<Setter Property="Background"        Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"       Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness"   Value="1"/>
			<Setter Property="CornerRadius"      Value="6"/>
			<Setter Property="Padding"           Value="14 7"/>
			<Setter Property="FontSize"          Value="12"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"            Value="Hand"/>
		</Style>
		<Style Selector="Button.DialogPlain:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
		<Style Selector="Button.IconClose">
			<Setter Property="Background"        Value="Transparent"/>
			<Setter Property="BorderThickness"   Value="0"/>
			<Setter Property="Width"             Value="28"/>
			<Setter Property="Height"            Value="28"/>
			<Setter Property="CornerRadius"      Value="6"/>
			<Setter Property="Padding"           Value="0"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Cursor"            Value="Hand"/>
		</Style>
		<Style Selector="Button.IconClose:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
	</UserControl.Styles>

	<Grid>
		<Border x:Name="Scrim" Background="#B3000000"/>

		<Border HorizontalAlignment="Center" VerticalAlignment="Center"
		        Margin="24" Width="520"
		        Background="{DynamicResource BgBaseBrush}"
		        BorderBrush="{DynamicResource BorderDefaultBrush}"
		        BorderThickness="1" CornerRadius="16" Padding="20 18">
			<Border.Effect>
				<DropShadowEffect BlurRadius="32" OffsetX="0" OffsetY="12" Opacity="0.55" Color="#000000"/>
			</Border.Effect>

			<StackPanel Spacing="12">

				<Grid ColumnDefinitions="* Auto">
					<TextBlock Grid.Column="0"
					           Text="{x:Static loc:TextEditorStrings.Tab_Title}"
					           FontSize="16" FontWeight="SemiBold"
					           VerticalAlignment="Center"
					           Foreground="{DynamicResource TextPrimaryBrush}"/>
					<Button Grid.Column="1" x:Name="CloseBtn" Classes="IconClose">
						<PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
						          Width="14" Height="14"/>
					</Button>
				</Grid>

				<Grid ColumnDefinitions="220 *" ColumnSpacing="18">

					<!-- Левая половина: набор позиций абзаца -->
					<StackPanel Grid.Column="0" Spacing="6">
						<TextBlock Classes="FieldLabel"
						           Text="{x:Static loc:TextEditorStrings.Tab_Existing}"/>

						<Border Background="{DynamicResource BgSurfaceBrush}"
						        BorderBrush="{DynamicResource BorderDefaultBrush}"
						        BorderThickness="1" CornerRadius="6"
						        Height="176">
							<Panel>
								<ListBox x:Name="StopsList"
								         Background="Transparent"
								         BorderThickness="0"
								         FontSize="12"/>
								<TextBlock x:Name="EmptyHint"
								           Text="{x:Static loc:TextEditorStrings.Tab_Empty}"
								           FontSize="11"
								           IsVisible="False"
								           HorizontalAlignment="Center"
								           VerticalAlignment="Center"
								           Foreground="{DynamicResource TextMutedBrush}"/>
							</Panel>
						</Border>

						<TextBlock Classes="FieldLabel"
						           Margin="0 6 0 4"
						           Text="{x:Static loc:TextEditorStrings.Tab_DefaultStep}"/>
						<TextBox x:Name="DefaultStepBox" Classes="Value" Width="90"
						         HorizontalAlignment="Left"/>
					</StackPanel>

					<!-- Правая половина: параметры одной позиции -->
					<StackPanel Grid.Column="1" Spacing="10">

						<StackPanel>
							<TextBlock Classes="FieldLabel"
							           Text="{x:Static loc:TextEditorStrings.Tab_Position}"/>
							<TextBox x:Name="PositionBox" Classes="Value" Width="120"
							         HorizontalAlignment="Left"/>
						</StackPanel>

						<StackPanel>
							<TextBlock Classes="FieldLabel"
							           Text="{x:Static loc:TextEditorStrings.Tab_Alignment}"/>
							<RadioButton x:Name="AlignLeftBtn"    Classes="Option" GroupName="TabAlign"
							             Content="{x:Static loc:TextEditorStrings.Tab_AlignLeft}"/>
							<RadioButton x:Name="AlignCenterBtn"  Classes="Option" GroupName="TabAlign"
							             Content="{x:Static loc:TextEditorStrings.Tab_AlignCenter}"/>
							<RadioButton x:Name="AlignRightBtn"   Classes="Option" GroupName="TabAlign"
							             Content="{x:Static loc:TextEditorStrings.Tab_AlignRight}"/>
							<RadioButton x:Name="AlignDecimalBtn" Classes="Option" GroupName="TabAlign"
							             Content="{x:Static loc:TextEditorStrings.Tab_AlignDecimal}"/>
						</StackPanel>

						<StackPanel>
							<TextBlock Classes="FieldLabel"
							           Text="{x:Static loc:TextEditorStrings.Tab_Leader}"/>
							<RadioButton x:Name="LeaderNoneBtn"   Classes="Option" GroupName="TabLeader"
							             Content="{x:Static loc:TextEditorStrings.Tab_LeaderNone}"/>
							<RadioButton x:Name="LeaderDotsBtn"   Classes="Option" GroupName="TabLeader"
							             Content="{x:Static loc:TextEditorStrings.Tab_LeaderDots}"/>
							<RadioButton x:Name="LeaderDashesBtn" Classes="Option" GroupName="TabLeader"
							             Content="{x:Static loc:TextEditorStrings.Tab_LeaderDashes}"/>
							<RadioButton x:Name="LeaderLineBtn"   Classes="Option" GroupName="TabLeader"
							             Content="{x:Static loc:TextEditorStrings.Tab_LeaderLine}"/>
						</StackPanel>

						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button x:Name="SetBtn"      Classes="DialogPlain"
							        Content="{x:Static loc:TextEditorStrings.Tab_Set}"/>
							<Button x:Name="RemoveBtn"   Classes="DialogPlain"
							        Content="{x:Static loc:TextEditorStrings.Tab_Remove}"/>
							<Button x:Name="ClearAllBtn" Classes="DialogPlain"
							        Content="{x:Static loc:TextEditorStrings.Tab_ClearAll}"/>
						</StackPanel>

					</StackPanel>
				</Grid>

				<TextBlock Text="{x:Static loc:TextEditorStrings.Tab_RulerHint}"
				           FontSize="11" TextWrapping="Wrap"
				           Foreground="{DynamicResource TextMutedBrush}"/>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
					<Button x:Name="CancelBtn" Classes="DialogPlain"
					        Content="{x:Static loc:TextEditorStrings.Tab_Cancel}"/>
					<Button x:Name="OkBtn" Classes="DialogAccent"
					        Content="{x:Static loc:TextEditorStrings.Tab_Ok}"/>
				</StackPanel>

			</StackPanel>
		</Border>
	</Grid>

</UserControl>
