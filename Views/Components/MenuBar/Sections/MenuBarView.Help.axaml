<MenuItem xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:vm="using:Writersword.ViewModels.Components.MenuBar"
          xmlns:loc="using:Writersword.Resources.Localization"
          x:Class="Writersword.Views.Components.MenuBar.Sections.MenuBarHelp"
          x:DataType="vm:MenuBarViewModel"
          Header="{x:Static loc:Strings.Menu_Help}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          FontSize="13"
          Padding="10,6,10,6">

	<MenuItem x:Name="HotKey_Help_Documentation"
              Header="{x:Static loc:Strings.Menu_Help_Documentation}"
              IsEnabled="False"/>

	<MenuItem x:Name="HotKey_Help_CheckUpdates"
              Header="{x:Static loc:Strings.Menu_Help_CheckUpdates}"
              IsEnabled="False"/>

	<Separator/>

	<MenuItem x:Name="HotKey_Help_About"
              Header="{x:Static loc:Strings.Menu_Help_About}"
              IsEnabled="False"/>

</MenuItem>