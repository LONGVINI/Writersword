<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Writersword.Modules.TextEditor.Views.Dialogs.ListLevelsOverlay">

    <UserControl.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.Field">
            <Setter Property="Background"          Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="CornerRadius"        Value="6"/>
            <Setter Property="MinHeight"           Value="30"/>
            <Setter Property="Padding"             Value="10 0"/>
            <Setter Property="FontSize"            Value="12"/>
            <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.IconClose">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.IconClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>
        <Style Selector="Button.Dialog">
            <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="18 8"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.Dialog:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.DialogAccent">
            <Setter Property="Background"      Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="18 8"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border x:Name="Scrim" Background="#B3000000"/>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="24" Width="380"
                Background="{DynamicResource BgBaseBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="20 18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" OffsetX="0" OffsetY="12" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="* Auto">
                    <TextBlock Grid.Column="0" Text="Уровни списка"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Grid.Column="1" x:Name="CloseBtn" Classes="IconClose">
                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Width="14" Height="14"/>
                    </Button>
                </Grid>

                <TextBlock FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Тип маркера для каждого уровня. Переход между уровнями — Tab (глубже) и Shift+Tab (выше)."/>

                <Grid ColumnDefinitions="Auto *" RowDefinitions="Auto Auto Auto Auto Auto" ColumnSpacing="12" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Уровень 1"/>
                    <ComboBox   Grid.Row="0" Grid.Column="1" x:Name="Level1Combo" Classes="Field" SelectedIndex="0">
                        <ComboBoxItem>1, 2, 3</ComboBoxItem>
                        <ComboBoxItem>01, 02, 03</ComboBoxItem>
                        <ComboBoxItem>a, b, c</ComboBoxItem>
                        <ComboBoxItem>A, B, C</ComboBoxItem>
                        <ComboBoxItem>i, ii, iii</ComboBoxItem>
                        <ComboBoxItem>I, II, III</ComboBoxItem>
                        <ComboBoxItem>• маркер</ComboBoxItem>
                        <ComboBoxItem>◦ круг</ComboBoxItem>
                        <ComboBoxItem>▪ квадрат</ComboBoxItem>
                        <ComboBoxItem>– тире</ComboBoxItem>
                        <ComboBoxItem>➤ стрелка</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Уровень 2"/>
                    <ComboBox   Grid.Row="1" Grid.Column="1" x:Name="Level2Combo" Classes="Field" SelectedIndex="2">
                        <ComboBoxItem>1, 2, 3</ComboBoxItem>
                        <ComboBoxItem>01, 02, 03</ComboBoxItem>
                        <ComboBoxItem>a, b, c</ComboBoxItem>
                        <ComboBoxItem>A, B, C</ComboBoxItem>
                        <ComboBoxItem>i, ii, iii</ComboBoxItem>
                        <ComboBoxItem>I, II, III</ComboBoxItem>
                        <ComboBoxItem>• маркер</ComboBoxItem>
                        <ComboBoxItem>◦ круг</ComboBoxItem>
                        <ComboBoxItem>▪ квадрат</ComboBoxItem>
                        <ComboBoxItem>– тире</ComboBoxItem>
                        <ComboBoxItem>➤ стрелка</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Уровень 3"/>
                    <ComboBox   Grid.Row="2" Grid.Column="1" x:Name="Level3Combo" Classes="Field" SelectedIndex="4">
                        <ComboBoxItem>1, 2, 3</ComboBoxItem>
                        <ComboBoxItem>01, 02, 03</ComboBoxItem>
                        <ComboBoxItem>a, b, c</ComboBoxItem>
                        <ComboBoxItem>A, B, C</ComboBoxItem>
                        <ComboBoxItem>i, ii, iii</ComboBoxItem>
                        <ComboBoxItem>I, II, III</ComboBoxItem>
                        <ComboBoxItem>• маркер</ComboBoxItem>
                        <ComboBoxItem>◦ круг</ComboBoxItem>
                        <ComboBoxItem>▪ квадрат</ComboBoxItem>
                        <ComboBoxItem>– тире</ComboBoxItem>
                        <ComboBoxItem>➤ стрелка</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Уровень 4"/>
                    <ComboBox   Grid.Row="3" Grid.Column="1" x:Name="Level4Combo" Classes="Field" SelectedIndex="0">
                        <ComboBoxItem>1, 2, 3</ComboBoxItem>
                        <ComboBoxItem>01, 02, 03</ComboBoxItem>
                        <ComboBoxItem>a, b, c</ComboBoxItem>
                        <ComboBoxItem>A, B, C</ComboBoxItem>
                        <ComboBoxItem>i, ii, iii</ComboBoxItem>
                        <ComboBoxItem>I, II, III</ComboBoxItem>
                        <ComboBoxItem>• маркер</ComboBoxItem>
                        <ComboBoxItem>◦ круг</ComboBoxItem>
                        <ComboBoxItem>▪ квадрат</ComboBoxItem>
                        <ComboBoxItem>– тире</ComboBoxItem>
                        <ComboBoxItem>➤ стрелка</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Уровень 5"/>
                    <ComboBox   Grid.Row="4" Grid.Column="1" x:Name="Level5Combo" Classes="Field" SelectedIndex="2">
                        <ComboBoxItem>1, 2, 3</ComboBoxItem>
                        <ComboBoxItem>01, 02, 03</ComboBoxItem>
                        <ComboBoxItem>a, b, c</ComboBoxItem>
                        <ComboBoxItem>A, B, C</ComboBoxItem>
                        <ComboBoxItem>i, ii, iii</ComboBoxItem>
                        <ComboBoxItem>I, II, III</ComboBoxItem>
                        <ComboBoxItem>• маркер</ComboBoxItem>
                        <ComboBoxItem>◦ круг</ComboBoxItem>
                        <ComboBoxItem>▪ квадрат</ComboBoxItem>
                        <ComboBoxItem>– тире</ComboBoxItem>
                        <ComboBoxItem>➤ стрелка</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0 6 0 0">
                    <Button x:Name="CancelBtn" Classes="Dialog" Content="Отмена"/>
                    <Button x:Name="OkBtn" Classes="DialogAccent" Content="ОК"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
