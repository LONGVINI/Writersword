<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.Toolbar"
             xmlns:converters="using:Writersword.Modules.TextEditor.Converters"
             xmlns:loc="using:Writersword.Src.Modules.TextEditor.Resources"
             x:Class="Writersword.Modules.TextEditor.Views.Toolbar.Tabs.RibbonHomeTab"
             x:DataType="vm:RibbonHomeTabViewModel">

    <UserControl.Styles>
        <Style Selector="Button.RibbonBtn">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderBrush"              Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="CornerRadius"             Value="3"/>
            <Setter Property="Padding"                  Value="4"/>
            <Setter Property="MinWidth"                 Value="24"/>
            <Setter Property="MinHeight"                Value="24"/>
            <Setter Property="VerticalAlignment"        Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"                   Value="Hand"/>
        </Style>
        <Style Selector="Button.RibbonBtn:pointerover">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        </Style>
        <Style Selector="Button.RibbonBtn:pressed">
            <Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.RibbonBtn:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="Button.RibbonBtnLarge">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderBrush"              Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="CornerRadius"             Value="3"/>
            <Setter Property="Padding"                  Value="4 2"/>
            <Setter Property="MinWidth"                 Value="40"/>
            <Setter Property="MinHeight"                Value="52"/>
            <Setter Property="VerticalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"                   Value="Hand"/>
        </Style>
        <Style Selector="Button.RibbonBtnLarge:pointerover">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        </Style>
        <Style Selector="Button.RibbonBtnLarge:pressed">
            <Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.RibbonBtnLarge:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="ToggleButton.RibbonToggle">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderBrush"              Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="CornerRadius"             Value="3"/>
            <Setter Property="Padding"                  Value="4"/>
            <Setter Property="MinWidth"                 Value="24"/>
            <Setter Property="MinHeight"                Value="24"/>
            <Setter Property="VerticalAlignment"        Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"                   Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.RibbonToggle:pointerover">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        </Style>
        <Style Selector="ToggleButton.RibbonToggle:pressed">
            <Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="ToggleButton.RibbonToggle:checked">
            <Setter Property="Background"  Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="ToggleButton.RibbonToggle:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="SplitButton.RibbonSplit">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Padding"         Value="4 4 2 4"/>
            <Setter Property="MinWidth"        Value="24"/>
            <Setter Property="MinHeight"       Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="SplitButton.RibbonSplit:pointerover">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        </Style>
        <Style Selector="SplitButton.RibbonSplit:pressed">
            <Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal"
                    Spacing="1"
                    Margin="4 2"
                    VerticalAlignment="Center">

            <!-- Буфер обмена -->
            <Border Padding="4 2">
                <StackPanel Spacing="2">
                    <TextBlock Text="Clipboard"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Command="{Binding PasteCommand}"
                                Classes="RibbonBtnLarge"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_Paste}">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z" Width="24" Height="24"/>
                                <TextBlock Text="{x:Static loc:TextEditorStrings.Format_Paste}" FontSize="9" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <Button Command="{Binding CutCommand}"
                                    Classes="RibbonBtn"
                                    ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_Cut}">
                                <PathIcon Data="M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm0 12c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3h-3z" Width="14" Height="14"/>
                            </Button>
                            <Button Command="{Binding CopyCommand}"
                                    Classes="RibbonBtn"
                                    ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_Copy}">
                                <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Separator Width="1" Height="40" Background="{DynamicResource BorderSubtleBrush}" Margin="3 0" VerticalAlignment="Center"/>

            <!-- Шрифт -->
            <Border Padding="4 2">
                <StackPanel Spacing="4">
                    <TextBlock Text="Font"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ComboBox ItemsSource="{Binding AvailableFonts}"
                                  SelectedItem="{Binding CurrentFontFamily}"
                                  Width="120" Height="22" FontSize="11"
                                  ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_FontFamily}"/>
                        <NumericUpDown Value="{Binding CurrentFontSize}"
                                       Minimum="6" Maximum="144" Increment="1"
                                       Width="52" Height="22" FontSize="11"
                                       FormatString="0"
                                       ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_FontSize}"/>
                        <Button Command="{Binding IncreaseFontSizeCommand}"
                                Classes="RibbonBtn"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_IncreaseFontSize}">
                            <PathIcon Data="M2 12C2 6.48 6.48 2 12 2s10 4.48 10 10-4.48 10-10 10S2 17.52 2 12zm11-5h-2v4H7v2h4v4h2v-4h4v-2h-4V7z" Width="14" Height="14"/>
                        </Button>
                        <Button Command="{Binding DecreaseFontSizeCommand}"
                                Classes="RibbonBtn"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_DecreaseFontSize}">
                            <PathIcon Data="M2 12C2 6.48 6.48 2 12 2s10 4.48 10 10-4.48 10-10 10S2 17.52 2 12zm5 1h10v-2H7v2z" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton IsChecked="{Binding IsBold}"
                                      Command="{Binding BoldCommand}"
                                      Classes="RibbonToggle"
                                      FontWeight="Bold"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_Bold}">B</ToggleButton>
                        <ToggleButton IsChecked="{Binding IsItalic}"
                                      Command="{Binding ItalicCommand}"
                                      Classes="RibbonToggle"
                                      FontStyle="Italic"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_Italic}">I</ToggleButton>
                        <ToggleButton IsChecked="{Binding IsUnderline}"
                                      Command="{Binding UnderlineCommand}"
                                      Classes="RibbonToggle"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_Underline}">
                            <TextBlock Text="U" TextDecorations="Underline"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsStrikethrough}"
                                      Command="{Binding StrikethroughCommand}"
                                      Classes="RibbonToggle"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_Strikethrough}">
                            <TextBlock Text="S" TextDecorations="Strikethrough"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsSubscript}"
                                      Command="{Binding SubscriptCommand}"
                                      Classes="RibbonToggle"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_Subscript}">
                            <TextBlock FontSize="10">X<Run BaselineAlignment="Subscript" FontSize="7">2</Run></TextBlock>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsSuperscript}"
                                      Command="{Binding SuperscriptCommand}"
                                      Classes="RibbonToggle"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_Superscript}">
                            <TextBlock FontSize="10">X<Run BaselineAlignment="Superscript" FontSize="7">2</Run></TextBlock>
                        </ToggleButton>
                        <Separator Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="2 0" VerticalAlignment="Center"/>
                        <Button Command="{Binding TextColorCommand}"
                                Classes="RibbonBtn"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_TextColor}">
                            <PathIcon Data="M11.39 1.48L6.18 15h2.31l1.05-3h5.12l1.05 3h2.31L12.61 1.48h-1.22zm-1.21 8.52l1.82-5.2 1.82 5.2H10.18zM2 20h20v-2H2v2z" Width="14" Height="14"/>
                        </Button>
                        <Button Command="{Binding HighlightColorCommand}"
                                Classes="RibbonBtn"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_Highlight}">
                            <PathIcon Data="M23.06 18.17l-4.58-4.58-.01.01L9.27 4.42C8.9 4.05 8.43 3.86 7.96 3.86c-.47 0-.94.19-1.31.55l-1.27 1.27c-.37.37-.56.84-.55 1.31 0 .47.19.95.56 1.31L9.7 12.6l-4.1 4.1C4.4 17.9 4 19 4 20h2c0-.48.2-1.02.64-1.46l4.1-4.1 3.72 3.72c.37.37.84.55 1.31.55.47 0 .94-.18 1.31-.55l1.27-1.27c.72-.73.73-1.9.01-2.62 0-.03-.02-.04-.03-.06z" Width="14" Height="14"/>
                        </Button>
                        <Button Command="{Binding ClearFormattingCommand}"
                                Classes="RibbonBtn"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Format_ClearFormatting}">
                            <PathIcon Data="M14.06 9l.94.94L5.92 19H5v-.92L14.06 9zm3.6-6c-.25 0-.51.1-.7.29l-1.83 1.83 3.75 3.75 1.83-1.83c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.2-.2-.45-.29-.71-.29zm-3.6 3.19L3 17.25V21h3.75L17.81 9.94l-3.75-3.75z" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Separator Width="1" Height="40" Background="{DynamicResource BorderSubtleBrush}" Margin="3 0" VerticalAlignment="Center"/>

            <!-- Абзац -->
            <Border Padding="4 2">
                <StackPanel Spacing="4">
                    <TextBlock Text="Paragraph"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton IsChecked="{Binding IsBulletList}"
                                      Command="{Binding BulletListCommand}"
                                      Classes="RibbonToggle"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.List_Bullet}">
                            <PathIcon Data="M4 10.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5zm0-6c-.83 0-1.5.67-1.5 1.5S3.17 7.5 4 7.5 5.5 6.83 5.5 6 4.83 4.5 4 4.5zm0 12c-.83 0-1.5.68-1.5 1.5s.68 1.5 1.5 1.5 1.5-.68 1.5-1.5-.67-1.5-1.5-1.5zM7 19h14v-2H7v2zm0-6h14v-2H7v2zm0-8v2h14V5H7z" Width="14" Height="14"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsNumberedList}"
                                      Command="{Binding NumberedListCommand}"
                                      Classes="RibbonToggle"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.List_Numbered}">
                            <PathIcon Data="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z" Width="14" Height="14"/>
                        </ToggleButton>
                        <Separator Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="2 0" VerticalAlignment="Center"/>
                        <Button Command="{Binding DecreaseIndentCommand}"
                                Classes="RibbonBtn"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Para_Outdent}">
                            <PathIcon Data="M11 17h10v-2H11v2zm-8-5l4 4V8l-4 4zm0 9h18v-2H3v2zM3 3v2h18V3H3zm8 6h10V7H11v2zm0 4h10v-2H11v2z" Width="14" Height="14"/>
                        </Button>
                        <Button Command="{Binding IncreaseIndentCommand}"
                                Classes="RibbonBtn"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Para_Indent}">
                            <PathIcon Data="M3 21h18v-2H3v2zm0-4h18v-2H3v2zm0-4h10v-2H3v2zm0-4h10V7H3v2zm8-8v4l4-4H3v2h8V3zm0 0h10v-2H11v2z" Width="14" Height="14"/>
                        </Button>
                        <Separator Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="2 0" VerticalAlignment="Center"/>
                        <ToggleButton IsChecked="{Binding CurrentAlignment,
                                          Converter={x:Static converters:EqualityConverter.Instance},
                                          ConverterParameter=Left}"
                                      Command="{Binding AlignLeftCommand}"
                                      Classes="RibbonToggle"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.Align_Left}">
                            <PathIcon Data="M15 15H3v2h12v-2zm0-8H3v2h12V7zM3 13h18v-2H3v2zm0 8h18v-2H3v2zM3 3v2h18V3H3z" Width="14" Height="14"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding CurrentAlignment,
                                          Converter={x:Static converters:EqualityConverter.Instance},
                                          ConverterParameter=Center}"
                                      Command="{Binding AlignCenterCommand}"
                                      Classes="RibbonToggle"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.Align_Center}">
                            <PathIcon Data="M7 15v2h10v-2H7zm-4 6h18v-2H3v2zm0-8h18v-2H3v2zm4-6v2h10V7H7zM3 3v2h18V3H3z" Width="14" Height="14"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding CurrentAlignment,
                                          Converter={x:Static converters:EqualityConverter.Instance},
                                          ConverterParameter=Right}"
                                      Command="{Binding AlignRightCommand}"
                                      Classes="RibbonToggle"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.Align_Right}">
                            <PathIcon Data="M3 21h18v-2H3v2zm6-4h12v-2H9v2zm-6-4h18v-2H3v2zm6-4h12V7H9v2zM3 3v2h18V3H3z" Width="14" Height="14"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding CurrentAlignment,
                                          Converter={x:Static converters:EqualityConverter.Instance},
                                          ConverterParameter=Justify}"
                                      Command="{Binding AlignJustifyCommand}"
                                      Classes="RibbonToggle"
                                      ToolTip.Tip="{x:Static loc:TextEditorStrings.Align_Justify}">
                            <PathIcon Data="M3 21h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18V7H3v2zm0-6v2h18V3H3z" Width="14" Height="14"/>
                        </ToggleButton>
                        <Separator Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="2 0" VerticalAlignment="Center"/>
                        <SplitButton Classes="RibbonSplit"
                                     ToolTip.Tip="{x:Static loc:TextEditorStrings.Para_LineSpacing}">
                            <SplitButton.Content>
                                <PathIcon Data="M6 7h2.5L5 3.5 1.5 7H4v10H1.5L5 20.5 8.5 17H6V7zm4 2v2h12V9H10zm0 6h12v-2H10v2zm0-4h12v-2H10v2z" Width="14" Height="14"/>
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="1.0"  Command="{Binding SetLineSpacingCommand}" CommandParameter="1.0"/>
                                    <MenuItem Header="1.15" Command="{Binding SetLineSpacingCommand}" CommandParameter="1.15"/>
                                    <MenuItem Header="1.5"  Command="{Binding SetLineSpacingCommand}" CommandParameter="1.5"/>
                                    <MenuItem Header="2.0"  Command="{Binding SetLineSpacingCommand}" CommandParameter="2.0"/>
                                    <MenuItem Header="3.0"  Command="{Binding SetLineSpacingCommand}" CommandParameter="3.0"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button Command="{Binding SpaceBeforeCommand}"
                                Classes="RibbonBtn"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Para_SpaceBefore}">
                            <PathIcon Data="M4 6h16v2H4zm4 5h12v2H8zm-4 5h16v2H4z" Width="14" Height="14"/>
                        </Button>
                        <Button Command="{Binding SpaceAfterCommand}"
                                Classes="RibbonBtn"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Para_SpaceAfter}">
                            <PathIcon Data="M4 5h16v2H4zm4 5h12v2H8zm-4 7h16v2H4z" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Separator Width="1" Height="40" Background="{DynamicResource BorderSubtleBrush}" Margin="3 0" VerticalAlignment="Center"/>

            <!-- Стили -->
            <Border Padding="4 2">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static loc:TextEditorStrings.Ribbon_Styles}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ListBox ItemsSource="{Binding AvailableStyles}"
                             SelectedItem="{Binding CurrentStyleName}"
                             Height="48" Width="140">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Separator Width="1" Height="40" Background="{DynamicResource BorderSubtleBrush}" Margin="3 0" VerticalAlignment="Center"/>

            <!-- Правка -->
            <Border Padding="4 2">
                <StackPanel Spacing="2">
                    <TextBlock Text="Editing"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Command="{Binding FindCommand}"
                                Classes="RibbonBtnLarge"
                                Width="44"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Find_Title}">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Width="20" Height="20"/>
                                <TextBlock Text="{x:Static loc:TextEditorStrings.Find_Title}" FontSize="9" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FindReplaceCommand}"
                                Classes="RibbonBtnLarge"
                                Width="50"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.FindReplace_Title}">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M11 6C9.55 6 8.23 6.57 7.25 7.47l1.42 1.42C9.28 8.34 10.11 8 11 8c2.21 0 4 1.79 4 4s-1.79 4-4 4c-1.93 0-3.54-1.38-3.92-3.19l1.45 1.45 1.41-1.41-3.88-3.88L2.18 12.8l1.41 1.41.88-.88C4.95 16.23 7.75 18 11 18c3.86 0 7-3.14 7-7s-3.14-7-7-7z" Width="20" Height="20"/>
                                <TextBlock Text="{x:Static loc:TextEditorStrings.FindReplace_Title}" FontSize="9" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectAllCommand}"
                                Classes="RibbonBtnLarge"
                                Width="44"
                                ToolTip.Tip="{x:Static loc:TextEditorStrings.Edit_SelectAll}">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M3 5h2V3c-1.1 0-2 .9-2 2zm0 8h2v-2H3v2zm4 8h2v-2H7v2zM3 9h2V7H3v2zm10-6h-2v2h2V3zm6 0v2h2c0-1.1-.9-2-2-2zM5 21v-2H3c0 1.1.9 2 2 2zm-2-4h2v-2H3v2zM9 3H7v2h2V3zm2 18h2v-2h-2v2zm8-8h2v-2h-2v2zm0 8c1.1 0 2-.9 2-2h-2v2zm0-12h2V7h-2v2zm0 8h2v-2h-2v2zm-4 4h2v-2h-2v2zm0-16h2V3h-2v2z" Width="20" Height="20"/>
                                <TextBlock Text="{x:Static loc:TextEditorStrings.Edit_SelectAll}" FontSize="9" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
