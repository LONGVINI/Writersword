<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Characters.ViewModels"
             xmlns:views="using:Writersword.Modules.Characters.Views"
             xmlns:loc="using:Writersword.Src.Modules.Characters.Resources"
             xmlns:conv="using:Writersword.Modules.Characters.Converters"
             xmlns:icv="using:Writersword.Infrastructure.Converters"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             xmlns:controls="using:Writersword.Modules.Characters.Controls"
             x:Class="Writersword.Modules.Characters.Views.Tabs.CharacterEditView"
             x:DataType="vm:CharactersViewModel">

    <UserControl.Styles>
        <!-- Плоские кнопки без неявных переходов темы (иначе BrushTransition гонит
             широкую перерисовку), лёгкий фон под курсором. -->
        <Style Selector="Button.edit-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- Рамка фокуса рисуется вокруг всей кнопки, за пределами баннера —
                 отключается, чтобы выделение не выходило за блок. -->
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Transitions">
                <Transitions/>
            </Setter>
        </Style>
        <!-- Наведение подсвечивает сам баннер (Border внутри контента кнопки),
             а не весь ContentPresenter — у баннеров есть отступы и скругления.
             Собственная ховер-заливка кнопки из темы Fluent глушится, иначе
             подсветка выходит за пределы баннера. -->
        <Style Selector="Button.edit-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.edit-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.edit-row:pointerover Border#RowBanner">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>
        <Style Selector="Button.fold-header">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Transitions">
                <Transitions/>
            </Setter>
        </Style>
        <Style Selector="Button.fold-header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.fold-header:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.fold-header:pointerover Border#FolderBanner">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>

        <!-- Скроллбар бокового списка: всегда видимый, приглушённый, из цветов темы.
             Трек — в цвет панели (сливается с фоном списка), ползунок — цвет рамок
             (BorderDefaultBrush), под курсором — приглушённый текстовый (TextMutedBrush). -->
        <Style Selector="ScrollViewer.sidebar-scroll /template/ ScrollBar">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>
        <!-- TrackRect — внутренний прямоугольник трека в Fluent-шаблоне ScrollBar:
             у него собственная заливка из ресурсов темы, Background самого ScrollBar
             её не перекрывает — поэтому заливается отдельно. -->
        <Style Selector="ScrollViewer.sidebar-scroll /template/ ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="Stroke" Value="Transparent"/>
        </Style>
        <!-- Глобальный стиль (Styles/Controls.axaml) подменяет шаблон ползунка
             и зашивает в его Border тёмный BorderDefaultBrush — Background самого
             Thumb там не участвует. Поэтому здесь перекрашивается именно Border
             внутри шаблона ползунка. -->
        <Style Selector="ScrollViewer.sidebar-scroll /template/ ScrollBar /template/ Thumb /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}"/>
        </Style>
        <Style Selector="ScrollViewer.sidebar-scroll /template/ ScrollBar /template/ Thumb:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="ScrollViewer.sidebar-scroll /template/ ScrollBar /template/ Thumb:pressed /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>

        <!-- Площадка аватарки в строке списка. В компактном режиме подписей
             нет, и она занимает обе колонки разом — те, что идут после полоски
             цвета. Центр считается по ним, то есть по внутренней области
             плитки; полоска в расчёт не входит и лежит слева от неё.

             Отступы здесь обнулены намеренно: подбирать их бесполезно, остаток
             строки зависит от ширины панели и полосы прокрутки, и подобранные
             числа врут при первом же их изменении. -->
        <Style Selector="Panel.avatar-slot.compact">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Кнопки управления боковым списком (компактный режим, скрытие).
             Размер задан жёстко, а не выведен из содержимого: значки разной
             величины (16, 12, 16) давали кнопки разной высоты, и нажимные
             области с подсветкой наведения не совпадали. 24 — это ровно треть
             содержимого шапки в компактном режиме (84 минус поля 6 и 6),
             поэтому три кнопки делят полосу без остатка. Поля обнулены:
             содержимое выравнивает по центру сама кнопка. -->
        <Style Selector="Button.side-tool">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.side-tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>
        <Style Selector="Button.side-tool Path">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
        </Style>
        <Style Selector="Button.side-tool:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.side-tool Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
        </Style>
        <Style Selector="Button.side-tool:pointerover Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.side-tool Rectangle">
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.side-tool:pointerover Rectangle">
            <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Шаблоны строк плоского списка: заголовок папки и персонаж выбираются
         репитером по типу элемента EditorRows. -->
    <UserControl.DataTemplates>

        <!-- Заголовок папки (read-only): плоский блок-баннер, клик сворачивает/
             разворачивает. Ни переименования, ни удаления, ни редактирования
             комментария. -->
        <DataTemplate DataType="vm:CharacterFolderViewModel">
            <!-- Высота строки берётся из той же вьюмодели, что отдаёт её
                 раскладке: иначе расчёт скролла и нарисованная строка
                 разъедутся, и ползунок снова начнёт плавать. -->
            <Button Classes="fold-header"
                    Height="{Binding RowHeight}"
                    Command="{Binding ToggleExpandCommand}">
                <!-- Задник нейтральный (BgListBlockBrush) без цветного выделения:
                     цвет папки показывает только точка внутри. -->
                <Border x:Name="FolderBanner"
                        Margin="6,4,6,2"
                        CornerRadius="0"
                        ClipToBounds="True"
                        Background="{DynamicResource BgListBlockBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="34"
                          ToolTip.Tip="{Binding Name}">
                            <!-- Конвертер цвета: поддерживает и одноцвет, и градиенты. -->
                            <Border Grid.Column="0"
                                    Width="10" Height="10" CornerRadius="5"
                                    Background="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
                                    Margin="10,0,8,0"
                                    VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                        IsVisible="{ReflectionBinding $parent[UserControl].DataContext.IsSidebarFull}">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Comment}"
                                           FontSize="10" FontStyle="Italic"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Count}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" MinWidth="20"
                                       TextAlignment="Center" Margin="4,0"
                                       IsVisible="{ReflectionBinding $parent[UserControl].DataContext.IsSidebarFull}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding IsExpanded, Converter={x:Static conv:BoolToCollapseArrowConverter.Instance}}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="4,0,10,0"
                                       IsVisible="{ReflectionBinding $parent[UserControl].DataContext.IsSidebarFull}"/>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Строка персонажа: плоский блок с нейтральным фоном BgListBlockBrush
             и тонкой окантовкой цветом/градиентом персонажа. Внутри — аватар-кружок,
             имя и описание. Фиксированная высота ряда сохраняет точную высоту списка. -->
        <DataTemplate DataType="vm:CharacterListItemViewModel">
            <!-- Строка списка — заодно источник перетаскивания: тащится на
                 полотно связей в открытой карточке. Обычный щелчок при этом
                 продолжает открывать персонажа: перетаскивание начинается
                 только после сдвига мыши на несколько пикселей. -->
            <Button Classes="edit-row"
                    Height="{Binding RowHeight}"
                    Command="{ReflectionBinding $parent[UserControl].DataContext.EditCharacterCommand}"
                    CommandParameter="{Binding Id}"
                    PointerPressed="OnRowPointerPressed"
                    PointerMoved="OnRowPointerMoved"
                    PointerReleased="OnRowPointerReleased">
                <Border x:Name="RowBanner"
                        Margin="6,2"
                        CornerRadius="0"
                        ClipToBounds="True"
                        Background="{DynamicResource BgListBlockBrush}"
                        BorderThickness="1"
                        BorderBrush="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
                        Opacity="{Binding DeadRowOpacity}"
                        ToolTip.Tip="{Binding Name}">
                    <Grid ColumnDefinitions="4,46,*" Height="52">
                        <!-- Полоска цветом/градиентом персонажа по левому краю блока. -->
                        <Border Grid.Column="0"
                                Background="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>
                        <!-- Отступов нет: плитка 36 центруется в колонке 46
                             сама, а локальное значение Margin перебивало бы
                             сеттер стиля avatar-slot.compact. -->
                        <Panel Classes="avatar-slot"
                               Classes.compact="{ReflectionBinding $parent[UserControl].DataContext.IsSidebarCompact}"
                               Grid.Column="1"
                               Width="36" Height="36"
                               VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>
                                <TextBlock Text="{Binding FallbackIcon}"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           IsVisible="{Binding AvatarBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                                <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding AvatarBitmap, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Image Source="{Binding AvatarBitmap}" Stretch="UniformToFill"/>
                                </Border>
                                <!-- Кольцо цветом персонажа вокруг аватарки с зазором —
                                     как на карточках основного списка: кольцо крупнее
                                     круга аватарки, иначе сливается с её заливкой
                                     (свойство AvatarRing). -->
                                <Border Width="36" Height="36" CornerRadius="999"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        BorderThickness="1"
                                        BorderBrush="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding AvatarRing}"/>

                                <!-- Метка «Мёртв»: бейдж-череп на аватаре. Объект —
                                     носитель смысла, приглушение строки — усилитель.
                                     Крестик здесь не используется: им в интерфейсе
                                     обозначается удаление. -->
                                <Border Width="14" Height="14" CornerRadius="7"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#CC202020"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding IsDead}">
                                    <Path Data="M12,2C7.03,2 3,6.03 3,11c0,2.85 1.34,5.38 3.42,7.02V21c0,0.55 0.45,1 1,1h1.5v-2h2v2h2v-2h2v2H16c0.55,0 1,-0.45 1,-1v-2.98C19.66,16.38 21,13.85 21,11C21,6.03 16.97,2 12,2zM8.5,13C7.67,13 7,12.33 7,11.5C7,10.67 7.67,10 8.5,10s1.5,0.67 1.5,1.5C10,12.33 9.33,13 8.5,13zM15.5,13c-0.83,0 -1.5,-0.67 -1.5,-1.5c0,-0.83 0.67,-1.5 1.5,-1.5s1.5,0.67 1.5,1.5C17,12.33 16.33,13 15.5,13z"
                                          Fill="#FF5252"
                                          Stretch="Uniform"
                                          Margin="2"/>
                                </Border>
                            </Panel>
                            <!-- Подписи, ленточка группы и точка папки живут только
                                 в полном режиме списка: в компактном (одни аватарки)
                                 их прячет общая Panel-обёртка. -->
                            <Panel Grid.Column="2"
                                   IsVisible="{ReflectionBinding $parent[UserControl].DataContext.IsSidebarFull}">
                                <StackPanel Margin="6,6,20,6"
                                            VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="Medium"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                                        <!-- Имя, по которому карточка нашлась, если оно
                                             не отображаемое. Боковой список редактора
                                             показывает результаты того же поиска, что
                                             и основной, — пояснение нужно и здесь. -->
                                        <TextBlock Text="{Binding MatchedName}"
                                                   IsVisible="{Binding HasMatchedName}"
                                                   FontSize="11"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.75"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ShortDescription}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding ShortDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Признак группы: закладка-ленточка цветом персонажа,
                                     свисающая с верхней кромки баннера — как на карточках
                                     основного списка. Показывается для всех групповых. -->
                                <Path IsVisible="{Binding IsCollective}"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,0,8,0"
                                      Data="M0,0 H10 V15 L5,10.5 L0,15 Z"
                                      Fill="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>

                                <!-- Точка цвета папки в результатах поиска: показывает,
                                     из какой папки взят персонаж. Вне поиска свойство
                                     не заполняется и точка скрыта. -->
                                <Border Width="10" Height="10" CornerRadius="5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding ShowSearchFolderDot}"
                                        Background="{Binding SearchFolderColor, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>
                            </Panel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

    </UserControl.DataTemplates>

    <Grid x:Name="EditorRootGrid">
        <!-- Боковой список редактора растягивается сплиттером, как панель модуля:
             колонка 0 — список (с пределами ширины), колонка 1 — GridSplitter,
             колонка 2 — карточка персонажа. Ширина колонки применяется из
             сессии модуля и сохраняется после перетаскивания (code-behind). -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="170" MaxWidth="520"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                IsVisible="{Binding IsSidebarShown}"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*"
                  Background="{DynamicResource BgPanelBrush}">

                <Border Grid.Row="0" Padding="6,8"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Panel>

                        <!-- Полный режим: поле поиска и две кнопки справа от него. -->
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              IsVisible="{Binding IsSidebarFull}">
                            <TextBox Grid.Column="0"
                                     x:Name="SidebarSearchBox"
                                     Text="{ReflectionBinding SearchQuery}"
                                     PlaceholderText="{x:Static loc:CharactersStrings.Search_Placeholder}"
                                     FontSize="12"
                                     Background="{DynamicResource BgSurfaceBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderDefaultBrush}"
                                     BorderThickness="1" CornerRadius="6" Padding="7,5"
                                     Margin="0,0,6,0"
                                     KeyDown="OnSidebarSearchKeyDown"
                                     LostFocus="OnSidebarSearchLostFocus"/>

                            <!-- Переключение полный/компактный список -->
                            <Button Grid.Column="1" Classes="side-tool"
                                    Click="OnCompactToggleClick">
                                <Ellipse Width="12" Height="12"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Button>

                            <!-- Скрыть список полностью -->
                            <Button Grid.Column="2" Classes="side-tool"
                                    Click="OnHideSidebarClick">
                                <Path Width="16" Height="16"
                                      Data="M10.5,3 L5.5,8 L10.5,13"
                                      Fill="Transparent"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"/>
                            </Button>
                        </Grid>

                        <!-- Компактный режим: поля поиска нет, вместо него лупа —
                             набирать запрос вслепую, по одним аватаркам, нельзя.
                             Три кнопки равны по ширине и делят полосу поровну:
                             в сетке с колонками Auto их прижимало к её краям.

                             Все три значка лежат в поле 16 на 16 и нарисованы
                             симметрично относительно точки 8,8. Растяжение
                             (Stretch) не используется: оно подгоняет под рамку
                             только очертание, а обводка остаётся прежней, и
                             значки снова разъезжаются по видимой толщине. -->
                        <UniformGrid Columns="3"
                                     IsVisible="{Binding IsSidebarCompact}">
                            <Button Classes="side-tool"
                                    Click="OnSidebarSearchClick">
                                <!-- Окружность радиуса 4 с центром 6.75,6.75 и
                                     ручка от неё под 45 градусов до 13.25:
                                     очертание занимает от 2.75 до 13.25 по обеим
                                     осям, то есть ровно середину поля. -->
                                <Path Width="16" Height="16"
                                      Data="M2.75,6.75 A4,4 0 1 0 10.75,6.75 A4,4 0 1 0 2.75,6.75 M9.6,9.6 L13.25,13.25"
                                      Fill="Transparent"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"/>
                            </Button>

                            <Button Classes="side-tool"
                                    Click="OnCompactToggleClick">
                                <!-- Три полосы дают 12 на 12; поле того же
                                     размера, что у соседей, задаёт Panel. -->
                                <Panel Width="16" Height="16">
                                    <StackPanel Spacing="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Rectangle Width="12" Height="2"/>
                                        <Rectangle Width="12" Height="2"/>
                                        <Rectangle Width="12" Height="2"/>
                                    </StackPanel>
                                </Panel>
                            </Button>

                            <Button Classes="side-tool"
                                    Click="OnHideSidebarClick">
                                <Path Width="16" Height="16"
                                      Data="M10.5,3 L5.5,8 L10.5,13"
                                      Fill="Transparent"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"/>
                            </Button>
                        </UniformGrid>

                    </Panel>
                </Border>

                <!-- Без поиска: плоский список — папки (в той же последовательности,
                     что в основном списке) и персонажи под ними.
                     Виртуализация с KnownHeightStackLayout: высоту строки отдаёт
                     сама вьюмодель (IRowHeight), поэтому смещения считаются точной
                     суммой, а не оценкой по показанным строкам. Прежний StackLayout
                     на разновысоких строках (папка 40, персонаж 52) пересчитывал
                     оценку при каждой прокрутке — ползунок плавал в размере, скролл
                     дёргался и прыгал на десятки строк, из-за чего список пришлось
                     оставить невиртуализованным целиком.
                     Список плоский, вложенных репитеров нет — зацикленный перемер,
                     ради которого писался PerfItemsRepeater, здесь невозможен. -->
                <!-- Скроллбар всегда видим (AllowAutoHide=False) и занимает собственную
                     полосу справа — на контент строк не налезает, паддинг не нужен. -->
                <ScrollViewer Grid.Row="1" Classes="sidebar-scroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Visible"
                              AllowAutoHide="False"
                              IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                    <ItemsRepeater ItemsSource="{Binding EditorRows}">
                        <ItemsRepeater.Layout>
                            <controls:KnownHeightStackLayout DefaultRowHeight="52"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <!-- Шаблон по типу строки выбирают DataTemplates
                                     вьюхи: репитер сам неявные шаблоны не ищет. -->
                                <ContentControl Content="{Binding}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- При активном поиске: плоские результаты (FilteredCharacters).
                     Строки здесь все одной высоты, виртуализация достаётся той же
                     раскладкой без оговорок. -->
                <ScrollViewer Grid.Row="1" Classes="sidebar-scroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Visible"
                              AllowAutoHide="False"
                              IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <ItemsRepeater ItemsSource="{Binding FilteredCharacters}">
                        <ItemsRepeater.Layout>
                            <controls:KnownHeightStackLayout DefaultRowHeight="52"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- Узкая полоса на месте скрытого списка: только кнопка разворота.
             Разворачивает в тот режим, из которого список скрыли. -->
        <Border Grid.Column="0"
                IsVisible="{Binding IsSidebarHidden}"
                ClipToBounds="True"
                Background="{DynamicResource BgPanelBrush}">
            <Button Classes="side-tool"
                    Click="OnRestoreSidebarClick"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.EditorSidebar_Show}">
                <Path Width="16" Height="16"
                      Data="M5.5,3 L10.5,8 L5.5,13"
                      Fill="Transparent"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"/>
            </Button>
        </Border>

        <!-- Сплиттер ширины бокового списка. Колонка занимает 1px — это и есть
             видимая линия-граница между списком и карточкой (правый бордер списка
             убран, линию рисует сам сплиттер). Отрицательные поля расширяют зону
             захвата до 5px по обе стороны линии, не добавляя видимой толщины.
             Тянуть можно только в полном режиме — в компактном и скрытом колонка
             фиксированная. -->
        <GridSplitter x:Name="SidebarSplitter"
                      Grid.Column="1"
                      Margin="-2,0"
                      ZIndex="1"
                      Background="Transparent"
                      IsEnabled="{Binding IsSidebarFull}"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
            <GridSplitter.Template>
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Rectangle Width="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   Fill="{DynamicResource BorderDefaultBrush}"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Panel Grid.Column="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        IsVisible="{Binding !IsCardOpen}">
                <TextBlock Text="{x:Static loc:CharactersStrings.Placeholder_SelectCharacter}"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            <!-- Шапка с именем и кнопкой Save убрана: имя персонажа редактируется
                 под аватаром во вкладке Basics, а карточка сохраняется сама
                 (автосохранение в CharacterCardViewModel). Panel-обёртка нужна,
                 чтобы IsCardOpen биндился к вьюмодели модуля, а не к карточке,
                 чей DataContext назначается вложенной вьюхе. -->
            <Panel IsVisible="{Binding IsCardOpen, FallbackValue=False}">
                <views:CharacterCardView DataContext="{Binding SelectedCharacterCard}"
                                         Background="{DynamicResource BgSurfaceBrush}"/>
            </Panel>
        </Panel>
    </Grid>
</UserControl>
