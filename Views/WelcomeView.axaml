<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Writersword.ViewModels"
        xmlns:loc="using:Writersword.Resources.Localization"
        x:Class="Writersword.Views.WelcomeView"
        x:DataType="vm:WelcomeViewModel"
        Title="Welcome to Writersword"
        Width="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

	<Grid>

		<!-- Подложка -->
		<Border Background="{DynamicResource BgBaseBrush}"
                CornerRadius="14"
                Margin="2"/>

		<!-- Основной контент -->
		<Border Background="{DynamicResource BgAppBrush}"
                CornerRadius="12"
                Margin="8"
                Padding="40">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Кнопка закрытия -->
				<Button Grid.Row="0"
                        Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="32"
                        Height="32"
                        Margin="0,-20,-20,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextMutedBrush}"
                        FontSize="18"
                        Cursor="Hand"
                        Click="CloseButton_Click">
					<Button.Styles>
						<Style Selector="Button:pointerover">
							<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
							<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
						</Style>
					</Button.Styles>
				</Button>

				<!-- Заголовок -->
				<StackPanel Grid.Row="0" Margin="0,0,0,30">
					<TextBlock Text="{x:Static loc:Strings.Welcome_Title}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
					<TextBlock Text="{x:Static loc:Strings.Welcome_Subtitle}"
                               FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
				</StackPanel>

				<!-- Основной контент -->
				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="20"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- Левая колонка: Новый проект -->
					<Border Grid.Column="0"
                            Background="{DynamicResource BgSurfaceBrush}"
                            CornerRadius="8"
                            Padding="20">
						<StackPanel>
							<TextBlock Text="{x:Static loc:Strings.Welcome_NewProject}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,15"/>

							<!-- Динамический список типов проектов -->
							<ItemsControl ItemsSource="{Binding ProjectTypes}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:ProjectTypeItem">
										<RadioButton IsChecked="{Binding IsSelected}"
                                                     GroupName="ProjectType"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     FontSize="14"
                                                     Margin="0,0,0,8">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<TextBlock Text="{Binding Icon}"/>
												<TextBlock Text="{Binding DisplayName}"/>
											</StackPanel>
										</RadioButton>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Button Content="{x:Static loc:Strings.Welcome_CreateButton}"
                                    Command="{Binding NewProjectCommand}"
                                    Background="{DynamicResource AccentDefaultBrush}"
                                    Foreground="White"
                                    Padding="20,12"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Stretch"
                                    FontSize="14"
                                    Cursor="Hand"/>

							<!-- Разделитель "or" -->
							<Grid Margin="0,15,0,15">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<Border Grid.Column="0"
                                        Height="1"
                                        Background="{DynamicResource BorderDefaultBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"/>

								<TextBlock Grid.Column="1"
                                           Text="or"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

								<Border Grid.Column="2"
                                        Height="1"
                                        Background="{DynamicResource BorderDefaultBrush}"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>
							</Grid>

							<Button Content="{x:Static loc:Strings.Welcome_BrowseButton}"
                                    Command="{Binding OpenProjectCommand}"
                                    Background="{DynamicResource AccentDefaultBrush}"
                                    Foreground="White"
                                    Padding="20,12"
                                    HorizontalAlignment="Stretch"
                                    FontSize="14"
                                    Cursor="Hand"/>
						</StackPanel>
					</Border>

					<!-- Правая колонка: Открыть проект -->
					<Border Grid.Column="2"
                            Background="{DynamicResource BgSurfaceBrush}"
                            CornerRadius="8"
                            Padding="20">
						<StackPanel>
							<TextBlock Text="{x:Static loc:Strings.Welcome_OpenProject}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,15"/>

							<TextBlock Text="{x:Static loc:Strings.Welcome_RecentProjects}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,10"/>

							<!-- Список недавних проектов -->
							<ItemsControl ItemsSource="{Binding RecentProjects}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Background="{DynamicResource BgPanelBrush}"
                                                CornerRadius="4"
                                                Padding="8,5"
                                                Cursor="Hand"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Margin="0,0,0,5"
                                                PointerPressed="RecentProject_Click">
											<Border.Styles>
												<Style Selector="Border:pointerover">
													<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
													<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
												</Style>
											</Border.Styles>
											<StackPanel>
												<TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
												<TextBlock Text="{Binding Path}"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           FontSize="9"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

						</StackPanel>
					</Border>

				</Grid>
			</Grid>

		</Border>
	</Grid>

</Window>