<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Writersword.ViewModels"
        xmlns:loc="using:Writersword.Resources.Localization"
        xmlns:converters="using:Writersword.Converters"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:components="using:Writersword.Views.Components"
        x:Class="Writersword.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1400"
        Height="900"
        WindowState="Maximized"
        Background="#1E1E1E"
        RequestedThemeVariant="Dark">
	<DockPanel>
		<!-- Меню -->
		<components:MenuBarView DockPanel.Dock="Top"
                                DataContext="{Binding MenuBar}"/>
		<!-- Панель вкладок -->
		<components:TabBarView DockPanel.Dock="Top"
                               DataContext="{Binding TabBar}"/>
		<!-- Панель WorkModes -->
		<components:WorkModeBarView DockPanel.Dock="Top"
                                    DataContext="{Binding WorkModeBar}"/>
		<!-- Баннер восстановления -->
		<ContentControl DockPanel.Dock="Top"
                        Content="{Binding TabBar.ActiveTab.RecoveryBanner, FallbackValue={x:Null}}"
                        IsVisible="{Binding TabBar.ActiveTab.HasRecoveryBanner}">
			<ContentControl.ContentTemplate>
				<DataTemplate>
					<components:RecoveryBanner/>
				</DataTemplate>
			</ContentControl.ContentTemplate>
		</ContentControl>
		
		<!-- Главная область: DockControl заполняет всё оставшееся пространство -->
		<!-- NotificationContainer поверх как прозрачный overlay -->
		<Panel>
			<dock:DockControl Layout="{Binding DockLayout}"
                              Background="#252526"/>
			<Panel Name="NotificationContainer"
                   ZIndex="1000"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"/>
		</Panel>
	</DockPanel>
</Window>
