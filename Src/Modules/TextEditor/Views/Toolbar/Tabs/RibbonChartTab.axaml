<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.Toolbar"
             xmlns:converters="using:Writersword.Modules.TextEditor.Converters"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             xmlns:controls="using:Writersword.Styles.UserControls"
             x:Class="Writersword.Modules.TextEditor.Views.Toolbar.Tabs.RibbonChartTab"
             x:DataType="vm:RibbonChartTabViewModel">

	<!-- Вкладка «Диаграмма»: видна, пока выделена диаграмма. Данные, вид, группировка
	     рядов, элементы и цвета; всё остальное о диаграмме — в её окне. -->
	<UserControl.Styles>
		<Style Selector="Button.RibbonBtnLarge">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="4 2"/>
			<Setter Property="MinWidth"                   Value="40"/>
			<!-- 56 — общая для всех вкладок высота тела группы: столько занимают
			     два ряда кнопок по 26 в группах «Шрифт» и «Абзац» на «Главной». -->
			<Setter Property="MinHeight"                  Value="56"/>
			<Setter Property="VerticalAlignment"          Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="Button.RibbonBtnLarge /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="Button.RibbonBtnLarge:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.RibbonBtnLarge:pressed /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<Style Selector="Border.RibbonGroup">
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="4"/>
			<Setter Property="Padding"         Value="6 4 6 0"/>
			<Setter Property="Margin"          Value="2 3"/>
		</Style>

		<Style Selector="Grid.RibbonGroupLabelGrid">
			<Setter Property="Margin" Value="0 3 0 2"/>
		</Style>

		<Style Selector="TextBlock.RibbonGroupLabel">
			<Setter Property="FontSize"            Value="10"/>
			<Setter Property="Foreground"          Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="TextAlignment"       Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment"   Value="Center"/>
		</Style>

		<Style Selector="ToggleButton.SegSquare">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="0"/>
			<Setter Property="Width"                      Value="24"/>
			<Setter Property="Height"                     Value="24"/>
			<Setter Property="MinWidth"                   Value="24"/>
			<Setter Property="MinHeight"                  Value="24"/>
			<Setter Property="VerticalAlignment"          Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare:checked /template/ ContentPresenter">
			<Setter Property="Background"             Value="{DynamicResource AccentSubtleBrush}"/>
			<Setter Property="BorderBrush"            Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="TextElement.Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare:checked:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare:checked PathIcon">
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<!-- Кнопка-квадрат с меню: тот же облик, что у SegSquare, с уголком-стрелкой. -->
		<Style Selector="Button.SegDrop">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="0"/>
			<Setter Property="Width"                      Value="24"/>
			<Setter Property="Height"                     Value="24"/>
			<Setter Property="MinWidth"                   Value="24"/>
			<Setter Property="MinHeight"                  Value="24"/>
			<Setter Property="VerticalAlignment"          Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment"   Value="Stretch"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="Button.SegDrop /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="Button.SegDrop:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.SegDrop:pressed /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.SegDrop:disabled">
			<Setter Property="Opacity" Value="0.45"/>
		</Style>
		<!-- Галереи стилей и макетов: четыре образца в ряд шире предела темы. -->
		<Style Selector="FlyoutPresenter.chartGallery">
			<Setter Property="MaxWidth" Value="2000"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare:disabled">
			<Setter Property="Opacity" Value="0.45"/>
		</Style>
		<Style Selector="Button.RibbonBtnLarge:disabled">
			<Setter Property="Opacity" Value="0.45"/>
		</Style>
	</UserControl.Styles>

	<controls:RibbonScrollContainer x:Name="ScrollContainer">
		<controls:RibbonScrollContainer.RibbonContent>
			<StackPanel Orientation="Horizontal">

				<!-- ── Данные ─────────────────────────────────────────────── -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Данные"/>
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="4">
							<Button Classes="RibbonBtnLarge"
							        Command="{Binding EditDataCommand}"
							        behaviours:TooltipBehavior.Tip="Окно диаграммы: таблица данных, вид и оформление">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Width="18" Height="18" Data="M3 3h18v18H3V3zm2 2v4h6V5H5zm8 0v4h6V5h-6zm-8 6v4h6v-4H5zm8 0v4h6v-4h-6zm-8 6v2h6v-2H5zm8 0v2h6v-2h-6z"/>
									<TextBlock FontSize="9" Text="Изменить данные" HorizontalAlignment="Center"/>
								</StackPanel>
							</Button>
							<Button Classes="RibbonBtnLarge"
							        IsEnabled="{Binding CanSwitchRowColumn}"
							        Command="{Binding SwitchRowColumnCommand}"
							        behaviours:TooltipBehavior.Tip="Поменять местами ряды и категории">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Width="18" Height="18" Data="M7 3L3 7h3v7h2V7h3L7 3zm10 18l4-4h-3v-7h-2v7h-3l4 4z"/>
									<TextBlock FontSize="9" Text="Строка/столбец" HorizontalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</DockPanel>
				</Border>

				<!-- ── Вид ─────────────────────────────────────────────────── -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Вид"/>
						</Grid>
						<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
						      RowSpacing="4" ColumnSpacing="2" VerticalAlignment="Center">
								<ToggleButton Classes="SegSquare" Grid.Row="0" Grid.Column="0"
								              Command="{Binding SetKindCommand}" CommandParameter="Column"
								              IsChecked="{Binding CurrentKind, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Column, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Гистограмма">
									<PathIcon Width="14" Height="14" Data="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare" Grid.Row="0" Grid.Column="1"
								              Command="{Binding SetKindCommand}" CommandParameter="Bar"
								              IsChecked="{Binding CurrentKind, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Bar, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Линейчатая">
									<PathIcon Width="14" Height="14" Data="M4 5h10v3H4V5zm0 5.6h16v2.8H4v-2.8zm0 5.6h7V19H4v-2.8z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare" Grid.Row="0" Grid.Column="2"
								              Command="{Binding SetKindCommand}" CommandParameter="Line"
								              IsChecked="{Binding CurrentKind, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Line, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="График">
									<PathIcon Width="14" Height="14" Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare" Grid.Row="0" Grid.Column="3"
								              Command="{Binding SetKindCommand}" CommandParameter="Area"
								              IsChecked="{Binding CurrentKind, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Area, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="С областями">
									<PathIcon Width="14" Height="14" Data="M3 19l5-8 4 4 5-9 4 6v7z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare" Grid.Row="0" Grid.Column="4"
								              Command="{Binding SetKindCommand}" CommandParameter="Pie"
								              IsChecked="{Binding CurrentKind, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Pie, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Круговая">
									<PathIcon Width="14" Height="14" Data="M11 2v20c-5.07-.5-9-4.79-9-10s3.93-9.5 9-10zm2.03 0v8.99H22c-.47-4.74-4.24-8.52-8.97-8.99zm0 11.01V22c4.74-.47 8.5-4.25 8.97-8.99h-8.97z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare" Grid.Row="1" Grid.Column="0"
								              Command="{Binding SetKindCommand}" CommandParameter="Doughnut"
								              IsChecked="{Binding CurrentKind, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Doughnut, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Кольцевая">
									<PathIcon Width="14" Height="14" Data="M13 2.05v3.03c3.39.49 6 3.39 6 6.92 0 .9-.18 1.75-.48 2.54l2.6 1.53c.56-1.24.88-2.62.88-4.07 0-5.18-3.95-9.45-9-9.95zM12 19c-3.87 0-7-3.13-7-7 0-3.53 2.61-6.43 6-6.92V2.05c-5.06.5-9 4.76-9 9.95 0 5.52 4.47 10 9.99 10 3.31 0 6.24-1.61 8.06-4.09l-2.6-1.53C16.17 17.98 14.21 19 12 19z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare" Grid.Row="1" Grid.Column="1"
								              Command="{Binding SetKindCommand}" CommandParameter="Scatter"
								              IsChecked="{Binding CurrentKind, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Scatter, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Точечная">
									<PathIcon Width="14" Height="14" Data="M5 15h3v3H5zm4-7h3v3H9zm6 8h3v3h-3zm2-10h3v3h-3zm-4 4h3v3h-3z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare" Grid.Row="1" Grid.Column="2"
								              Command="{Binding SetKindCommand}" CommandParameter="Bubble"
								              IsChecked="{Binding CurrentKind, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Bubble, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Пузырьковая">
									<PathIcon Width="14" Height="14" Data="M3 15a4 4 0 1 0 8 0a4 4 0 1 0 -8 0zM13 7a3 3 0 1 0 6 0a3 3 0 1 0 -6 0zM15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare" Grid.Row="1" Grid.Column="3"
								              Command="{Binding SetKindCommand}" CommandParameter="Radar"
								              IsChecked="{Binding CurrentKind, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Radar, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Лепестковая">
									<PathIcon Width="14" Height="14" Data="M12 2l9.5 6.9-3.6 11.1H6.1L2.5 8.9 12 2zm0 2.5L4.9 9.6l2.7 8.4h8.8l2.7-8.4L12 4.5zm0 3.5l4.2 3.1-1.6 4.9H9.4l-1.6-4.9L12 8z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare" Grid.Row="1" Grid.Column="4"
								              Command="{Binding SetKindCommand}" CommandParameter="Stock"
								              IsChecked="{Binding CurrentKind, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Stock, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Биржевая">
									<PathIcon Width="14" Height="14" Data="M6 3h2v3h1v10H8v5H6v-5H5V6h1V3zm9 3h2v3h1v8h-1v4h-2v-4h-1V9h1V6z"/>
								</ToggleButton>
						</Grid>
					</DockPanel>
				</Border>

				<!-- ── Ряды ────────────────────────────────────────────────── -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Ряды"/>
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
								<ToggleButton Classes="SegSquare"
								              IsEnabled="{Binding HasGrouping}"
								              Command="{Binding SetGroupingCommand}" CommandParameter="Standard"
								              IsChecked="{Binding CurrentGrouping, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Standard, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Рядом">
									<PathIcon Width="14" Height="14" Data="M4 19h3V9H4v10zm5 0h3V5H9v14zm5 0h3v-7h-3v7zm5 0h3V8h-3v11z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare"
								              IsEnabled="{Binding HasGrouping}"
								              Command="{Binding SetGroupingCommand}" CommandParameter="Stacked"
								              IsChecked="{Binding CurrentGrouping, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Stacked, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="С накоплением">
									<PathIcon Width="14" Height="14" Data="M5 19h4v-5H5v5zm0-6h4V9H5v4zm6 6h4v-8h-4v8zm0-9h4V5h-4v5zm6 9h4v-4h-4v4zm0-5h4v-3h-4v3z"/>
								</ToggleButton>
								<ToggleButton Classes="SegSquare"
								              IsEnabled="{Binding HasGrouping}"
								              Command="{Binding SetGroupingCommand}" CommandParameter="PercentStacked"
								              IsChecked="{Binding CurrentGrouping, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=PercentStacked, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Нормированная: каждая категория — 100 %">
									<PathIcon Width="14" Height="14" Data="M5 19h4v-7H5v7zm0-8h4V5H5v6zm6 8h4v-4h-4v4zm0-5h4V5h-4v9zm6 5h4V9h-4v10zm0-11h4V5h-4v3z"/>
								</ToggleButton>
						</StackPanel>
					</DockPanel>
				</Border>

				<!-- ── Элементы ────────────────────────────────────────────── -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Элементы"/>
						</Grid>
						<!-- «Добавить элемент»: меню собирается при открытии по выделенной
						     диаграмме (RibbonChartTab.axaml.cs). -->
						<Button x:Name="AddElementButton"
						        DockPanel.Dock="Left"
						        Classes="RibbonBtnLarge"
						        Margin="0 0 6 0"
						        behaviours:TooltipBehavior.Tip="Добавить элемент диаграммы"
						        behaviours:TooltipBehavior.Description="Оси, названия осей, название, метки данных, таблица данных, линии сетки и легенда">
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="18" Height="18" Data="M3 3h2v16h16v2H3V3zm4 10h3v4H7v-4zm5-4h3v8h-3V9zm5-4h3v12h-3V5zM19 1h2v2h2v2h-2v2h-2V5h-2V3h2V1z"/>
								<StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
									<TextBlock FontSize="9" Text="Добавить элемент"/>
									<PathIcon Width="7" Height="7" Data="M7 10l5 5 5-5z"/>
								</StackPanel>
							</StackPanel>
							<Button.Flyout>
								<MenuFlyout Placement="BottomEdgeAlignedLeft"/>
							</Button.Flyout>
						</Button>
						<!-- Элементы, которые включают и выключают чаще всего: значки, как у «Вида». -->
						<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
						      RowSpacing="4" ColumnSpacing="2" VerticalAlignment="Center">
							<ToggleButton Classes="SegSquare" Grid.Row="0" Grid.Column="0"
							              Command="{Binding ToggleTitleCommand}"
							              IsChecked="{Binding ShowTitle, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Название диаграммы"
							              behaviours:TooltipBehavior.Description="Строка названия над диаграммой. Текст правится в окне диаграммы">
								<PathIcon Width="14" Height="14" Data="M4 3h16v3.5H4V3zm1 9h2.6v8H5v-8zm4.6-2.5h2.6V20H9.6V9.5zm4.6 4h2.6V20h-2.6v-6.5zm4.6-2.5H21v9h-2.2v-9z"/>
							</ToggleButton>
							<ToggleButton Classes="SegSquare" Grid.Row="0" Grid.Column="1"
							              Command="{Binding ToggleDataLabelsCommand}"
							              IsChecked="{Binding ShowDataLabels, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Подписи значений"
							              behaviours:TooltipBehavior.Description="Число у каждой точки, столбца или доли">
								<PathIcon Width="14" Height="14" Data="M4 14h3.4v7H4v-7zm6.3-4h3.4v11h-3.4V10zm6.3 3H20v8h-3.4v-8zM3.2 9.5h5v2.6h-5V9.5zm6.3-4h5v2.6h-5V5.5zm6.3 3h5v2.6h-5V8.5z"/>
							</ToggleButton>
							<ToggleButton Classes="SegSquare" Grid.Row="0" Grid.Column="2"
							              IsEnabled="{Binding HasAxes}"
							              Command="{Binding ToggleGridlinesCommand}"
							              IsChecked="{Binding ShowGridlines, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Линии сетки"
							              behaviours:TooltipBehavior.Description="Основные линии сетки по оси значений">
								<PathIcon Width="14" Height="14" Data="M3 3h1.6v16.4H21V21H3V3zm4 1h14v1.4H7V4zm0 4.6h14V10H7V8.6zm0 4.6h14v1.4H7v-1.4z"/>
							</ToggleButton>
							<ToggleButton Classes="SegSquare" Grid.Row="1" Grid.Column="0"
							              IsEnabled="{Binding HasAxes}"
							              Command="{Binding ToggleAxisTitlesCommand}"
							              IsChecked="{Binding ShowAxisTitles, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Названия осей"
							              behaviours:TooltipBehavior.Description="Подписи вдоль осей. Текст правится в окне диаграммы">
								<PathIcon Width="14" Height="14" Data="M6 2h1.6v15.4H22V19H6V2zM10 20.6h8V22h-8v-1.4zM2 6h1.4v8H2V6zm8 6h2.4v4H10v-4zm4-4h2.4v8H14V8zm4 2h2.4v6H18v-6z"/>
							</ToggleButton>
							<ToggleButton Classes="SegSquare" Grid.Row="1" Grid.Column="1"
							              Command="{Binding ToggleBorderCommand}"
							              IsChecked="{Binding ShowBorder, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Рамка"
							              behaviours:TooltipBehavior.Description="Тонкая рамка вокруг диаграммы">
								<PathIcon Width="14" Height="14" Data="M3 4h18v16H3V4zm1.6 1.6v12.8h14.8V5.6H4.6zM7 13h2.2v3.5H7V13zm3.9-4.5h2.2v8h-2.2v-8zm3.9 2.5H17v5.5h-2.2V11z"/>
							</ToggleButton>
							<Button Classes="SegDrop" Grid.Row="1" Grid.Column="2"
							        behaviours:TooltipBehavior.Tip="Легенда"
							        behaviours:TooltipBehavior.Description="Где стоит легенда: снизу, справа, сверху, слева или нигде">
								<Grid>
									<PathIcon Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
									          Data="M3 5h4v4H3V5zm6 1.3h12v1.4H9V6.3zM3 10h4v4H3v-4zm6 1.3h12v1.4H9v-1.4zM3 15h4v4H3v-4zm6 1.3h12v1.4H9v-1.4z"/>
									<PathIcon Width="5" Height="5" Margin="0 0 2 2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
									          Data="M24 6L12 20 0 6z"/>
								</Grid>
								<Button.Flyout>
									<MenuFlyout>
										<MenuItem Header="Нет" Command="{Binding SetLegendCommand}" CommandParameter="None"/>
										<MenuItem Header="Снизу" Command="{Binding SetLegendCommand}" CommandParameter="Bottom"/>
										<MenuItem Header="Справа" Command="{Binding SetLegendCommand}" CommandParameter="Right"/>
										<MenuItem Header="Сверху" Command="{Binding SetLegendCommand}" CommandParameter="Top"/>
										<MenuItem Header="Слева" Command="{Binding SetLegendCommand}" CommandParameter="Left"/>
									</MenuFlyout>
								</Button.Flyout>
							</Button>
						</Grid>
					</DockPanel>
				</Border>

				<!-- ── Цвета ───────────────────────────────────────────────── -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Стиль"/>
						</Grid>
						<!-- Цвета, стили и экспресс-макеты: образцы собираются при открытии по
						     выделенной диаграмме (RibbonChartTab.axaml.cs). -->
						<StackPanel Orientation="Horizontal" Spacing="4">
							<Button x:Name="QuickLayoutButton"
							        Classes="RibbonBtnLarge"
							        behaviours:TooltipBehavior.Tip="Экспресс-макет"
							        behaviours:TooltipBehavior.Description="Готовое расположение элементов: название, легенда, названия осей, подписи, таблица данных">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Width="18" Height="18" Data="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v4h-8V3zm0 6h8v2h-8V9zM3 13h18v8H3v-8zm2 2v4h14v-4H5z"/>
									<StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
										<TextBlock FontSize="9" Text="Экспресс-макет"/>
										<PathIcon Width="7" Height="7" Data="M7 10l5 5 5-5z"/>
									</StackPanel>
								</StackPanel>
								<Button.Flyout>
									<Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="chartGallery"/>
								</Button.Flyout>
							</Button>
							<Button x:Name="ColorsButton"
							        Classes="RibbonBtnLarge"
							        behaviours:TooltipBehavior.Tip="Изменить цвета"
							        behaviours:TooltipBehavior.Description="Набор цветов рядов (у круговой — долей): готовые и свои наборы">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Width="18" Height="18" Data="M12 3a9 9 0 0 0 0 18c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3-4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3 4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
									<StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
										<TextBlock FontSize="9" Text="Цвета"/>
										<PathIcon Width="7" Height="7" Data="M7 10l5 5 5-5z"/>
									</StackPanel>
								</StackPanel>
								<Button.Flyout>
									<Flyout Placement="BottomEdgeAlignedLeft"/>
								</Button.Flyout>
							</Button>
							<Button x:Name="StylesButton"
							        Classes="RibbonBtnLarge"
							        behaviours:TooltipBehavior.Tip="Стили диаграмм"
							        behaviours:TooltipBehavior.Description="Готовый облик: фон, сетка, рамка, надписи; данные и расположение элементов не меняются">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Width="18" Height="18" Data="M7 14c-1.66 0-3 1.34-3 3 0 1.31-1.16 2-2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34a.996.996 0 0 0-1.41 0L9 12.25 11.75 15l8.96-8.96a.996.996 0 0 0 0-1.41z"/>
									<StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
										<TextBlock FontSize="9" Text="Стили"/>
										<PathIcon Width="7" Height="7" Data="M7 10l5 5 5-5z"/>
									</StackPanel>
								</StackPanel>
								<Button.Flyout>
									<Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="chartGallery"/>
								</Button.Flyout>
							</Button>
						</StackPanel>
					</DockPanel>
				</Border>

			</StackPanel>
		</controls:RibbonScrollContainer.RibbonContent>
	</controls:RibbonScrollContainer>
</UserControl>
