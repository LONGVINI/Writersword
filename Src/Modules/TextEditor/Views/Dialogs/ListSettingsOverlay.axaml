<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Writersword.Modules.TextEditor.Views.Dialogs.ListSettingsOverlay">

    <UserControl.Styles>

        <Style Selector="TextBlock.Section">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.Hint">
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="ComboBox.Field">
            <Setter Property="Background"          Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="CornerRadius"        Value="6"/>
            <Setter Property="MinHeight"           Value="30"/>
            <Setter Property="Padding"             Value="10 0"/>
            <Setter Property="FontSize"            Value="12"/>
            <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="NumericUpDown.Field">
            <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="MinHeight"       Value="30"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="NumericUpDown.Field /template/ TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="CornerRadius"    Value="0"/>
        </Style>

        <Style Selector="TextBox.Field">
            <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="MinHeight"       Value="30"/>
            <Setter Property="Padding"         Value="10 4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.IconClose">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.IconClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>

        <Style Selector="Button.Dialog">
            <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="18 8"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.Dialog:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.DialogAccent">
            <Setter Property="Background"      Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="18 8"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

    </UserControl.Styles>

    <Grid>

        <Border x:Name="Scrim" Background="#B3000000"/>

        <Border x:Name="EditorPanel"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="24"
                Width="460"
                Background="{DynamicResource BgBaseBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20 18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" OffsetX="0" OffsetY="12" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">

                    <Grid ColumnDefinitions="* Auto">
                        <TextBlock Grid.Column="0" Text="Настройка списка"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1" x:Name="CloseBtn" Classes="IconClose">
                            <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Width="14" Height="14"/>
                        </Button>
                    </Grid>

                    <!-- Тип списка -->
                    <StackPanel Spacing="3">
                        <TextBlock Classes="FieldLabel" Text="Тип списка"/>
                        <ComboBox x:Name="TypeCombo" Classes="Field" SelectedIndex="0">
                            <ComboBoxItem>Маркированный (один символ)</ComboBoxItem>
                            <ComboBoxItem>Нумерованный (счётная система)</ComboBoxItem>
                            <ComboBoxItem>Свой набор символов</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Маркированный: спецсимвол -->
                    <StackPanel x:Name="BulletPanel" Spacing="3">
                        <TextBlock Classes="FieldLabel" Text="Символ маркера"/>
                        <TextBox x:Name="BulletSymbolBox" Classes="Field" MaxLength="8" Text="•"/>
                        <TextBlock Classes="Hint" Text="Любой символ, одинаковый для всех пунктов: •  ▪  ◦  ★  →  —  §  ✓"/>
                    </StackPanel>

                    <!-- Нумерованный: система счёта -->
                    <StackPanel x:Name="NumberPanel" Spacing="3" IsVisible="False">
                        <TextBlock Classes="FieldLabel" Text="Система счёта"/>
                        <ComboBox x:Name="NumberSystemCombo" Classes="Field" SelectedIndex="0">
                            <ComboBoxItem>1, 2, 3 …</ComboBoxItem>
                            <ComboBoxItem>01, 02, 03 …</ComboBoxItem>
                            <ComboBoxItem>a, b, c …</ComboBoxItem>
                            <ComboBoxItem>A, B, C …</ComboBoxItem>
                            <ComboBoxItem>i, ii, iii …</ComboBoxItem>
                            <ComboBoxItem>I, II, III …</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Свой набор символов -->
                    <StackPanel x:Name="SequencePanel" Spacing="3" IsVisible="False">
                        <TextBlock Classes="FieldLabel" Text="Символы по порядку (через пробел)"/>
                        <TextBox x:Name="SequenceBox" Classes="Field"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="60" Text="① ② ③ ④ ⑤"/>
                        <TextBlock Classes="Hint" Text="1-й пункт получит 1-й символ, 2-й — второй и т.д. Разделяйте пробелами или переносами строк."/>
                        <TextBlock Classes="FieldLabel" Margin="0 6 0 0" Text="Когда символы закончатся"/>
                        <ComboBox x:Name="SequenceWrapCombo" Classes="Field" SelectedIndex="0">
                            <ComboBoxItem>Повторять сначала</ComboBoxItem>
                            <ComboBoxItem>Оставлять последний символ</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Общие правила нумерации (для нумерованного и своего набора) -->
                    <StackPanel x:Name="RulesPanel" Spacing="12" IsVisible="False">
                        <Grid ColumnDefinitions="* *" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="FieldLabel" Text="Перед номером"/>
                                <TextBox x:Name="PrefixBox" Classes="Field" MaxLength="8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="FieldLabel" Text="После номера"/>
                                <TextBox x:Name="SuffixBox" Classes="Field" MaxLength="8" Text="."/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="* *" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="FieldLabel" Text="Начать с (номер пункта)"/>
                                <NumericUpDown x:Name="StartAtBox" Classes="Field"
                                               Minimum="1" Maximum="100000" Increment="1" FormatString="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="FieldLabel" Text="Продолжение"/>
                                <ComboBox x:Name="NumberingModeCombo" Classes="Field" SelectedIndex="0">
                                    <ComboBoxItem>Продолжить предыдущий</ComboBoxItem>
                                    <ComboBoxItem>Начать заново</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Отступы -->
                    <TextBlock Classes="Section" Text="ОТСТУПЫ (ПТ)"/>
                    <Grid ColumnDefinitions="* * *" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Classes="FieldLabel" Text="Маркер"/>
                            <NumericUpDown x:Name="MarkerIndentBox" Classes="Field"
                                           Minimum="0" Maximum="1000" Increment="1" FormatString="0.#"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Classes="FieldLabel" Text="Текст"/>
                            <NumericUpDown x:Name="TextIndentBox" Classes="Field"
                                           Minimum="0" Maximum="1000" Increment="1" FormatString="0.#"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Classes="FieldLabel" Text="Мин. зазор"/>
                            <NumericUpDown x:Name="MinGapBox" Classes="Field"
                                           Minimum="0" Maximum="200" Increment="1" FormatString="0.#"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="Hint" Text="Маркер — где стоит символ; Текст — где начинается текст пункта; Мин. зазор — на сколько маркер минимум отступает от текста при перетаскивании."/>

                    <!-- Образец -->
                    <TextBlock Classes="Section" Text="ОБРАЗЕЦ"/>
                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14 12"
                            MinHeight="52">
                        <TextBlock x:Name="PreviewSample"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="1. элемент   2. элемент   3. элемент"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10"
                                Margin="0 6 0 0">
                        <Button x:Name="CancelBtn" Classes="Dialog" Content="Отмена"/>
                        <Button x:Name="OkBtn" Classes="DialogAccent" Content="ОК"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>

</UserControl>
