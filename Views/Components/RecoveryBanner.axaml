<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.ViewModels"
             xmlns:res="using:Writersword.Resources.Localization"
             x:Class="Writersword.Views.Components.RecoveryBanner"
             x:DataType="vm:RecoveryBannerViewModel">

	<!-- Современный баннер в стиле VS Code -->
	<Border Background="#2D2D30"
            BorderBrush="#007ACC"
            BorderThickness="0,2,0,0"
            Padding="15,10">

		<Grid ColumnDefinitions="Auto,*,Auto">

			<!-- ЛЕВАЯ ЧАСТЬ: Иконка + Текст -->
			<StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">

				<!-- Иконка -->
				<Border Background="#FFA500"
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        VerticalAlignment="Center">
					<TextBlock Text="⚠"
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
				</Border>

				<!-- Текст -->
				<TextBlock Text="{Binding VersionText}"
                           Foreground="#E0E0E0"
                           FontSize="13"
                           VerticalAlignment="Center"/>

			</StackPanel>

			<!-- ПРАВАЯ ЧАСТЬ: Кнопки -->
			<StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

				<!-- Кнопка переключения -->
				<Button Content="{Binding SwitchButtonText}"
                        Command="{Binding SwitchVersionCommand}"
                        Background="#007ACC"
                        Foreground="White"
                        Padding="12,6"
                        CornerRadius="3"
                        BorderThickness="0"
                        Cursor="Hand">
					<Button.Styles>
						<Style Selector="Button:pointerover">
							<Setter Property="Background" Value="#1E88E5"/>
						</Style>
					</Button.Styles>
				</Button>

				<!-- Кнопка сохранения (только при просмотре кеша) -->
				<Button Content="{x:Static res:Strings.AutoSave_Button_SaveAndContinue}"
                        Command="{Binding SaveCommand}"
                        Background="#4CAF50"
                        Foreground="White"
                        Padding="12,6"
                        CornerRadius="3"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsVisible="{Binding IsViewingCache}">
					<Button.Styles>
						<Style Selector="Button:pointerover">
							<Setter Property="Background" Value="#66BB6A"/>
						</Style>
					</Button.Styles>
				</Button>

				<!-- Кнопка "Отменить изменения" (при просмотре кеша) -->
				<Button Content="{x:Static res:Strings.AutoSave_Button_DiscardChanges}"
                        Command="{Binding DiscardCommand}"
                        Background="Transparent"
                        Foreground="#F44336"
                        BorderBrush="#F44336"
                        BorderThickness="1"
                        Padding="12,6"
                        CornerRadius="3"
                        Cursor="Hand"
                        IsVisible="{Binding IsViewingCache}">
					<Button.Styles>
						<Style Selector="Button:pointerover">
							<Setter Property="Background" Value="#F4433620"/>
						</Style>
					</Button.Styles>
				</Button>

				<!-- Кнопка "Удалить автосохранение" (при просмотре сохранённой версии) -->
				<Button Content="{x:Static res:Strings.AutoSave_Button_DeleteAutoSave}"
                        Command="{Binding DiscardCommand}"
                        Background="Transparent"
                        Foreground="#F44336"
                        BorderBrush="#F44336"
                        BorderThickness="1"
                        Padding="12,6"
                        CornerRadius="3"
                        Cursor="Hand"
                        IsVisible="{Binding !IsViewingCache}">
					<Button.Styles>
						<Style Selector="Button:pointerover">
							<Setter Property="Background" Value="#F4433620"/>
						</Style>
					</Button.Styles>
				</Button>

			</StackPanel>

		</Grid>
	</Border>

</UserControl>