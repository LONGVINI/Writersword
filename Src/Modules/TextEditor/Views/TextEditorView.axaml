<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels"
             xmlns:toolbar="using:Writersword.Modules.TextEditor.Views.Toolbar"
             xmlns:reading="using:Writersword.Modules.TextEditor.Views.Reading"
             xmlns:backdrops="using:Writersword.Modules.TextEditor.Views.Backdrops"
             xmlns:statusbar="using:Writersword.Modules.TextEditor.Views.StatusBar"
             xmlns:doc="using:Writersword.Modules.TextEditor.Document"
             xmlns:converters="using:Writersword.Modules.TextEditor.Converters"
             xmlns:ui="using:Writersword.Styles.UserControls"
             xmlns:dlg="using:Writersword.Modules.TextEditor.Views.Dialogs"
             x:Class="Writersword.Modules.TextEditor.Views.TextEditorView"
             x:DataType="vm:TextEditorViewModel"
             ui:ModalHost.IsHost="True">

	<Grid RowDefinitions="Auto * Auto">

		<!-- Оверлей редактора цвета — поверх всего модуля -->
		<ui:ColorEditorOverlay x:Name="ColorEditorOverlay"
		                       Grid.Row="0" Grid.RowSpan="3"
		                       ZIndex="200"/>

		<!-- Оверлей настроек абзаца — поверх всего модуля -->
		<dlg:ParagraphSettingsOverlay x:Name="ParagraphOverlay"
		                              Grid.Row="0" Grid.RowSpan="3"
		                              ZIndex="210"/>

		<!-- Оверлей «Определить новый список» — поверх всего модуля -->
		<dlg:ListSettingsOverlay x:Name="ListOverlay"
		                         Grid.Row="0" Grid.RowSpan="3"
		                         ZIndex="211"/>

		<!-- Оверлей «Уровни списка» — поверх всего модуля -->
		<dlg:ListLevelsOverlay x:Name="ListLevelsOverlay"
		                       Grid.Row="0" Grid.RowSpan="3"
		                       ZIndex="212"/>

		<!-- Список гарнитур. Он не всплывающее окно, а обычный контрол модуля:
		     см. пояснение в FontPickerOverlay. Слой выше остальных оверлеев —
		     список открывается из ленты и не должен уходить под них. -->
		<dlg:FontPickerOverlay x:Name="FontOverlay"
		                       Grid.Row="0" Grid.RowSpan="3"
		                       ZIndex="214"/>

		<!-- Оверлей видов чтения — поверх всего модуля -->
		<reading:ReadingThemeOverlay x:Name="ThemeOverlay"
		                             Grid.Row="0" Grid.RowSpan="3"
		                             ZIndex="213"/>

		<!-- Окно фонов: папки и плитки. Слоем выше видов чтения — открывается
		     поверх них, если человек пришёл сюда из окна видов. -->
		<backdrops:BackdropPickerOverlay x:Name="BackdropOverlay"
		                                 Grid.Row="0" Grid.RowSpan="3"
		                                 ZIndex="216"/>

		<!-- Окно «Статистика» — поверх всего модуля. Слой выше списка гарнитур:
		     оно открывается из строки состояния и из горячей клавиши, и уходить
		     под другие оверлеи ему незачем. -->
		<dlg:DocumentStatisticsOverlay x:Name="StatisticsOverlay"
		                               Grid.Row="0" Grid.RowSpan="3"
		                               ZIndex="215"/>

		<!-- Окно «Табуляция» — поверх всего модуля. Открывается из меню линейки,
		     и уходить под другие оверлеи ему незачем. -->
		<dlg:TabSettingsOverlay x:Name="TabsOverlay"
		                        Grid.Row="0" Grid.RowSpan="3"
		                        ZIndex="217"/>

		<!-- Строка 0: ленты. Их две, и одновременно видна ровно одна: правка
		     рукописи и чтение — разные занятия, и держать на экране инструменты
		     обоих значит не дать сосредоточиться ни на одном.
		     Видимость висит на обёртках, а не на самих лентах: у тех свой
		     DataContext, и привязка искала бы свойство в модели ленты. -->
		<!-- В режиме фокуса лента редактора убирается вместе с остальным верхом.
		     Возвращается она язычком у правого края или наведением к верхней
		     кромке — и уезжает снова, стоит указателю уйти вниз, к рукописи. -->
		<ContentControl x:Name="EditorRibbonHost"
		                Grid.Row="0"
		                ZIndex="160"
		                IsVisible="{Binding IsRibbonVisible}">
			<toolbar:RibbonView DataContext="{Binding Ribbon}"/>
		</ContentControl>

		<!-- Высота ленты чтения задана явно, как и у ленты редактора: иначе она
		     меняется от появления собственной полосы прокрутки, а вместе с её
		     высотой меняется и высота книги — то есть вся раскладка чтения.
		     Она же и уводит ленту: сворачиваясь, высота идёт к нулю переходом, и
		     лента уезжает под верхний край, а не пропадает рывком. -->
		<ContentControl x:Name="ReadingRibbonHost"
		                Grid.Row="0"
		                Height="104"
		                ClipToBounds="True"
		                IsVisible="False">
			<!-- Кривая симметричная, и это не придирка. CubicEaseOut трогается
			     резко и доезжает медленно: сворачиваясь, лента уходит бодро и
			     мягко замирает — выглядит хорошо. А разворачиваясь, она за треть
			     времени выпрыгивает почти на всю высоту и потом еле доползает
			     последние пиксели — и читается это как «появилась рывком».
			     CubicEaseInOut одинаково мягок на обоих концах. -->
			<ContentControl.Transitions>
				<Transitions>
					<DoubleTransition Property="Height" Duration="0:0:0.26" Easing="CubicEaseInOut"/>
					<DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="CubicEaseInOut"/>
				</Transitions>
			</ContentControl.Transitions>
			<reading:ReadingRibbonView DataContext="{Binding ReadingRibbon}"/>
		</ContentControl>

		<!-- Строка 1: Рабочая область — 2×2 сетка как в Word, плюс колонка
		     справа под вертикальную ленту чтения. -->
		<Grid Grid.Row="1"
              RowDefinitions="Auto *"
              ColumnDefinitions="Auto * Auto"
              ClipToBounds="True">

			<!-- [0,0] Переключатель типа табуляции — на пересечении линеек, как в Word.
			     Раньше здесь стоял выключатель привязки к сетке; он убран, потому что
			     привязка нужна на секунду внутри одного жеста, а не постоянной кнопкой:
			     теперь она включена всегда, а правая кнопка при перетаскивании её
			     отпускает. Освободившийся угол занял тот, кому он и принадлежит. -->
			<doc:TabTypeBoxControl Grid.Row="0" Grid.Column="0"
			                       DataContext="{Binding Ruler}"
			                       IsVisible="{Binding IsVisible}"/>

			<!-- [0,1] Горизонтальная линейка — точно над ScrollViewer -->
			<doc:HorizontalRulerControl
                    Grid.Row="0" Grid.Column="1"
                    DataContext="{Binding Ruler}"
                    IsVisible="{Binding IsVisible}"
                    ClipToBounds="True"/>

			<!-- [1,0] Вертикальная линейка — точно слева от ScrollViewer.
			     Видимость висит на обёртке: у самой линейки DataContext — модель
			     линейки, а решение принимается по режиму редактора. -->
			<ContentControl Grid.Row="1" Grid.Column="0"
			                IsVisible="{Binding IsVerticalRulerVisible}">
				<doc:VerticalRulerControl
                        x:Name="VerticalRuler"
                        DataContext="{Binding Ruler}"
                        ClipToBounds="True"/>
			</ContentControl>

			<!-- [1,1] Рабочая область: слой фона и ScrollViewer с канвасом.
			     Фон лежит ОТДЕЛЬНЫМ слоем под прокруткой, а не рисуется канвасом,
			     и причина простая: канвас прокручивается вместе с рукописью.
			     Картинка, привязанная к его координатам, растягивается на все
			     страницы разом; привязанная к видимому окну — дрожит, потому что
			     канвас перерисовывается не на каждый пиксель прокрутки. Слой не
			     прокручивается вовсе и потому стоит намертво.
			     Пока фон не задан, слои скрыты и поле, как раньше, заливает
			     канвас. -->
			<Panel Grid.Row="1" Grid.Column="1">

				<!-- Цвет поля: под картинкой он виден там, где она не закрывает
				     окно целиком, и сквозь неё, если она полупрозрачна. -->
				<Border x:Name="BackdropFillLayer" IsVisible="False"/>

				<!-- Сама картинка. Кладётся кистью, а не Image: одной кистью
				     делаются все четыре способа — заполнить, уместить, растянуть
				     и замостить. -->
				<Border x:Name="BackdropImageLayer" IsVisible="False"/>

				<ScrollViewer Name="DocumentScrollViewer"
	                          HorizontalScrollBarVisibility="Auto"
	                          VerticalScrollBarVisibility="Auto"
	                          AllowAutoHide="False"
	                          Background="Transparent">

					<!-- Своих стилей у полос прокрутки здесь нет намеренно: тонкий
					     скруглённый бегунок без стрелок задан один раз в
					     Styles/Controls.axaml и одинаков во всей программе.
					     Прежние правки цвета и ширины расходились с ним, и полосы
					     стояли то шире дорожки, то со смещением. -->

					<doc:DocumentCanvas x:Name="PageCanvas"
	                                    HorizontalAlignment="Stretch"
	                                    DataContext="{Binding DocumentViewModel}"/>

				</ScrollViewer>
			</Panel>

			<!-- [0..1, 2] Вертикальная лента чтения. Появляется, когда по ширине
			     на книгу почти ничего не остаётся: горизонтальная полоса в узком
			     окне отбирает у чтения больше, чем стоит. -->
			<ContentControl x:Name="ReadingRibbonSideHost"
			                Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
			                IsVisible="False"
			                ClipToBounds="True"
			                Width="182">
				<ContentControl.Transitions>
					<Transitions>
						<DoubleTransition Property="Width" Duration="0:0:0.26" Easing="CubicEaseInOut"/>
						<DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="CubicEaseInOut"/>
					</Transitions>
				</ContentControl.Transitions>
			</ContentControl>

			<!-- Язычок ленты чтения. Висит у правого верхнего угла — там же, где
			     кончается сама лента: тянуться за ней в середину экрана незачем,
			     а внизу и слева лежит книга. Свёрнутая лента оставляет на виду
			     только его. Форму язычок меняет вместе с лентой: полукруг снизу
			     у горизонтальной, полукруг слева у вертикальной. -->
			<Button x:Name="ReadingRibbonTab"
			        Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
			        IsVisible="False"
			        ZIndex="170"
			        Click="OnReadingRibbonTabClick"
			        Width="46" Height="20"
			        Padding="0"
			        Margin="0 0 18 0"
			        HorizontalAlignment="Right"
			        VerticalAlignment="Top"
			        Background="#E61E1E1E"
			        BorderBrush="#33FFFFFF"
			        BorderThickness="1 0 1 1"
			        CornerRadius="0 0 22 22"
			        Focusable="False"
			        Cursor="Hand"
			        ToolTip.Tip="Лента чтения">
				<Path x:Name="ReadingRibbonTabArrow"
				      Data="M 0,0 L 5,5 L 10,0"
				      Stroke="#CFCFCF"
				      StrokeThickness="1.6"
				      StrokeLineCap="Round"
				      HorizontalAlignment="Center"
				      VerticalAlignment="Center">
					<Path.Transitions>
						<Transitions>
							<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28"/>
						</Transitions>
					</Path.Transitions>
				</Path>
			</Button>

			<!-- Язычок ленты редактора. Тот же, что у ленты чтения: форма, место у
			     правого верхнего угла и стрелка, которая разворачивается вместе с
			     лентой. Движение убранной ленты в программе одно, и учить ему
			     заново на каждом режиме незачем.
			     Он и сворачивает ленту в обычной правке, и вызывает её в фокусе:
			     для человека это одно и то же действие — достать инструменты. -->
			<Button x:Name="EditorRibbonTab"
			        Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
			        IsVisible="False"
			        ZIndex="171"
			        Click="OnEditorRibbonTabClick"
			        Width="46" Height="20"
			        Padding="0"
			        Margin="0 0 18 0"
			        HorizontalAlignment="Right"
			        VerticalAlignment="Top"
			        Background="#E61E1E1E"
			        BorderBrush="#33FFFFFF"
			        BorderThickness="1 0 1 1"
			        CornerRadius="0 0 12 12"
			        Focusable="False"
			        Cursor="Hand"
			        ToolTip.Tip="Лента редактора">
				<Path x:Name="EditorRibbonTabArrow"
				      Data="M 0,0 L 5,5 L 10,0"
				      Stroke="#CFCFCF"
				      StrokeThickness="1.6"
				      StrokeLineCap="Round"
				      HorizontalAlignment="Center"
				      VerticalAlignment="Center">
					<Path.Transitions>
						<Transitions>
							<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28"/>
						</Transitions>
					</Path.Transitions>
				</Path>
			</Button>

			<!-- Всплывающая подсказка номера страницы при перетаскивании ползунка -->
			<StackPanel x:Name="PageDragTooltip"
			            Grid.Row="1" Grid.Column="1"
			            Orientation="Horizontal"
			            IsVisible="False"
			            ZIndex="150"
			            HorizontalAlignment="Right"
			            VerticalAlignment="Top"
			            Margin="0,0,16,0"
			            IsHitTestVisible="False">
				<Border Background="#E6303030"
				        BorderBrush="#66FFFFFF"
				        BorderThickness="1"
				        CornerRadius="4"
				        Padding="10,5"
				        VerticalAlignment="Center">
					<TextBlock x:Name="PageDragTooltipText"
					           Foreground="White"
					           FontSize="12"
					           FontWeight="SemiBold"
					           Text="Страница 1 / 1"/>
				</Border>
				<!-- Указатель вправо, к ползунку -->
				<Path Data="M0,0 L7,7 L0,14 Z"
				      Fill="#E6303030"
				      VerticalAlignment="Center"
				      Margin="-1,0,0,0"/>
			</StackPanel>

		</Grid>

		<!-- Строка 2: Строка состояния. Убирается не только в чтении, но и в
		     фокусе, и по отдельной галочке на вкладке «Вид»: кому-то счётчик
		     знаков нужен и в фокусе, и отбирать его насильно незачем. -->
		<ContentControl Grid.Row="2" IsVisible="{Binding IsStatusBarVisible}">
			<statusbar:EditorStatusBarView DataContext="{Binding StatusBar}"/>
		</ContentControl>

	</Grid>

</UserControl>
