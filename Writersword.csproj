<Project Sdk="Microsoft.NET.Sdk">

	<!-- ========================================
       НАСТРОЙКИ ПРОЕКТА
       ======================================== -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<AssemblyName>Writersword</AssemblyName>
		<RootNamespace>Writersword</RootNamespace>
		<Version>1.0.0</Version>
		<Product>Writersword</Product>
		<Company>Writersword Team</Company>
		<Copyright>Copyright © 2025</Copyright>
		<Description>Multi-modal writing application for writers, poets, screenwriters, and game developers</Description>
		<ApplicationIcon>Resources\Images\icon.ico</ApplicationIcon>

		<!-- Отключаем скомпилированные привязки по умолчанию
		КРАЙНЕ ОПАСНО! ЭТО РЕФЛЕКСИВНЫЕ БИНДИНГИ ПРИ КАЖДОМ ОБНОВЛЕНИИ UI И ЯВЛЯЕТСЯ НЕ ОЧЕНЬ ХОРОШИМ РЕШЕНИЕМ!!!
		-->
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

		<!-- Отключаем автоматическое включение .resx (управляем вручную) -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	</PropertyGroup>

	<!-- ========================================
       КОНФИГУРАЦИОННЫЕ ФАЙЛЫ
       ======================================== -->
	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- ========================================
       AVALONIA UI + DOCK СИСТЕМА
       ======================================== -->
	<ItemGroup>
		<PackageReference Include="AnimatedImage.Avalonia" Version="2.1.4" />
		<PackageReference Include="Avalonia" Version="12.0.1" />
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.1" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
		<PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
		<PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
		<PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
		<PackageReference Include="Dock.Model" Version="12.0.0.2" />
		<PackageReference Include="Dock.Model.Avalonia" Version="12.0.0.2" />
		<PackageReference Include="Dock.Serializer.Newtonsoft" Version="12.0.0.2" />
		<PackageReference Include="Dock.Settings" Version="12.0.0.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-preview.3.26207.106" />
		<PackageReference Include="ProDiagnostics" Version="12.0.0" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
		<PackageReference Include="Serilog" Version="4.3.2-dev-02419" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1-dev-02339" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />
	</ItemGroup>

	<!-- ========================================
       MVVM + DEPENDENCY INJECTION
       ======================================== -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.3.26207.106" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.3.26207.106" />
	</ItemGroup>

	<!-- ========================================
       ЛОКАЛИЗАЦИЯ + JSON
       ======================================== -->
	<ItemGroup>
		<PackageReference Include="System.Resources.Extensions" Version="11.0.0-preview.3.26207.106" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
	</ItemGroup>

	<!-- ========================================
       РЕСУРСЫ (картинки)
       ======================================== -->
	<ItemGroup>
		<AvaloniaResource Include="Resources\**" Exclude="Resources\Localization\**" />
	</ItemGroup>

	<!-- ========================================
       СТИЛИ И ТЕМЫ
       Файлы прописаны явно — исключены из неявного glob через AvaloniaXaml Remove
       ======================================== -->
	<ItemGroup>
		<AvaloniaResource Include="Styles\DockStyles.axaml">
			<SubType>Designer</SubType>
		</AvaloniaResource>
		<AvaloniaResource Include="Styles\Base\Colors.axaml" />
		<AvaloniaResource Include="Styles\Base\Typography.axaml" />
		<AvaloniaResource Include="Styles\Base\Spacing.axaml" />
		<AvaloniaResource Include="Styles\Themes\DarkTheme.axaml" />
		<AvaloniaResource Include="Styles\Themes\LightTheme.axaml" />
		<AvaloniaResource Include="Styles\Themes\SepiaTheme.axaml" />
	</ItemGroup>

	<!-- Убираем явно прописанные стили из неявного glob чтобы не было дублирования -->
	<ItemGroup>
		<AvaloniaXaml Remove="Styles\DockStyles.axaml" />
		<AvaloniaXaml Remove="Styles\Base\Colors.axaml" />
		<AvaloniaXaml Remove="Styles\Base\Typography.axaml" />
		<AvaloniaXaml Remove="Styles\Base\Spacing.axaml" />
		<AvaloniaXaml Remove="Styles\Themes\DarkTheme.axaml" />
		<AvaloniaXaml Remove="Styles\Themes\LightTheme.axaml" />
		<AvaloniaXaml Remove="Styles\Themes\SepiaTheme.axaml" />
	</ItemGroup>

	<!-- ========================================
       ЛОКАЛИЗАЦИЯ (resx файлы)
       ======================================== -->
	<ItemGroup>
		<!-- Основная локализация приложения -->
		<EmbeddedResource Include="Resources\Localization\Strings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources\Localization\Strings.ru.resx">
			<DependentUpon>Strings.resx</DependentUpon>
		</EmbeddedResource>

		<!-- Базовые resx модулей -->
		<EmbeddedResource Include="Src\**\Resources\*Strings.resx" />

		<!-- Культурно-специфичные resx модулей -->
		<EmbeddedResource Include="Src\**\Resources\*Strings.*.resx" />

		<Compile Update="Resources\Localization\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<!-- ========================================
       ИСКЛЮЧЕНИЯ
       ======================================== -->
	<ItemGroup>
		<AvaloniaXaml Remove="Docs\AI_GUIDE V2.0\**" />
		<AvaloniaXaml Remove="Docs\AI_GUIDE V3.0\**" />
		<AvaloniaXaml Remove="Src\Core\Models\Document\**" />
		<AvaloniaXaml Remove="Tests\**" />
		<Compile Remove="Docs\AI_GUIDE V2.0\**" />
		<Compile Remove="Docs\AI_GUIDE V3.0\**" />
		<Compile Remove="Src\Core\Models\Document\**" />
		<Compile Remove="Tests\**" />
		<None Remove="Docs\AI_GUIDE V2.0\**" />
		<None Remove="Docs\AI_GUIDE V3.0\**" />
		<None Remove="Src\Core\Models\Document\**" />
		<None Remove="Tests\**" />
	</ItemGroup>

	<!-- ========================================
       ПРОЧИЕ ФАЙЛЫ
       ======================================== -->
	<ItemGroup>
		<Content Include="Docs\AI_GUIDE V3.0\Configuration_text.txt" />
	</ItemGroup>

	<!-- ========================================
       ПУСТЫЕ ПАПКИ (для структуры проекта)
       ======================================== -->
	<ItemGroup>
		<Folder Include="Docs\Architecture\" />
		<Folder Include="Docs\UserGuide\" />
		<Folder Include="Models\" />
		<Folder Include="Src\Core\Models\Modules\" />
		<Folder Include="Src\Modules\Characters\Resources\Assets\Avatars\" />
		<Folder Include="Src\Modules\Characters\Views\Tabs\" />
		<Folder Include="Src\Modules\TextEditor\Views\Document\" />
		<Folder Include="Src\WorkModes\Branching\" />
		<Folder Include="Src\WorkModes\Dialogues\" />
		<Folder Include="Src\WorkModes\GameEconomy\" />
		<Folder Include="Src\WorkModes\Locations\" />
		<Folder Include="Src\WorkModes\Maps\" />
		<Folder Include="Src\WorkModes\PlotPoints\" />
		<Folder Include="Src\WorkModes\Poetry\" />
	</ItemGroup>

	<!-- MenuBar Sections -->
	<ItemGroup>
		<Compile Update="Src\Modules\Characters\Resources\CharactersStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>CharactersStrings.resx</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.File.axaml.cs">
			<DependentUpon>MenuBarView.File.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.View.axaml.cs">
			<DependentUpon>MenuBarView.View.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.Workspace.axaml.cs">
			<DependentUpon>MenuBarView.Workspace.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.Tools.axaml.cs">
			<DependentUpon>MenuBarView.Tools.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.Help.axaml.cs">
			<DependentUpon>MenuBarView.Help.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\MenuBarView.axaml.cs">
			<DependentUpon>MenuBarView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Settings\SettingButtons.axaml.cs">
			<DependentUpon>SettingButtons.axaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Src\Modules\Characters\Resources\CharactersStrings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>CharactersStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ProjectExtensions>
		<VisualStudio>
			<UserProperties />
		</VisualStudio>
	</ProjectExtensions>

</Project>