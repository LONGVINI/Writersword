<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Writersword.Mobile.Views.SyncCheckView">

	<ScrollViewer>
		<StackPanel Margin="16" Spacing="10">

			<TextBlock Text="Подключение к хранилищу"
			           FontSize="20"
			           FontWeight="SemiBold"/>

			<TextBlock Text="Адрес WebDAV" FontSize="13" Opacity="0.7"/>
			<TextBox x:Name="ServerBox"
			         PlaceholderText="https://app.koofr.net/dav/Koofr"/>

			<TextBlock Text="Логин" FontSize="13" Opacity="0.7"/>
			<TextBox x:Name="LoginBox"/>

			<TextBlock Text="Пароль приложения" FontSize="13" Opacity="0.7"/>
			<TextBox x:Name="PasswordBox" PasswordChar="*"/>

			<TextBlock Text="Папка" FontSize="13" Opacity="0.7"/>
			<TextBox x:Name="FolderBox" Text="writersword"/>

			<TextBlock Text="Мастер-пароль шифрования" FontSize="13" Opacity="0.7"/>
			<TextBox x:Name="MasterBox" PasswordChar="*"/>

			<Button x:Name="ConnectButton"
			        Content="Сохранить и подключиться"
			        HorizontalAlignment="Stretch"
			        HorizontalContentAlignment="Center"
			        Margin="0,8,0,0"/>

			<!-- Проверка круга оставлена отдельной кнопкой: она пишет на сервер
			     проверочный файл, и делать это при каждом подключении незачем. -->
			<Button x:Name="RunButton"
			        Content="Проверить круг"
			        HorizontalAlignment="Stretch"
			        HorizontalContentAlignment="Center"/>

			<Border Background="#11000000"
			        CornerRadius="6"
			        Padding="12"
			        MinHeight="160">
				<SelectableTextBlock x:Name="LogBlock"
				                     FontFamily="monospace"
				                     FontSize="12"
				                     TextWrapping="Wrap"
				                     Text="Заполните поля и нажмите «Сохранить и подключиться»."/>
			</Border>

		</StackPanel>
	</ScrollViewer>
</UserControl>
