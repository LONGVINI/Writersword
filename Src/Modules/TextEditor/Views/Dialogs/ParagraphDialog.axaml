<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Writersword.Modules.TextEditor.Views.Dialogs.ParagraphDialog"
        Title="Абзац"
        Width="460"
        MaxHeight="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Styles>

        <Style Selector="TextBlock.Section">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0 6 0 0"/>
        </Style>

        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="ComboBox.Field">
            <Setter Property="Background"          Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="CornerRadius"        Value="6"/>
            <Setter Property="MinHeight"           Value="30"/>
            <Setter Property="Padding"             Value="10 0"/>
            <Setter Property="FontSize"            Value="12"/>
            <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="NumericUpDown.Field">
            <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="MinHeight"       Value="30"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.IconClose">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.IconClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>

        <Style Selector="Button.Dialog">
            <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="18 8"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.Dialog:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.DialogAccent">
            <Setter Property="Background"      Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="18 8"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

    </Window.Styles>

    <Panel>
        <Grid>

            <Border Background="{DynamicResource BgBaseBrush}"
                    CornerRadius="16"
                    Margin="-2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" OffsetX="0" OffsetY="12" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
            </Border>

            <Border Background="{DynamicResource BgBaseBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22 18">

                <StackPanel Spacing="12">

                    <!-- Шапка -->
                    <Grid ColumnDefinitions="* Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Абзац"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1" x:Name="CloseBtn" Classes="IconClose">
                            <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Width="14" Height="14"/>
                        </Button>
                    </Grid>

                    <!-- Единицы измерения -->
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Единицы"/>
                        <ComboBox x:Name="UnitCombo" Grid.Column="1" Classes="Field" SelectedIndex="0">
                            <ComboBoxItem>Сантиметры</ComboBoxItem>
                            <ComboBoxItem>Пункты</ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <TextBlock Classes="Section" Text="ВЫРАВНИВАНИЕ"/>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Выравнивание"/>
                        <ComboBox x:Name="AlignmentCombo" Grid.Column="1" Classes="Field" SelectedIndex="0">
                            <ComboBoxItem>По левому краю</ComboBoxItem>
                            <ComboBoxItem>По центру</ComboBoxItem>
                            <ComboBoxItem>По правому краю</ComboBoxItem>
                            <ComboBoxItem>По ширине</ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <TextBlock Classes="Section" Text="ОТСТУПЫ"/>
                    <Grid ColumnDefinitions="150,150,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" x:Name="LeftLabel" Text="Слева"/>
                        <NumericUpDown x:Name="LeftIndentBox" Grid.Column="1" Classes="Field"
                                       Minimum="-1000" Maximum="1000" Increment="0.25" FormatString="0.##"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,150,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" x:Name="RightLabel" Text="Справа"/>
                        <NumericUpDown x:Name="RightIndentBox" Grid.Column="1" Classes="Field"
                                       Minimum="-1000" Maximum="1000" Increment="0.25" FormatString="0.##"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Первая строка"/>
                        <ComboBox x:Name="FirstLineModeCombo" Grid.Column="1" Classes="Field" SelectedIndex="0">
                            <ComboBoxItem>(нет)</ComboBoxItem>
                            <ComboBoxItem>Отступ</ComboBoxItem>
                            <ComboBoxItem>Выступ</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="150,150,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" x:Name="FirstLineLabel" Text="на"/>
                        <NumericUpDown x:Name="FirstLineValueBox" Grid.Column="1" Classes="Field"
                                       Minimum="0" Maximum="1000" Increment="0.25" FormatString="0.##"/>
                    </Grid>

                    <TextBlock Classes="Section" Text="ИНТЕРВАЛ"/>
                    <Grid ColumnDefinitions="150,150,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" x:Name="BeforeLabel" Text="Перед"/>
                        <NumericUpDown x:Name="SpaceBeforeBox" Grid.Column="1" Classes="Field"
                                       Minimum="0" Maximum="2000" Increment="0.25" FormatString="0.##"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,150,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" x:Name="AfterLabel" Text="После"/>
                        <NumericUpDown x:Name="SpaceAfterBox" Grid.Column="1" Classes="Field"
                                       Minimum="0" Maximum="2000" Increment="0.25" FormatString="0.##"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Междустрочный"/>
                        <ComboBox x:Name="LineSpacingCombo" Grid.Column="1" Classes="Field" SelectedIndex="0">
                            <ComboBoxItem>Одинарный</ComboBoxItem>
                            <ComboBoxItem>1.5 строки</ComboBoxItem>
                            <ComboBoxItem>Двойной</ComboBoxItem>
                            <ComboBoxItem>Множитель</ComboBoxItem>
                            <ComboBoxItem>Точно (пт)</ComboBoxItem>
                            <ComboBoxItem>Минимум (пт)</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="150,150,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" Text="значение"/>
                        <NumericUpDown x:Name="LineSpacingValueBox" Grid.Column="1" Classes="Field"
                                       Minimum="0" Maximum="1000" Increment="0.1" FormatString="0.##"/>
                    </Grid>

                    <!-- Образец -->
                    <TextBlock Classes="Section" Text="ОБРАЗЕЦ"/>
                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14 12"
                            Height="150"
                            ClipToBounds="True">
                        <StackPanel Spacing="5">
                            <Rectangle Height="6" Width="360" RadiusX="3" RadiusY="3"
                                       HorizontalAlignment="Left" Opacity="0.35"
                                       Fill="{DynamicResource TextMutedBrush}"/>
                            <Rectangle Height="6" Width="300" RadiusX="3" RadiusY="3"
                                       HorizontalAlignment="Left" Opacity="0.35"
                                       Fill="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="PreviewSample"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="Образец текста этого абзаца, который показывает выбранные отступы, выравнивание и интервалы."/>
                            <Rectangle Height="6" Width="330" RadiusX="3" RadiusY="3"
                                       HorizontalAlignment="Left" Opacity="0.35"
                                       Fill="{DynamicResource TextMutedBrush}"/>
                            <Rectangle Height="6" Width="280" RadiusX="3" RadiusY="3"
                                       HorizontalAlignment="Left" Opacity="0.35"
                                       Fill="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10"
                                Margin="0 6 0 0">
                        <Button x:Name="CancelBtn" Classes="Dialog" Content="Отмена" IsCancel="True"/>
                        <Button x:Name="OkBtn" Classes="DialogAccent" Content="ОК" IsDefault="True"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Panel>
</Window>
