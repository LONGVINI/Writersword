<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.ViewModels.Components"
             xmlns:converters="using:Writersword.Converters"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:behaviors="using:Writersword.Behaviors"
             x:Class="Writersword.Views.Components.TabBarView"
             x:DataType="vm:TabBarViewModel"
             x:Name="TabBarViewRoot">

	<UserControl.Resources>
		<converters:TabBackgroundConverter x:Key="TabBackgroundConverter"/>
		<converters:TabForegroundConverter x:Key="TabForegroundConverter"/>
		<converters:TabSeparatorConverter x:Key="TabSeparatorConverter"/>
	</UserControl.Resources>

	<Border Background="#2D2D30"
            BorderBrush="#3F3F46"
            BorderThickness="0,0,0,1"
            Padding="5,0,5,0">

		<ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">

			<StackPanel Orientation="Horizontal" Spacing="2">

				<ItemsControl ItemsSource="{Binding Tabs}"
				              x:Name="TabsItemsControl">

					<i:Interaction.Behaviors>
						<behaviors:TabDragDropBehavior />
					</i:Interaction.Behaviors>

					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" Spacing="0"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Spacing="0">
								<Button Classes="TabButton"
									    Background="{Binding IsActive, Converter={StaticResource TabBackgroundConverter}}"
										CornerRadius="8,8,0,0"
										Padding="12,6,8,6"
										Width="180"
										Height="32"
										BorderThickness="0"
										HorizontalContentAlignment="Stretch"
										VerticalContentAlignment="Center"
										Command="{Binding #TabBarViewRoot.DataContext.ActivateTabCommand}"
										CommandParameter="{Binding}">

									<Button.RenderTransform>
										<TranslateTransform X="0" Y="0" />
									</Button.RenderTransform>

									<Button.Styles>
										<Style Selector="Button:pointerover">
											<Setter Property="Background" Value="#2A2D2E"/>
										</Style>
									</Button.Styles>

									<Grid ColumnDefinitions="*,Auto">
										<TextBlock Grid.Column="0"
												   Text="{Binding Title}"
												   Foreground="{Binding IsActive, Converter={StaticResource TabForegroundConverter}}"
												   FontSize="12"
												   VerticalAlignment="Center"
												   IsHitTestVisible="False"
												   TextTrimming="CharacterEllipsis"
												   Margin="0,0,8,0"/>

										<Button Grid.Column="1"
												Command="{Binding #TabBarViewRoot.DataContext.CloseTabCommand}"
												CommandParameter="{Binding}"
												Background="Transparent"
												BorderThickness="0"
												Width="18"
												Height="18"
												Padding="0"
												CornerRadius="3"
												VerticalAlignment="Center"
												HorizontalAlignment="Center"
												Margin="4,0,0,0">
											<Viewbox Width="10" Height="10">
												<TextBlock Text="✕"
														   Foreground="#858585"
														   FontSize="16"
														   HorizontalAlignment="Center"
														   VerticalAlignment="Center"
														   IsHitTestVisible="False"/>
											</Viewbox>
											<Button.Styles>
												<Style Selector="Button:pointerover /template/ TextBlock">
													<Setter Property="Foreground" Value="White"/>
												</Style>
												<Style Selector="Button:pointerover">
													<Setter Property="Background" Value="#4A4A4A"/>
												</Style>
											</Button.Styles>
										</Button>
									</Grid>

								</Button>

								<!-- Разделитель справа от вкладки -->
								<Border Width="1" 
										Height="20" 
										Background="#3F3F46"
										VerticalAlignment="Center"
										Margin="4,0,4,0">
									<Border.IsVisible>
										<MultiBinding Converter="{StaticResource TabSeparatorConverter}">
											<Binding Path="." />
											<Binding Path="#TabBarViewRoot.DataContext.Tabs" />
											<Binding Path="#TabBarViewRoot.DataContext.ActiveTab" />
										</MultiBinding>
									</Border.IsVisible>
								</Border>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Разделитель перед кнопкой "+" -->
				<Border Width="1" 
						Height="20" 
						Background="#3F3F46"
						VerticalAlignment="Center"
						Margin="0,0,4,0">
					<Border.IsVisible>
						<MultiBinding Converter="{StaticResource TabSeparatorConverter}" ConverterParameter="LastTab">
							<Binding Path="Tabs" />
							<Binding Path="ActiveTab" />
						</MultiBinding>
					</Border.IsVisible>
				</Border>

				<Button Content="+"
						Command="{Binding CreateNewTabCommand}"
						Background="Transparent"
						Foreground="#858585"
						FontSize="16"
						Width="30"
						Height="28"
						Padding="0"
						BorderThickness="0"
						CornerRadius="4"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
						Margin="4,0,0,0">
					<Button.Styles>
						<Style Selector="Button:pointerover">
							<Setter Property="Background" Value="#3A3A3C"/>
							<Setter Property="Foreground" Value="White"/>
						</Style>
					</Button.Styles>
				</Button>

			</StackPanel>

		</ScrollViewer>

	</Border>

</UserControl>