<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.ViewModels.Components"
             xmlns:converters="using:Writersword.Converters"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:behaviors="using:Writersword.Behaviors"
             x:Class="Writersword.Views.Components.WorkModeBarView"
             x:DataType="vm:WorkModeBarViewModel"
             x:Name="WorkModeBarViewRoot">

	<UserControl.Styles>
		<Style Selector="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
		</Style>
		<Style Selector="Button /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="0"/>
		</Style>
		<Style Selector="Button:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
	</UserControl.Styles>

	<Border Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,5">

		<ItemsControl ItemsSource="{Binding WorkModes}">

			<i:Interaction.Behaviors>
				<behaviors:WorkModeDragDropBehavior />
			</i:Interaction.Behaviors>

			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" Spacing="5"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Button Content="{Binding Title}"
                            Command="{Binding #WorkModeBarViewRoot.DataContext.SwitchWorkModeCommand}"
                            CommandParameter="{Binding}"
                            Classes.active="{Binding IsActive}"
                            Padding="10,4"
                            FontSize="12"
                            Foreground="{DynamicResource TextPrimaryBrush}">

						<Button.Effect>
							<DropShadowEffect BlurRadius="0" OffsetX="0" OffsetY="0" Opacity="0" Color="Transparent"/>
						</Button.Effect>

						<Button.RenderTransform>
							<TranslateTransform X="0" Y="0"/>
						</Button.RenderTransform>

						<Button.Template>
							<ControlTemplate>
								<Border x:Name="PART_Border"
                                        Background="{DynamicResource BgHoverBrush}"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
									<ContentPresenter Content="{TemplateBinding Content}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>

						<Button.Styles>
							<Style Selector="Button.active /template/ Border#PART_Border">
								<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
							</Style>
							<Style Selector="Button:pointerover /template/ Border#PART_Border">
								<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
							</Style>
							<Style Selector="Button.active:pointerover /template/ Border#PART_Border">
								<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
							</Style>
							<Style Selector="Button:pressed /template/ Border#PART_Border">
								<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
							</Style>
							<Style Selector="Button.active:pressed /template/ Border#PART_Border">
								<Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
							</Style>
							<Style Selector="Button.dragging /template/ Border#PART_Border">
								<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
							</Style>
							<Style Selector="Button.active.dragging /template/ Border#PART_Border">
								<Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
							</Style>
						</Button.Styles>

					</Button>
				</DataTemplate>
			</ItemsControl.ItemTemplate>

		</ItemsControl>

	</Border>

</UserControl>