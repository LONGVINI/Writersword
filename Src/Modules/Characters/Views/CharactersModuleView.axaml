<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Characters.ViewModels"
             xmlns:views="using:Writersword.Modules.Characters.Views"
             xmlns:avatars="using:Writersword.Modules.Characters.Views.Avatars"
             xmlns:onb="using:Writersword.Modules.Characters.Views.Onboarding"
             xmlns:loc="using:Writersword.Src.Modules.Characters.Resources"
             xmlns:ui="using:Writersword.Styles.UserControls"
             x:Class="Writersword.Modules.Characters.Views.CharactersModuleView"
             x:DataType="vm:CharactersViewModel"
             ui:ModalHost.IsHost="True"
             Background="{DynamicResource BgSurfaceBrush}">
	<Grid>

		<!-- Онбординг — поверх всего -->
		<Border ZIndex="100"
                Background="#CC000000"
                IsVisible="{Binding ShowOnboarding}">
			<onb:CharactersOnboardingView DataContext="{Binding OnboardingViewModel}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          MaxWidth="520"/>
		</Border>

		<!-- Оверлей редактора цвета — внутри модуля, поверх всего -->
		<ui:ColorEditorOverlay x:Name="ColorEditorOverlay" ZIndex="200"/>

		<!-- Окно настроек карточки (кольцо, закладка, толщина рамки) — по центру
		     модуля, со скримом, как редактор цвета -->
		<views:CardSettingsOverlay x:Name="CardSettingsOverlayControl" ZIndex="150"/>

		<!-- Редактор метки персонажа (значок, цвет, эффект, показ) — по центру
		     модуля, со скримом, как окно настроек карточки -->
		<views:LabelEditorOverlay x:Name="LabelEditorOverlayControl" ZIndex="155"/>

		<!-- Конструктор набора полей — по центру модуля, со скримом, как
		     редактор метки. Здесь задаётся определение полей: имя, тип,
		     подсказка, подписи делений шкалы. -->
		<views:AnketaEditorOverlay x:Name="AnketaEditorOverlayControl" ZIndex="160"/>

		<!-- Сравнение карточек: персонажи рядом, поля строками. Ради него
		     поля и заводились — оно ловит то, чего автор сам не видит. -->
		<views:CharacterComparisonOverlay x:Name="ComparisonOverlayControl" ZIndex="165"/>

		<!-- Выбор аватара — по центру модуля, со скримом, как редактор цвета -->
		<avatars:CharacterAvatarPickerOverlay x:Name="AvatarPickerOverlayControl" ZIndex="170"/>

		<Grid RowDefinitions="Auto,*">

			<!-- Вкладки -->
			<Border Grid.Row="0"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="4,0">
				<Border.Styles>
					<!-- Дефолты вкладок заданы стилем, а не атрибутами: локальные
					     значения приоритетнее сеттеров класса, из-за чего подсветка
					     активной вкладки (tab-active) раньше перебивалась и не была
					     видна. Толщина рамки постоянная (низ 2px), у неактивных
					     рамка прозрачная — высота кнопок не дёргается. -->
					<Style Selector="Button.tab">
						<Setter Property="FontSize" Value="12"/>
						<Setter Property="Padding" Value="12,8"/>
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="BorderThickness" Value="0,0,0,2"/>
						<Setter Property="BorderBrush" Value="Transparent"/>
						<Setter Property="CornerRadius" Value="0"/>
						<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
						<!-- Дефолтный Fluent-ControlTheme вешает на Background/BorderBrush
						     неявные BrushTransition. При наведении они анимируются покадрово,
						     а анимация кисти в композиторе инвалидирует широкую область —
						     перерисовывалось всё окно, а не кнопка. Пустой набор переходов
						     отключает их: смена цвета мгновенная, инвалидация ограничена
						     самой кнопкой. -->
						<Setter Property="Transitions">
							<Transitions/>
						</Setter>
					</Style>
					<Style Selector="Button.tab:pointerover">
						<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
					</Style>
					<!-- Гасим серый hover-фон темы у ContentPresenter: под курсором
					     меняется только цвет текста, лишней заливки и её инвалидации нет. -->
					<Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Background" Value="Transparent"/>
					</Style>
					<Style Selector="Button.tab.tab-active">
						<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
						<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
						<Setter Property="FontWeight" Value="SemiBold"/>
					</Style>
					<Style Selector="Button.tab.tab-active:pointerover">
						<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
						<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
					</Style>
					<!-- Шаблон Fluent при наведении красит текст через свой
					     ContentPresenter — перекрываем его для активной вкладки,
					     чтобы акцентный цвет не сбрасывался под курсором. -->
					<Style Selector="Button.tab.tab-active /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
					</Style>
					<Style Selector="Button.tab.tab-active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
					</Style>
				</Border.Styles>
				<StackPanel Orientation="Horizontal">
					<Button Content="{x:Static loc:CharactersStrings.Tab_Characters}"
                            Command="{ReflectionBinding GoToCharactersCommand}"
                            Classes="tab"
                            Classes.tab-active="{Binding IsTab0Active}"/>
					<Button Content="{x:Static loc:CharactersStrings.Tab_Edit}"
                            Command="{ReflectionBinding GoToEditCommand}"
                            Classes="tab"
                            Classes.tab-active="{Binding IsTab1Active}"/>
					<Button Content="{x:Static loc:CharactersStrings.Tab_Relationships}"
                            Command="{ReflectionBinding GoToRelationshipsCommand}"
                            Classes="tab"
                            Classes.tab-active="{Binding IsTab2Active}"/>
					<Button Content="{x:Static loc:CharactersStrings.Tab_Templates}"
                            Command="{ReflectionBinding GoToTemplatesCommand}"
                            Classes="tab"
                            Classes.tab-active="{Binding IsTab3Active}"/>
				</StackPanel>
			</Border>

			<!-- Содержимое вкладок: живут одновременно, переключается видимость
			     (см. SwitchTab) — тяжёлые «Персонажи» не рвутся при переходе. -->
			<Panel Grid.Row="1" x:Name="TabContent"/>
		</Grid>

		<!-- Тост снизу — появляется при удалении, скрывается по Ctrl+Z или по кнопке -->
		<Border x:Name="UndoToast"
                ZIndex="50"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Padding="16,10,12,10"
                CornerRadius="8"
                Background="#E0161616"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                IsVisible="{Binding UndoToastMessage,
                    Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
			<Border.Effect>
				<DropShadowEffect BlurRadius="16" OffsetX="0" OffsetY="4" Opacity="0.35"/>
			</Border.Effect>
			<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
				<TextBlock Text="{Binding UndoToastMessage}"
                           FontSize="13"
                           Foreground="White"
                           VerticalAlignment="Center"/>
				<Border Background="#33FFFFFF"
                        CornerRadius="4" Padding="6,3"
                        VerticalAlignment="Center">
					<TextBlock Text="Ctrl+Z"
                               FontSize="11"
                               Foreground="White"
                               FontFamily="Consolas, monospace"/>
				</Border>
				<Button x:Name="ToastDismissButton"
                        Content="✕"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,0"
                        Foreground="#88FFFFFF"
                        FontSize="13"
                        VerticalAlignment="Center"/>
			</StackPanel>
		</Border>

	</Grid>
</UserControl>