<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="using:Writersword.Infrastructure.Controls"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:dockSettings="clr-namespace:Dock.Settings;assembly=Dock.Settings">

	<!-- Document body is not a drag handle.
	     Dock marks PART_TabBody with IsDragArea, so a press inside a document may
	     start dragging the whole document. A press inside a popup - the font list
	     of the ribbon - has no visual root, GetPosition returns the origin, and
	     Dock hit-tests the top-left corner of DockControl, finds PART_TabBody
	     there and begins a drag: global dock targets flash over the layout on
	     every pick from the list, and stay on screen while the button is held.
	     Documents are still dragged by their tab - the tab strip item lies
	     outside PART_TabBody and keeps IsDragArea. -->
	<Style Selector="Border#PART_TabBody">
		<Setter Property="dockSettings:DockProperties.IsDragEnabled" Value="False"/>
	</Style>

	<!-- Стиль для DockControl -->
	<Style Selector="dock|DockControl">
		<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
	</Style>

	<!-- Стиль для заголовков вкладок Dock -->
	<Style Selector="TabItem">
		<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Padding" Value="10,4"/>
		<Setter Property="FontSize" Value="12"/>
	</Style>
	<Style Selector="TabItem:selected">
		<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
	</Style>
	<Style Selector="TabItem:pointerover">
		<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
	</Style>

	<!-- Стиль для сплиттеров -->
	<Style Selector="GridSplitter">
		<Setter Property="Background" Value="{DynamicResource BorderDefaultBrush}"/>
	</Style>

	<!-- ========================================
         МЕНЮ — фон попапа и пунктов
         ======================================== -->
	<Style Selector="Menu">
		<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
	</Style>

	<Style Selector="MenuItem">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<!-- Верхнеуровневые MenuItem в MenuBar наследуют фон Menu -->
	<Style Selector="Menu > MenuItem /template/ Border#PART_LayoutRoot">
		<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
	</Style>

	<!-- MenuItem внутри попапа — фон поверхности чтобы не просвечивал чёрный PopupRoot -->
	<Style Selector="MenuItem MenuItem /template/ Border#PART_LayoutRoot">
		<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
	</Style>

	<Style Selector="MenuItem:pointerover">
		<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<Style Selector="MenuItem:pointerover /template/ ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<!-- Фон попапа меню (выпадающий список пунктов) -->
	<Style Selector="MenuItem /template/ Popup Border">
		<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="4"/>
	</Style>

	<!-- Foreground для вложенного контента MenuItem через шаблон -->
	<Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
	</Style>

	<!-- Разделители в меню -->
	<Style Selector="Separator">
		<Setter Property="Background" Value="{DynamicResource BorderDefaultBrush}"/>
		<Setter Property="Height" Value="1"/>
		<Setter Property="Margin" Value="4,2"/>
	</Style>

	<!-- Avalonia 12 применяет :disabled к корневым MenuItem без Command.
	     Переопределяем визуальное состояние чтобы они выглядели как активные. -->
	<Style Selector="Menu > MenuItem:disabled">
		<Setter Property="Opacity" Value="1"/>
	</Style>
	<Style Selector="Menu > MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Opacity" Value="1"/>
	</Style>
	<Style Selector="Menu > MenuItem:disabled /template/ Border#PART_LayoutRoot">
		<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
		<Setter Property="Opacity" Value="1"/>
	</Style>

	<!-- ========================================
         COMBOBOX — фон попапа и элементов
         ======================================== -->
	<Style Selector="ComboBox">
		<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
	</Style>

	<!-- Фон попапа ComboBox -->
	<Style Selector="ComboBox /template/ Popup Border">
		<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="4"/>
	</Style>

	<!-- Явный фон для внутреннего Border попапа ComboBox -->
	<Style Selector="ComboBox /template/ Border#PopupBorder">
		<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="4"/>
	</Style>

	<!-- Элементы в списке ComboBox.
	     Этот файл подключается после Styles/Controls.axaml и перекрывает его,
	     поэтому отступ и скругление подсветки задаются и здесь: без них плашка
	     выделения упиралась в края выпадающего списка, а угол выглядел
	     обрубленным. Держать оформление одного контрола в двух файлах — плохо,
	     но убирать отсюда стиль целиком рискованно: он писался под контролы
	     Dock. -->
	<Style Selector="ComboBoxItem">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="Padding" Value="8,6"/>
		<Setter Property="Margin" Value="4,1"/>
		<Setter Property="CornerRadius" Value="4"/>
	</Style>
	<!-- Подсветку рисует сам пункт, а не его ContentPresenter: презентер
	     заполняет элемент целиком, поэтому отступ и скругление на нём
	     не сказываются — плашка выбранного упиралась в края списка
	     и выглядела обрубленной. Презентер при этом делается прозрачным,
	     иначе он закрасил бы скруглённые углы. -->
	<Style Selector="ComboBoxItem /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="CornerRadius" Value="4"/>
	</Style>
	<Style Selector="ComboBoxItem:pointerover">
		<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
	</Style>
	<Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="ComboBoxItem:selected">
		<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
	</Style>
	<Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="ComboBoxItem:selected:pointerover">
		<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
	</Style>
	<Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<!-- ========================================
         ВКЛАДКА МОДУЛЯ — значок предупреждения
         ======================================== -->
	<!-- Занимается слот иконки, а не заголовка. Заголовок рисует штатный шаблон
	     Dock, и подменять его нельзя: ошибка в подменённом шаблоне оставляет
	     модуль вообще без названия. Слот иконки в дереве вкладки есть всегда —
	     по умолчанию Dock кладёт туда пустой Panel, — и мы просто заменяем
	     пустой на видимый.

	     Сам шаблон собран кодом, в ModuleWarning.TabIconTemplate. DataTemplate,
	     объявленный здесь же внутри Setter, отдаёт всем презентерам один и тот
	     же экземпляр контрола, и второй презентер роняет приложение на попытке
	     прицепить чужой контрол к своему дереву. FuncDataTemplate с выключенной
	     переработкой строит новое дерево на каждый вызов. -->
	<Style Selector="dock|DocumentControl">
		<Setter Property="IconTemplate" Value="{x:Static infra:ModuleWarning.TabIconTemplate}"/>
	</Style>

	<!-- ========================================
         DOCK — сброс кнопок внутри Dock контролов
         чтобы Button.axaml не перебивал шаблоны Dock
         ======================================== -->
	<!-- Сброс касается всех кнопок внутри дока, включая содержимое модулей:
	     на него полагаются круглые кнопки цвета и настроек в карточках,
	     значки на плитках и прочие плоские органы. Кнопке, которой нужен
	     обычный вид, оформление задаётся на месте — сужать этот селектор
	     нельзя, проверено. -->
	<Style Selector="dock|DockControl Button">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="MinHeight" Value="0"/>
		<Setter Property="Padding" Value="0"/>
	</Style>
	<Style Selector="dock|DockControl Button /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="CornerRadius" Value="0"/>
	</Style>

</Styles>