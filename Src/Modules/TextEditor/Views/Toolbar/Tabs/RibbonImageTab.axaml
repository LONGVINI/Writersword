<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.Toolbar"
             xmlns:converters="using:Writersword.Modules.TextEditor.Converters"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             xmlns:controls="using:Writersword.Styles.UserControls"
             x:Class="Writersword.Modules.TextEditor.Views.Toolbar.Tabs.RibbonImageTab"
             x:DataType="vm:RibbonImageTabViewModel">

	<UserControl.Styles>
		<Style Selector="Button.RibbonBtn">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="4"/>
			<Setter Property="MinWidth"                   Value="26"/>
			<Setter Property="MinHeight"                  Value="26"/>
			<Setter Property="VerticalAlignment"          Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="Button.RibbonBtn /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="Button.RibbonBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.RibbonBtn:pressed /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<Style Selector="ToggleButton.RibbonToggleLarge">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="4 2"/>
			<Setter Property="MinWidth"                   Value="44"/>
			<!-- 56 — общая для всех вкладок высота тела группы: столько занимают
			     два ряда кнопок по 26 в группах «Шрифт» и «Абзац» на «Главной». -->
			<Setter Property="MinHeight"                  Value="56"/>
			<Setter Property="VerticalAlignment"          Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggleLarge /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggleLarge:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggleLarge:pressed /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggleLarge:checked /template/ ContentPresenter">
			<Setter Property="Background"             Value="{DynamicResource AccentSubtleBrush}"/>
			<Setter Property="BorderBrush"            Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="TextElement.Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggleLarge:checked:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggleLarge:checked PathIcon">
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Сегмент выбора единиц (мм / px) -->
		<Style Selector="ToggleButton.SegSmall">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="5 0"/>
			<Setter Property="MinWidth"                   Value="28"/>
			<Setter Property="MinHeight"                  Value="20"/>
			<Setter Property="FontSize"                   Value="10"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="ToggleButton.SegSmall /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="ToggleButton.SegSmall:checked /template/ ContentPresenter">
			<Setter Property="Background"             Value="{DynamicResource AccentSubtleBrush}"/>
			<Setter Property="BorderBrush"            Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="TextElement.Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Квадратный переключатель-радиокнопка (положение рамки картинки) -->
		<Style Selector="ToggleButton.SegSquare">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="0"/>
			<Setter Property="Width"                      Value="24"/>
			<Setter Property="Height"                     Value="24"/>
			<Setter Property="MinWidth"                   Value="24"/>
			<Setter Property="MinHeight"                  Value="24"/>
			<Setter Property="VerticalAlignment"          Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare:checked /template/ ContentPresenter">
			<Setter Property="Background"             Value="{DynamicResource AccentSubtleBrush}"/>
			<Setter Property="BorderBrush"            Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="TextElement.Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare:checked:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare:checked PathIcon">
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Кнопка выбора единиц живёт в общем стиле Button.UnitToggle
		     (Styles/Controls/UnitToggle.axaml) — она одинакова и здесь, и в ленте
		     таблиц. Локальное объявление другим вкладкам не доставалось. -->

		<!-- Обвязка группы повторяет вкладку «Главная» до пикселя: рамка, отступы
		     и подпись задают всю высоту ленты помимо содержимого, и стоит им
		     разойтись — вкладки прыгают по высоте при переключении. -->
		<Style Selector="Border.RibbonGroup">
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="4"/>
			<Setter Property="Margin"          Value="2 3"/>
			<Setter Property="Padding"         Value="6 4 6 0"/>
		</Style>
		<!-- Инструмент, неприменимый к выделенному объекту, остаётся на своём
		     месте и гаснет. Прежде такие группы и кнопки скрывались, и одна и та
		     же вкладка «Формат» выглядела двумя разными: у фигуры был свой набор
		     групп, у картинки свой, а соседние группы каждый раз переезжали. -->
		<Style Selector="Border.RibbonGroup:disabled">
			<Setter Property="Opacity" Value="0.45"/>
		</Style>
		<Style Selector="ToggleButton.SegSquare:disabled">
			<Setter Property="Opacity" Value="0.45"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggleLarge:disabled">
			<Setter Property="Opacity" Value="0.45"/>
		</Style>

		<Style Selector="TextBlock.RibbonGroupLabel">
			<Setter Property="FontSize"            Value="10"/>
			<Setter Property="Foreground"          Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="TextAlignment"       Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment"   Value="Center"/>
		</Style>
		<Style Selector="Grid.RibbonGroupLabelGrid">
			<Setter Property="Margin" Value="0 3 0 2"/>
		</Style>

		<!-- PathIcon наследует цвет через Foreground -->
		<Style Selector="PathIcon">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<!-- Числовое поле ленты — общий класс NumericUpDown.Ribbon из
		     Styles/Controls/NumericUpDown.axaml: геометрия, рамка, стрелки и
		     состояния описаны там же и одинаковы для всех вкладок ленты.
		     Ширина остаётся местной: у полей поворота, размера и отступов
		     она разная. -->

		<!-- Ползунок в стиле палитровых градиентных ползунков -->
		<Style Selector="Slider.knob">
			<Setter Property="MinHeight" Value="18"/>
			<Setter Property="Height" Value="18"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Grid VerticalAlignment="Center">
						<Border Height="5" CornerRadius="3" VerticalAlignment="Center"
						        Background="{DynamicResource BgHoverBrush}"
						        BorderBrush="{DynamicResource BorderSubtleBrush}"
						        BorderThickness="1"/>
						<Track Name="PART_Track" Orientation="Horizontal"
						       Minimum="{TemplateBinding Minimum}"
						       Maximum="{TemplateBinding Maximum}"
						       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
							<Track.DecreaseButton>
								<RepeatButton Name="PART_DecreaseButton" Focusable="False"
								              Background="Transparent" BorderThickness="0">
									<RepeatButton.Template>
										<ControlTemplate><Border Background="Transparent"/></ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.DecreaseButton>
							<Track.IncreaseButton>
								<RepeatButton Name="PART_IncreaseButton" Focusable="False"
								              Background="Transparent" BorderThickness="0">
									<RepeatButton.Template>
										<ControlTemplate><Border Background="Transparent"/></ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.IncreaseButton>
							<Thumb Width="12" Height="12" Padding="0">
								<Thumb.Template>
									<ControlTemplate>
										<Border Background="{DynamicResource AccentDefaultBrush}"
										        CornerRadius="6"
										        BorderBrush="{DynamicResource BgSurfaceBrush}"
										        BorderThickness="2"/>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Track>
					</Grid>
				</ControlTemplate>
			</Setter>
		</Style>
	</UserControl.Styles>

	<controls:RibbonScrollContainer x:Name="ScrollContainer">
		<controls:RibbonScrollContainer.RibbonContent>
			<StackPanel Orientation="Horizontal">

				<!-- ── Группа: Форма ────────────────────────────────────────── -->
				<!-- Одна группа на оба объекта: у фигуры это её вид, у картинки —
				     контур, по которому картинка обрезается и идёт рамка. Линия и
				     стрелка картинке не применяются: у них нет площади, и обрезать
				     по ним нечего, — но кнопки остаются на месте серыми. Набор и
				     порядок инструментов вкладки одинаковы для фигуры и картинки,
				     иначе одна и та же вкладка читается как две разных. -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Форма"/>
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

							<ToggleButton Classes="SegSquare"
							              Command="{Binding ShapeRectangleCommand}"
							              IsChecked="{Binding CurrentShapeType, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Rectangle, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Прямоугольник"
							              behaviours:TooltipBehavior.ShowDelay="700">
								<PathIcon Width="14" Height="14" Data="M3 5h18v14H3V5zm2 2v10h14V7H5z"/>
							</ToggleButton>

							<ToggleButton Classes="SegSquare"
							              Command="{Binding ShapeEllipseCommand}"
							              IsChecked="{Binding CurrentShapeType, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Ellipse, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Эллипс"
							              behaviours:TooltipBehavior.ShowDelay="700">
								<PathIcon Width="14" Height="14" Data="M12 5c5 0 9 3.1 9 7s-4 7-9 7-9-3.1-9-7 4-7 9-7zm0 2c-3.9 0-7 2.2-7 5s3.1 5 7 5 7-2.2 7-5-3.1-5-7-5z"/>
							</ToggleButton>

							<ToggleButton Classes="SegSquare"
							              Command="{Binding ShapeCalloutCommand}"
							              IsChecked="{Binding CurrentShapeType, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Callout, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Выноска"
							              behaviours:TooltipBehavior.ShowDelay="700">
								<PathIcon Width="14" Height="14" Data="M3 4h18v11H9l-4 5v-5H3V4zm2 2v7h2v3l2.4-3H19V6H5z"/>
							</ToggleButton>

							<ToggleButton Classes="SegSquare"
							              IsEnabled="{Binding IsShapeSelected}"
							              Command="{Binding ShapeLineCommand}"
							              IsChecked="{Binding CurrentShapeType, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Line, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Линия"
							              behaviours:TooltipBehavior.ShowDelay="700">
								<PathIcon Width="14" Height="14" Data="M3 18.6L18.6 3 21 5.4 5.4 21 3 18.6z"/>
							</ToggleButton>

							<ToggleButton Classes="SegSquare"
							              IsEnabled="{Binding IsShapeSelected}"
							              Command="{Binding ShapeArrowCommand}"
							              IsChecked="{Binding CurrentShapeType, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Arrow, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Стрелка"
							              behaviours:TooltipBehavior.ShowDelay="700">
								<PathIcon Width="14" Height="14" Data="M3 11h10v2H3v-2zm10-5l8 6-8 6V6z"/>
							</ToggleButton>

						</StackPanel>
					</DockPanel>
				</Border>

				<!-- ── Группа: Содержимое ──────────────────────────────────── -->
				<!-- Не «Заливка»: заливка — это только цвет, а группа держит ещё и
				     картинку, и её обрезку. Общее у них то, ЧЕМ объект заполнен, —
				     а заполнен он и у фигуры, и у картинки.
				     Поэтому группа работает на обоих, и гасятся в ней отдельные
				     кнопки, а не она целиком: у картинки нет заливки цветом и
				     нечего «убирать» — картинка и есть объект, — зато замена файла
				     и обрезка её собственные. Без этого «Формат» у картинки
				     оставался с одной мёртвой группой и ни одним своим
				     инструментом. -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Содержимое"/>
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

						<StackPanel Spacing="3" VerticalAlignment="Center">

							<StackPanel Orientation="Horizontal" Spacing="4">
								<controls:ColorPickerButton Width="20" Height="20" VerticalAlignment="Center"
								                            IsEnabled="{Binding IsClosedShape}"
								                            HexColor="{Binding FillHexColor, Mode=TwoWay}"
								                            behaviours:TooltipBehavior.Tip="Цвет заливки фигуры. «Нет цвета» убирает заливку"
								                            behaviours:TooltipBehavior.ShowDelay="700"/>
								<TextBlock FontSize="10" VerticalAlignment="Center"
								           IsEnabled="{Binding IsClosedShape}"
								           Foreground="{DynamicResource TextSecondaryBrush}"
								           Text="Цвет"/>

								<Rectangle Width="1" Height="18" Margin="2 0"
								           VerticalAlignment="Center"
								           Fill="{DynamicResource BorderSubtleBrush}"/>

								<Button Classes="RibbonBtn" MinWidth="70" MinHeight="24"
								        Command="{Binding PickFillImageCommand}"
								        behaviours:TooltipBehavior.Tip="У фигуры — положить картинку внутрь: она обрежется по её контуру. У картинки — заменить файл, сохранив размер, поворот, обрезку и оформление"
								        behaviours:TooltipBehavior.ShowDelay="700">
									<StackPanel Orientation="Horizontal" Spacing="4">
										<PathIcon Width="13" Height="13" Data="M4 5h16v14H4V5zm2 2v8l3.5-3.5L13 15l3-3 2 2V7H6z"/>
										<TextBlock FontSize="10" VerticalAlignment="Center" Text="Картинка"/>
									</StackPanel>
								</Button>

								<Button Classes="RibbonBtn" MinWidth="26" MinHeight="24"
								        IsEnabled="{Binding CanClearFillImage}"
								        Command="{Binding ClearFillImageCommand}"
								        behaviours:TooltipBehavior.Tip="Убрать картинку из фигуры"
								        behaviours:TooltipBehavior.ShowDelay="700">
									<PathIcon Width="13" Height="13" Data="M6.2 4.8L4.8 6.2 9.6 11l-4.8 4.8 1.4 1.4L11 12.4l4.8 4.8 1.4-1.4-4.8-4.8 4.8-4.8-1.4-1.4L11 9.6 6.2 4.8z"/>
								</Button>
							
							</StackPanel>

							<CheckBox FontSize="10" VerticalAlignment="Center"
							          IsEnabled="{Binding CanClearFillImage}"
							          IsChecked="{Binding FillImageStretch, Mode=TwoWay}"
							          behaviours:TooltipBehavior.Tip="Растянуть картинку на весь габарит. Выключено — картинка вписывается целиком, сохраняя пропорции"
							          behaviours:TooltipBehavior.ShowDelay="700"
							          Content="Растянуть"/>

						</StackPanel>

						<Rectangle Width="1" Height="30" VerticalAlignment="Center"
						           Fill="{DynamicResource BorderSubtleBrush}"/>

						<!-- Обрезка стоит здесь, а не в «Размере»: она про то, ЧТО
						     показано в объекте, а не про его место на листе. В группе
						     размера она уезжала на вкладку «Расположение», и у картинки
						     во всём «Формате» не оставалось ни одного своего
						     инструмента. У фигуры пока серая: кадрирование заливки —
						     это ещё и жест с маркерами на канвасе. -->
						<ToggleButton Classes="RibbonToggleLarge"
						              IsEnabled="{Binding IsImageSelected}"
						              Command="{Binding ToggleCropModeCommand}"
						              IsChecked="{Binding IsCropMode, Mode=OneWay}"
						              behaviours:TooltipBehavior.Tip="Режим обрезки: маркеры двигают рамку кадрирования, размер картинки заблокирован. Срез применяется при выходе из режима — повторный клик или Enter, Esc отменяет"
						              behaviours:TooltipBehavior.ShowDelay="700">
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="18" Height="18"
								          Data="M17 15h2V7c0-1.1-.9-2-2-2H9v2h8v8zM7 17V1H5v4H1v2h4v10c0 1.1.9 2 2 2h10v4h2v-4h4v-2H7z"/>
								<TextBlock FontSize="9" Text="Обрезка" HorizontalAlignment="Center"/>
							</StackPanel>
						</ToggleButton>

						</StackPanel>
					</DockPanel>
				</Border>

				<!-- ── Группа: Наконечники (только у линии и стрелки) ───────── -->
				<!-- Наконечник требует открытого контура. У картинки его нет и не
				     будет: линия и стрелка ей не назначаются. Группа, которая не
				     может стать активной никогда, не гасится, а убирается — иначе
				     она занимает место в ленте и не даёт ничего взамен. Место
				     группы при этом своё, третье: появляется она там же, где
				     стоит у фигуры, а не в хвосте ленты. -->
				<Border Classes="RibbonGroup" IsVisible="{Binding IsLineLike}">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Наконечники"/>
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

							<ToggleButton Classes="SegSquare"
							              Command="{Binding ArrowNoneCommand}"
							              IsChecked="{Binding HasNoArrows, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Без наконечников — простая линия"
							              behaviours:TooltipBehavior.ShowDelay="700">
								<PathIcon Width="14" Height="14" Data="M3 11h18v2H3v-2z"/>
							</ToggleButton>

							<ToggleButton Classes="SegSquare"
							              Command="{Binding ArrowStartCommand}"
							              IsChecked="{Binding HasStartArrow, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Стрелка в начале"
							              behaviours:TooltipBehavior.ShowDelay="700">
								<PathIcon Width="14" Height="14" Data="M21 11H11v2h10v-2zM10 6v12l-8-6 8-6z"/>
							</ToggleButton>

							<ToggleButton Classes="SegSquare"
							              Command="{Binding ArrowEndCommand}"
							              IsChecked="{Binding HasEndArrow, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Стрелка в конце"
							              behaviours:TooltipBehavior.ShowDelay="700">
								<PathIcon Width="14" Height="14" Data="M3 11h10v2H3v-2zm10-5l8 6-8 6V6z"/>
							</ToggleButton>

							<ToggleButton Classes="SegSquare"
							              Command="{Binding ArrowBothCommand}"
							              IsChecked="{Binding HasBothArrows, Mode=OneWay}"
							              behaviours:TooltipBehavior.Tip="Стрелки с обеих сторон"
							              behaviours:TooltipBehavior.ShowDelay="700">
								<PathIcon Width="14" Height="14" Data="M9 6v12l-7-6 7-6zm6 0l7 6-7 6V6zM8 11h8v2H8v-2z"/>
							</ToggleButton>

							<Rectangle Width="1" Height="18" Margin="2 0"
							           VerticalAlignment="Center"
							           Fill="{DynamicResource BorderSubtleBrush}"/>

							<Button Classes="RibbonBtn" MinWidth="26" MinHeight="24"
							        IsEnabled="{Binding CanFlipArrows}"
							        Command="{Binding FlipArrowsCommand}"
							        behaviours:TooltipBehavior.Tip="Развернуть: наконечники меняются концами. Набирать стрелку заново, чтобы её перевернуть, значит помнить, какой конец сейчас какой"
							        behaviours:TooltipBehavior.ShowDelay="700">
								<PathIcon Width="14" Height="14" Data="M7 7h11l-3-3 1.4-1.4L21.8 8l-5.4 5.4L15 12l3-3H7V7zm10 10H6l3 3-1.4 1.4L2.2 16l5.4-5.4L9 12l-3 3h11v2z"/>
							</Button>

						</StackPanel>
					</DockPanel>
				</Border>

				<!-- ── Группа: Отражение (работает и у фигуры) ─────────────── -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Отражение"/>
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="2">

							<Button Classes="RibbonBtn" MinHeight="56" MinWidth="40"
							        Command="{Binding FlipHorizontalCommand}"
							        behaviours:TooltipBehavior.Tip="Отразить картинку по горизонтали"
							        behaviours:TooltipBehavior.ShowDelay="700">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Width="18" Height="18"
									          Data="M15 21h2v-2h-2v2zm4-12h2V7h-2v2zM3 5v14c0 1.1.9 2 2 2h4v-2H5V5h4V3H5c-1.1 0-2 .9-2 2zm16-2v2h2c0-1.1-.9-2-2-2zM11 23h2V1h-2v22zm8-6h2v-2h-2v2zM15 5h2V3h-2v2zm4 8h2v-2h-2v2zm0 8c1.1 0 2-.9 2-2h-2v2z"/>
									<TextBlock FontSize="9" Text="По гориз." HorizontalAlignment="Center"/>
								</StackPanel>
							</Button>

							<Button Classes="RibbonBtn" MinHeight="56" MinWidth="40"
							        Command="{Binding FlipVerticalCommand}"
							        behaviours:TooltipBehavior.Tip="Отразить картинку по вертикали"
							        behaviours:TooltipBehavior.ShowDelay="700">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<!-- Та же фигура, что у «По гориз.», развёрнутая на 90 градусов.      -->
									<!-- Прежний путь рисовал только уголки и штрихи по периметру, без      -->
									<!-- сплошной половины, и читался как пунктирная рамка, а не отражение. -->
									<PathIcon Width="18" Height="18"
									          RenderTransformOrigin="50%,50%"
									          Data="M15 21h2v-2h-2v2zm4-12h2V7h-2v2zM3 5v14c0 1.1.9 2 2 2h4v-2H5V5h4V3H5c-1.1 0-2 .9-2 2zm16-2v2h2c0-1.1-.9-2-2-2zM11 23h2V1h-2v22zm8-6h2v-2h-2v2zM15 5h2V3h-2v2zm4 8h2v-2h-2v2zm0 8c1.1 0 2-.9 2-2h-2v2z">
										<PathIcon.RenderTransform>
											<RotateTransform Angle="90"/>
										</PathIcon.RenderTransform>
									</PathIcon>
									<TextBlock FontSize="9" Text="По верт." HorizontalAlignment="Center"/>
								</StackPanel>
							</Button>

						</StackPanel>
					</DockPanel>
				</Border>

				<!-- ── Группа: Оформление ───────────────────────────────────── -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Оформление"/>
						</Grid>
						<StackPanel Spacing="3" VerticalAlignment="Center">

							<StackPanel Orientation="Horizontal" Spacing="4">
								<controls:ColorPickerButton Width="20" Height="20" VerticalAlignment="Center"
								                            HexColor="{Binding BorderHexColor, Mode=TwoWay}"
								                            behaviours:TooltipBehavior.Tip="Цвет рамки картинки. «Нет цвета» убирает рамку"
								                            behaviours:TooltipBehavior.ShowDelay="700"/>
								<TextBlock FontSize="10" VerticalAlignment="Center"
								           Foreground="{DynamicResource TextSecondaryBrush}"
								           Text="Рамка"/>
								<NumericUpDown Classes="Ribbon" Width="72"
								               Value="{Binding BorderThickness, Mode=TwoWay}"
								               Minimum="0" Maximum="50"
								               Increment="{Binding LineUnitIncrement}"
								               FormatString="{Binding LineUnitFormat}"
								               ClipValueToMinMax="True"
								               behaviours:TooltipBehavior.Tip="Толщина рамки, 0 — без рамки"
								               behaviours:TooltipBehavior.ShowDelay="700"/>

								<Button Classes="UnitToggle" Content="{Binding LineUnitLabel}"
								        VerticalAlignment="Center"
								        Command="{Binding ToggleLineUnitCommand}"
								        behaviours:TooltipBehavior.Tip="Единицы толщины и скругления — пункты, миллиметры или пиксели. Нажатие переключает по кругу"
								        behaviours:TooltipBehavior.ShowDelay="700"/>

								<Rectangle Width="1" Height="18" Margin="2 0"
								           VerticalAlignment="Center"
								           Fill="{DynamicResource BorderSubtleBrush}"/>

								<ToggleButton Classes="SegSquare"
								              Command="{Binding BorderAlignInsideCommand}"
								              IsChecked="{Binding CurrentBorderAlign, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Inside, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Рамка внутрь картинки: наружу габарита не выходит, текст обтекает по краю картинки"
								              behaviours:TooltipBehavior.ShowDelay="700">
									<PathIcon Width="14" Height="14"
									          Data="M4 4h16v16H4V4zM8 8v8h8V8H8z"/>
								</ToggleButton>

								<ToggleButton Classes="SegSquare"
								              Command="{Binding BorderAlignCenterCommand}"
								              IsChecked="{Binding CurrentBorderAlign, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Center, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Рамка по границе картинки: половина толщины внутрь, половина наружу"
								              behaviours:TooltipBehavior.ShowDelay="700">
									<PathIcon Width="14" Height="14"
									          Data="M2 2h20v20H2V2zM6 6v12h12V6H6z"/>
								</ToggleButton>

								<ToggleButton Classes="SegSquare"
								              Command="{Binding BorderAlignOutsideCommand}"
								              IsChecked="{Binding CurrentBorderAlign, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Outside, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Рамка снаружи картинки: габарит растёт на её толщину, и текст отходит на неё же"
								              behaviours:TooltipBehavior.ShowDelay="700">
									<PathIcon Width="14" Height="14"
									          Data="M0 0h24v24H0V0zM4 4v16h16V4H4z"/>
								</ToggleButton>
							</StackPanel>

							<StackPanel Orientation="Horizontal" Spacing="4">
								<PathIcon Width="13" Height="13" VerticalAlignment="Center"
								          Foreground="{DynamicResource TextSecondaryBrush}"
								          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18V4c4.41 0 8 3.59 8 8s-3.59 8-8 8z"/>
								<TextBlock FontSize="10" VerticalAlignment="Center"
								           Foreground="{DynamicResource TextSecondaryBrush}"
								           Text="Видимость"/>
								<Slider Classes="knob" Width="72"
								        Minimum="0" Maximum="100"
								        Value="{Binding OpacityValue, Mode=TwoWay}"
								        behaviours:TooltipBehavior.Tip="Видимость картинки: 100% — полностью непрозрачная, 0% — невидимая"
								        behaviours:TooltipBehavior.ShowDelay="700"/>
								<NumericUpDown Classes="Ribbon" Width="64"
								               Value="{Binding OpacityPercent, Mode=TwoWay}"
								               Minimum="0" Maximum="100"
								               Increment="5"
								               FormatString="0"
								               ClipValueToMinMax="True"
								               behaviours:TooltipBehavior.Tip="Видимость картинки в процентах: 100% — полностью непрозрачная, 0% — невидимая"
								               behaviours:TooltipBehavior.ShowDelay="700"/>
							</StackPanel>

						</StackPanel>
					</DockPanel>
				</Border>

				<!-- ── Группа: Тип рамки ─────────────────────────────────────── -->
				<!-- Штрих и скругление стоят отдельной группой, а не в «Оформлении»:  -->
				<!-- та уже держит два ряда и цвет с толщиной, и третий ряд разогнал бы -->
				<!-- высоту тела ленты, общую на все вкладки.                           -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel" Text="Тип рамки"/>
						</Grid>
						<StackPanel Spacing="3" VerticalAlignment="Center">

							<StackPanel Orientation="Horizontal" Spacing="2">
								<ToggleButton Classes="SegSquare"
								              Command="{Binding BorderDashSolidCommand}"
								              IsChecked="{Binding CurrentBorderDash, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Solid, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Сплошная рамка"
								              behaviours:TooltipBehavior.ShowDelay="700">
									<PathIcon Width="14" Height="14" Data="M3 11h18v2H3v-2z"/>
								</ToggleButton>

								<ToggleButton Classes="SegSquare"
								              Command="{Binding BorderDashDashCommand}"
								              IsChecked="{Binding CurrentBorderDash, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Dash, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Пунктирная рамка"
								              behaviours:TooltipBehavior.ShowDelay="700">
									<PathIcon Width="14" Height="14" Data="M3 11h5v2H3v-2zm7 0h5v2h-5v-2zm7 0h4v2h-4v-2z"/>
								</ToggleButton>

								<ToggleButton Classes="SegSquare"
								              Command="{Binding BorderDashDotCommand}"
								              IsChecked="{Binding CurrentBorderDash, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Dot, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Рамка из точек"
								              behaviours:TooltipBehavior.ShowDelay="700">
									<PathIcon Width="14" Height="14" Data="M3 11h2v2H3v-2zm4 0h2v2H7v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2z"/>
								</ToggleButton>

								<ToggleButton Classes="SegSquare"
								              Command="{Binding BorderDashDashDotCommand}"
								              IsChecked="{Binding CurrentBorderDash, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=DashDot, Mode=OneWay}"
								              behaviours:TooltipBehavior.Tip="Штрихпунктирная рамка"
								              behaviours:TooltipBehavior.ShowDelay="700">
									<PathIcon Width="14" Height="14" Data="M3 11h6v2H3v-2zm8 0h2v2h-2v-2zm4 0h6v2h-6v-2z"/>
								</ToggleButton>
							</StackPanel>

							<StackPanel Orientation="Horizontal" Spacing="4"
							            IsVisible="{Binding !IsLineLike}">
								<PathIcon Width="13" Height="13" VerticalAlignment="Center"
								          Foreground="{DynamicResource TextSecondaryBrush}"
								          Data="M4 20V10C4 6.7 6.7 4 10 4h10v2H10c-2.2 0-4 1.8-4 4v10H4z"/>
								<TextBlock FontSize="10" VerticalAlignment="Center"
								           Foreground="{DynamicResource TextSecondaryBrush}"
								           Text="Углы"/>
								<NumericUpDown Classes="Ribbon" Width="76"
								               Value="{Binding ImageCornerRadius, Mode=TwoWay}"
								               Minimum="0" Maximum="400"
								               Increment="{Binding LineUnitIncrement}"
								               FormatString="{Binding LineUnitFormat}"
								               ClipValueToMinMax="True"
								               behaviours:TooltipBehavior.Tip="Скругление углов: по нему обрезается содержимое и идёт рамка. Единицы — те же, что у толщины рамки"
								               behaviours:TooltipBehavior.ShowDelay="700"/>
							</StackPanel>

						</StackPanel>
					</DockPanel>
				</Border>

			</StackPanel>
		</controls:RibbonScrollContainer.RibbonContent>
	</controls:RibbonScrollContainer>
</UserControl>
