<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Writersword.Views.Settings.SettingButtons">
	<StackPanel Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center"
                Margin="6,0,0,0">

		<Button x:Name="BtnResetToGlobal"
                Classes="ghost"
                Width="22" Height="22" Padding="0"
                IsVisible="False"
                ToolTip.Tip="Сбросить до глобального">
			<TextBlock Text="&#x2B6F;" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource SectionGlobalFgBrush}"/>
		</Button>

		<Button x:Name="BtnResetToHardcoded"
                Classes="ghost"
                Width="22" Height="22" Padding="0"
                IsVisible="False"
                ToolTip.Tip="Сбросить до стандартного">
			<TextBlock Text="&#x21BA;" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
		</Button>

	</StackPanel>
</UserControl>