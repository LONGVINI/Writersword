<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AssemblyName>Writersword.UI.Shared</AssemblyName>
		<RootNamespace>Writersword</RootNamespace>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<!-- Убираем все AXAML что SDK мог подхватить автоматически -->
	<ItemGroup>
		<AvaloniaXaml Remove="**\*.axaml" />
	</ItemGroup>

	<!-- Infrastructure/Behaviours и Controls -->
	<ItemGroup>
		<Compile Include="Src\Infrastructure\Behaviours\ClickOutsideBehavior.cs" />
		<Compile Include="Src\Infrastructure\Behaviours\FocusOnVisibleBehavior.cs" />
		<Compile Include="Src\Infrastructure\Behaviours\TooltipBehavior.cs" />
		<Compile Include="Src\Infrastructure\Controls\ItalicCaretTextBox.cs" />
		<Compile Include="Src\Infrastructure\Converters\GradientBrushFactory.cs" />
	</ItemGroup>

	<!-- UserControls — явно после Remove выше -->
	<ItemGroup>
		<Compile Include="Styles\UserControls\ColorPickerButton.axaml.cs" />
		<AvaloniaXaml Include="Styles\UserControls\ColorPickerButton.axaml" />
		<Compile Include="Styles\UserControls\ScreenColorPicker.cs" />
		<Compile Include="Styles\UserControls\ModalHost.cs" />
		<Compile Include="Styles\UserControls\ColorEditorOverlay.axaml.cs" />
		<AvaloniaXaml Include="Styles\UserControls\ColorEditorOverlay.axaml" />
		<Compile Include="Styles\UserControls\EyedropperOverlay.axaml.cs" />
		<AvaloniaXaml Include="Styles\UserControls\EyedropperOverlay.axaml" />
		<Compile Include="Styles\UserControls\PaletteManagerView.axaml.cs" />
		<AvaloniaXaml Include="Styles\UserControls\PaletteManagerView.axaml" />
		<Compile Include="Styles\UserControls\GradientStripEditor.axaml.cs" />
		<AvaloniaXaml Include="Styles\UserControls\GradientStripEditor.axaml" />
		<Compile Include="Styles\UserControls\AngleDial.cs" />
		<Compile Include="Styles\UserControls\StandardColors.cs" />
		<Compile Include="Styles\UserControls\RibbonScrollContainer.axaml.cs" />
		<AvaloniaXaml Include="Styles\UserControls\RibbonScrollContainer.axaml" />
		<Compile Include="Styles\UserControls\TooltipView.axaml.cs" />
		<AvaloniaXaml Include="Styles\UserControls\TooltipView.axaml" />
	</ItemGroup>

	<!-- Локализация общих контролов -->
	<ItemGroup>
		<Compile Include="Styles\UserControls\SharedStrings.Designer.cs" />
		<EmbeddedResource Include="Styles\UserControls\SharedStrings.resx" />
		<EmbeddedResource Include="Styles\UserControls\SharedStrings.ru.resx">
			<DependentUpon>SharedStrings.resx</DependentUpon>
		</EmbeddedResource>
	</ItemGroup>


	<ItemGroup>
		<Compile Include="Views\Settings\SettingButtons.axaml.cs" />
		<AvaloniaXaml Include="Views\Settings\SettingButtons.axaml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.3" />
		<PackageReference Include="AnimatedImage.Avalonia" Version="2.1.4" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
		<PackageReference Include="Serilog" Version="4.3.2-dev-02419" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="Src\Writersword.Core.csproj" />
	</ItemGroup>

</Project>