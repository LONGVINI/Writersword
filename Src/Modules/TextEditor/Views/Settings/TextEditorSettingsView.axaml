<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels"
             xmlns:loc="using:Writersword.Modules.TextEditor.Resources"
             xmlns:sf="using:Writersword.Views.Settings"
             x:Class="Writersword.Modules.TextEditor.Views.Settings.TextEditorSettingsView"
             x:DataType="vm:TextEditorSettingsViewModel"
             MinWidth="420">

	<UserControl.Styles>
		<Style Selector="TextBlock.FieldLabel">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
		</Style>
		<Style Selector="NumericUpDown">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="ButtonSpinnerLocation" Value="Right"/>
		</Style>
	</UserControl.Styles>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="16" Spacing="24">

			<StackPanel Spacing="12">
				<TextBlock Text="{x:Static loc:TextEditorStrings.Settings_FontGroup}"
                           FontWeight="SemiBold" FontSize="13"/>
				<Separator/>

				<StackPanel Spacing="0">
					<TextBlock Classes="FieldLabel"
                               Text="{x:Static loc:TextEditorStrings.Settings_FontFamily}"/>
					<Grid ColumnDefinitions="*,Auto">
						<ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableFonts}"
                                  SelectedItem="{Binding FontFamily.Value}"
                                  HorizontalAlignment="Stretch"/>
						<sf:SettingButtons Grid.Column="1"
                                           Setting="{Binding FontFamily}"
                                           Context="{Binding Context}"/>
					</Grid>
				</StackPanel>

				<StackPanel Spacing="0">
					<TextBlock Classes="FieldLabel"
                               Text="{x:Static loc:TextEditorStrings.Settings_FontSize}"/>
					<Grid ColumnDefinitions="120,Auto">
						<NumericUpDown Grid.Column="0"
                                       Value="{Binding FontSizeProxy}"
                                       Minimum="6" Maximum="144" Increment="1"
                                       FormatString="0"/>
						<sf:SettingButtons Grid.Column="1"
                                           Setting="{Binding FontSize}"
                                           Context="{Binding Context}"/>
					</Grid>
				</StackPanel>

				<Border Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="12,8">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Settings_PreviewText}"
                               FontFamily="{Binding FontFamily.Value}"
                               FontSize="{Binding FontSize.Value}"
                               TextWrapping="Wrap"/>
				</Border>
			</StackPanel>

			<StackPanel Spacing="12">
				<TextBlock Text="{x:Static loc:TextEditorStrings.Settings_SpellGroup}"
                           FontWeight="SemiBold" FontSize="13"/>
				<Separator/>

				<Grid ColumnDefinitions="*,Auto">
					<CheckBox Grid.Column="0"
                              IsChecked="{Binding SpellCheckEnabled.Value}"
                              Content="{x:Static loc:TextEditorStrings.Settings_SpellCheckEnabled}"/>
					<sf:SettingButtons Grid.Column="1"
                                       Setting="{Binding SpellCheckEnabled}"
                                       Context="{Binding Context}"/>
				</Grid>

				<Grid ColumnDefinitions="*,Auto">
					<CheckBox Grid.Column="0"
                              IsChecked="{Binding ShowSpellErrors.Value}"
                              IsEnabled="{Binding SpellCheckEnabled.Value}"
                              Content="{x:Static loc:TextEditorStrings.Settings_ShowSpellErrors}"/>
					<sf:SettingButtons Grid.Column="1"
                                       Setting="{Binding ShowSpellErrors}"
                                       Context="{Binding Context}"/>
				</Grid>

				<StackPanel Spacing="0">
					<TextBlock Classes="FieldLabel"
                               Text="{x:Static loc:TextEditorStrings.Settings_DefaultLanguage}"/>
					<Grid ColumnDefinitions="*,Auto">
						<ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding DefaultLanguage.Value}"
                                  IsEnabled="{Binding SpellCheckEnabled.Value}"
                                  HorizontalAlignment="Stretch"/>
						<sf:SettingButtons Grid.Column="1"
                                           Setting="{Binding DefaultLanguage}"
                                           Context="{Binding Context}"/>
					</Grid>
				</StackPanel>
			</StackPanel>

			<StackPanel Spacing="12">
				<TextBlock Text="{x:Static loc:TextEditorStrings.Settings_AutoReplaceGroup}"
                           FontWeight="SemiBold" FontSize="13"/>
				<Separator/>

				<Grid ColumnDefinitions="*,Auto">
					<CheckBox Grid.Column="0"
                              IsChecked="{Binding AutoReplaceEnabled.Value}"
                              Content="{x:Static loc:TextEditorStrings.Settings_AutoReplaceEnabled}"/>
					<sf:SettingButtons Grid.Column="1"
                                       Setting="{Binding AutoReplaceEnabled}"
                                       Context="{Binding Context}"/>
				</Grid>
			</StackPanel>

			<StackPanel Spacing="12">
				<TextBlock Text="{x:Static loc:TextEditorStrings.Settings_ViewGroup}"
                           FontWeight="SemiBold" FontSize="13"/>
				<Separator/>

				<Grid ColumnDefinitions="*,Auto">
					<CheckBox Grid.Column="0"
                              IsChecked="{Binding ShowRuler.Value}"
                              Content="{x:Static loc:TextEditorStrings.Settings_ShowRuler}"/>
					<sf:SettingButtons Grid.Column="1"
                                       Setting="{Binding ShowRuler}"
                                       Context="{Binding Context}"/>
				</Grid>

				<Grid ColumnDefinitions="*,Auto">
					<CheckBox Grid.Column="0"
                              IsChecked="{Binding ShowFormattingMarks.Value}"
                              Content="{x:Static loc:TextEditorStrings.Settings_ShowFormattingMarks}"/>
					<sf:SettingButtons Grid.Column="1"
                                       Setting="{Binding ShowFormattingMarks}"
                                       Context="{Binding Context}"/>
				</Grid>

				<StackPanel Spacing="0">
					<TextBlock Classes="FieldLabel"
                               Text="{x:Static loc:TextEditorStrings.Settings_DefaultViewMode}"/>
					<Grid ColumnDefinitions="*,Auto">
						<ComboBox Grid.Column="0"
                                  ItemsSource="{Binding ViewModes}"
                                  SelectedItem="{Binding DefaultViewMode.Value}"
                                  HorizontalAlignment="Stretch"/>
						<sf:SettingButtons Grid.Column="1"
                                           Setting="{Binding DefaultViewMode}"
                                           Context="{Binding Context}"/>
					</Grid>
				</StackPanel>

				<StackPanel Spacing="0">
					<TextBlock Classes="FieldLabel"
                               Text="{x:Static loc:TextEditorStrings.Settings_DefaultZoom}"/>
					<Grid ColumnDefinitions="*,8,120,Auto">
						<Slider Grid.Column="0"
                                Minimum="25" Maximum="500"
                                Value="{Binding ZoomPercent}"
                                VerticalAlignment="Center"/>

						<NumericUpDown Grid.Column="2"
                                       Value="{Binding ZoomPercent}"
                                       Minimum="25" Maximum="500"
                                       Increment="1"
                                       FormatString="0 '%'"
                                       HorizontalContentAlignment="Center"/>

						<sf:SettingButtons Grid.Column="3"
                                           Setting="{Binding DefaultZoom}"
                                           Context="{Binding Context}"/>
					</Grid>
				</StackPanel>
			</StackPanel>

			<StackPanel Spacing="12">
				<TextBlock Text="{x:Static loc:TextEditorStrings.Settings_MonitorGroup}"
                           FontWeight="SemiBold" FontSize="13"/>
				<Separator/>

				<StackPanel Spacing="0">
					<TextBlock Classes="FieldLabel"
                               Text="{x:Static loc:TextEditorStrings.Settings_MonitorSize}"/>
					<Grid ColumnDefinitions="80,Auto,*,Auto">
						<TextBox Name="MonitorTextBox"
                                 Grid.Column="0"
                                 HorizontalAlignment="Stretch"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center"/>
						<TextBlock Grid.Column="1"
                                   Text="{x:Static loc:TextEditorStrings.Settings_MonitorSizeUnit}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
						<sf:SettingButtons Grid.Column="3"
                                           Setting="{Binding MonitorSizeInches}"
                                           Context="{Binding Context}"/>
					</Grid>
				</StackPanel>

				<TextBlock Text="{x:Static loc:TextEditorStrings.Settings_MonitorSizeHint}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
			</StackPanel>

			<StackPanel Spacing="12">
				<TextBlock Text="{x:Static loc:TextEditorStrings.Settings_AutoSaveGroup}"
                           FontWeight="SemiBold" FontSize="13"/>
				<Separator/>

				<StackPanel Spacing="0">
					<TextBlock Classes="FieldLabel"
                               Text="{x:Static loc:TextEditorStrings.Settings_AutoSaveInterval}"/>
					<Grid ColumnDefinitions="140,Auto,*,Auto">
						<NumericUpDown Grid.Column="0"
									   Value="{Binding AutoSaveSecondsProxy}"
									   Minimum="0" Maximum="3600" Increment="10"
									   FormatString="0"
									   HorizontalContentAlignment="Center"/>
						<TextBlock Grid.Column="1"
                                   Text="{x:Static loc:TextEditorStrings.Settings_AutoSaveSeconds}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
						<sf:SettingButtons Grid.Column="3"
                                           Setting="{Binding AutoSaveIntervalSeconds}"
                                           Context="{Binding Context}"/>
					</Grid>
				</StackPanel>

				<TextBlock Text="{x:Static loc:TextEditorStrings.Settings_AutoSaveHint}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
			</StackPanel>

			<!-- Секция: Шрифты по языкам -->
			<StackPanel Spacing="12">
				<TextBlock Text="Шрифты по языковым скриптам"
                           FontWeight="SemiBold" FontSize="13"/>
				<Separator/>

				<TextBlock Text="Выбранный шрифт используется автоматически когда текущий шрифт документа не поддерживает символы этого скрипта."
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

				<ItemsControl ItemsSource="{Binding ScriptFonts}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ScriptFontEntry">
							<Grid ColumnDefinitions="180,*" Margin="0,3,0,3">
								<TextBlock Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
								<ComboBox Grid.Column="1"
                                          ItemsSource="{Binding $parent[UserControl].((vm:TextEditorSettingsViewModel)DataContext).AvailableFonts}"
                                          SelectedItem="{Binding FontFamily}"
                                          HorizontalAlignment="Stretch"
                                          Height="28"
                                          FontSize="12"/>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

		</StackPanel>
	</ScrollViewer>
</UserControl>