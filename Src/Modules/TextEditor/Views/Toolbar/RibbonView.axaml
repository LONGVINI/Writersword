<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.Toolbar"
             xmlns:tabs="using:Writersword.Modules.TextEditor.Views.Toolbar.Tabs"
             xmlns:loc="using:Writersword.Modules.TextEditor.Resources"
             x:Class="Writersword.Modules.TextEditor.Views.Toolbar.RibbonView"
             x:DataType="vm:RibbonViewModel">

	<Border Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="0 0 0 1">

		<TabControl SelectedIndex="{Binding SelectedTabIndex}"
                    Padding="0"
                    Background="Transparent">

			<TabControl.Styles>

				<!-- Базовый стиль вкладки -->
				<Style Selector="TabItem">
					<Setter Property="FontSize" Value="12"/>
					<Setter Property="Padding" Value="11 4"/>
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="BorderThickness" Value="0"/>
					<Setter Property="MinHeight" Value="0"/>
					<Setter Property="Height" Value="26"/>
					<Setter Property="Cursor" Value="Hand"/>
					<Setter Property="VerticalContentAlignment" Value="Center"/>
				</Style>

				<!-- Цвет текста в обычном состоянии -->
				<Style Selector="TabItem > TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource MenuBarItemForeground}"/>
					<Setter Property="FontSize" Value="12"/>
					<Setter Property="VerticalAlignment" Value="Center"/>
				</Style>

				<!-- При наведении — оранжевый фон, белый текст -->
				<Style Selector="TabItem:pointerover">
					<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
					<Setter Property="BorderThickness" Value="0"/>
				</Style>
				<Style Selector="TabItem:pointerover > TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource MenuBarItemForegroundPointerOver}"/>
				</Style>

				<!-- Выбранная вкладка -->
				<Style Selector="TabItem:selected">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="BorderThickness" Value="0 0 0 2"/>
					<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
				</Style>
				<Style Selector="TabItem:selected > TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
				</Style>

				<!-- Убираем FluentTheme-полоску -->
				<Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="IsVisible" Value="False"/>
				</Style>

				<!-- Контекстная вкладка «Таблица» — заголовок зелёного цвета -->
				<Style Selector="TabItem.TableContextTab > TextBlock">
					<Setter Property="Foreground" Value="#2E7D32"/>
					<Setter Property="FontWeight" Value="Medium"/>
				</Style>
				<Style Selector="TabItem.TableContextTab:selected">
					<Setter Property="BorderBrush" Value="#2E7D32"/>
				</Style>
				<Style Selector="TabItem.TableContextTab:selected > TextBlock">
					<Setter Property="Foreground" Value="#2E7D32"/>
				</Style>
				<Style Selector="TabItem.TableContextTab:pointerover">
					<Setter Property="Background" Value="#2E7D32"/>
				</Style>

			</TabControl.Styles>

			<!-- ── Главная ──────────────────────────────────────────────── -->
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static loc:TextEditorStrings.Ribbon_Home}"/>
				</TabItem.Header>
				<tabs:RibbonHomeTab DataContext="{Binding Home}"/>
			</TabItem>

			<!-- ── Вставка ──────────────────────────────────────────────── -->
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static loc:TextEditorStrings.Ribbon_Insert}"/>
				</TabItem.Header>
				<tabs:RibbonInsertTab DataContext="{Binding Insert}"/>
			</TabItem>

			<!-- ── Макет ────────────────────────────────────────────────── -->
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static loc:TextEditorStrings.Ribbon_Layout}"/>
				</TabItem.Header>
				<tabs:RibbonLayoutTab DataContext="{Binding Layout}"/>
			</TabItem>

			<!-- ── Ссылки ───────────────────────────────────────────────── -->
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static loc:TextEditorStrings.Ribbon_References}"/>
				</TabItem.Header>
				<tabs:RibbonReferencesTab DataContext="{Binding References}"/>
			</TabItem>

			<!-- ── Работа с таблицей (КОНТЕКСТНАЯ) ─────────────────────── -->
			<!-- Видна только когда каретка находится внутри таблицы.       -->
			<!-- IsTableTabVisible управляется из TextEditorViewModel.       -->
			<TabItem Classes="TableContextTab"
                     IsVisible="{Binding IsTableTabVisible}">
				<TabItem.Header>
					<TextBlock Text="Работа с таблицами"/>
				</TabItem.Header>
				<tabs:RibbonTableTab DataContext="{Binding Table}"/>
			</TabItem>

		</TabControl>
	</Border>
</UserControl>
