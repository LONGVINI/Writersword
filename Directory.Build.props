<Project>
	<PropertyGroup>
		<BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>

		<!-- «Claude outputs» — папка для присланных файлов, а не часть исходников.
		     Она лежит в корне решения, а корень решения — это ещё и корень двух
		     проектов (Writersword и Writersword.UI.Shared), поэтому их неявные
		     шаблоны забирали её содержимое в сборку: копия класса конфликтовала
		     с настоящей (CS0436), а копия разметки поднимала генератор имён на
		     класс, которого в этой сборке нет (CS1929).

		     Исключение задано свойством, а не через Remove: неявные шаблоны
		     Compile, AvaloniaXaml и прочих вычисляются уже после этого файла, и
		     Remove отсюда до них не дотянулся бы. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);obj\**\*;Claude outputs\**\*</DefaultItemExcludes>
	</PropertyGroup>
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Writersword.Core' and '$(MSBuildProjectName)' != 'Tests'">
		<!-- Горячая перезагрузка XAML в Debug-сборках. При мультипроектной
		     структуре HotAvalonia должен присутствовать в каждом проекте
		     с Avalonia-контролами. Это dev-only зависимость — в Release-сборки
		     не попадает. Writersword.Core и Tests исключены: они подключают
		     Avalonia без XAML-компилятора (ExcludeAssets="build"), и цель
		     CompileAvaloniaXaml, нужная HotAvalonia, там отсутствует. -->
		<PackageReference Include="HotAvalonia" Version="3.1.4" PrivateAssets="All" Publish="True" />
	</ItemGroup>
</Project>