<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:infra="using:Writersword.Infrastructure.Controls">
	<!-- Базовые стили поля ввода -->
	<Style Selector="TextBox">
		<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeS}"/>
		<Setter Property="Padding" Value="{DynamicResource PaddingXS}"/>
		<Setter Property="MinHeight" Value="28"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
		<Setter Property="SelectionBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		<Setter Property="SelectionForegroundBrush" Value="White"/>
	</Style>
	<!-- Наведение подсвечивает рамку: раньше здесь стоял тот же цвет, что и
	     в покое, и поле никак не показывало, что в него можно писать. -->
	<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
		<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
	</Style>
	<!-- Внутреннее поле редактируемого ComboBox под это правило не подпадает:
	     фон и рамку там рисует сам список, см. Styles/Controls/ComboBox.axaml. -->
	<Style Selector="ComboBox /template/ TextBox:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
	</Style>
	<!-- Локальное отключение акцентной окантовки на фокусе: Classes="noAccent" -->
	<Style Selector="TextBox.noAccent:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
	</Style>
	<Style Selector="TextBox:disabled">
		<Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
		<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
	</Style>
	<Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
	</Style>
	<!-- Редакторское поле для большого текста (TextEditor, сценарии, поэзия и т.д.) -->
	<!-- Использование: Classes="editor" на TextBox -->
	<Style Selector="TextBox.editor">
		<Setter Property="AcceptsReturn" Value="True"/>
		<Setter Property="TextWrapping" Value="Wrap"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="White"/>
		<Setter Property="Foreground" Value="#000000"/>
		<Setter Property="CaretBrush" Value="#000000"/>
		<Setter Property="SelectionBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		<Setter Property="SelectionForegroundBrush" Value="White"/>
		<Setter Property="Padding" Value="60,40"/>
		<Setter Property="MinHeight" Value="1000"/>
		<Setter Property="Focusable" Value="True"/>
		<Setter Property="UndoLimit" Value="1000"/>
	</Style>
	<Style Selector="TextBox.editor /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="White"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
	</Style>
	<Style Selector="TextBox.editor:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="White"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
	</Style>
	<Style Selector="TextBox.editor:focus /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="White"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
	</Style>
	<Style Selector="TextBox.editor:disabled">
		<Setter Property="Background" Value="White"/>
		<Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
	</Style>
	<Style Selector="TextBox.editor:disabled /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="White"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
	</Style>

	<Style Selector="TextBox.italic /template/ TextPresenter#PART_TextPresenter">
		<Setter Property="Margin" Value="0,0,6,0"/>
	</Style>

	<!-- ── Обязательное поле, оставленное пустым ──────────────────────────
	     Classes="invalid" вешается кодом в тот момент, когда без этого поля
	     дальше не пройти: нажали «ОК», а имя не вписано. Заранее краснеть
	     полю незачем — пустым оно и так будет всю первую секунду.

	     Красный тот же, что у конфликта горячих клавиш: у каждой темы свой
	     оттенок (в тёмной он светлее, иначе тонет в фоне), а четвёртого
	     красного в программе не заводится.

	     Правится рамка в шаблоне, а не свойство самого поля: наведение и
	     фокус уже красят Border#PART_BorderElement, и цвет, поставленный
	     полю, под курсором и в фокусе до рамки бы не дошёл — а поле в этот
	     момент как раз в фокусе, курсор туда и поставили. По той же причине
	     правило стоит в конце файла: при равной силе селектора выигрывает
	     объявленное последним.

	     Стиль общий, а не в окне метки: поле, без которого не нажимается
	     кнопка, встречается не только там, и краснеть везде должно
	     одинаково. -->
	<Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource HotKeyConflictCriticalBrush}"/>
		<Setter Property="BorderThickness" Value="1.5"/>
	</Style>
	<Style Selector="TextBox.invalid:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource HotKeyConflictCriticalBrush}"/>
		<Setter Property="BorderThickness" Value="1.5"/>
	</Style>
	<Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource HotKeyConflictCriticalBrush}"/>
		<Setter Property="BorderThickness" Value="1.5"/>
	</Style>
	<!-- Каретка тоже красная: поле в фокусе, и янтарная каретка в красной
	     рамке читается как «тут всё в порядке, просто рамка такая». -->
	<Style Selector="TextBox.invalid">
		<Setter Property="CaretBrush" Value="{DynamicResource HotKeyConflictCriticalBrush}"/>
	</Style>
</Styles>