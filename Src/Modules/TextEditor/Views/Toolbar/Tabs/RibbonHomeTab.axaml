<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.Toolbar"
             xmlns:converters="using:Writersword.Modules.TextEditor.Converters"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             xmlns:loc="using:Writersword.Modules.TextEditor.Resources"
             xmlns:controls="using:Writersword.Styles.UserControls"
             x:Class="Writersword.Modules.TextEditor.Views.Toolbar.Tabs.RibbonHomeTab"
             x:DataType="vm:RibbonHomeTabViewModel">

    <UserControl.Styles>

        <!-- RibbonBtn -->
        <Style Selector="Button.RibbonBtn">
            <Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness"            Value="1"/>
            <Setter Property="CornerRadius"               Value="3"/>
            <Setter Property="Padding"                    Value="4"/>
            <Setter Property="MinWidth"                   Value="26"/>
            <Setter Property="MinHeight"                  Value="26"/>
            <Setter Property="VerticalAlignment"          Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"                     Value="Hand"/>
        </Style>
        <Style Selector="Button.RibbonBtn /template/ ContentPresenter">
            <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
        </Style>
        <Style Selector="Button.RibbonBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.RibbonBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.RibbonBtn:disabled /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Opacity"     Value="0.4"/>
        </Style>

        <!-- RibbonBtnLarge -->
        <Style Selector="Button.RibbonBtnLarge">
            <Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness"            Value="1"/>
            <Setter Property="CornerRadius"               Value="3"/>
            <Setter Property="Padding"                    Value="4 2"/>
            <Setter Property="MinWidth"                   Value="40"/>
            <Setter Property="MinHeight"                  Value="54"/>
            <Setter Property="VerticalAlignment"          Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"                     Value="Hand"/>
        </Style>
        <Style Selector="Button.RibbonBtnLarge /template/ ContentPresenter">
            <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
        </Style>
        <Style Selector="Button.RibbonBtnLarge:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.RibbonBtnLarge:pressed /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.RibbonBtnLarge:disabled /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Opacity"     Value="0.4"/>
        </Style>

        <!-- RibbonToggle -->
        <Style Selector="ToggleButton.RibbonToggle">
            <Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness"            Value="1"/>
            <Setter Property="CornerRadius"               Value="3"/>
            <Setter Property="Padding"                    Value="4"/>
            <Setter Property="MinWidth"                   Value="26"/>
            <Setter Property="MinHeight"                  Value="26"/>
            <Setter Property="VerticalAlignment"          Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"                     Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.RibbonToggle /template/ ContentPresenter">
            <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
        </Style>
        <Style Selector="ToggleButton.RibbonToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="ToggleButton.RibbonToggle:pressed /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="ToggleButton.RibbonToggle:checked /template/ ContentPresenter">
            <Setter Property="Background"             Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush"            Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="ToggleButton.RibbonToggle:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="ToggleButton.RibbonToggle:disabled /template/ ContentPresenter">
            <Setter Property="Background"  Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Opacity"     Value="0.4"/>
        </Style>

        <!-- RibbonSplit -->
        <Style Selector="SplitButton.RibbonSplit">
            <Setter Property="Background"        Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="CornerRadius"      Value="3"/>
            <Setter Property="Padding"           Value="4 4 2 4"/>
            <Setter Property="MinWidth"          Value="26"/>
            <Setter Property="MinHeight"         Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"            Value="Hand"/>
        </Style>
        <Style Selector="SplitButton.RibbonSplit:pointerover">
            <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="SplitButton.RibbonSplit:pressed">
            <Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>

        <!-- Группа риббона — рамка развёрнутая -->
        <Style Selector="Border.RibbonGroup">
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="6 4 6 0"/>
            <Setter Property="Margin"          Value="2 3"/>
        </Style>

        <!-- Группа риббона — рамка свёрнутая -->
        <Style Selector="Border.RibbonGroupCollapsed">
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="2 4 2 0"/>
            <Setter Property="Margin"          Value="2 3"/>
        </Style>

        <!-- Подпись группы — контейнер -->
        <Style Selector="Grid.RibbonGroupLabelGrid">
            <Setter Property="Margin" Value="0 3 0 2"/>
        </Style>

        <!-- Подпись группы — текст -->
        <Style Selector="TextBlock.RibbonGroupLabel">
            <Setter Property="FontSize"            Value="10"/>
            <Setter Property="Foreground"          Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <!-- Кнопка настроек группы -->
        <Style Selector="Button.RibbonGroupSettings">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderBrush"                Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="2 1"/>
            <Setter Property="MinWidth"                   Value="0"/>
            <Setter Property="MinHeight"                  Value="0"/>
            <Setter Property="HorizontalAlignment"        Value="Right"/>
            <Setter Property="VerticalAlignment"          Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Foreground"                 Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Cursor"                     Value="Hand"/>
        </Style>
        <Style Selector="Button.RibbonGroupSettings /template/ ContentPresenter">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="2"/>
        </Style>
        <Style Selector="Button.RibbonGroupSettings:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>
        <Style Selector="Button.RibbonGroupSettings:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        </Style>
        <Style Selector="Button.RibbonGroupSettings:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>

        <!-- Вертикальный разделитель внутри группы -->
        <Style Selector="Separator.RibbonDivider">
            <Setter Property="Width"             Value="1"/>
            <Setter Property="Height"            Value="22"/>
            <Setter Property="Background"        Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Margin"            Value="3 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- TextBox для поля размера шрифта -->
        <!-- Дропдаун: фиксированная ширина, без горизонтального скролла -->
        <Style Selector="AutoCompleteBox#FontAutoComplete /template/ Popup > Border">
            <Setter Property="MinWidth"  Value="260"/>
            <Setter Property="MaxHeight" Value="320"/>
        </Style>
        <Style Selector="AutoCompleteBox#FontAutoComplete /template/ ListBox">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="AutoCompleteBox#FontAutoComplete /template/ ListBoxItem">
            <Setter Property="Padding"   Value="8,3"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBox.FontSizeInput">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Padding"                  Value="2 0"/>
            <Setter Property="Width"                    Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment"            Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush"           Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="White"/>
        </Style>
        <Style Selector="TextBox.FontSizeInput /template/ Border#PART_BorderElement">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Галерея стилей -->
        <Style Selector="ListBox.StyleGallery">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem">
            <Setter Property="Padding"   Value="0"/>
            <Setter Property="Margin"    Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="0"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem Border.StyleCard">
            <Setter Property="Background"      Value="#F8F6F0"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem:pointerover Border.StyleCard">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="Background"  Value="#FFFFFF"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem:selected Border.StyleCard">
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Список размеров шрифта в Flyout -->
        <Style Selector="ListBox.FontSizeList">
            <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="2"/>
        </Style>
        <Style Selector="ListBox.FontSizeList ListBoxItem">
            <Setter Property="Padding"                    Value="4 3"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor"                     Value="Hand"/>
        </Style>
        <Style Selector="ListBox.FontSizeList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background"             Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="ListBox.FontSizeList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>

    </UserControl.Styles>

    <controls:RibbonScrollContainer x:Name="ScrollContainer">
		<controls:RibbonScrollContainer.RibbonContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════════
                     БУФЕР ОБМЕНА — развёрнутый
                     ═══════════════════════════════════════════════════════ -->
                <Border Grid.Column="0" Classes="RibbonGroup"
                        IsVisible="{Binding IsClipboardGroupExpanded}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Clipboard_Group}"/>
                            <Button Grid.Column="1" Classes="RibbonGroupSettings"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Clipboard_Group}"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                            <Button Command="{Binding PasteCommand}" Classes="RibbonBtnLarge"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Paste}"
                                    behaviours:TooltipBehavior.HotKey="Ctrl+V"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <PathIcon Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z" Width="22" Height="22"/>
                                    <TextBlock Text="{x:Static loc:TextEditorStrings.Format_Paste}" FontSize="9" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Command="{Binding CutCommand}" Classes="RibbonBtn"
                                            behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Cut}"
                                            behaviours:TooltipBehavior.HotKey="Ctrl+X"
                                            behaviours:TooltipBehavior.ShowDelay="700">
                                        <PathIcon Data="M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm0 12c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3h-3z" Width="14" Height="14"/>
                                    </Button>
                                    <Button Command="{Binding UndoCommand}" Classes="RibbonBtn"
                                            behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Edit_Undo}"
                                            behaviours:TooltipBehavior.HotKey="Ctrl+Z"
                                            behaviours:TooltipBehavior.ShowDelay="700">
                                        <PathIcon Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Command="{Binding CopyCommand}" Classes="RibbonBtn"
                                            behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Copy}"
                                            behaviours:TooltipBehavior.HotKey="Ctrl+C"
                                            behaviours:TooltipBehavior.ShowDelay="700">
                                        <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="14" Height="14"/>
                                    </Button>
                                    <Button Command="{Binding RedoCommand}" Classes="RibbonBtn"
                                            behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Edit_Redo}"
                                            behaviours:TooltipBehavior.HotKey="Ctrl+Y"
                                            behaviours:TooltipBehavior.ShowDelay="700">
                                        <PathIcon Data="M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- БУФЕР ОБМЕНА — свёрнутый -->
                <Border Grid.Column="0" Classes="RibbonGroupCollapsed"
                        IsVisible="{Binding !IsClipboardGroupExpanded}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Clipboard_Group}"/>
                            <Button Grid.Column="1" Classes="RibbonGroupSettings"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Clipboard_Group}"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <Button Classes="RibbonBtnLarge" VerticalAlignment="Top"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Clipboard_Group}"
                                behaviours:TooltipBehavior.ShowDelay="700">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="6" Margin="8">
                                        <Button Command="{Binding PasteCommand}" Classes="RibbonBtnLarge"
                                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Paste}"
                                                behaviours:TooltipBehavior.HotKey="Ctrl+V"
                                                behaviours:TooltipBehavior.ShowDelay="700">
                                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                <PathIcon Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z" Width="22" Height="22"/>
                                                <TextBlock Text="{x:Static loc:TextEditorStrings.Format_Paste}" FontSize="9" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Command="{Binding CutCommand}" Classes="RibbonBtn"
                                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Cut}"
                                                    behaviours:TooltipBehavior.HotKey="Ctrl+X" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm0 12c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3h-3z" Width="14" Height="14"/>
                                            </Button>
                                            <Button Command="{Binding CopyCommand}" Classes="RibbonBtn"
                                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Copy}"
                                                    behaviours:TooltipBehavior.HotKey="Ctrl+C" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="14" Height="14"/>
                                            </Button>
                                            <Button Command="{Binding UndoCommand}" Classes="RibbonBtn"
                                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Edit_Undo}"
                                                    behaviours:TooltipBehavior.HotKey="Ctrl+Z" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" Width="14" Height="14"/>
                                            </Button>
                                            <Button Command="{Binding RedoCommand}" Classes="RibbonBtn"
                                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Edit_Redo}"
                                                    behaviours:TooltipBehavior.HotKey="Ctrl+Y" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z" Width="20" Height="20"/>
                                <TextBlock Text="{x:Static loc:TextEditorStrings.Clipboard_Group}" FontSize="9" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     ШРИФТ — всегда развёрнут
                     ═══════════════════════════════════════════════════════ -->
                <Border Grid.Column="1" Classes="RibbonGroup">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Font_Group}"/>
                            <Button Grid.Column="1" Classes="RibbonGroupSettings"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Font_Group}"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <StackPanel Spacing="4" VerticalAlignment="Top">

                            <!-- Строка 1: Шрифт + Размер + A↑ A↓ + Aa -->
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <AutoCompleteBox x:Name="FontAutoComplete"
                                                ItemsSource="{Binding AvailableFonts}"
                                                Text="{Binding CurrentFontFamilyText}"
                                                SelectedItem="{Binding CurrentFontFamily}"
                                                FilterMode="Contains"
                                                MinimumPrefixLength="0"
                                                MinimumPopulateDelay="0"
                                                Width="120"
                                                Height="24"
                                                FontSize="11"
                                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_FontFamily}"
                                                behaviours:TooltipBehavior.ShowDelay="700">
                                    <AutoCompleteBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{Binding}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </AutoCompleteBox.ItemTemplate>
                                </AutoCompleteBox>
                                <!-- Размер шрифта: TextBox + стрелка внутри одной кнопки -->
                                <Button Classes="RibbonBtn" Padding="2 0" Height="24"
                                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_FontSize}"
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <ListBox x:Name="FontSizeListBox"
                                                     ItemsSource="{Binding StandardFontSizes}"
                                                     Classes="FontSizeList"
                                                     MinWidth="44"
                                                     MaxHeight="200"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Flyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <TextBox Text="{Binding CurrentFontSizeText}"
                                                 Classes="FontSizeInput"/>
                                        <PathIcon Data="M7 10l5 5 5-5z" Width="8" Height="8"
                                                  Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                                <!-- A↑ -->
                                <Button Command="{Binding IncreaseFontSizeCommand}" Classes="RibbonBtn"
                                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_IncreaseFontSize}"
                                        behaviours:TooltipBehavior.HotKey="Ctrl+Shift+."
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <Grid Width="16" Height="16">
                                        <TextBlock Text="A" FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="+" FontSize="8" FontWeight="Bold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource AccentDefaultBrush}"/>
                                    </Grid>
                                </Button>
                                <!-- A↓ -->
                                <Button Command="{Binding DecreaseFontSizeCommand}" Classes="RibbonBtn"
                                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_DecreaseFontSize}"
                                        behaviours:TooltipBehavior.HotKey="Ctrl+Shift+,"
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <Grid Width="16" Height="16">
                                        <TextBlock Text="A" FontSize="10"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Margin="0 2 0 0"/>
                                        <TextBlock Text="-" FontSize="8" FontWeight="Bold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource AccentDefaultBrush}"/>
                                    </Grid>
                                </Button>
                                <!-- Aa — смена регистра -->
                                <Button Classes="RibbonBtn"
                                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_ChangeCase}"
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="{x:Static loc:TextEditorStrings.Case_Sentence}"
                                                      Command="{Binding CaseSentenceCommand}"/>
                                            <MenuItem Header="{x:Static loc:TextEditorStrings.Case_Lower}"
                                                      Command="{Binding CaseLowerCommand}"/>
                                            <MenuItem Header="{x:Static loc:TextEditorStrings.Case_Upper}"
                                                      Command="{Binding CaseUpperCommand}"/>
                                            <MenuItem Header="{x:Static loc:TextEditorStrings.Case_Title}"
                                                      Command="{Binding CaseTitleCommand}"/>
                                            <MenuItem Header="{x:Static loc:TextEditorStrings.Case_Toggle}"
                                                      Command="{Binding CaseToggleCommand}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <TextBlock Text="Aa" FontSize="11"/>
                                </Button>
                            </StackPanel>

                            <!-- Строка 2: Форматирование + Цвета + Эффекты -->
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton IsChecked="{Binding IsBold}" Command="{Binding BoldCommand}"
                                              Classes="RibbonToggle" FontWeight="Bold"
                                              behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Bold}"
                                              behaviours:TooltipBehavior.HotKey="Ctrl+B"
                                              behaviours:TooltipBehavior.ShowDelay="700">
                                    <TextBlock Text="{x:Static loc:TextEditorStrings.Format_Bold_Letter}" FontWeight="Bold"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding IsItalic}" Command="{Binding ItalicCommand}"
                                              Classes="RibbonToggle"
                                              behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Italic}"
                                              behaviours:TooltipBehavior.HotKey="Ctrl+I"
                                              behaviours:TooltipBehavior.ShowDelay="700">
                                    <TextBlock Text="{x:Static loc:TextEditorStrings.Format_Italic_Letter}"
                                               FontStyle="Italic" FontFamily="Georgia"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding IsUnderline}" Command="{Binding UnderlineCommand}"
                                              Classes="RibbonToggle"
                                              behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Underline}"
                                              behaviours:TooltipBehavior.HotKey="Ctrl+U"
                                              behaviours:TooltipBehavior.ShowDelay="700">
                                    <TextBlock Text="{x:Static loc:TextEditorStrings.Format_Underline_Letter}"
                                               TextDecorations="Underline"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding IsStrikethrough}" Command="{Binding StrikethroughCommand}"
                                              Classes="RibbonToggle"
                                              behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Strikethrough}"
                                              behaviours:TooltipBehavior.HotKey="Ctrl+Shift+S"
                                              behaviours:TooltipBehavior.ShowDelay="700">
                                    <Grid Width="14" Height="14">
                                        <TextBlock Text="{x:Static loc:TextEditorStrings.Format_Strikethrough_Letter}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Rectangle Height="1.5" Fill="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding IsSubscript}" Command="{Binding SubscriptCommand}"
                                              Classes="RibbonToggle"
                                              behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Subscript}"
                                              behaviours:TooltipBehavior.HotKey="Ctrl+="
                                              behaviours:TooltipBehavior.ShowDelay="700">
                                    <TextBlock FontSize="10">X<Run BaselineAlignment="Subscript" FontSize="7">2</Run></TextBlock>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding IsSuperscript}" Command="{Binding SuperscriptCommand}"
                                              Classes="RibbonToggle"
                                              behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Superscript}"
                                              behaviours:TooltipBehavior.HotKey="Ctrl+Shift+="
                                              behaviours:TooltipBehavior.ShowDelay="700">
                                    <TextBlock FontSize="10">X<Run BaselineAlignment="Superscript" FontSize="7">2</Run></TextBlock>
                                </ToggleButton>
                                <Separator Classes="RibbonDivider"/>
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                            behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_Highlight}"
                                            behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M23.06 18.17l-4.58-4.58-.01.01L9.27 4.42C8.9 4.05 8.43 3.86 7.96 3.86c-.47 0-.94.19-1.31.55l-1.27 1.27c-.37.37-.56.84-.55 1.31 0 .47.19.95.56 1.31L9.7 12.6l-4.1 4.1C4.4 17.9 4 19 4 20h2c0-.48.2-1.02.64-1.46l4.1-4.1 3.72 3.72c.37.37.84.55 1.31.55.47 0 .94-.18 1.31-.55l1.27-1.27c.72-.73.73-1.9.01-2.62 0-.03-.02-.04-.03-.06z" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <controls:ColorPickerButton Width="16" Height="16" VerticalAlignment="Center"
                                            HexColor="{Binding HighlightColorPick, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                            behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_TextColor}"
                                            behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M11.39 1.48L6.18 15h2.31l1.05-3h5.12l1.05 3h2.31L12.61 1.48h-1.22zm-1.21 8.52l1.82-5.2 1.82 5.2H10.18zM2 20h20v-2H2v2z" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <controls:ColorPickerButton Width="16" Height="16" VerticalAlignment="Center"
                                            HexColor="{Binding TextColorPick, Mode=TwoWay}"/>
                                </StackPanel>
                                <Button Command="{Binding ClearFormattingCommand}" Classes="RibbonBtn"
                                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Format_ClearFormatting}"
                                        behaviours:TooltipBehavior.HotKey="Ctrl+Shift+N"
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M14.06 9l.94.94L5.92 19H5v-.92L14.06 9zm3.6-6c-.25 0-.51.1-.7.29l-1.83 1.83 3.75 3.75 1.83-1.83c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.2-.2-.45-.29-.71-.29zm-3.6 3.19L3 17.25V21h3.75L17.81 9.94l-3.75-3.75z" Width="14" Height="14"/>
                                </Button>
                                <Separator Classes="RibbonDivider"/>
                                <!-- Эффекты текста — A▾ -->
                                <Button Classes="RibbonBtn"
                                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.TextEffect_Title}"
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="{x:Static loc:TextEditorStrings.TextEffect_Outline}"
                                                      Command="{Binding TextOutlineCommand}"/>
                                            <MenuItem Header="{x:Static loc:TextEditorStrings.TextEffect_Shadow}"
                                                      Command="{Binding TextShadowCommand}"/>
                                            <MenuItem Header="{x:Static loc:TextEditorStrings.TextEffect_Reflection}"
                                                      Command="{Binding TextReflectionCommand}"/>
                                            <MenuItem Header="{x:Static loc:TextEditorStrings.TextEffect_Glow}"
                                                      Command="{Binding TextGlowCommand}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <TextBlock Text="A" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentDefaultBrush}"/>
                                        <PathIcon Data="M7 10l5 5 5-5z" Width="8" Height="8"
                                                  Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     АБЗАЦ — развёрнутый
                     ═══════════════════════════════════════════════════════ -->
                <Border Grid.Column="2" Classes="RibbonGroup"
                        IsVisible="{Binding IsParagraphGroupExpanded}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Paragraph_Group}"/>
                            <Button Grid.Column="1" Classes="RibbonGroupSettings"
                                    Click="OnParagraphSettingsClick"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Paragraph_Group}"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <StackPanel Spacing="4" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <SplitButton Classes="RibbonSplit" Command="{Binding BulletListCommand}"
                                             behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.List_Bullet}"
                                             behaviours:TooltipBehavior.HotKey="Ctrl+Shift+L"
                                             behaviours:TooltipBehavior.ShowDelay="700">
                                    <SplitButton.Content>
                                        <PathIcon Data="M4 10.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5zm0-6c-.83 0-1.5.67-1.5 1.5S3.17 7.5 4 7.5 5.5 6.83 5.5 6 4.83 4.5 4 4.5zm0 12c-.83 0-1.5.68-1.5 1.5s.68 1.5 1.5 1.5 1.5-.68 1.5-1.5-.67-1.5-1.5-1.5zM7 19h14v-2H7v2zm0-6h14v-2H7v2zm0-8v2h14V5H7z" Width="14" Height="14"/>
                                    </SplitButton.Content>
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="•  Маркер"  Command="{Binding SelectListTypeCommand}" CommandParameter="Bullet"/>
                                            <MenuItem Header="–  Тире"    Command="{Binding SelectListTypeCommand}" CommandParameter="Dash"/>
                                            <MenuItem Header="▪  Квадрат" Command="{Binding SelectListTypeCommand}" CommandParameter="Square"/>
                                            <MenuItem Header="◦  Круг"    Command="{Binding SelectListTypeCommand}" CommandParameter="Circle"/>
                                            <MenuItem Header="➤  Стрелка" Command="{Binding SelectListTypeCommand}" CommandParameter="Arrow"/>
                                            <Separator/>
                                            <MenuItem Header="Определить новый список…" Click="OnDefineListClick"/>
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                                <SplitButton Classes="RibbonSplit" Command="{Binding NumberedListCommand}"
                                             behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.List_Numbered}"
                                             behaviours:TooltipBehavior.HotKey="Ctrl+Shift+O"
                                             behaviours:TooltipBehavior.ShowDelay="700">
                                    <SplitButton.Content>
                                        <PathIcon Data="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z" Width="14" Height="14"/>
                                    </SplitButton.Content>
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="1.  2.  3."   Command="{Binding SelectListTypeCommand}" CommandParameter="Decimal"/>
                                            <MenuItem Header="01. 02. 03."  Command="{Binding SelectListTypeCommand}" CommandParameter="DecimalLeadingZero"/>
                                            <MenuItem Header="a.  b.  c."   Command="{Binding SelectListTypeCommand}" CommandParameter="LowerAlpha"/>
                                            <MenuItem Header="A.  B.  C."   Command="{Binding SelectListTypeCommand}" CommandParameter="UpperAlpha"/>
                                            <MenuItem Header="i.  ii. iii." Command="{Binding SelectListTypeCommand}" CommandParameter="LowerRoman"/>
                                            <MenuItem Header="I.  II. III." Command="{Binding SelectListTypeCommand}" CommandParameter="UpperRoman"/>
                                            <Separator/>
                                            <MenuItem Header="Определить новый список…" Click="OnDefineListClick"/>
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                                <SplitButton Classes="RibbonSplit" Command="{Binding MultilevelListCommand}"
                                             behaviours:TooltipBehavior.Tip="Многоуровневый список"
                                             behaviours:TooltipBehavior.ShowDelay="700">
                                    <SplitButton.Content>
                                        <PathIcon Data="M3 5h2v2H3V5zm4 0h14v2H7V5zM5 11H3v2h2v-2zm2 0h14v2H7v-2zm-2 6H3v2h2v-2zm2 0h14v2H7v-2z" Width="14" Height="14"/>
                                    </SplitButton.Content>
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="1. → a. → i.  (смешанный)" Command="{Binding SelectMultilevelSchemeCommand}" CommandParameter="mixed"/>
                                            <MenuItem Header="1. → 1. → 1.  (числа)"     Command="{Binding SelectMultilevelSchemeCommand}" CommandParameter="numeric"/>
                                            <MenuItem Header="•  → ◦  → ▪  (маркеры)"    Command="{Binding SelectMultilevelSchemeCommand}" CommandParameter="bullets"/>
                                            <Separator/>
                                            <MenuItem Header="Настроить уровни…" Click="OnMultilevelSettingsClick"/>
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                                <Separator Classes="RibbonDivider"/>
                                <Button Command="{Binding DecreaseIndentCommand}" Classes="RibbonBtn"
                                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Para_Outdent}"
                                        behaviours:TooltipBehavior.HotKey="Shift+Tab"
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M11 17h10v-2H11v2zm-8-5l4 4V8l-4 4zm0 9h18v-2H3v2zM3 3v2h18V3H3zm8 6h10V7H11v2zm0 4h10v-2H11v2z" Width="14" Height="14"/>
                                </Button>
                                <Button Command="{Binding IncreaseIndentCommand}" Classes="RibbonBtn"
                                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Para_Indent}"
                                        behaviours:TooltipBehavior.HotKey="Tab"
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M3 21h18v-2H3v2zm0-4h18v-2H3v2zm0-4h10v-2H3v2zm0-4h10V7H3v2zm8-8v4l4-4H3v2h8V3zm0 0h10v-2H11v2z" Width="14" Height="14"/>
                                </Button>
                                <Separator Classes="RibbonDivider"/>
                                <SplitButton Classes="RibbonSplit"
                                             behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Para_LineSpacing}"
                                             behaviours:TooltipBehavior.ShowDelay="700">
                                    <SplitButton.Content>
                                        <PathIcon Data="M6 7h2.5L5 3.5 1.5 7H4v10H1.5L5 20.5 8.5 17H6V7zm4 2v2h12V9H10zm0 6h12v-2H10v2zm0-4h12v-2H10v2z" Width="14" Height="14"/>
                                    </SplitButton.Content>
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="1.0"  Command="{Binding SetLineSpacingCommand}" CommandParameter="1.0"/>
                                            <MenuItem Header="1.15" Command="{Binding SetLineSpacingCommand}" CommandParameter="1.15"/>
                                            <MenuItem Header="1.5"  Command="{Binding SetLineSpacingCommand}" CommandParameter="1.5"/>
                                            <MenuItem Header="2.0"  Command="{Binding SetLineSpacingCommand}" CommandParameter="2.0"/>
                                            <MenuItem Header="3.0"  Command="{Binding SetLineSpacingCommand}" CommandParameter="3.0"/>
                                            <Separator/>
                                            <MenuItem Header="Другие интервалы…" Click="OnParagraphSettingsClick"/>
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                                <ToggleButton IsChecked="{Binding IsSpaceBefore}" Command="{Binding SpaceBeforeCommand}" Classes="RibbonToggle"
                                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Para_SpaceBefore}"
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M4 6h16v2H4zm4 5h12v2H8zm-4 5h16v2H4z" Width="14" Height="14"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding IsSpaceAfter}" Command="{Binding SpaceAfterCommand}" Classes="RibbonToggle"
                                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Para_SpaceAfter}"
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M4 5h16v2H4zm4 5h12v2H8zm-4 7h16v2H4z" Width="14" Height="14"/>
                                </ToggleButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton IsChecked="{Binding CurrentAlignment, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Left, Mode=OneWay}"
                                              Command="{Binding AlignLeftCommand}" Classes="RibbonToggle"
                                              behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Align_Left}"
                                              behaviours:TooltipBehavior.HotKey="Ctrl+L"
                                              behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M15 15H3v2h12v-2zm0-8H3v2h12V7zM3 13h18v-2H3v2zm0 8h18v-2H3v2zM3 3v2h18V3H3z" Width="14" Height="14"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding CurrentAlignment, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Center, Mode=OneWay}"
                                              Command="{Binding AlignCenterCommand}" Classes="RibbonToggle"
                                              behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Align_Center}"
                                              behaviours:TooltipBehavior.HotKey="Ctrl+E"
                                              behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M7 15v2h10v-2H7zm-4 6h18v-2H3v2zm0-8h18v-2H3v2zm4-6v2h10V7H7zM3 3v2h18V3H3z" Width="14" Height="14"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding CurrentAlignment, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Right, Mode=OneWay}"
                                              Command="{Binding AlignRightCommand}" Classes="RibbonToggle"
                                              behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Align_Right}"
                                              behaviours:TooltipBehavior.HotKey="Ctrl+R"
                                              behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M3 21h18v-2H3v2zm6-4h12v-2H9v2zm-6-4h18v-2H3v2zm6-4h12V7H9v2zM3 3v2h18V3H3z" Width="14" Height="14"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding CurrentAlignment, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Justify, Mode=OneWay}"
                                              Command="{Binding AlignJustifyCommand}" Classes="RibbonToggle"
                                              behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Align_Justify}"
                                              behaviours:TooltipBehavior.HotKey="Ctrl+J"
                                              behaviours:TooltipBehavior.ShowDelay="700">
                                    <PathIcon Data="M3 21h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18V7H3v2zm0-6v2h18V3H3z" Width="14" Height="14"/>
                                </ToggleButton>
                                <Separator Classes="RibbonDivider"/>
                                <!-- Уровень структуры абзаца -->
                                <Button Classes="RibbonBtn"
                                        behaviours:TooltipBehavior.Tip="Уровень структуры"
                                        behaviours:TooltipBehavior.ShowDelay="700">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Основной текст" Foreground="#8A8A8A" Command="{Binding SetOutlineLevelCommand}" CommandParameter="0"/>
                                            <MenuItem Header="Уровень 1" Foreground="#E07B39" Command="{Binding SetOutlineLevelCommand}" CommandParameter="1"/>
                                            <MenuItem Header="Уровень 2" Foreground="#D67D43" Command="{Binding SetOutlineLevelCommand}" CommandParameter="2"/>
                                            <MenuItem Header="Уровень 3" Foreground="#CB7F4E" Command="{Binding SetOutlineLevelCommand}" CommandParameter="3"/>
                                            <MenuItem Header="Уровень 4" Foreground="#C18158" Command="{Binding SetOutlineLevelCommand}" CommandParameter="4"/>
                                            <MenuItem Header="Уровень 5" Foreground="#B68463" Command="{Binding SetOutlineLevelCommand}" CommandParameter="5"/>
                                            <MenuItem Header="Уровень 6" Foreground="#AC866D" Command="{Binding SetOutlineLevelCommand}" CommandParameter="6"/>
                                            <MenuItem Header="Уровень 7" Foreground="#A18877" Command="{Binding SetOutlineLevelCommand}" CommandParameter="7"/>
                                            <MenuItem Header="Уровень 8" Foreground="#978A82" Command="{Binding SetOutlineLevelCommand}" CommandParameter="8"/>
                                            <MenuItem Header="Уровень 9" Foreground="#8C8C8C" Command="{Binding SetOutlineLevelCommand}" CommandParameter="9"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <Panel Width="14" Height="14">
                                            <PathIcon Data="M3 9h12V7H3v2zm0 4h12v-2H3v2zm0 4h12v-2H3v2zm14 0h4v-2h-4v2zm0-10v2h4V7h-4zm0 6h4v-2h-4v2z"
                                                      Width="14" Height="14"
                                                      Foreground="{Binding OutlineLevelBrush}"
                                                      Opacity="{Binding OutlineIconOpacity}"/>
                                            <TextBlock Text="{Binding OutlineLevelDigit}"
                                                       Foreground="{Binding OutlineLevelBrush}"
                                                       FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Panel>
                                        <PathIcon Data="M7 10l5 5 5-5z" Width="8" Height="8" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- АБЗАЦ — свёрнутый -->
                <Border Grid.Column="2" Classes="RibbonGroupCollapsed"
                        IsVisible="{Binding !IsParagraphGroupExpanded}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Paragraph_Group}"/>
                            <Button Grid.Column="1" Classes="RibbonGroupSettings"
                                    Click="OnParagraphSettingsClick"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Paragraph_Group}"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <Button Classes="RibbonBtnLarge" VerticalAlignment="Top"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Paragraph_Group}"
                                behaviours:TooltipBehavior.ShowDelay="700">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="6" Margin="8">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <ToggleButton IsChecked="{Binding IsBulletList}" Command="{Binding BulletListCommand}" Classes="RibbonToggle"
                                                          behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.List_Bullet}" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M4 10.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5zm0-6c-.83 0-1.5.67-1.5 1.5S3.17 7.5 4 7.5 5.5 6.83 5.5 6 4.83 4.5 4 4.5zm0 12c-.83 0-1.5.68-1.5 1.5s.68 1.5 1.5 1.5 1.5-.68 1.5-1.5-.67-1.5-1.5-1.5zM7 19h14v-2H7v2zm0-6h14v-2H7v2zm0-8v2h14V5H7z" Width="14" Height="14"/>
                                            </ToggleButton>
                                            <ToggleButton IsChecked="{Binding IsNumberedList}" Command="{Binding NumberedListCommand}" Classes="RibbonToggle"
                                                          behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.List_Numbered}" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z" Width="14" Height="14"/>
                                            </ToggleButton>
                                            <Separator Classes="RibbonDivider"/>
                                            <Button Command="{Binding DecreaseIndentCommand}" Classes="RibbonBtn"
                                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Para_Outdent}" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M11 17h10v-2H11v2zm-8-5l4 4V8l-4 4zm0 9h18v-2H3v2zM3 3v2h18V3H3zm8 6h10V7H11v2zm0 4h10v-2H11v2z" Width="14" Height="14"/>
                                            </Button>
                                            <Button Command="{Binding IncreaseIndentCommand}" Classes="RibbonBtn"
                                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Para_Indent}" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M3 21h18v-2H3v2zm0-4h18v-2H3v2zm0-4h10v-2H3v2zm0-4h10V7H3v2zm8-8v4l4-4H3v2h8V3zm0 0h10v-2H11v2z" Width="14" Height="14"/>
                                            </Button>
                                            <Separator Classes="RibbonDivider"/>
                                            <Button Command="{Binding SpaceBeforeCommand}" Classes="RibbonBtn"
                                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Para_SpaceBefore}" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M4 6h16v2H4zm4 5h12v2H8zm-4 5h16v2H4z" Width="14" Height="14"/>
                                            </Button>
                                            <Button Command="{Binding SpaceAfterCommand}" Classes="RibbonBtn"
                                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Para_SpaceAfter}" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M4 5h16v2H4zm4 5h12v2H8zm-4 7h16v2H4z" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <ToggleButton IsChecked="{Binding CurrentAlignment, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Left, Mode=OneWay}"
                                                          Command="{Binding AlignLeftCommand}" Classes="RibbonToggle"
                                                          behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Align_Left}" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M15 15H3v2h12v-2zm0-8H3v2h12V7zM3 13h18v-2H3v2zm0 8h18v-2H3v2zM3 3v2h18V3H3z" Width="14" Height="14"/>
                                            </ToggleButton>
                                            <ToggleButton IsChecked="{Binding CurrentAlignment, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Center, Mode=OneWay}"
                                                          Command="{Binding AlignCenterCommand}" Classes="RibbonToggle"
                                                          behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Align_Center}" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M7 15v2h10v-2H7zm-4 6h18v-2H3v2zm0-8h18v-2H3v2zm4-6v2h10V7H7zM3 3v2h18V3H3z" Width="14" Height="14"/>
                                            </ToggleButton>
                                            <ToggleButton IsChecked="{Binding CurrentAlignment, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Right, Mode=OneWay}"
                                                          Command="{Binding AlignRightCommand}" Classes="RibbonToggle"
                                                          behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Align_Right}" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M3 21h18v-2H3v2zm6-4h12v-2H9v2zm-6-4h18v-2H3v2zm6-4h12V7H9v2zM3 3v2h18V3H3z" Width="14" Height="14"/>
                                            </ToggleButton>
                                            <ToggleButton IsChecked="{Binding CurrentAlignment, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=Justify, Mode=OneWay}"
                                                          Command="{Binding AlignJustifyCommand}" Classes="RibbonToggle"
                                                          behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Align_Justify}" behaviours:TooltipBehavior.ShowDelay="700">
                                                <PathIcon Data="M3 21h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18V7H3v2zm0-6v2h18V3H3z" Width="14" Height="14"/>
                                            </ToggleButton>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M3 21h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18V7H3v2zm0-6v2h18V3H3z" Width="20" Height="20"/>
                                <TextBlock Text="{x:Static loc:TextEditorStrings.Paragraph_Group}" FontSize="9" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     СТИЛИ — развёрнутые
                     ═══════════════════════════════════════════════════════ -->
                <Border Grid.Column="3" Classes="RibbonGroup"
                        IsVisible="{Binding IsStylesGroupExpanded}">
                    <StackPanel>
                        <ListBox ItemsSource="{Binding VisibleStyles}"
                                 SelectedItem="{Binding CurrentStyleName}"
                                 Classes="StyleGallery" Height="54"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="StyleCard" Width="62" Height="50" Padding="4 3">
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="{Binding Converter={x:Static converters:StylePreviewSizeConverter.Instance}}"
                                                       FontWeight="{Binding Converter={x:Static converters:StylePreviewWeightConverter.Instance}}"
                                                       FontStyle="{Binding Converter={x:Static converters:StylePreviewStyleConverter.Instance}}"
                                                       Foreground="#1A1A1A" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" FontSize="8" Foreground="#6A6A6A"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Classes="RibbonGroupLabelGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Ribbon_Styles}"/>
                            <Button Grid.Column="1" Classes="RibbonGroupSettings"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Ribbon_Styles}"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="{x:Static loc:TextEditorStrings.Styles_SaveFromCursor}"
                                                  Command="{Binding SaveStyleFromCursorCommand}"/>
                                        <MenuItem Header="{x:Static loc:TextEditorStrings.Styles_EditStyles}"
                                                  Command="{Binding EditStylesCommand}"/>
                                        <MenuItem Header="{x:Static loc:TextEditorStrings.Styles_ResetToDefaults}"
                                                  Command="{Binding ResetStylesToDefaultsCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- СТИЛИ — свёрнутые -->
                <Border Grid.Column="3" Classes="RibbonGroupCollapsed"
                        IsVisible="{Binding !IsStylesGroupExpanded}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Ribbon_Styles}"/>
                            <Button Grid.Column="1" Classes="RibbonGroupSettings"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Ribbon_Styles}"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="{x:Static loc:TextEditorStrings.Styles_SaveFromCursor}"
                                                  Command="{Binding SaveStyleFromCursorCommand}"/>
                                        <MenuItem Header="{x:Static loc:TextEditorStrings.Styles_EditStyles}"
                                                  Command="{Binding EditStylesCommand}"/>
                                        <MenuItem Header="{x:Static loc:TextEditorStrings.Styles_ResetToDefaults}"
                                                  Command="{Binding ResetStylesToDefaultsCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <Button Classes="RibbonBtnLarge" VerticalAlignment="Top"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Ribbon_Styles}"
                                behaviours:TooltipBehavior.ShowDelay="700">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <ListBox ItemsSource="{Binding AvailableStyles}"
                                             SelectedItem="{Binding CurrentStyleName}"
                                             Classes="StyleGallery" Height="54"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="2"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="StyleCard" Width="62" Height="50" Padding="4 3">
                                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="{Binding Converter={x:Static converters:StylePreviewSizeConverter.Instance}}"
                                                                   FontWeight="{Binding Converter={x:Static converters:StylePreviewWeightConverter.Instance}}"
                                                                   FontStyle="{Binding Converter={x:Static converters:StylePreviewStyleConverter.Instance}}"
                                                                   Foreground="#1A1A1A" TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding}" FontSize="8" Foreground="#6A6A6A"
                                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="M20 6h-3V4h-2v2h-3l4 4 4-4zm-8 12h-3v-2H7v2H4l4 4 4-4zm8-4H4v2h16v-2zm0-4H4v2h16v-2z" Width="20" Height="20"/>
                                <TextBlock Text="{x:Static loc:TextEditorStrings.Ribbon_Styles}" FontSize="9" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     ПРАВКА — развёрнутая
                     ═══════════════════════════════════════════════════════ -->
                <Border Grid.Column="4" Classes="RibbonGroup"
                        IsVisible="{Binding IsEditGroupExpanded}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Edit_Group}"/>
                            <Button Grid.Column="1" Classes="RibbonGroupSettings"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Edit_Group}"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                            <Button Command="{Binding FindCommand}" Classes="RibbonBtnLarge" Width="44"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Find_Title}"
                                    behaviours:TooltipBehavior.HotKey="Ctrl+F"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
