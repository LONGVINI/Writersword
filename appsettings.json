{
  // Уровни логирования.
  //
  // Сейчас режим разбора: свой код пишет всё от Debug, чужие сборки молчат до
  // Warning. Когда разбор закончится, вернуть Default на Warning и поднять до
  // Debug только те области, которые в тот момент нужны, — иначе журнал за день
  // работы становится нечитаемым.
  //
  // Комментарии здесь допустимы: файл читает провайдер конфигурации .NET, а он
  // их пропускает.
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      // Разбор истории с пропажей данных у модулей: свой код целиком на Debug.
      //
      // Чужие сборки при этом остаются на Warning, и это не полумера. Debug у
      // Avalonia — это трассировка разметки и привязок на каждый кадр, тысячи
      // строк в секунду; нужная запись в них не находится, а сама запись начинает
      // тормозить отрисовку. Ровно та причина, по которой LogToTrace в Program.cs
      // держат на Warning.
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Avalonia": "Warning",

        // Рендер текста и вёрстка страниц шумят на каждый кадр и к нынешнему
        // разбору отношения не имеют.
        "Writersword.Infrastructure.Rendering": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{ShortSourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "path": "logs/writersword-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [{ShortSourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithShortSourceContext" ]
  }
}
