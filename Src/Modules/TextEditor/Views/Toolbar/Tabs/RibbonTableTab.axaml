<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.Toolbar"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             x:Class="Writersword.Modules.TextEditor.Views.Toolbar.Tabs.RibbonTableTab"
             x:DataType="vm:RibbonTableTabViewModel">

	<UserControl.Styles>

		<Style Selector="Button.RibbonBtn">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="4"/>
			<Setter Property="MinWidth"                   Value="26"/>
			<Setter Property="MinHeight"                  Value="26"/>
			<Setter Property="VerticalAlignment"          Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="Button.RibbonBtn /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="Button.RibbonBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.RibbonBtn:pressed /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<Style Selector="Button.RibbonBtnLarge">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="4 2"/>
			<Setter Property="MinWidth"                   Value="44"/>
			<Setter Property="MinHeight"                  Value="54"/>
			<Setter Property="VerticalAlignment"          Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="Button.RibbonBtnLarge /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="Button.RibbonBtnLarge:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.RibbonBtnLarge:pressed /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<Style Selector="Border.RibbonGroup">
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="4"/>
			<Setter Property="Margin"          Value="2 2 0 2"/>
			<Setter Property="Padding"         Value="4 2"/>
		</Style>
		<Style Selector="TextBlock.RibbonGroupLabel">
			<Setter Property="FontSize"         Value="10"/>
			<Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Grid.RibbonGroupLabelGrid">
			<Setter Property="Margin" Value="0 2 0 0"/>
		</Style>

	</UserControl.Styles>

	<!-- Контекстный цвет заголовка вкладки — оранжевый, как в Word -->
	<ScrollViewer HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled"
                  Height="66">
		<StackPanel Orientation="Horizontal" Spacing="0" Height="66">

			<!-- ── Группа: Строки ──────────────────────────────────────── -->
			<Border Classes="RibbonGroup">
				<DockPanel>
					<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
						<TextBlock Classes="RibbonGroupLabel" Text="Строки"/>
					</Grid>
					<StackPanel Orientation="Horizontal" Spacing="2">

						<Button Command="{Binding AddRowAboveCommand}"
                                Classes="RibbonBtnLarge"
                                behaviours:TooltipBehavior.Tip="Вставить строку выше"
                                behaviours:TooltipBehavior.ShowDelay="700">
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="18" Height="18"
                                          Data="M3 3h18v4H3V3zm0 6h18v2H3V9zm0 4h18v2H3v-2zm0 4h18v2H3v-2zM12 1l-4 4h8l-4-4z"/>
								<TextBlock FontSize="9" Text="Выше" HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding AddRowBelowCommand}"
                                Classes="RibbonBtnLarge"
                                behaviours:TooltipBehavior.Tip="Вставить строку ниже"
                                behaviours:TooltipBehavior.ShowDelay="700">
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="18" Height="18"
                                          Data="M3 3h18v4H3V3zm0 6h18v2H3V9zm0 4h18v2H3v-2zm0 4h18v2H3v-2zM12 23l4-4H8l4 4z"/>
								<TextBlock FontSize="9" Text="Ниже" HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding DeleteRowCommand}"
                                Classes="RibbonBtnLarge"
                                behaviours:TooltipBehavior.Tip="Удалить строку"
                                behaviours:TooltipBehavior.ShowDelay="700">
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="18" Height="18"
                                          Data="M3 3h18v4H3V3zm0 6h18v2H3V9zm0 4h18v2H3v-2zm0 4h18v2H3v-2zM5 19l2 2 2-2-2-2-2 2zm5 0l2 2 2-2-2-2-2 2zm5 0l2 2 2-2-2-2-2 2z"/>
								<TextBlock FontSize="9" Text="Удалить" HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>

					</StackPanel>
				</DockPanel>
			</Border>

			<!-- ── Группа: Столбцы ─────────────────────────────────────── -->
			<Border Classes="RibbonGroup">
				<DockPanel>
					<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
						<TextBlock Classes="RibbonGroupLabel" Text="Столбцы"/>
					</Grid>
					<StackPanel Orientation="Horizontal" Spacing="2">

						<Button Command="{Binding AddColumnLeftCommand}"
                                Classes="RibbonBtnLarge"
                                behaviours:TooltipBehavior.Tip="Вставить столбец слева"
                                behaviours:TooltipBehavior.ShowDelay="700">
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="18" Height="18"
                                          Data="M3 3h4v18H3V3zm6 0h2v18H9V3zm4 0h2v18h-2V3zm4 0h4v18h-4V3zM1 12l4-4v8l-4-4z"/>
								<TextBlock FontSize="9" Text="Слева" HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding AddColumnRightCommand}"
                                Classes="RibbonBtnLarge"
                                behaviours:TooltipBehavior.Tip="Вставить столбец справа"
                                behaviours:TooltipBehavior.ShowDelay="700">
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="18" Height="18"
                                          Data="M3 3h4v18H3V3zm6 0h2v18H9V3zm4 0h2v18h-2V3zm4 0h4v18h-4V3zM23 12l-4 4V8l4 4z"/>
								<TextBlock FontSize="9" Text="Справа" HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding DeleteColumnCommand}"
                                Classes="RibbonBtnLarge"
                                behaviours:TooltipBehavior.Tip="Удалить столбец"
                                behaviours:TooltipBehavior.ShowDelay="700">
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="18" Height="18"
                                          Data="M3 3h4v18H3V3zm6 0h2v18H9V3zm4 0h2v18h-2V3zm4 0h4v18h-4V3zM17 5l2 2 2-2-2-2-2 2zm0 5l2 2 2-2-2-2-2 2zm0 5l2 2 2-2-2-2-2 2z"/>
								<TextBlock FontSize="9" Text="Удалить" HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>

					</StackPanel>
				</DockPanel>
			</Border>

			<!-- ── Группа: Таблица ─────────────────────────────────────── -->
			<Border Classes="RibbonGroup">
				<DockPanel>
					<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
						<TextBlock Classes="RibbonGroupLabel" Text="Таблица"/>
					</Grid>
					<StackPanel Orientation="Horizontal" Spacing="2">

						<Button Command="{Binding DeleteTableCommand}"
                                Classes="RibbonBtnLarge"
                                behaviours:TooltipBehavior.Tip="Удалить таблицу"
                                behaviours:TooltipBehavior.ShowDelay="700">
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="18" Height="18"
                                          Data="M20 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h15c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-8 14H5v-5h7v5zm0-7H5V5h7v5zm8 7h-6v-5h6v5zm0-7h-6V5h6v5z"/>
								<TextBlock FontSize="9" Text="Удалить" HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>

					</StackPanel>
				</DockPanel>
			</Border>

		</StackPanel>
	</ScrollViewer>

</UserControl>
