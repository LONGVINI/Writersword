<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.Toolbar"
             xmlns:converters="using:Writersword.Modules.TextEditor.Converters"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             xmlns:controls="using:Writersword.Styles.UserControls"
             xmlns:shared="using:Writersword.Modules.TextEditor.Views.Shared"
             x:Class="Writersword.Modules.TextEditor.Views.Toolbar.Tabs.RibbonAppearanceTab"
             x:DataType="vm:RibbonAppearanceTabViewModel">

	<!--
	    Вкладка «Вид»: чем залит лист при правке, что лежит вокруг страниц, каким
	    светом и что остаётся на экране в фокусе.

	    Вид листа и фон устроены так же, как группа «Вид чтения» в ленте чтения:
	    одна группа, две строки одной сеткой — значок, подпись, значение. Вид и
	    фон — одно и то же дело: как выглядит лист, — и держать их в двух группах
	    значило делать вид, будто фон живёт отдельно от вида. Свет — тем же
	    столбиком ползунков, что и в чтении.

	    Кнопки, группы, ползунки и списки ленты живут в Styles/Controls/Ribbon.axaml —
	    одни на все вкладки. Список видов плитками — общий с лентой чтения
	    (Views/Shared/ThemeTilePicker): пункты у них одни и те же, и плитка обязана
	    выглядеть одинаково. Здесь только подпись и значок строки.

	    Флажков на вкладке нет. Всё, что включается и выключается, — тумблеры со
	    значком: в полосе высотой в шестьдесят точек флажок с подписью занимает
	    строку целиком, а значок помещается рядом с кнопкой и читается быстрее.
	-->

	<UserControl.Styles>
		<!-- Подпись поля: короткое слово слева от значения. Без неё видно только
		     значение — «Белая», «Кастомное», — и что именно этим задаётся,
		     приходится узнавать наведением. Та же, что и в ленте чтения. -->
		<Style Selector="TextBlock.FieldCaption">
			<Setter Property="FontSize"          Value="10"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Width"             Value="34"/>
		</Style>

		<!-- Значок поля: тем же тоном, что и подпись, чтобы не спорить со
		     значением рядом. -->
		<Style Selector="PathIcon.FieldGlyph">
			<Setter Property="Width"             Value="13"/>
			<Setter Property="Height"            Value="13"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextMutedBrush}"/>
		</Style>

		<!-- Подпись ползунка света: той же ширины, что и в ленте чтения, чтобы
		     ползунки обеих лент начинались на одной отметке. -->
		<Style Selector="TextBlock.LightLabel">
			<Setter Property="FontSize"          Value="10"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Width"             Value="58"/>
		</Style>
	</UserControl.Styles>

	<controls:RibbonScrollContainer x:Name="ScrollContainer">
		<controls:RibbonScrollContainer.RibbonContent>
			<StackPanel Orientation="Horizontal">

				<!-- ═══ ВИД ЛИСТА ═══════════════════════════════════════════
				     Вид, заливка поля и картинка — это всё одно и то же: как
				     выглядит лист. Две строки одной сеткой: значки, подписи и
				     значения встают в столбцы. Обе строки высотой 24 с зазором 4,
				     как в группе «Вид чтения». -->
				<Border Classes="RibbonGroup" IsVisible="{Binding IsThemeGroupExpanded}">
					<DockPanel>
						<TextBlock DockPanel.Dock="Bottom"
						           Classes="RibbonGroupLabel"
						           Text="Вид листа"/>
						<Grid ColumnDefinitions="Auto Auto 120"
						      RowDefinitions="Auto Auto"
						      ColumnSpacing="5" RowSpacing="4"
						      VerticalAlignment="Center">

							<!-- Виды. Плитки с видами открываются из списка, окно видов —
							     кнопкой внизу этого списка. -->
							<PathIcon Grid.Row="0" Grid.Column="0" Classes="FieldGlyph"
							          Data="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
							<TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldCaption" Text="Вид"/>

							<!-- Ширина кнопки задана и не зависит от имени вида: имя человек
							     придумывает сам, и длинное растягивало кнопку, сдвигая всё,
							     что стоит в ленте правее. Не поместилось — обрежется
							     многоточием, полное имя есть в списке. -->
							<Button Grid.Row="0" Grid.Column="2"
							        Classes="RibbonBtn"
							        MinHeight="24" Height="24" Width="120"
							        Padding="8 0"
							        HorizontalContentAlignment="Stretch"
							        behaviours:TooltipBehavior.Tip="Вид листа"
							        behaviours:TooltipBehavior.Description="Чем залит лист при правке: цвет бумаги, цвет букв, поле вокруг и свет. «Без вида» — белая бумага и серое поле. Правка ползунками или фоном на ходу превращает вид в «Кастомное» — сохранить её под именем можно в окне видов">
								<Grid ColumnDefinitions="* Auto">
									<TextBlock Grid.Column="0"
									           Text="{Binding SelectedThemeItem.Label}"
									           FontSize="11"
									           VerticalAlignment="Center"
									           TextTrimming="CharacterEllipsis"/>
									<PathIcon Grid.Column="1" Width="8" Height="8" Margin="6 0 0 0"
									          VerticalAlignment="Center"
									          Data="M7 10l5 5 5-5z"/>
								</Grid>

								<Button.Flyout>
									<Flyout Placement="Bottom">
										<Border Padding="8">
											<!-- Плитки видов — общий список с лентой чтения: вид один, и
											     выбирать его нужно одинаково, где бы список ни открыли. -->
											<shared:ThemeTilePicker Items="{Binding ThemeItems}"
											                        SelectCommand="{Binding SelectThemeCommand}"
											                        ConfigureCommand="{Binding OpenThemeEditorCommand}"/>
										</Border>
									</Flyout>
								</Button.Flyout>
							</Button>

							<!-- Фон вокруг листа. Цвет — тем же кружком, что и любой цвет в
							     программе; рядом загрузка картинки и сброс. Картинка, как и
							     цвет, правит вид на ходу: он становится «Кастомным»,
							     сохранить можно в окне видов. Без вида фону не на чем
							     лежать — строка тогда недоступна. -->
							<PathIcon Grid.Row="1" Grid.Column="0" Classes="FieldGlyph"
							          Data="M12 22C6.49 22 2 17.51 2 12S6.49 2 12 2s10 4.04 10 9c0 3.31-2.69 6-6 6h-1.77c-.28 0-.5.22-.5.5 0 .12.05.23.13.33.41.47.64 1.06.64 1.67 0 1.38-1.12 2.5-2.5 2.5zm0-18c-4.41 0-8 3.59-8 8s3.59 8 8 8c.28 0 .5-.22.5-.5 0-.16-.08-.28-.14-.35-.41-.46-.63-1.05-.63-1.65 0-1.38 1.12-2.5 2.5-2.5H16c2.21 0 4-1.79 4-4 0-3.86-3.59-7-8-7z"/>
							<TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldCaption" Text="Фон"/>

							<StackPanel Grid.Row="1" Grid.Column="2"
							            Orientation="Horizontal" Spacing="4"
							            VerticalAlignment="Center"
							            IsEnabled="{Binding IsThemeApplied}">
								<controls:ColorPickerButton Width="20" Height="20"
								                            Margin="2 0"
								                            VerticalAlignment="Center"
								                            ToolTip.Tip="{x:Null}"
								                            HexColor="{Binding BackdropColorHex, Mode=TwoWay}"
								                            behaviours:TooltipBehavior.Tip="Цвет фона вокруг листа"
								                            behaviours:TooltipBehavior.Description="Цвет или градиент — тот же выбор, что и у любого другого цвета в программе. Пока своего нет, фон выводится из бумаги: под светлым листом темнее, под тёмным чуть светлее"/>
								<Button Classes="RibbonBtn"
								        Width="24" Height="24" MinWidth="24" MinHeight="24"
								        Padding="0"
								        Click="OnLoadBackdropImageClick"
								        behaviours:TooltipBehavior.Tip="Загрузить картинку фона"
								        behaviours:TooltipBehavior.Description="Картинка с диска ляжет вокруг листа вместо цвета. Как она ложится и насколько плотная, настраивается в окне видов. Вид при этом становится «Кастомным» — сохранить его под именем можно там же">
									<PathIcon Width="12" Height="12"
									          Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
								</Button>
								<Button Classes="RibbonBtn"
								        Width="24" Height="24" MinWidth="24" MinHeight="24"
								        Padding="0"
								        Command="{Binding ResetBackdropCommand}"
								        behaviours:TooltipBehavior.Tip="Вернуть фон к бумаге"
								        behaviours:TooltipBehavior.Description="Убирает свой цвет и картинку: фон снова выводится из цвета бумаги">
									<PathIcon Width="12" Height="12"
									          Data="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9z"/>
								</Button>
							</StackPanel>
						</Grid>
					</DockPanel>
				</Border>

				<!-- ВИД ЛИСТА — свёрнутая. Во флайауте то же, что и в развёрнутой
				     группе: плитки видов, «Настроить виды» и строка фона. Узкое окно
				     меняет место кнопки, а не то, как выбирают вид. -->
				<Border Classes="RibbonGroupCollapsed" IsVisible="{Binding !IsThemeGroupExpanded}">
					<DockPanel>
						<TextBlock DockPanel.Dock="Bottom"
						           Classes="RibbonGroupLabel"
						           Text="Вид листа"/>
						<Button Classes="RibbonBtnLarge"
						        behaviours:TooltipBehavior.Tip="Вид листа">
							<Button.Flyout>
								<Flyout Placement="Bottom">
									<Border Padding="8">
										<Grid RowDefinitions="Auto Auto" Width="228">
											<shared:ThemeTilePicker Grid.Row="0"
											                        Items="{Binding ThemeItems}"
											                        SelectCommand="{Binding SelectThemeCommand}"
											                        ConfigureCommand="{Binding OpenThemeEditorCommand}"/>

											<!-- Строка фона — та же, что в развёрнутой группе. -->
											<StackPanel Grid.Row="1" Margin="0 10 0 0"
											            Orientation="Horizontal" Spacing="5"
											            IsEnabled="{Binding IsThemeApplied}">
												<PathIcon Classes="FieldGlyph"
												          Data="M12 22C6.49 22 2 17.51 2 12S6.49 2 12 2s10 4.04 10 9c0 3.31-2.69 6-6 6h-1.77c-.28 0-.5.22-.5.5 0 .12.05.23.13.33.41.47.64 1.06.64 1.67 0 1.38-1.12 2.5-2.5 2.5zm0-18c-4.41 0-8 3.59-8 8s3.59 8 8 8c.28 0 .5-.22.5-.5 0-.16-.08-.28-.14-.35-.41-.46-.63-1.05-.63-1.65 0-1.38 1.12-2.5 2.5-2.5H16c2.21 0 4-1.79 4-4 0-3.86-3.59-7-8-7z"/>
												<TextBlock Classes="FieldCaption" Text="Фон"/>
												<controls:ColorPickerButton Width="20" Height="20"
												                            Margin="2 0"
												                            VerticalAlignment="Center"
												                            ToolTip.Tip="{x:Null}"
												                            HexColor="{Binding BackdropColorHex, Mode=TwoWay}"
												                            behaviours:TooltipBehavior.Tip="Цвет фона вокруг листа"/>
												<Button Classes="RibbonBtn"
												        Width="24" Height="24" MinWidth="24" MinHeight="24"
												        Padding="0"
												        Click="OnLoadBackdropImageClick"
												        behaviours:TooltipBehavior.Tip="Загрузить картинку фона">
													<PathIcon Width="12" Height="12"
													          Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
												</Button>
												<Button Classes="RibbonBtn"
												        Width="24" Height="24" MinWidth="24" MinHeight="24"
												        Padding="0"
												        Command="{Binding ResetBackdropCommand}"
												        behaviours:TooltipBehavior.Tip="Вернуть фон к бумаге">
													<PathIcon Width="12" Height="12"
													          Data="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9z"/>
												</Button>
											</StackPanel>
										</Grid>
									</Border>
								</Flyout>
							</Button.Flyout>
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="20" Height="20"
								          Data="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
								<TextBlock Text="{Binding ThemeName}"
								           FontSize="9"
								           MaxWidth="56"
								           TextTrimming="CharacterEllipsis"
								           TextAlignment="Center"/>
							</StackPanel>
						</Button>
					</DockPanel>
				</Border>

				<!-- ═══ СВЕТ ════════════════════════════════════════════════
				     Три параметра столбиком, как в ленте чтения: они одного рода, и
				     ставить их в ряд значит растянуть ленту втрое без всякой пользы.
				     Рядом — «Сброс»: вернуть свет таким, каким его задаёт вид. -->
				<Border Classes="RibbonGroup" IsVisible="{Binding IsLightGroupExpanded}">
					<DockPanel>
						<TextBlock DockPanel.Dock="Bottom"
						           Classes="RibbonGroupLabel"
						           Text="Свет"/>
						<StackPanel Orientation="Horizontal" Spacing="4"
						            VerticalAlignment="Center"
						            IsEnabled="{Binding IsThemeApplied}">
							<StackPanel Spacing="1" VerticalAlignment="Center">
								<StackPanel Orientation="Horizontal" Spacing="4"
								            behaviours:TooltipBehavior.Tip="Яркость"
								            behaviours:TooltipBehavior.Description="Приглушает свет над листом, не трогая цвета документа">
									<TextBlock Classes="LightLabel" Text="Яркость"/>
									<Slider Classes="RibbonSlider" Width="104"
									        Minimum="0.35" Maximum="1"
									        Value="{Binding Brightness, Mode=TwoWay}"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="4"
								            behaviours:TooltipBehavior.Tip="Контраст"
								            behaviours:TooltipBehavior.Description="Разводит текст и бумагу. Меньше — буквы мягче, больше — резче. Работает и на тёмной бумаге">
									<TextBlock Classes="LightLabel" Text="Контраст"/>
									<Slider Classes="RibbonSlider" Width="104"
									        Minimum="0.6" Maximum="1.6"
									        Value="{Binding Contrast, Mode=TwoWay}"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="4"
								            behaviours:TooltipBehavior.Tip="Тёплота"
								            behaviours:TooltipBehavior.Description="Убирает синеву, как ночной режим экрана. Помогает писать перед сном">
									<TextBlock Classes="LightLabel" Text="Тёплота"/>
									<Slider Classes="RibbonSlider" Width="104"
									        Minimum="0" Maximum="1"
									        Value="{Binding Warmth, Mode=TwoWay}"/>
								</StackPanel>
							</StackPanel>
							<Button Classes="RibbonBtn"
							        Padding="6 3"
							        Command="{Binding ResetLightCommand}"
							        behaviours:TooltipBehavior.Tip="Вернуть свет к обычному"
							        Content="Сброс"/>
						</StackPanel>
					</DockPanel>
				</Border>

				<!-- СВЕТ — свёрнутая -->
				<Border Classes="RibbonGroupCollapsed" IsVisible="{Binding !IsLightGroupExpanded}">
					<DockPanel>
						<TextBlock DockPanel.Dock="Bottom"
						           Classes="RibbonGroupLabel"
						           Text="Свет"/>
						<Button Classes="RibbonBtnLarge"
						        behaviours:TooltipBehavior.Tip="Свет">
							<Button.Flyout>
								<Flyout Placement="Bottom">
									<StackPanel Orientation="Horizontal" Spacing="4" Margin="2"
									            IsEnabled="{Binding IsThemeApplied}">
										<StackPanel Spacing="1" VerticalAlignment="Center">
											<StackPanel Orientation="Horizontal" Spacing="4">
												<TextBlock Classes="LightLabel" Text="Яркость"/>
												<Slider Classes="RibbonSlider" Width="104"
												        Minimum="0.35" Maximum="1"
												        Value="{Binding Brightness, Mode=TwoWay}"/>
											</StackPanel>
											<StackPanel Orientation="Horizontal" Spacing="4">
												<TextBlock Classes="LightLabel" Text="Контраст"/>
												<Slider Classes="RibbonSlider" Width="104"
												        Minimum="0.6" Maximum="1.6"
												        Value="{Binding Contrast, Mode=TwoWay}"/>
											</StackPanel>
											<StackPanel Orientation="Horizontal" Spacing="4">
												<TextBlock Classes="LightLabel" Text="Тёплота"/>
												<Slider Classes="RibbonSlider" Width="104"
												        Minimum="0" Maximum="1"
												        Value="{Binding Warmth, Mode=TwoWay}"/>
											</StackPanel>
										</StackPanel>
										<Button Classes="RibbonBtn"
										        Padding="6 3"
										        Command="{Binding ResetLightCommand}"
										        behaviours:TooltipBehavior.Tip="Вернуть свет к обычному"
										        Content="Сброс"/>
									</StackPanel>
								</Flyout>
							</Button.Flyout>
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Width="20" Height="20"
								          Data="M12 9a3 3 0 100 6 3 3 0 000-6zm0-7l2.39 3.42 4.18-.02-.02 4.18L22 12l-3.45 2.42.02 4.18-4.18-.02L12 22l-2.39-3.42-4.18.02.02-4.18L2 12l3.45-2.42-.02-4.18 4.18.02L12 2z"/>
								<TextBlock Text="Свет" FontSize="9" TextAlignment="Center"/>
							</StackPanel>
						</Button>
					</DockPanel>
				</Border>

				<!-- ═══ ПОКАЗ ═══════════════════════════════════════════════ -->
				<Border Classes="RibbonGroup" IsVisible="{Binding IsShowGroupExpanded}">
					<DockPanel>
						<TextBlock DockPanel.Dock="Bottom"
						           Classes="RibbonGroupLabel"
						           Text="Показ"/>
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
							<ToggleButton Classes="RibbonToggle RibbonToggleLarge"
							              IsChecked="{Binding ShowRuler, Mode=TwoWay}"
							              behaviours:TooltipBehavior.Tip="Линейки">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Width="18" Height="18"
									          Data="M20 6H4a2 2 0 00-2 2v8a2 2 0 002 2h16a2 2 0 002-2V8a2 2 0 00-2-2zm0 10H4V8h2v4h2V8h2v4h2V8h2v4h2V8h2v8z"/>
									<TextBlock Text="Линейка" FontSize="9" TextAlignment="Center"/>
								</StackPanel>
							</ToggleButton>
							<ToggleButton Classes="RibbonToggle RibbonToggleLarge"
							              IsChecked="{Binding ShowStatusBar, Mode=TwoWay}"
							              behaviours:TooltipBehavior.Tip="Строка состояния">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Width="18" Height="18"
									          Data="M3 5h18v2H3V5zm0 6h18v2H3v-2zm0 6h12v2H3v-2z"/>
									<TextBlock Text="Состояние" FontSize="9" TextAlignment="Center"/>
								</StackPanel>
							</ToggleButton>

							<Separator Classes="RibbonDivider"/>

							<!-- Цвет каретки. Выключено — каретка берёт цвет у текста,
							     который пишет, и видна на любом листе сама собой. Включают
							     это те, кому на тёмном листе каретка сливается со строкой,
							     которую как раз и правят. Палитра сама включает тумблер:
							     к ней тянутся тогда, когда цвет и нужен. -->
							<StackPanel Spacing="2" VerticalAlignment="Center">
								<ToggleButton Classes="RibbonToggle"
								              MinWidth="24" MinHeight="17"
								              Padding="0"
								              IsChecked="{Binding IsCaretColorCustom, Mode=TwoWay}"
								              behaviours:TooltipBehavior.Tip="Свой цвет каретки"
								              behaviours:TooltipBehavior.Description="Выключено — каретка берёт цвет у текста, который пишет, и меняется вместе с ним. Включено — она всегда того цвета, что выбран рядом">
									<PathIcon Width="12" Height="12"
									          Data="M11 4h2v16h-2V4zM8 4h2v2H8V4zm6 0h2v2h-2V4zM8 18h2v2H8v-2zm6 0h2v2h-2v-2z"/>
								</ToggleButton>
								<controls:ColorPickerButton Width="24" Height="17"
								                            HexColor="{Binding CaretColor, Mode=TwoWay}"
								                            behaviours:TooltipBehavior.Tip="Цвет каретки"/>
							</StackPanel>
						</StackPanel>
					</DockPanel>
				</Border>

				<!-- ═══ ФОКУС И ЭКРАН ═══════════════════════════════════════
				     Фокус убирает лишнее внутри окна, экран забирает окну весь
				     монитор. Три значка справа — что именно уезжает в фокусе. -->
				<Border Classes="RibbonGroup">
					<DockPanel>
						<TextBlock DockPanel.Dock="Bottom"
						           Classes="RibbonGroupLabel"
						           Text="Фокус"/>
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
							<ToggleButton Classes="RibbonToggle RibbonToggleLarge"
							              IsChecked="{Binding IsFocusMode, Mode=TwoWay}"
							              behaviours:TooltipBehavior.Tip="Фокус"
							              behaviours:TooltipBehavior.Description="Убирает верх и оставляет рукопись. Лента возвращается язычком у правого края, выход — Esc">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Width="20" Height="20"
									          Data="M5 5h5V3H3v7h2V5zm14 0v5h2V3h-7v2h5zM5 19v-5H3v7h7v-2H5zm14 0h-5v2h7v-7h-2v5z"/>
									<TextBlock Text="Фокус" FontSize="9" TextAlignment="Center"/>
								</StackPanel>
							</ToggleButton>

							<ToggleButton Classes="RibbonToggle RibbonToggleLarge"
							              IsChecked="{Binding IsFullscreen, Mode=TwoWay}"
							              behaviours:TooltipBehavior.Tip="Экран"
							              behaviours:TooltipBehavior.Description="Правка во весь экран: окно забирает монитор целиком, оболочка приложения уходит">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Width="20" Height="20"
									          Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
									<TextBlock Text="Экран" FontSize="9" TextAlignment="Center"/>
								</StackPanel>
							</ToggleButton>

							<!-- Что уезжает в фокусе. Значками, а не подписями:
							     подписи занимали строку каждая и выдавливали
							     ленту за край окна. -->
							<StackPanel Spacing="2" VerticalAlignment="Center">
								<ToggleButton Classes="RibbonToggle"
								              MinWidth="24" MinHeight="17"
								              Padding="0"
								              IsChecked="{Binding FocusHidesRuler, Mode=TwoWay}"
								              behaviours:TooltipBehavior.Tip="В фокусе убирать линейки">
									<PathIcon Width="12" Height="12"
									          Data="M20 6H4a2 2 0 00-2 2v8a2 2 0 002 2h16a2 2 0 002-2V8a2 2 0 00-2-2zm0 10H4V8h2v4h2V8h2v4h2V8h2v4h2V8h2v8z"/>
								</ToggleButton>
								<ToggleButton Classes="RibbonToggle"
								              MinWidth="24" MinHeight="17"
								              Padding="0"
								              IsChecked="{Binding FocusHidesStatusBar, Mode=TwoWay}"
								              behaviours:TooltipBehavior.Tip="В фокусе убирать строку состояния">
									<PathIcon Width="12" Height="12"
									          Data="M3 5h18v2H3V5zm0 6h18v2H3v-2zm0 6h12v2H3v-2z"/>
								</ToggleButton>
								<ToggleButton Classes="RibbonToggle"
								              MinWidth="24" MinHeight="17"
								              Padding="0"
								              IsChecked="{Binding FocusRibbonOnHover, Mode=TwoWay}"
								              behaviours:TooltipBehavior.Tip="В фокусе возвращать ленту наведением к верхнему краю">
									<PathIcon Width="12" Height="12"
									          Data="M12 8l-6 6h12l-6-6z"/>
								</ToggleButton>
							</StackPanel>
						</StackPanel>
					</DockPanel>
				</Border>

			</StackPanel>
		</controls:RibbonScrollContainer.RibbonContent>
	</controls:RibbonScrollContainer>

</UserControl>
