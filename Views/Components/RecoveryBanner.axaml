<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.ViewModels"
             xmlns:loc="using:Writersword.Resources.Localization"
             x:Class="Writersword.Views.Components.RecoveryBanner"
             x:DataType="vm:RecoveryBannerViewModel">

	<Border Background="{DynamicResource BgPanelBrush}"
            Padding="12,8"
            BorderThickness="0,0,0,2"
            BorderBrush="{DynamicResource BorderDefaultBrush}">

		<Grid ColumnDefinitions="*,Auto">

			<!-- Левая часть: информация -->
			<StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">

				<!-- Заголовок -->
				<TextBlock FontSize="13" FontWeight="Bold">
					<Run Text="{Binding CurrentVersionText}"
                         Foreground="{Binding CurrentVersionColor}"/>
				</TextBlock>

				<!-- Даты -->
				<Grid ColumnDefinitions="Auto,Auto,Auto"
                      RowDefinitions="Auto,Auto">

					<!-- Автосохранение -->
					<TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{x:Static loc:Strings.AutoSave_Time_AutoSave}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               Margin="0,0,8,3"/>
					<TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding CacheDate, StringFormat='dd.MM.yyyy HH:mm'}"
                               FontWeight="{Binding CacheFontWeight}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="0,0,6,3"/>
					<TextBlock Grid.Row="0" Grid.Column="2"
                               Text="◀"
                               Foreground="#FFA500"
                               FontWeight="Bold"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,0,3"
                               IsVisible="{Binding IsViewingCache}"/>

					<!-- Сохранённая -->
					<TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{x:Static loc:Strings.AutoSave_Time_Saved}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               Margin="0,0,8,0"/>
					<TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding SaveDate, StringFormat='dd.MM.yyyy HH:mm'}"
                               FontWeight="{Binding SavedFontWeight}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="0,0,6,0"/>
					<TextBlock Grid.Row="1" Grid.Column="2"
                               Text="◀"
                               Foreground="#00C853"
                               FontWeight="Bold"
                               FontSize="12"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsViewingSaved}"/>

				</Grid>

			</StackPanel>

			<!-- Правая часть: кнопки -->
			<StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">

				<!-- Переключить (всегда видна) -->
				<Button Content="{x:Static loc:Strings.Recovery_Button_Switch}"
                        Command="{Binding SwitchVersionCommand}"
                        Background="{DynamicResource BgHoverBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Padding="12,6"
                        FontSize="12"/>

				<!-- Сохранить (только когда смотрим КЕШ) -->
				<Button Content="{x:Static loc:Strings.Recovery_Button_Save}"
                        Command="{Binding SaveCommand}"
                        Background="#00C853"
                        Foreground="White"
                        Padding="12,6"
                        FontSize="12"
                        IsVisible="{Binding IsViewingCache}"/>

				<!-- Удалить кеш (всегда видна) -->
				<Button Content="{x:Static loc:Strings.Recovery_Button_DeleteCache}"
                        Command="{Binding DiscardCommand}"
                        Background="#D32F2F"
                        Foreground="White"
                        Padding="12,6"
                        FontSize="12"/>

			</StackPanel>

		</Grid>

	</Border>

</UserControl>