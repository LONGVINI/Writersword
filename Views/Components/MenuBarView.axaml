<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.ViewModels.Components"
             xmlns:loc="using:Writersword.Resources.Localization"
             x:Class="Writersword.Views.Components.MenuBarView"
             x:DataType="vm:MenuBarViewModel"
             x:Name="MenuBarViewRoot">

	<!-- Главное меню -->
	<Menu x:Name="MainMenu" Background="#2D2D30" Padding="5,3">

		<!-- FILE -->
		<MenuItem Header="{x:Static loc:Strings.Menu_File}"
		          Foreground="#F0F0F0"
		          FontSize="13">

			<MenuItem Header="{x:Static loc:Strings.Menu_File_NewProject}"
			          InputGesture="Ctrl+N"
			          Command="{Binding NewProjectCommand}"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_File_OpenProject}"
			          InputGesture="Ctrl+O"
			          Command="{Binding OpenProjectCommand}"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_File_RecentProjects}"
					  ItemsSource="{Binding RecentProjects}">
				<MenuItem.Styles>
					<Style Selector="MenuItem > MenuItem">
						<Setter Property="Header" Value="{Binding ProjectName}"/>
						<Setter Property="Command" Value="{Binding #MenuBarViewRoot.DataContext.OpenRecentProjectCommand}"/>
						<Setter Property="CommandParameter" Value="{Binding FilePath}"/>
					</Style>
				</MenuItem.Styles>
			</MenuItem>

			<Separator/>

			<MenuItem Header="{x:Static loc:Strings.Menu_File_Save}"
			          InputGesture="Ctrl+S"
			          Command="{Binding SaveProjectCommand}"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_File_SaveAs}"
			          InputGesture="Ctrl+Shift+S"
			          Command="{Binding SaveAsProjectCommand}"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_File_SaveAll}"
					  InputGesture="Ctrl+Alt+S"
					  Command="{Binding SaveAllProjectsCommand}"/>

			<Separator/>

			<MenuItem Header="{x:Static loc:Strings.Menu_File_CloseTab}"
					  InputGesture="Ctrl+W"
					  Command="{Binding CloseTabCommand}"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_File_CloseAllTabs}"
					  Command="{Binding CloseAllTabsCommand}"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_File_CloseOtherTabs}"
					  Command="{Binding CloseOtherTabsCommand}"/>

			<Separator/>

			<MenuItem Header="{x:Static loc:Strings.Menu_File_Settings}"
					  InputGesture="Ctrl+,"
					  Command="{Binding OpenSettingsCommand}"/>

			<Separator/>

			<MenuItem Header="{x:Static loc:Strings.Menu_File_Exit}"
			          Command="{Binding ExitCommand}"/>
		</MenuItem>

		<!-- EDIT -->
		<MenuItem Header="{x:Static loc:Strings.Menu_Edit}"
		          Foreground="#F0F0F0"
		          FontSize="13">

			<MenuItem Header="{x:Static loc:Strings.Menu_Edit_Undo}"
			          InputGesture="Ctrl+Z"
			          IsEnabled="False"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_Edit_Redo}"
			          InputGesture="Ctrl+Y"
			          IsEnabled="False"/>

			<Separator/>

			<MenuItem Header="{x:Static loc:Strings.Menu_Edit_Cut}"
			          InputGesture="Ctrl+X"
			          IsEnabled="False"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_Edit_Copy}"
			          InputGesture="Ctrl+C"
			          IsEnabled="False"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_Edit_Paste}"
			          InputGesture="Ctrl+V"
			          IsEnabled="False"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_Edit_SelectAll}"
			          InputGesture="Ctrl+A"
			          IsEnabled="False"/>

			<Separator/>

			<MenuItem Header="{x:Static loc:Strings.Menu_Edit_Find}"
			          InputGesture="Ctrl+F"
			          IsEnabled="False"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_Edit_FindReplace}"
			          InputGesture="Ctrl+H"
			          IsEnabled="False"/>
		</MenuItem>

		<!-- VIEW -->
		<MenuItem Header="{x:Static loc:Strings.Menu_View}"
		          Foreground="#F0F0F0"
		          FontSize="13">

			<!-- WorkModes -->
			<MenuItem Header="{x:Static loc:Strings.Menu_View_WorkModes}"
			          ItemsSource="{Binding AllWorkModes}">
				<MenuItem.ItemTemplate>
					<DataTemplate>
						<MenuItem Command="{Binding $parent[UserControl].DataContext.ToggleWorkModeCommand}"
						          CommandParameter="{Binding WorkModeId}">
							<MenuItem.Header>
								<StackPanel Orientation="Horizontal" Spacing="5">
									<TextBlock Text="✓"
									           IsVisible="{Binding IsChecked}"
									           FontWeight="Bold"
									           Width="15"/>
									<TextBlock Text="{Binding Icon}"/>
									<TextBlock Text="{Binding Name}"/>
								</StackPanel>
							</MenuItem.Header>
						</MenuItem>
					</DataTemplate>
				</MenuItem.ItemTemplate>
			</MenuItem>

			<!-- Modules -->
			<MenuItem Header="{x:Static loc:Strings.Menu_View_Modules}"
					  ItemsSource="{Binding AllModules}"
					  x:Name="ModulesMenuItem">
				<MenuItem.ItemTemplate>
					<DataTemplate>
						<MenuItem Header="{Binding Name}"
								  Command="{Binding #MenuBarViewRoot.DataContext.ToggleModuleCommand}"
								  CommandParameter="{Binding ModuleType}"
								  IsEnabled="{Binding IsEnabled}">
							<MenuItem.Icon>
								<StackPanel Orientation="Horizontal" Spacing="5">
									<TextBlock Text="✓"
											   IsVisible="{Binding IsChecked}"
											   FontWeight="Bold"/>
									<TextBlock Text="{Binding Icon}"/>
								</StackPanel>
							</MenuItem.Icon>
						</MenuItem>
					</DataTemplate>
				</MenuItem.ItemTemplate>
			</MenuItem>
		</MenuItem>

		<!-- WORKSPACE -->
		<MenuItem Header="{x:Static loc:Strings.Menu_Workspace}"
				  Foreground="#F0F0F0"
				  FontSize="13">
	
			<!-- Сохранить для типа проекта (глобальная конфигурация) -->
			<MenuItem Header="{x:Static loc:Strings.Menu_Workspace_SaveForType}"
					  Command="{Binding SaveWorkspaceGlobalCommand}"
					  IsEnabled="{Binding HasActiveTab}"/>
	
			<Separator Background="#3F3F46" Height="1" Margin="0,2"/>
	
			<!-- Сбросить до глобальной конфигурации -->
			<MenuItem Header="{x:Static loc:Strings.Menu_Workspace_ResetToGlobal}"
					  Command="{Binding ResetWorkspaceToGlobalCommand}"
					  IsEnabled="{Binding HasActiveTab}"/>
	
			<!-- Сбросить до дефолтной конфигурации -->
			<MenuItem Header="{x:Static loc:Strings.Menu_Workspace_ResetToDefault}"
					  Command="{Binding ResetWorkspaceToDefaultCommand}"
					  IsEnabled="{Binding HasActiveTab}"/>
		</MenuItem>

		<!-- TOOLS -->
		<MenuItem Header="{x:Static loc:Strings.Menu_Tools}"
		          Foreground="#F0F0F0"
		          FontSize="13">

			<MenuItem Header="{x:Static loc:Strings.Menu_Tools_Statistics}"
			          IsEnabled="False"/>
		</MenuItem>

		<!-- HELP -->
		<MenuItem Header="{x:Static loc:Strings.Menu_Help}"
		          Foreground="#F0F0F0"
		          FontSize="13">

			<MenuItem Header="{x:Static loc:Strings.Menu_Help_Documentation}"
			          InputGesture="F1"
			          IsEnabled="False"/>

			<MenuItem Header="{x:Static loc:Strings.Menu_Help_CheckUpdates}"
			          IsEnabled="False"/>

			<Separator/>

			<MenuItem Header="{x:Static loc:Strings.Menu_Help_About}"
			          IsEnabled="False"/>
		</MenuItem>

	</Menu>

</UserControl>