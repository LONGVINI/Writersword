<Project Sdk="Microsoft.NET.Sdk">

	<!-- ========================================
       МОБИЛЬНАЯ ГОЛОВА
       ========================================
       Отдельный проект, а не второй TargetFramework у существующих.

       Причина: десктопный Writersword.csproj несёт Avalonia.Desktop, Dock и
       обращения к user32, которым на телефоне делать нечего, а мультитаргет
       протащил бы условную компиляцию через весь код ради нуля выгоды.
       Здесь же переиспользуется ровно то, что переносимо, — Writersword.Core.

       На десктопную сборку этот проект не влияет: он не входит в неё
       ни одной ссылкой, и Avalonia.Android в её вывод не попадает.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0-android36.0</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<AssemblyName>Writersword.Android</AssemblyName>
		<RootNamespace>Writersword.Mobile</RootNamespace>

		<ApplicationId>com.writersword.app</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<!-- APK, а не AAB: пакет ставится на своё устройство напрямую через
		     adb, а формат AAB нужен только для публикации в магазине. -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	</PropertyGroup>

	<!-- HotAvalonia приезжает из Directory.Build.props всем проектам с XAML.
	     Горячая перезагрузка рассчитана на десктопный процесс с доступом к
	     исходникам и на устройстве смысла не имеет, поэтому убирается здесь,
	     а не правкой общего файла. -->
	<ItemGroup>
		<PackageReference Remove="HotAvalonia" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Android" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
		<PackageReference Include="Serilog" Version="4.3.2-dev-02419" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Модуль редактора собран под net10.0, а net10.0-android надстроен над
		     ним, поэтому ссылка прямая: отдельной мобильной сборки модуля не
		     нужно. Лента и оверлеи при этом приезжают вместе с ним и на телефоне
		     не используются — читалке нужны только модель, раскладка и Skia. -->
		<ProjectReference Include="..\Src\Writersword.Core.csproj" />
		<ProjectReference Include="..\Src\Modules\TextEditor\Writersword.TextEditor.csproj" />
	</ItemGroup>

</Project>
