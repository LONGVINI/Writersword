<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Горячие клавиши конфликты -->
	<SolidColorBrush x:Key="HotKeyConflictCriticalBrush">#C0392B</SolidColorBrush>
	<SolidColorBrush x:Key="HotKeyConflictCriticalRowBrush">#FDECEA</SolidColorBrush>
	<SolidColorBrush x:Key="HotKeyConflictWarningBrush">#E67E22</SolidColorBrush>
	<SolidColorBrush x:Key="HotKeyConflictWarningRowBrush">#FEF6E4</SolidColorBrush>
	<SolidColorBrush x:Key="AccentSubtleBrush">#E3F0FB</SolidColorBrush>

	<!-- Фоны -->
	<SolidColorBrush x:Key="BgBaseBrush">#D0D0D0</SolidColorBrush>
	<SolidColorBrush x:Key="BgAppBrush">#F5F5F5</SolidColorBrush>
	<SolidColorBrush x:Key="BgSurfaceBrush">#EBEBEB</SolidColorBrush>
	<SolidColorBrush x:Key="BgPanelBrush">#E0E0E0</SolidColorBrush>
	<SolidColorBrush x:Key="BgHoverBrush">#D4D4D4</SolidColorBrush>

	<!-- Текст -->
	<SolidColorBrush x:Key="TextPrimaryBrush">#1A1A1A</SolidColorBrush>
	<SolidColorBrush x:Key="TextSecondaryBrush">#3A3A3A</SolidColorBrush>
	<SolidColorBrush x:Key="TextMutedBrush">#6A6A6A</SolidColorBrush>
	<SolidColorBrush x:Key="TextDisabledBrush">#AAAAAA</SolidColorBrush>

	<!-- Акцент -->
	<SolidColorBrush x:Key="AccentDefaultBrush">#007ACC</SolidColorBrush>
	<SolidColorBrush x:Key="AccentHoverBrush">#1C86C8</SolidColorBrush>
	<SolidColorBrush x:Key="AccentPressedBrush">#005A9E</SolidColorBrush>

	<!-- Границы -->
	<SolidColorBrush x:Key="BorderDefaultBrush">#C0C0C4</SolidColorBrush>
	<SolidColorBrush x:Key="BorderSubtleBrush">#DCDCDC</SolidColorBrush>

	<!-- Семантические цвета секций настроек -->
	<SolidColorBrush x:Key="SectionGlobalBgBrush">#D0E4F7</SolidColorBrush>
	<SolidColorBrush x:Key="SectionGlobalFgBrush">#1A5FA8</SolidColorBrush>
	<SolidColorBrush x:Key="SectionProjectBgBrush">#FFF3CD</SolidColorBrush>
	<SolidColorBrush x:Key="SectionProjectFgBrush">#8A5A00</SolidColorBrush>

	<!-- Переопределение токенов FluentTheme для Menu и MenuItem -->
	<SolidColorBrush x:Key="MenuFlyoutBackground">#EBEBEB</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutBorderBrush">#C0C0C4</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemBackground">Transparent</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver">#007ACC</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed">#005A9E</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemForeground">#1A1A1A</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver">#FFFFFF</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled">#AAAAAA</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarBackground">#E0E0E0</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarItemBackground">Transparent</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver">#007ACC</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarItemBackgroundPressed">#005A9E</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarItemForeground">#1A1A1A</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarItemForegroundPointerOver">#FFFFFF</SolidColorBrush>

	<!-- Подсказки -->
	<SolidColorBrush x:Key="AppTooltipBackground">#F5F5F5</SolidColorBrush>
	<SolidColorBrush x:Key="AppTooltipBorderBrush">#C0C0C4</SolidColorBrush>
	<SolidColorBrush x:Key="AppTooltipForeground">#1A1A1A</SolidColorBrush>

</ResourceDictionary>