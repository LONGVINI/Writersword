<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Notes.ViewModels"
             xmlns:loc="using:Writersword.Src.Modules.Notes.Resources"
             x:Class="Writersword.Modules.Notes.Views.NotesView"
             x:DataType="vm:NotesViewModel">

	<Border Padding="10"
            Background="{DynamicResource BgSurfaceBrush}">
		<StackPanel Spacing="5">

			<!-- Заголовок модуля -->
			<TextBlock Text="{x:Static loc:NotesStrings.Title}"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

			<!-- Поле для ввода заметок (многострочное) -->
			<TextBox Text="{Binding NoteText}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80"
                     Background="{DynamicResource BgPanelBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource AccentDefaultBrush}"
                     BorderThickness="1"/>

		</StackPanel>
	</Border>

</UserControl>