<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Writersword.Styles.UserControls"
             xmlns:behaviors="using:Writersword.Infrastructure.Behaviours"
             xmlns:conv="using:Writersword.Infrastructure.Converters"
             x:Class="Writersword.Styles.UserControls.PaletteManagerView"
             x:Name="Root">

	<UserControl.Styles>
		<Style Selector="Border.swatch">
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Panel.swatchCell:pointerover Border.swatch">
			<Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="BorderThickness" Value="2.5"/>
		</Style>
		<Style Selector="Button.removeBtn">
			<Setter Property="Width" Value="14"/>
			<Setter Property="Height" Value="14"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="9"/>
			<Setter Property="CornerRadius" Value="7"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="#E6202020"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,-3,-3,0"/>
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
		</Style>
		<Style Selector="Panel.swatchCell:pointerover Button.removeBtn">
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>
		<Style Selector="Button.addtile">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.mini.palAccent">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.mini">
			<Setter Property="Padding" Value="10,3"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<!-- Переключатель области берётся общим стилем
		     (Styles/Controls/ScopeToggle.axaml): раньше здесь лежала своя копия,
		     и она разошлась с копией в окне папок с аватарками. -->

		<!-- Заголовок секции и шеврон. -->
		<Style Selector="Path.chev">
			<Setter Property="Stroke" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="StrokeThickness" Value="2"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.secHeader">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="10,9"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.secHeader /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>
		<Style Selector="Button.secHeader:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
		<Style Selector="TextBlock.secTitle">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Карточка палитры (раскрывающаяся). -->
		<Style Selector="Border.pcard">
			<Setter Property="Background" Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Margin" Value="0,2"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<!-- Включённые палитры — фон на полутон светлее базового, чтобы сразу
		     было видно, какие включены, а какие нет. -->
		<Style Selector="Border.pcard.shown">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
		</Style>
		<Style Selector="Border.pcard:pointerover">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
		<Style Selector="Border.pcard.active">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<!-- Скрытые палитры: приглушаем только текст и иконки (видно, что неактивны),
		     а сами цвета (превью-лента и свотчи) оставляем яркими. -->
		<Style Selector="Border.pcard.hidden TextBlock">
			<Setter Property="Opacity" Value="0.45"/>
		</Style>
		<Style Selector="Border.pcard.hidden PathIcon">
			<Setter Property="Opacity" Value="0.45"/>
		</Style>

		<!-- Шапка строки палитры. Прозрачный фон — чтобы пустые места тоже ловили клик. -->
		<Style Selector="Grid.phdr">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<!-- Плоские значки (не кнопки-коробки): появляются по наведению на карточку. -->
		<Style Selector="Button.rowicon">
			<Setter Property="Width" Value="24"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
		</Style>
		<Style Selector="Border.pcard:pointerover Button.rowicon">
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>
		<Style Selector="Border.pcard.active Button.rowicon">
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>
		<Style Selector="Button.rowicon PathIcon">
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="Button.rowicon:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgBaseBrush}"/>
		</Style>
		<Style Selector="Button.rowicon.eyeoff PathIcon">
			<Setter Property="Opacity" Value="0.55"/>
		</Style>
		<Style Selector="Button.rowicon.trash PathIcon">
			<Setter Property="Foreground" Value="#C9897F"/>
		</Style>
		<Style Selector="Button.rowicon.trash:pointerover PathIcon">
			<Setter Property="Foreground" Value="#E86A6A"/>
		</Style>

		<!-- Поле имени палитры в строке: правится по клику, длинное обрезается. -->
		<Style Selector="TextBox.renameBox">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBox.renameBox:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource BgBaseBrush}"/>
		</Style>
	</UserControl.Styles>

	<Panel x:Name="RootHost">
	<StackPanel Spacing="10">

		<!-- Стандартные цвета (глобальные). Сворачиваемая секция. -->
		<StackPanel Spacing="6">
			<Button x:Name="StdHeader" Classes="secHeader" Tag="std" Click="OnSectionHeader"
			        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
			        Padding="8,6">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Grid.Column="0" Classes="secTitle"
					           Text="{x:Static res:SharedStrings.Palette_Standard}"/>
					<Path Grid.Column="1" x:Name="StdChevron" Classes="chev"
					      Data="M0,0 L5,5 L10,0"/>
				</Grid>
			</Button>

			<StackPanel x:Name="StandardBody" Spacing="6">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
					<Button Grid.Column="2" Classes="addtile" Click="OnAddStandard"
					        ToolTip.Tip="{x:Static res:SharedStrings.ColorEditor_AddCurrent}">
						<Panel Width="12" Height="12">
							<Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1"
							           Fill="{DynamicResource TextSecondaryBrush}"
							           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<Rectangle Width="2" Height="12" RadiusX="1" RadiusY="1"
							           Fill="{DynamicResource TextSecondaryBrush}"
							           HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Panel>
					</Button>
					<Button Grid.Column="0" Classes="mini" Click="OnResetStandard"
					        Content="{x:Static res:SharedStrings.Palette_Reset}"/>
				</Grid>
				<Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="10" Padding="6" MinHeight="44">
					<ItemsControl x:Name="StandardItems" ItemsSource="{Binding Standard, ElementName=Root}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Panel Classes="swatchCell" Width="26" Height="26" Margin="3">
									<Border Classes="swatch" Background="{Binding Converter={x:Static conv:ColorCodeToBrushConverter.Instance}}"
									        PointerPressed="OnPaletteColorPressed" PointerMoved="OnPaletteColorMoved" PointerReleased="OnPaletteColorReleased">
									<Border.RenderTransform>
										<TranslateTransform>
											<TranslateTransform.Transitions>
												<Transitions>
													<DoubleTransition Property="X" Duration="0:0:0.16" Easing="CubicEaseOut"/>
													<DoubleTransition Property="Y" Duration="0:0:0.16" Easing="CubicEaseOut"/>
												</Transitions>
											</TranslateTransform.Transitions>
										</TranslateTransform>
									</Border.RenderTransform>
								</Border>
									<Button Classes="removeBtn" Content="✕" Click="OnRemoveStandard"/>
								</Panel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
			</StackPanel>
		</StackPanel>

		<!-- Палитры: раскрывающиеся карточки. Клик по строке — активна+раскрыта;
		     имя правится в строке; значки (↑↓ глазик мусорка) по наведению;
		     перестановка перетаскиванием при удержании. -->
		<StackPanel Spacing="6">
			<Button x:Name="PalHeader" Classes="secHeader" Tag="pal" Click="OnSectionHeader"
			        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
			        Padding="8,6">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Grid.Column="0" Classes="secTitle"
					           Text="{x:Static res:SharedStrings.Palette_Palettes}"/>
					<Path Grid.Column="1" x:Name="PalChevron" Classes="chev"
					      Data="M0,0 L5,5 L10,0"/>
				</Grid>
			</Button>

			<StackPanel x:Name="PalettesBody" Spacing="6" Margin="0,0,8,0">
				<Grid ColumnDefinitions="*,Auto">
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
						<Button Classes="mini" Click="OnOpenPaletteIO"
							        ToolTip.Tip="{x:Static res:SharedStrings.Palette_LoadTitle}">
								<PathIcon Width="14" Height="14"
								          Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
							</Button>
												<Button Classes="mini palAccent" Click="OnNewPalette"
						        Content="{x:Static res:SharedStrings.Palette_New}"/>
					</StackPanel>
				</Grid>

				<ItemsControl x:Name="PaletteList" ItemsSource="{Binding Palettes, ElementName=Root}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Classes="pcard" Classes.active="{Binding IsActive}" Classes.shown="{Binding Shown}" Classes.hidden="{Binding Hidden}">
								<Border.RenderTransform>
									<TranslateTransform>
										<TranslateTransform.Transitions>
											<Transitions>
												<DoubleTransition Property="Y" Duration="0:0:0.16" Easing="CubicEaseOut"/>
											</Transitions>
										</TranslateTransform.Transitions>
									</TranslateTransform>
								</Border.RenderTransform>
								<StackPanel>

									<Grid Classes="phdr" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto"
									      Margin="6,4" MinHeight="30"
									      PointerPressed="OnPaletteRowPressed"
									      PointerMoved="OnPaletteRowMoved"
									      PointerReleased="OnPaletteRowReleased">

										<PathIcon Grid.Column="0" IsVisible="False" Width="14" Height="14" Margin="0,0,6,0"
										          VerticalAlignment="Center"
										          Foreground="{DynamicResource TextSecondaryBrush}"
										          Data="M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>

										<Border Grid.Column="1" Height="18" CornerRadius="3" ClipToBounds="True"
										        Margin="0,0,8,0" VerticalAlignment="Center"
										        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
											<ItemsControl ItemsSource="{Binding Preview}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border Width="7" Height="18" Background="{Binding Converter={x:Static conv:ColorCodeToBrushConverter.Instance}}"/>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</Border>

										<Panel Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
											<PathIcon Width="15" Height="15" IsVisible="{Binding IsGlobal}"
											          ToolTip.Tip="Глобальная палитра"
											          Foreground="{DynamicResource SectionGlobalFgBrush}"
											          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
											<PathIcon Width="14" Height="14" IsVisible="{Binding IsLocal}"
											          ToolTip.Tip="Локальная палитра (в проекте)"
											          Foreground="{DynamicResource SectionProjectFgBrush}"
											          Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
										</Panel>

										<Panel Grid.Column="3" VerticalAlignment="Center">
											<TextBlock Text="{Binding DisplayName}" IsVisible="{Binding !IsRenaming}"
											           FontSize="12" VerticalAlignment="Center"
											           Margin="6,0,0,0"
											           TextTrimming="CharacterEllipsis"
											           ToolTip.Tip="{Binding Palette.Name}"
											           Foreground="{DynamicResource TextPrimaryBrush}"/>
											<TextBox Classes="renameBox" IsVisible="{Binding IsRenaming}"
											         Text="{Binding Palette.Name, Mode=OneWay}"
											         behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsRenaming}"
											         GotFocus="OnRenameGotFocus"
											         LostFocus="OnRenameCommit" KeyDown="OnRenameKeyDown"/>
										</Panel>

										<Button Grid.Column="4" Classes="rowicon" Click="OnRenamePalette"
										        ToolTip.Tip="Переименовать">
											<PathIcon Width="13" Height="13"
											          Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
										</Button>
										<Button Grid.Column="5" Classes="rowicon" Click="OnMovePaletteUp"
										        ToolTip.Tip="Выше">
											<PathIcon Width="14" Height="14" Data="M7 14l5-5 5 5z"/>
										</Button>
										<Button Grid.Column="6" Classes="rowicon" Click="OnMovePaletteDown"
										        ToolTip.Tip="Ниже">
											<PathIcon Width="14" Height="14" Data="M7 10l5 5 5-5z"/>
										</Button>
										<Button Grid.Column="7" Classes="rowicon" Click="OnToggleVisible"
										        ToolTip.Tip="{x:Static res:SharedStrings.Palette_ToggleVisible}">
											<Panel Width="16" Height="16">
												<PathIcon Width="16" Height="16" IsVisible="{Binding Shown}"
												          Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
												<PathIcon Width="16" Height="16" IsVisible="{Binding Hidden}" Opacity="0.55"
												          Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>
											</Panel>
										</Button>
										<Button Grid.Column="8" Classes="rowicon trash" Click="OnDeletePaletteRow"
										        ToolTip.Tip="{x:Static res:SharedStrings.Palette_Delete}">
											<PathIcon Width="14" Height="14"
											          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
										</Button>
									</Grid>

									<StackPanel IsVisible="{Binding IsActive}" Margin="8,2,8,8" Spacing="6">
										<Grid ColumnDefinitions="Auto,*,Auto">
											<Border Grid.Column="0" Classes="scopeTrack">
												<Panel>
													<Border Classes="scopeThumb"
													        Classes.right="{Binding IsGlobal}"/>
													<StackPanel Orientation="Horizontal">
														<Button Classes="scope local" Classes.active="{Binding IsLocal}"
														        Click="OnScopeLocal"
														        Content="{x:Static res:SharedStrings.Palette_Local}"/>
														<Button Classes="scope global" Classes.active="{Binding IsGlobal}"
														        Click="OnScopeGlobal"
														        Content="{x:Static res:SharedStrings.Palette_Global}"/>
													</StackPanel>
												</Panel>
											</Border>

											<Border Grid.Column="1" Margin="10,0,0,0"
											        VerticalAlignment="Center" HorizontalAlignment="Left"
											        Background="Transparent" Padding="2"
											        behaviors:TooltipBehavior.Tip="{x:Static res:SharedStrings.Palette_ScopeHintTitle}"
											        behaviors:TooltipBehavior.Description="{x:Static res:SharedStrings.Palette_ScopeHintBody}"
											        behaviors:TooltipBehavior.ShowDelay="300">
												<PathIcon Width="16" Height="16"
												          Foreground="{DynamicResource TextPrimaryBrush}"
												          Data="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
											</Border>

											<Button Grid.Column="2" Classes="addtile" Click="OnAddPaletteColor"
											        ToolTip.Tip="{x:Static res:SharedStrings.ColorEditor_AddCurrent}">
												<Panel Width="12" Height="12">
													<Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1"
													           Fill="{DynamicResource TextSecondaryBrush}"
													           HorizontalAlignment="Center" VerticalAlignment="Center"/>
													<Rectangle Width="2" Height="12" RadiusX="1" RadiusY="1"
													           Fill="{DynamicResource TextSecondaryBrush}"
													           HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Panel>
											</Button>
										</Grid>

										<Border Background="{DynamicResource BgBaseBrush}" CornerRadius="10" Padding="6" MinHeight="44">
											<ItemsControl x:Name="PaletteColorsItems" ItemsSource="{Binding CurrentColors, ElementName=Root}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Panel Classes="swatchCell" Width="26" Height="26" Margin="3">
															<Border Classes="swatch" Background="{Binding Converter={x:Static conv:ColorCodeToBrushConverter.Instance}}"
															        PointerPressed="OnPaletteColorPressed" PointerMoved="OnPaletteColorMoved" PointerReleased="OnPaletteColorReleased">
																<Border.RenderTransform>
																	<TranslateTransform>
																		<TranslateTransform.Transitions>
																			<Transitions>
																				<DoubleTransition Property="X" Duration="0:0:0.16" Easing="CubicEaseOut"/>
																					<DoubleTransition Property="Y" Duration="0:0:0.16" Easing="CubicEaseOut"/>
																			</Transitions>
																		</TranslateTransform.Transitions>
																	</TranslateTransform>
																</Border.RenderTransform>
															</Border>
															<Button Classes="removeBtn" Content="✕" Click="OnRemovePaletteColor"/>
														</Panel>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</Border>
									</StackPanel>

								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</StackPanel>

	</StackPanel>

	<!-- Центрируемые мини-окна импорта и экспорта палитр. В конструкторе
	     выносятся в OverlayLayer окна и центрируются над модулем редактора. -->
	<!-- Центрируемое окно загрузки палитры: две вкладки — импорт и экспорт. -->
	<Border x:Name="PaletteIORoot" IsVisible="False" Background="#99000000">
		<Border Width="380" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
		        Background="{DynamicResource BgBaseBrush}" CornerRadius="12" Padding="16"
		        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
			<StackPanel Spacing="10">
				<Grid ColumnDefinitions="Auto,Auto,*">
					<Button Grid.Column="0" x:Name="IoImportTab" Classes="mini palAccent"
					        Click="OnIoTabImport" Margin="0,0,6,0"
					        Content="{x:Static res:SharedStrings.Palette_TabImport}"/>
					<Button Grid.Column="1" x:Name="IoExportTab" Classes="mini"
					        Click="OnIoTabExport"
					        Content="{x:Static res:SharedStrings.Palette_TabExport}"/>
					<Button Grid.Column="2" HorizontalAlignment="Right" Content="✕"
					        Background="Transparent" BorderThickness="0" Padding="8,2" FontSize="15"
					        Foreground="{DynamicResource TextSecondaryBrush}" Click="OnIoClose"/>
				</Grid>

				<!-- Импорт -->
				<StackPanel x:Name="IoImportPanel" Spacing="10">
					<TextBox x:Name="ImportName"
					         PlaceholderText="{x:Static res:SharedStrings.Palette_NamePlaceholder}"/>
					<TextBox x:Name="ImportCode" AcceptsReturn="True" Height="150" TextWrapping="Wrap"
					         PlaceholderText="{x:Static res:SharedStrings.Palette_ImportHint}"/>
					<TextBlock x:Name="ImportError" IsVisible="False" FontSize="11" Foreground="#E0573B"/>
					<Grid ColumnDefinitions="Auto,*,Auto">
						<Button Grid.Column="0" Classes="mini" Click="OnImportLoadFile"
						        Content="{x:Static res:SharedStrings.Palette_File}"/>
						<Button Grid.Column="2" Classes="mini palAccent" Click="OnImportConfirm"
						        Content="{x:Static res:SharedStrings.Palette_Add}"/>
					</Grid>
				</StackPanel>

				<!-- Экспорт -->
				<StackPanel x:Name="IoExportPanel" Spacing="10" IsVisible="False">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<Button x:Name="ExpHexBtn" Classes="mini" Click="OnExportHex"
						        Content="{x:Static res:SharedStrings.Palette_HexList}"/>
						<Button x:Name="ExpJsonBtn" Classes="mini" Click="OnExportJson" Content="JSON"/>
					</StackPanel>
					<TextBox x:Name="ExportCode" AcceptsReturn="True" Height="160" IsReadOnly="True"
					         TextWrapping="Wrap"/>
					<Grid ColumnDefinitions="Auto,*,Auto">
						<Button Grid.Column="0" Classes="mini" Click="OnExportSaveFile"
						        Content="{x:Static res:SharedStrings.Palette_SaveFile}"/>
						<Button Grid.Column="2" Classes="mini palAccent" Click="OnExportCopy"
						        Content="{x:Static res:SharedStrings.Palette_Copy}"/>
					</Grid>
				</StackPanel>

			</StackPanel>
		</Border>
	</Border>
	</Panel>
</UserControl>
