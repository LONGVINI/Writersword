<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Writersword.Modules.TextEditor.Views.Dialogs"
             x:Class="Writersword.Modules.TextEditor.Views.Dialogs.FontPickerOverlay">

	<UserControl.Styles>
		<Style Selector="TextBox.FontSearch">
			<Setter Property="Background"               Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="BorderBrush"              Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness"          Value="1"/>
			<Setter Property="CornerRadius"             Value="5"/>
			<Setter Property="MinHeight"                Value="28"/>
			<Setter Property="Padding"                  Value="8 0"/>
			<Setter Property="FontSize"                 Value="12"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="CaretBrush"               Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="SelectionBrush"           Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="SelectionForegroundBrush" Value="White"/>
		</Style>
		<Style Selector="TextBox.FontSearch:focus /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Отступ справа — под полосу прокрутки. Она всплывает поверх содержимого, а
		     не раздвигает его, и ложилась ровно на звёздочку у правого края строки.
		     Отступ небольшой: полоса вынесена к самому краю панели, за пределы списка,
		     и отводить под неё всю ширину больше не нужно — освободившееся место ушло
		     строке, то есть полю нажатия на шрифт. -->
		<Style Selector="ListBox.FontList">
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding"         Value="0 0 8 0"/>
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
		</Style>

		<!-- Полоса прокрутки: без подложки, у самого края панели.
		     Своя подложка здесь ни к чему — список лежит на сплошном фоне панели, и
		     серая колонка вдоль него только режет глаз. Отрицательное поле справа
		     выносит полосу за край списка, в поле самой панели: там она не отнимает у
		     строк ни точки и ни на что не налезает. -->
		<Style Selector="ListBox.FontList ScrollBar">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Margin"     Value="0 2 -6 2"/>
		</Style>
		<!-- Ширина полосы — это поле захвата, а не толщина ползунка. Ползунок внутри
		     тоньше, но брать его можно по всей этой ширине: тонкая полоса, по которой
		     ещё и надо попасть, мучительна. -->
		<Style Selector="ListBox.FontList ScrollBar:vertical">
			<Setter Property="Width"    Value="12"/>
			<Setter Property="MinWidth" Value="12"/>
		</Style>
		<Style Selector="ListBox.FontList ScrollBar /template/ Border">
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="ListBox.FontList ScrollBar /template/ Rectangle">
			<Setter Property="Fill" Value="Transparent"/>
		</Style>
		<!-- Кнопки-стрелки убираются целиком: на списке в полторы сотни строк ими не
		     пользуются, а места они занимают больше, чем сам ползунок. -->
		<Style Selector="ListBox.FontList ScrollBar /template/ RepeatButton">
			<Setter Property="IsVisible" Value="False"/>
			<Setter Property="Width"     Value="0"/>
			<Setter Property="Height"    Value="0"/>
		</Style>
		<!-- Ползунок виден всегда. Прятать его до наведения нельзя: список длинный, и
		     без ползунка не понять ни где ты в нём стоишь, ни сколько осталось.
		     Восемь точек — чтобы попадать мышью без прицеливания. -->
		<Style Selector="ListBox.FontList ScrollBar /template/ Thumb">
			<Setter Property="Background"          Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="BorderThickness"     Value="0"/>
			<Setter Property="CornerRadius"        Value="4"/>
			<Setter Property="MinWidth"            Value="8"/>
			<Setter Property="Width"               Value="8"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="Opacity"             Value="0.55"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
					<DoubleTransition Property="Width"   Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>

		<!-- Наведение считается по всей полосе, а не по самому ползунку: подсветиться он
		     обязан ДО того, как мышь на него попала, иначе целиться приходится в то,
		     чего не видно. -->
		<Style Selector="ListBox.FontList ScrollBar:pointerover /template/ Thumb">
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="Width"   Value="10"/>
		</Style>
		<Style Selector="ListBox.FontList ScrollBar /template/ Thumb:pressed">
			<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Opacity"    Value="1"/>
			<Setter Property="Width"      Value="10"/>
		</Style>

		<!-- Подсветка живёт на Border.Row, а не на самом ListBoxItem: заголовок
		     раздела лежит внутри первого пункта, и подсветка пункта затягивала бы
		     заголовок вместе с ним. -->
		<Style Selector="ListBox.FontList ListBoxItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding"    Value="0"/>
			<Setter Property="MinHeight"  Value="0"/>
		</Style>
		<Style Selector="ListBox.FontList ListBoxItem /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding"    Value="0"/>
		</Style>

		<!-- Поле справа меньше левого: звезда прижата к краю строки, подальше от
		     названия шрифта и поближе к полосе. По вертикали строка выше — попадать
		     по ней мышью на длинном списке проще. -->
		<Style Selector="Border.Row">
			<Setter Property="Background"   Value="Transparent"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding"      Value="8 6 3 6"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>

		<!-- Строка, которую тащат: приподнята и чуть просвечивает, чтобы под ней было
		     видно, куда она встанет. Тень даёт ощущение снятого со стопки листа —
		     остальные строки при этом просто расступаются. -->
		<Style Selector="Border.Row.Dragging">
			<Setter Property="Background"      Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="Opacity"         Value="0.9"/>
			<Setter Property="RenderTransform" Value="scale(1.015)"/>
			<Setter Property="ZIndex"          Value="10"/>
			<Setter Property="Effect">
				<DropShadowEffect BlurRadius="10" OffsetX="0" OffsetY="2" Opacity="0.5" Color="#000000"/>
			</Setter>
		</Style>
		<Style Selector="ListBoxItem:pointerover Border.Row">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
		<Style Selector="ListBoxItem:selected Border.Row">
			<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ListBoxItem:selected Border.Row TextBlock.FontName">
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<Style Selector="TextBlock.FontName">
			<Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="FontSize"          Value="14"/>
			<Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="TextBlock.SectionTitle">
			<Setter Property="Foreground"  Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="FontSize"    Value="10"/>
			<Setter Property="FontWeight"  Value="SemiBold"/>
			<Setter Property="Margin"      Value="8 8 8 3"/>
		</Style>

		<!-- Звёздочка проступает при наведении на строку и остаётся зажжённой у
		     закреплённых. Плавность здесь не украшение: полсотни звёзд, вспыхивающих
		     разом на пробеге мыши по списку, читаются как рябь. -->
		<Style Selector="Button.Star">
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding"         Value="7 3"/>
			<Setter Property="MinWidth"        Value="0"/>
			<Setter Property="MinHeight"       Value="0"/>
			<Setter Property="Cursor"          Value="Hand"/>
			<Setter Property="Opacity"         Value="0"/>
			<Setter Property="Foreground"      Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.Star /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem:pointerover Button.Star">
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="Button.Star.Pinned">
			<Setter Property="Opacity"    Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.Star:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ListBoxItem:selected Button.Star">
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</UserControl.Styles>

	<Grid>
		<!-- Перехватчик нажатий мимо панели. Прозрачный, но не Null: кисть нужна,
		     иначе граница не участвует в проверке попадания и закрыть список
		     щелчком по документу было бы нечем. -->
		<Border x:Name="Scrim" Background="Transparent"/>

		<!-- Отступ панели считает PositionUnder: она встаёт под полем ленты.
		     Выравнивание по левому верхнему углу обязательно — Margin работает
		     как координата только при нём. -->
		<Border x:Name="Panel"
		        HorizontalAlignment="Left" VerticalAlignment="Top"
		        Width="288"
		        Background="{DynamicResource BgBaseBrush}"
		        BorderBrush="{DynamicResource BorderDefaultBrush}"
		        BorderThickness="1" CornerRadius="8" Padding="6">
			<Border.Effect>
				<DropShadowEffect BlurRadius="24" OffsetX="0" OffsetY="8" Opacity="0.45" Color="#000000"/>
			</Border.Effect>

			<DockPanel LastChildFill="True">
				<TextBox x:Name="SearchBox" DockPanel.Dock="Top"
				         Classes="FontSearch" Margin="0 0 0 6"
				         PlaceholderText="Поиск шрифта"/>

				<TextBlock x:Name="EmptyLabel" DockPanel.Dock="Top"
				           Margin="8 6" FontSize="12" IsVisible="False"
				           Foreground="{DynamicResource TextMutedBrush}"
				           Text="Ничего не найдено"/>

				<ListBox x:Name="FontList" Classes="FontList" MaxHeight="360">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="local:FontEntry">
							<StackPanel>
								<TextBlock Classes="SectionTitle"
								           Text="{Binding SectionTitle}"
								           IsVisible="{Binding HasSection}"/>

								<Border Classes="Row"
								        Classes.Dragging="{Binding IsDragging}">
									<Grid ColumnDefinitions="* Auto">
										<TextBlock Grid.Column="0" Classes="FontName"
										           Text="{Binding Name}"
										           FontFamily="{Binding Name}"/>

										<Button Grid.Column="1" Classes="Star"
										        Classes.Pinned="{Binding IsPinned}"
										        Click="OnPinClick">
											<Panel>
												<PathIcon Width="13" Height="13"
												          IsVisible="{Binding !IsPinned}"
												          Data="M22 9.24l-7.19-.62L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.63-7.03L22 9.24zM12 15.4l-3.76 2.27 1-4.28-3.32-2.88 4.38-.38L12 6.1l1.71 4.04 4.38.38-3.32 2.88 1 4.28L12 15.4z"/>
												<PathIcon Width="13" Height="13"
												          IsVisible="{Binding IsPinned}"
												          Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
											</Panel>
										</Button>
									</Grid>
								</Border>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</Border>
	</Grid>

</UserControl>
