<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Writersword.ViewModels.Settings"
        xmlns:loc="using:Writersword.Resources.Localization"
        x:Class="Writersword.Views.Settings.SettingsView"
        x:DataType="vm:SettingsViewModel"
        Title="{x:Static loc:Strings.Settings_Title}"
        Width="960"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Grid>

        <Border Background="#0D0D0D"
                CornerRadius="14"
                Margin="2"/>

        <Border Background="#1E1E1E"
                CornerRadius="12"
                Margin="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,0">
                    <TextBlock Text="{x:Static loc:Strings.Settings_Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28"
                            Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#858585"
                            FontSize="14"
                            Cursor="Hand"
                            Command="{Binding CloseCommand}">
                        <TextBlock Text="&#x2715;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#3A3A3C"/>
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>

                <Border Grid.Row="0"
                        Height="1"
                        Background="#2D2D30"
                        VerticalAlignment="Bottom"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#252526"
                            CornerRadius="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tabs}"
                                          Margin="0,6,0,12"
                                          HorizontalAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingsTabItem">
                                        <Panel HorizontalAlignment="Stretch"
                                               IsVisible="{Binding IsVisibleInList}">

                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#555"
                                                       Margin="16,10,16,2"
                                                       IsVisible="{Binding IsHeader}"/>

                                            <Border IsVisible="{Binding IsSectionHeader}"
                                                    Padding="12,7,16,7"
                                                    Margin="0,6,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    Background="{Binding SectionHeaderBackground}"
                                                    Cursor="Hand"
                                                    PointerPressed="SectionHeader_PointerPressed">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding ExpandArrow}"
                                                               FontSize="14"
                                                               Foreground="{Binding SectionHeaderForeground}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding SectionHeaderForeground}"
                                                               LetterSpacing="1"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#666"
                                                       Margin="16,6,16,2"
                                                       IsVisible="{Binding IsModuleHeader}"/>

                                            <Grid IsVisible="{Binding IsClickable}"
                                                  HorizontalAlignment="Stretch">
                                                <Border Background="{Binding TabSelectedBackground}"
                                                        IsHitTestVisible="False"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"/>
                                                <Border HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Background="Transparent"
                                                        Padding="{Binding Indent}"
                                                        Cursor="Hand"
                                                        PointerPressed="Tab_PointerPressed">
                                                    <Border.Styles>
                                                        <Style Selector="Border:pointerover">
                                                            <Setter Property="Background" Value="#2A2A2C"/>
                                                        </Style>
                                                    </Border.Styles>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               Foreground="{Binding TabForeground}"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                            <Border HorizontalAlignment="Stretch"
                                                    Background="Transparent"
                                                    Padding="{Binding Indent}"
                                                    IsVisible="{Binding IsDisabled}">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           Foreground="#444"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="0"
                            Width="1"
                            Background="#2D2D30"
                            HorizontalAlignment="Right"/>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#001A2E"
                                Padding="20,9"
                                IsVisible="{Binding ShowGlobalBanner}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="!"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#3A8FD9"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_Banner_Global}"
                                           FontSize="12"
                                           Foreground="#3A8FD9"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0"
                                Height="1"
                                Background="#003A6E"
                                VerticalAlignment="Bottom"
                                IsVisible="{Binding ShowGlobalBanner}"/>

                        <Border Grid.Row="0"
                                Background="#2A1F00"
                                Padding="20,9"
                                IsVisible="{Binding ShowProjectBanner}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="!"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#F0A030"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_Banner_Project}"
                                           FontSize="12"
                                           Foreground="#C8881A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0"
                                Height="1"
                                Background="#3D2E00"
                                VerticalAlignment="Bottom"
                                IsVisible="{Binding ShowProjectBanner}"/>

                        <ScrollViewer Grid.Row="1"
                                      Padding="24,20"
                                      VerticalScrollBarVisibility="Auto">
                            <ContentControl Content="{Binding SelectedTab.Content}"/>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>