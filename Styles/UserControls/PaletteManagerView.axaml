<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Writersword.Styles.UserControls"
             x:Class="Writersword.Styles.UserControls.PaletteManagerView"
             x:Name="Root">

	<UserControl.Styles>
		<Style Selector="Border.swatch">
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Panel.swatchCell:pointerover Border.swatch">
			<Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="BorderThickness" Value="2.5"/>
		</Style>
		<Style Selector="Button.removeBtn">
			<Setter Property="Width" Value="14"/>
			<Setter Property="Height" Value="14"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="9"/>
			<Setter Property="CornerRadius" Value="7"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="#E6202020"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,-3,-3,0"/>
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
		</Style>
		<Style Selector="Panel.swatchCell:pointerover Button.removeBtn">
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>
		<Style Selector="Button.addtile">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.mini">
			<Setter Property="Padding" Value="10,3"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
		<Style Selector="Button.iconbtn">
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0,0,4,4"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="Button.scope">
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="Button.scope.active">
			<Setter Property="Background" Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="TextBlock.section">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>

		<!-- Заголовок секции (на базе проектной Button.ghost) и шеврон. -->
		<Style Selector="Path.chev">
			<Setter Property="Stroke" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="StrokeThickness" Value="2"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Button.secHeader">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="10,9"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.secHeader /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>
		<Style Selector="Button.secHeader:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
		<Style Selector="TextBlock.secTitle">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Строка палитры: перетаскивается целиком, подсветка по наведению. -->
		<Style Selector="Border.prow">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="6,4"/>
			<Setter Property="Margin" Value="0,1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Border.prow:pointerover">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
		</Style>

		<Style Selector="Border.badge">
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="5,1"/>
			<Setter Property="Margin" Value="0,0,6,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.badge TextBlock">
			<Setter Property="FontSize" Value="10"/>
		</Style>

		<Style Selector="Button.eyebtn">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<StackPanel Spacing="10">

		<!-- Стандартные цвета (глобальные). Сворачиваемая секция. -->
		<StackPanel Spacing="6">
			<Button Classes="secHeader" Tag="std" Click="OnSectionHeader"
			        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
			        Padding="8,6">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Grid.Column="0" Classes="secTitle"
					           Text="{x:Static res:SharedStrings.Palette_Standard}"/>
					<Path Grid.Column="1" x:Name="StdChevron" Classes="chev"
					      Data="M0,0 L5,5 L10,0"/>
				</Grid>
			</Button>

			<StackPanel x:Name="StandardBody" Spacing="6">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
					<Button Grid.Column="2" Classes="addtile" Click="OnAddStandard"
					        ToolTip.Tip="{x:Static res:SharedStrings.ColorEditor_AddCurrent}">
						<Panel Width="12" Height="12">
							<Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1"
							           Fill="{DynamicResource TextSecondaryBrush}"
							           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<Rectangle Width="2" Height="12" RadiusX="1" RadiusY="1"
							           Fill="{DynamicResource TextSecondaryBrush}"
							           HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Panel>
					</Button>
					<Button Grid.Column="0" Classes="mini" Click="OnResetStandard"
					        Content="{x:Static res:SharedStrings.Palette_Reset}"/>
				</Grid>
				<Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="10" Padding="6" MinHeight="44">
					<ItemsControl ItemsSource="{Binding Standard, ElementName=Root}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Panel Classes="swatchCell" Width="26" Height="26" Margin="3">
									<Border Classes="swatch" Background="{Binding}"
									        PointerPressed="OnStandardPressed"/>
									<Button Classes="removeBtn" Content="✕" Click="OnRemoveStandard"/>
								</Panel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
			</StackPanel>
		</StackPanel>

		<!-- Именованные палитры. Сворачиваемая секция. Строки перетаскиваются,
		     бейдж показывает область, глазик — видимость в попапе, клик — настройки. -->
		<StackPanel Spacing="6">
			<Button Classes="secHeader" Tag="pal" Click="OnSectionHeader"
			        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
			        Padding="8,6">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Grid.Column="0" Classes="secTitle"
					           Text="{x:Static res:SharedStrings.Palette_Palettes}"/>
					<Path Grid.Column="1" x:Name="PalChevron" Classes="chev"
					      Data="M0,0 L5,5 L10,0"/>
				</Grid>
			</Button>

			<StackPanel x:Name="PalettesBody" Spacing="6">
				<Grid ColumnDefinitions="*,Auto">
					<Button Grid.Column="1" Classes="mini" Click="OnNewPalette"
					        Content="{x:Static res:SharedStrings.Palette_New}"/>
				</Grid>

				<ItemsControl x:Name="PaletteList" ItemsSource="{Binding Palettes, ElementName=Root}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Classes="prow"
							        PointerPressed="OnPaletteRowPressed"
							        PointerMoved="OnPaletteRowMoved"
							        PointerReleased="OnPaletteRowReleased">
								<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
									<PathIcon Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0"
									          Foreground="{DynamicResource TextSecondaryBrush}"
									          Data="M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>

									<Border Grid.Column="1" Height="20" CornerRadius="3" ClipToBounds="True"
									        Margin="0,0,8,0" VerticalAlignment="Center"
									        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
										<ItemsControl ItemsSource="{Binding Preview}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border Width="7" Height="20" Background="{Binding}"/>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Border>

									<TextBlock Grid.Column="2" Text="{Binding DisplayName}"
									           VerticalAlignment="Center"
									           TextTrimming="CharacterEllipsis"
									           Foreground="{DynamicResource TextPrimaryBrush}"/>

									<Panel Grid.Column="3" VerticalAlignment="Center">
										<Border Classes="badge" IsVisible="{Binding IsGlobal}"
										        Background="{DynamicResource SectionGlobalBgBrush}">
											<TextBlock Text="{x:Static res:SharedStrings.Palette_Global}"
											           Foreground="{DynamicResource SectionGlobalFgBrush}"/>
										</Border>
										<Border Classes="badge" IsVisible="{Binding IsLocal}"
										        Background="{DynamicResource SectionProjectBgBrush}">
											<TextBlock Text="{x:Static res:SharedStrings.Palette_Local}"
											           Foreground="{DynamicResource SectionProjectFgBrush}"/>
										</Border>
									</Panel>

									<Button Grid.Column="4" Classes="eyebtn" Click="OnToggleVisible"
									        ToolTip.Tip="{x:Static res:SharedStrings.Palette_ToggleVisible}">
										<Panel Width="16" Height="16">
											<PathIcon Width="16" Height="16" IsVisible="{Binding Shown}"
											          Foreground="{DynamicResource TextSecondaryBrush}"
											          Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
											<PathIcon Width="16" Height="16" IsVisible="{Binding Hidden}"
											          Opacity="0.55"
											          Foreground="{DynamicResource TextSecondaryBrush}"
											          Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>
										</Panel>
									</Button>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<StackPanel x:Name="PaletteDetail" Spacing="6" IsVisible="False">
					<TextBox x:Name="PaletteName" FontSize="13"
					         KeyDown="OnNameKeyDown" LostFocus="OnNameCommit"/>

					<WrapPanel Orientation="Horizontal">
						<Border Background="{DynamicResource BgSurfaceBrush}"
						        CornerRadius="6" Padding="3" Margin="0,0,8,4" VerticalAlignment="Center">
							<StackPanel Orientation="Horizontal" Spacing="2">
								<Button x:Name="ScopeLocalBtn" Classes="scope" Click="OnScopeLocal"
								        Content="{x:Static res:SharedStrings.Palette_Local}"/>
								<Button x:Name="ScopeGlobalBtn" Classes="scope" Click="OnScopeGlobal"
								        Content="{x:Static res:SharedStrings.Palette_Global}"/>
							</StackPanel>
						</Border>

						<Button Classes="iconbtn" Click="OnAddPaletteColor"
						        ToolTip.Tip="{x:Static res:SharedStrings.ColorEditor_AddCurrent}">
							<Panel Width="12" Height="12">
								<Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1"
								           Fill="{DynamicResource TextPrimaryBrush}"
								           HorizontalAlignment="Center" VerticalAlignment="Center"/>
								<Rectangle Width="2" Height="12" RadiusX="1" RadiusY="1"
								           Fill="{DynamicResource TextPrimaryBrush}"
								           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Panel>
						</Button>

						<Button Classes="iconbtn" Click="OnDeletePalette"
						        ToolTip.Tip="{x:Static res:SharedStrings.Palette_Delete}">
							<PathIcon Width="14" Height="14"
							          Foreground="{DynamicResource TextPrimaryBrush}"
							          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
						</Button>
					</WrapPanel>

					<Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="10" Padding="6" MinHeight="44">
						<ItemsControl ItemsSource="{Binding CurrentColors, ElementName=Root}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Panel Classes="swatchCell" Width="26" Height="26" Margin="3">
										<Border Classes="swatch" Background="{Binding}"
										        PointerPressed="OnPaletteColorPressed"/>
										<Button Classes="removeBtn" Content="✕" Click="OnRemovePaletteColor"/>
									</Panel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Border>
				</StackPanel>
			</StackPanel>
		</StackPanel>

	</StackPanel>
</UserControl>
