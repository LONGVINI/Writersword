<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="using:Writersword.Modules.Characters.ViewModels.Tabs"
             xmlns:loc="using:Writersword.Src.Modules.Characters.Resources"
             xmlns:enums="using:Writersword.Modules.Characters.Models.Enums"
             xmlns:models="using:Writersword.Modules.Characters.Models"
             xmlns:conv="using:Writersword.Modules.Characters.Converters"
             xmlns:icv="using:Writersword.Infrastructure.Converters"
             xmlns:sys="using:System"
             xmlns:colorControls="using:Writersword.Styles.UserControls"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             xmlns:controls="using:Writersword.Modules.Characters.Controls"
             x:Class="Writersword.Modules.Characters.Views.Card.Tabs.CharacterBasicsTabView"
             x:DataType="tabs:CharacterBasicsTabViewModel">

	<UserControl.Resources>
		<conv:IsCustomImportanceConverter x:Key="IsCustomImportanceConverter"/>
		<icv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Ховер-заливка кнопки аватара из темы Fluent — квадратная по умолчанию;
             скругляется в круг под форму самого аватара. -->
		<Style Selector="Button.avatar-round /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="CornerRadius" Value="999"/>
		</Style>

		<!-- Имя персонажа в шапке: выглядит как заголовок, но это TextBox —
             клик по имени сразу даёт его редактировать. Шапка закреплена и
             прокруткой не уезжает, поэтому имя выровнено по левому краю
             рядом с аватаром, а не по центру колонки. -->
		<Style Selector="TextBox.name-title">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="8,3"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="TextBox.name-title:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
		</Style>
		<Style Selector="TextBox.name-title:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Подпись поверх поля имени: показывает то же самое, но с обрезкой
		     многоточием — само поле обрезать не умеет. Отступы и шрифт
		     повторяют поле точь-в-точь, иначе текст дёргается в тот миг,
		     когда подпись сменяется полем. Внешний отступ в единицу —
		     на толщину рамки поля.

		     Она же задаёт ширину поля: подпись меряется ровно по тексту,
		     а поле к измеренной ширине добавляет запас, и рамка тянулась
		     заметно дальше последней буквы.

		     Поэтому подпись не скрывается, а гаснет: скрытая, она перестала
		     бы меряться, и поле схлопнулось бы до наименьшей ширины, стоило
		     навести на него курсор. -->
		<Style Selector="Panel.name-slot">
			<Setter Property="HorizontalAlignment" Value="Left"/>
		</Style>
		<Style Selector="Panel.name-slot:pointerover TextBlock.name-title-trim">
			<Setter Property="Opacity" Value="0"/>
		</Style>
		<Style Selector="Panel.name-slot:focus-within TextBlock.name-title-trim">
			<Setter Property="Opacity" Value="0"/>
		</Style>
		<Style Selector="Panel.name-slot:pointerover TextBlock.name-subtitle-trim">
			<Setter Property="Opacity" Value="0"/>
		</Style>
		<Style Selector="Panel.name-slot:focus-within TextBlock.name-subtitle-trim">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<!-- Значок на месте пустого описания убирается только в правке:
		     под курсором он должен оставаться, по нему и нажимают. Своей
		     подсветки у него нет — под курсором подсвечивается поле, а два
		     выделения на одном месте спорили бы друг с другом. -->
		<Style Selector="Button.subtitle-icon /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.subtitle-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.subtitle-icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Panel.name-slot:focus-within Button.subtitle-icon">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
		</Style>

		<!-- Поле подсвечивается наведением на всю ячейку, а не на себя самого:
		     поверх него лежат подпись и значок, и стоило курсору попасть на
		     них, поле переставало считать себя под курсором — подсветка гасла
		     ровно там, куда человек целится. -->
		<Style Selector="Panel.name-slot:pointerover TextBox.name-title /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
		</Style>
		<Style Selector="Panel.name-slot:pointerover TextBox.name-subtitle /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
		</Style>
		<Style Selector="TextBlock.name-title-trim">
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<!-- Отступ на единицу больше, чем у поля: у поля к отступу
			     добавляется рамка, и без этой единицы текст стоял бы на
			     пиксель левее, а измеренной ширины не хватало бы ровно
			     на рамку. -->
			<Setter Property="Padding" Value="9,3"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<!-- Прижата влево, иначе занимает всю ширину поля, а поле берёт
			     ширину у неё — и значение залипает на самом длинном тексте,
			     что когда-либо был набран. -->
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<Style Selector="TextBlock.name-subtitle-trim">
			<Setter Property="FontSize" Value="12"/>
			<!-- Отступ на единицу больше, чем у поля: у поля к отступу
			     добавляется рамка, и без этой единицы текст стоял бы на
			     пиксель левее, а измеренной ширины не хватало бы ровно
			     на рамку. -->
			<Setter Property="Padding" Value="9,3"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<!-- Прижата влево, иначе занимает всю ширину поля, а поле берёт
			     ширину у неё — и значение залипает на самом длинном тексте,
			     что когда-либо был набран. -->
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>

		<!-- Короткое описание под именем: одна строка, тем же приёмом — поле,
             прикидывающееся подписью, пока его не тронули. -->
		<Style Selector="TextBox.name-subtitle">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="8,3"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="TextBox.name-subtitle:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
		</Style>
		<Style Selector="TextBox.name-subtitle:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Компонент карточки — единица стека. Ядро («Общее») снять нельзя,
		     подключаемые наборы появятся здесь же следующими блоками. Каждый
		     занимает всю ширину колонки: содержимое внутри раскладывается
		     сеткой, а не сжимается по самому длинному полю. -->
		<Style Selector="Border.block">
			<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="18,16"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>
		<!-- Заголовок компонента: акцентный маркер слева и разделитель под
		     текстом задают ритм, по которому глаз отделяет компоненты. -->
		<Style Selector="Border.block-header">
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
			<!-- Линия стоит ровно посередине между названием блока и первой
			     подписью под ним: сверху её держит отступ заголовка, снизу —
			     просвет стопки, общий на весь блок. Оба равны десяти, поэтому
			     своего внешнего отступа заголовку не нужно. -->
			<Setter Property="Padding" Value="0,0,0,10"/>
			<Setter Property="Margin" Value="0,0,0,0"/>
		</Style>
		<Style Selector="TextBlock.block-title">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<!-- Подзаголовок раздела внутри компонента: метки и теги живут
		     в «Общем», но своими разделами, а не сплошной лентой полей. -->
		<Style Selector="TextBlock.subhead">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<!-- Подпись выровнена по середине строки: рядом с ней стоит знак
		     подсказки, он выше её на несколько точек, и без общего выравнивания
		     подпись липнет к верху, а знак висит ниже неё. -->
		<Style Selector="TextBlock.field-label">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<!-- Ступень важности — кнопка, а не кружок с точкой: выбирают одну из
		     четырёх, и плашка показывает выбранное состояние заливкой, без
		     отдельного маркера рядом. Шаблон переопределён целиком — иначе
		     кружок остаётся в разметке и занимает место слева от текста. -->
		<Style Selector="RadioButton.importance">
			<!-- Наименьшая ширина с запасом на самую широкую цифру: иначе
			     тройка перерастает соседей, и ряд идёт ступеньками. -->
			<Setter Property="MinWidth" Value="40"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="8,0"/>
			<!-- Римская цифра набрана шрифтом с засечками: в рубленом шрифте
			     единица и тройка выглядят обрубками палочек, а с засечками
			     читаются именно как цифры. Разрядки нет намеренно — она
			     добавляет пробел после последнего знака, и цифра съезжает
			     влево от середины плашки. -->
			<Setter Property="FontFamily" Value="Georgia, Times New Roman, serif"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<!-- Текст ставит TextBlock, а не ContentPresenter: презентер
			     раскладывает содержимое по своим отступам и метрикам шрифта,
			     и узкий глиф римской единицы вставал в плашке не по середине.
			     TextBlock растянут на всю плашку и центрирует строку сам —
			     и по горизонтали, и по вертикали. -->
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="PART_Plate"
					        Background="{DynamicResource BgSurfaceBrush}"
					        BorderBrush="{DynamicResource BorderDefaultBrush}"
					        BorderThickness="1"
					        CornerRadius="4"
					        Padding="{TemplateBinding Padding}">
						<TextBlock Name="PART_Label"
						           Text="{TemplateBinding Content}"
						           HorizontalAlignment="Stretch"
						           VerticalAlignment="Center"
						           TextAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="RadioButton.importance:pointerover /template/ Border#PART_Plate">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="RadioButton.importance:checked /template/ Border#PART_Plate">
			<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="RadioButton.importance:checked">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<!-- У «своей» ступени вместо цифры слово: ширина растёт по тексту,
		     наименьшей ей быть незачем, а поля по бокам шире, чем у цифр —
		     слово не должно упираться в рамку. Шрифт обычный: засечки нужны
		     цифрам, а не подписи. -->
		<Style Selector="RadioButton.importance-custom">
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="Padding" Value="14,0"/>
			<Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<Style Selector="TextBox.field">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="8,6"/>
		</Style>

		<!-- Знак подсказки у заголовка раздела. Значок тот же, что в палитрах
		     цвета, — это уже принятый в программе знак «здесь есть пояснение»,
		     и заводить рядом второй означало бы учить пользователя двум разным
		     обозначениям одного и того же.
		     Объяснение живёт рядом с тем, что объясняет, а не в отдельной
		     справке, и показывает его общий TooltipBehavior — с заголовком,
		     описанием и местом под гифку. -->
		<Style Selector="Border.hint">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="2"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Help"/>
			<!-- К знаку подводят намеренно, поэтому ждать секунду с лишним,
			     как у обычных кнопок, здесь незачем. -->
			<Setter Property="behaviours:TooltipBehavior.ShowDelay" Value="300"/>
		</Style>
		<Style Selector="Border.hint PathIcon">
			<Setter Property="Width" Value="14"/>
			<Setter Property="Height" Value="14"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="Border.hint:pointerover PathIcon">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<!-- Полоса прокрутки как у списка карточек, но без подложки: дорожка
		     ничего не сообщает, а полосу вдоль всей галереи видно и так.
		     Fluent держит её цвет в двух местах — у самого ScrollBar и
		     у прямоугольника трека внутри шаблона. -->
		<Style Selector="ScrollViewer.tiles-scroll /template/ ScrollBar">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ScrollViewer.tiles-scroll /template/ ScrollBar /template/ Rectangle#TrackRect">
			<Setter Property="Fill" Value="Transparent"/>
			<Setter Property="Stroke" Value="Transparent"/>
		</Style>
		<Style Selector="ScrollViewer.tiles-scroll /template/ ScrollBar /template/ Thumb /template/ Border">
			<Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}"/>
		</Style>
		<Style Selector="ScrollViewer.tiles-scroll /template/ ScrollBar /template/ Thumb:pointerover /template/ Border">
			<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
		</Style>
		<Style Selector="ScrollViewer.tiles-scroll /template/ ScrollBar /template/ Thumb:pressed /template/ Border">
			<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Плитка на месте вставки бледнеет: пока картинку несут, в сетке
		     стоит её тусклая копия, а сама картинка летит под курсором.
		     Соседи при этом расступаются по-настоящему — их перемещение
		     доигрывает переход у сдвига, заведённого в шаблоне плитки. -->
		<Style Selector="Panel.tile">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Panel.tile.placeholder">
			<Setter Property="Opacity" Value="0.35"/>
			<Setter Property="ZIndex" Value="10"/>
		</Style>

		<!-- Крестик на плитке галереи виден только под курсором: в покое
		     галерея — это картинки, а не картинки с кнопками поверх.
		     Прячется прозрачностью, а не IsVisible: скрытый элемент нельзя
		     анимировать, он просто исчезает. -->
		<Style Selector="Button.tile-remove">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Panel.tile:pointerover Button.tile-remove">
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>

		<!-- Действия чипа проявляются под курсором: в покое чип — это значок
		     и название, без частокола микрокнопок. -->
		<Style Selector="Border.chip StackPanel.chip-actions">
			<Setter Property="IsVisible" Value="False"/>
		</Style>
		<Style Selector="Border.chip:pointerover StackPanel.chip-actions">
			<Setter Property="IsVisible" Value="True"/>
		</Style>
		<!-- Чип целиком — кнопка: щелчок открывает редактор. Фон ей не нужен
		     ни в покое, ни под курсором, иначе за скруглённой плашкой чипа
		     проступает прямоугольник системной подсветки. Локального
		     Background="Transparent" мало: тема красит ContentPresenter
		     внутри шаблона, и перебить её можно только оттуда же. -->
		<Style Selector="Button.chip-host /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.chip-host:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.chip-host:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="Button.chip-action">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="2,0"/>
			<Setter Property="Width" Value="16"/>
			<Setter Property="Height" Value="16"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<!-- Закладка группы уезжает за кромку шапки и возвращается из-за неё:
		     не сжимается на месте, а будто её тянут за верхний край. Прячет
		     её обрезка обёртки, поэтому за кромкой ленты не видно.
		
		     Набор переходов объявлен один раз и только здесь. Если задать его
		     ещё и в «.on», при смене класса меняется сам набор, новый не
		     успевает подхватить прежнее значение, и лента перескакивает
		     без движения. -->
		<Style Selector="Path.group-flag">
			<Setter Property="RenderTransform" Value="translateY(-56px)"/>
			<Setter Property="Transitions">
				<Transitions>
					<!-- Кривая падения ленты: резкий старт и долгое мягкое торможение
					     к концу, без перелёта за конечную точку. Те же контрольные
					     точки, что у cubic-bezier(0.165, 0.84, 0.44, 1) в вебе. -->
					<TransformOperationsTransition Property="RenderTransform"
					                               Duration="0:0:0.8">
						<TransformOperationsTransition.Easing>
							<SplineEasing X1="0.165" Y1="0.84" X2="0.44" Y2="1"/>
						</TransformOperationsTransition.Easing>
					</TransformOperationsTransition>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Path.group-flag.on">
			<Setter Property="RenderTransform" Value="none"/>
		</Style>
	</UserControl.Styles>

	<!-- Карточка = закреплённая шапка и прокручиваемый стек компонентов.
	     Шапка не уезжает: при десятке подключённых наборов иначе теряется,
	     чей это персонаж. -->
	<Grid RowDefinitions="Auto,*">
		<!-- ── Шапка ──────────────────────────────────────────────────── -->
		<Border Grid.Row="0"
		        Background="{DynamicResource BgSurfaceBrush}"
		        BorderBrush="{DynamicResource BorderDefaultBrush}"
		        BorderThickness="0,0,0,1"
		        Padding="20,14">
			<!-- Вторая колонка отдана полям вместе со свободным местом:
			     поля прижаты влево и занимают столько, сколько им нужно,
			     остаток колонки — тот самый запас, который ужимается по мере
			     роста имени. Потолок роста — правый край шапки: дальше
			     растянуться некуда, и текст обрезается. -->
			<Grid ColumnDefinitions="Auto,*">

				<!-- Признак группы: закладка-ленточка цветом персонажа, свисающая
				     с верхней кромки шапки — как на карточках основного списка.
				     Отступ вверх гасит верхнее поле шапки, чтобы лента начиналась
				     от самой кромки.
				
				     Обёртка режет по себе, а не по шапке: у шапки обрезка идёт
				     по внутренней области и утащила бы ленту вниз на высоту поля. -->
				<Panel Grid.Column="1"
				       Width="26" Height="52"
				       HorizontalAlignment="Right"
				       VerticalAlignment="Top"
				       Margin="0,-14,104,0"
				       ClipToBounds="True"
				       IsHitTestVisible="False">
					<Path Classes="group-flag"
					      Classes.on="{Binding IsCollective}"
					      Data="M0,0 H10 V15 L5,10.5 L0,15 Z"
					      Fill="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
					      Stretch="Fill"
					      VerticalAlignment="Top"
					      Height="52"/>
				</Panel>

				<!-- Аватар со спутниками. Кнопки идут по дуге слева от кольца,
				     на 152 и 205 градусах — отсчёт от правого горизонта против
				     часовой стрелки. Углы выбраны так, чтобы верхняя кнопка не
				     поднималась выше верхнего края кольца, а нижняя не
				     опускалась ниже нижнего: дуга остаётся в габаритах аватара
				     и шапку не растит.

				     Холст 114 на 84 при кольце 84 — запас ровно под вылет
				     кнопок влево, лишнего места вокруг нет. -->
				<!-- Высота с запасом под значки меток: они садятся снаружи
				     кольца и выходят за габарит кнопки аватара. Запас
				     постоянный, а не по числу меток — иначе шапка дёргалась
				     бы по высоте от того, повесил автор метку или снял. -->
				<Canvas Grid.Column="0"
				        Width="114"
				        Height="104"
				        VerticalAlignment="Center">

					<!-- Цвет выше настроек: его меняют чаще. -->
					<colorControls:ColorPickerButton Canvas.Left="8"
						    Canvas.Top="3"
						    Width="22" Height="22"
						    ShowCardPreview="True"
						    HexColor="{Binding Color, Mode=TwoWay}"
						    PreviewImage="{Binding AvatarBitmap}"
						    PreviewName="{Binding Name}"
						    PreviewFallback="{Binding AvatarGlyph}"
						    RingEnabled="{Binding AvatarRing, Mode=TwoWay}"
						    PreviewIsGroup="{Binding IsCollective}"
						    BookmarkEnabled="{Binding GroupBookmark, Mode=TwoWay}"
						    ApplyRingToAllCommand="{Binding ApplyRingToAllCommand}"/>

					<Button Canvas.Left="6.5"
						    Canvas.Top="56"
						    Width="22" Height="22"
						    Padding="0" CornerRadius="999"
						    Background="#88000000" BorderThickness="0"
						    HorizontalContentAlignment="Center"
						    VerticalContentAlignment="Center"
						    Click="OnCardSettingsClick"
						    behaviours:TooltipBehavior.Tip="Настройки карточки"
						    behaviours:TooltipBehavior.Description="Кольцо вокруг аватара, закладка группы, толщина рамки и вид аватара на карточке списка.">
						<PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
						      Width="12" Height="12"
						      Foreground="White"/>
					</Button>

					<!-- Аватар. Закреплённый элемент обязан быть компактным,
					     поэтому кружок 72 вместо прежних 96: крупный портрет —
					     задача галереи, а не шапки формы. -->
					<Button Canvas.Left="30"
					        Canvas.Top="0"
					        Classes="avatar-round"
					        Command="{Binding OpenPickerCommand}"
					        Background="Transparent"
					        BorderThickness="0"
					        Padding="0"
					        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Avatar_PickTooltip}">
					<Panel Width="84" Height="84">
					<Border Width="72"
					        Height="72"
					        CornerRadius="36"
					        ClipToBounds="True"
					        HorizontalAlignment="Center"
					        VerticalAlignment="Center"
					        Background="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}">
						<Panel>
							<Image Source="{Binding AvatarBitmap}"
							       Stretch="UniformToFill"
							       IsVisible="{Binding AvatarBitmap,
							           Converter={x:Static ObjectConverters.IsNotNull}}"/>

							<TextBlock Text="{Binding AvatarGlyph}"
							           FontSize="30"
							           HorizontalAlignment="Center"
							           VerticalAlignment="Center"
							           Foreground="White"
							           IsVisible="{Binding AvatarBitmap,
							               Converter={x:Static ObjectConverters.IsNull}}"/>
				</Panel>
						</Border>

						<!-- Кольцо цветом персонажа вокруг аватара с зазором -->
						<Border Width="84" Height="84"
						        CornerRadius="999"
						        BorderThickness="3"
						        BorderBrush="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
						        IsHitTestVisible="False"
						        IsVisible="{Binding AvatarRing}"
						        HorizontalAlignment="Center"
						        VerticalAlignment="Center"/>

					</Panel>
					</Button>

					<!-- Значки меток лежат на холсте, а не внутри кнопки аватара:
					     шаблон кнопки режет содержимое по своему скруглению, и
					     значки, выходящие за кружок, обрезались ровно по его
					     краю. Здесь же ничто не режет.

					     Поле 114 на 114 с серединой ровно в середине аватара:
					     аватар стоит на 30 по горизонтали при своих 84, значит
					     его середина — 72 и 42, отсюда и сдвиги. -->
					<ItemsControl Canvas.Left="15"
					              Canvas.Top="-15"
					              Width="114" Height="114"
					              ItemsSource="{Binding CardLabels}"
					              IsHitTestVisible="False"
					              ClipToBounds="False">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<!-- Радиус считается от кольца, а не от кружка: кольцо
								     цвета персонажа кончается на 42, и значок садится
								     сразу за ним. Меньшие радиусы клали значки внутрь
								     портрета, на лицо. -->
								<controls:LabelArcPanel ItemSize="16" ArcRadius="45" Sweep="120"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="models:CharacterLabel">
								<controls:CharacterLabelIcon
									Label="{Binding}"
									IconSize="16"
									RimBrush="{DynamicResource BgSurfaceBrush}"
									RimThickness="1.5"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!-- «Мёртв» — особая метка: одна, в верхнем правом углу
					     аватара под сорок пять градусов, на той же окружности,
					     что и общая нижняя дуга. -->
					<ItemsControl Canvas.Left="15"
					              Canvas.Top="-15"
					              Width="114" Height="114"
					              ItemsSource="{Binding DeadLabels}"
					              IsHitTestVisible="False"
					              ClipToBounds="False">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<controls:LabelArcPanel CenterAngle="-45" ItemSize="16" ArcRadius="45"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="models:CharacterLabel">
								<controls:CharacterLabelIcon
									Label="{Binding}"
									IconSize="16"
									RimBrush="{DynamicResource BgSurfaceBrush}"
									RimThickness="1.5"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

				</Canvas>

				<!-- Имя и короткое описание. Описание остаётся отдельным от
				     заметки: оно идёт в списки и превью, заметка — рабочий
				     текст внутри карточки.

				     Поля растут по тексту от нижней границы до потолка, а не
				     тянутся во всю шапку: строка ввода во весь экран под имя
				     из десяти букв выглядит пустой тратой места.

				     Длинное имя обрезается многоточием. Само поле обрезать
				     не умеет, поэтому в покое поверх него лежит подпись с
				     обрезкой, а под курсором и в правке видно поле целиком —
				     иначе текст нельзя было бы дочитать и поправить. -->
				<StackPanel Grid.Column="1"
				            Spacing="2"
				            VerticalAlignment="Center"
				            HorizontalAlignment="Left"
				            Margin="10,0,10,0">

					<Panel Classes="name-slot" Background="Transparent">
						<TextBox x:Name="NameBox"
						         Classes="name-title"
						         MinWidth="240"
						         Width="{Binding #NameTrim.Bounds.Width}"
						         Text="{Binding Name, Mode=TwoWay}"
						         KeyDown="OnNameTitleKeyDown"/>
						<TextBlock x:Name="NameTrim"
						           Classes="name-title-trim"
						           Text="{Binding Name}"
						           TextTrimming="CharacterEllipsis"
						           IsHitTestVisible="False"
						           Background="{DynamicResource BgSurfaceBrush}"/>
					</Panel>

					<Panel Classes="name-slot" Background="Transparent">
						<TextBox x:Name="ShortDescriptionBox"
						         Classes="name-subtitle"
						         MinWidth="240"
						         Width="{Binding #ShortDescriptionTrim.Bounds.Width}"
						         Text="{Binding ShortDescription, Mode=TwoWay}"/>
						<TextBlock x:Name="ShortDescriptionTrim"
						           Classes="name-subtitle-trim"
						           Text="{Binding ShortDescription}"
						           TextTrimming="CharacterEllipsis"
						           IsHitTestVisible="False"
						           Background="{DynamicResource BgSurfaceBrush}"/>

						<!-- Пока описания нет, на его месте стоит значок строк
						     текста, а не слово: подпись под именем читается как
						     содержимое карточки, и любое слово в ней выглядит
						     чужим описанием. Значок же говорит, что здесь пишут
						     текст, и в глаза не лезет.

						     По нему и нажимают: щелчок ставит курсор в поле.
						     Гаснет он только когда описание правят, — иначе
						     исчезал бы ровно в тот миг, когда к нему тянутся. -->
						<Button Classes="subtitle-icon"
						        Click="OnSubtitleIconClick"
						        HorizontalAlignment="Left"
						        VerticalAlignment="Center"
						        Margin="7,0,0,0"
						        Padding="2"
						        Background="Transparent"
						        BorderThickness="0"
						        IsVisible="{Binding ShortDescription,
						            Converter={x:Static StringConverters.IsNullOrEmpty}}"
						        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Field_ShortDescription}">
							<PathIcon Data="M14 17H4v2h10v-2zm6-8H4v2h16V9zM4 15h16v-2H4v2zM4 5v2h16V5H4z"
							          Width="13" Height="13"
							          Foreground="{DynamicResource TextSecondaryBrush}"/>
						</Button>
					</Panel>
				</StackPanel>

			</Grid>
		</Border>

		<!-- ── Стек компонентов ───────────────────────────────────────── -->
		<!-- Запас снизу больше верхнего: последний блок не должен упираться
		     в край окна — иначе конец списка читается как обрыв. -->
		<!-- Отступы живут на содержимом, а не на самой прокрутке: Padding
		     у ScrollViewer уменьшает область измерения, но не попадает
		     в Extent — нижняя часть контента ровно на высоту отступов
		     обрезается и прокруткой не достаётся. -->
		<ScrollViewer Grid.Row="1" x:Name="BodyScroll">

			<!-- Тело карточки: слева стопка компонентов, справа галерея.
			     Галерея — картинки, на которые смотрят, пока пишут; держать
			     их сбоку удобнее, чем прокручивать к ним каждый раз.
			     Прокручивается всё вместе: это одна область, а не две. -->
			<!-- Ширина правой колонки посчитана под две плитки: 96 + 96,
			     зазоры, отступы блока и полоса прокрутки. Круглое число вроде
			     300 оставляло справа пустую полосу. -->
			<Grid ColumnDefinitions="*,16,264" Margin="20,16">

			<StackPanel Grid.Column="0" Spacing="12"
			            HorizontalAlignment="Stretch">

				<!-- ── Компонент: кто это (снять нельзя) ──────────────── -->
				<Border Classes="block">
					<StackPanel Spacing="10">

						<Border Classes="block-header">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Border Width="3" Height="14" CornerRadius="2"
								        Background="{DynamicResource AccentDefaultBrush}"/>
								<TextBlock Classes="block-title"
								           Text="{x:Static loc:CharactersStrings.Block_Who}"/>
							</StackPanel>
						</Border>

						<!-- Важность идёт первой: это ответ на вопрос, кто перед
						     нами в проекте, и он короче любой заметки. Заметка
						     под ней — самое длинное поле блока, и начинать
						     компонент с высокого прямоугольника значит прятать
						     всё остальное под него. -->
						<Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16">
							<!-- Делитель колонок: тонкая линия по центру блока. Не рамка,
							     а подсказка глазу, где кончается одно и начинается другое. -->
							<Rectangle Grid.Column="1"
							           Width="1"
							           VerticalAlignment="Stretch"
							           Opacity="0.5"
							           Fill="{DynamicResource BorderDefaultBrush}"/>

							<Grid Grid.Column="0" ColumnDefinitions="Auto,16,Auto,16,*">
								<StackPanel Grid.Column="0" Spacing="4">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Classes="field-label"
										           Text="{x:Static loc:CharactersStrings.Field_ImportanceLevel}"/>
										<!-- Что означает выбранная ступень, говорит подсказка: строка
										     под рядом кнопок меняла высоту блока при каждом
										     переключении и уводила вниз всё, что за ней. -->
										<Border Classes="hint"
										        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Field_ImportanceLevel}"
										        behaviours:TooltipBehavior.Description="{Binding ImportanceLevelHint}">
											<PathIcon Data="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
										</Border>
									</StackPanel>

									<!-- Ступени стоят рядом, а не прячутся в списке: их
									     всего четыре, и выбор из четырёх не стоит
									     раскрытия списка. Римская цифра занимает мало
									     места и держит порядок ступеней перед глазами;
									     что она значит, говорит подсказка. -->
									<StackPanel Orientation="Horizontal" Spacing="6">
										<RadioButton Classes="importance"
										             GroupName="Importance"
										             Content="I"
										             IsChecked="{Binding ImportanceLevel,
										                 Converter={StaticResource EnumToBooleanConverter},
										                 ConverterParameter=Primary, Mode=TwoWay}"
										             behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Importance_Primary}"
										             behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Importance_PrimaryHint}"/>

										<RadioButton Classes="importance"
										             GroupName="Importance"
										             Content="II"
										             IsChecked="{Binding ImportanceLevel,
										                 Converter={StaticResource EnumToBooleanConverter},
										                 ConverterParameter=Secondary, Mode=TwoWay}"
										             behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Importance_Secondary}"
										             behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Importance_SecondaryHint}"/>

										<RadioButton Classes="importance"
										             GroupName="Importance"
										             Content="III"
										             IsChecked="{Binding ImportanceLevel,
										                 Converter={StaticResource EnumToBooleanConverter},
										                 ConverterParameter=Tertiary, Mode=TwoWay}"
										             behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Importance_Tertiary}"
										             behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Importance_TertiaryHint}"/>

										<RadioButton Classes="importance importance-custom"
										             GroupName="Importance"
										             Content="{x:Static loc:CharactersStrings.Importance_Custom}"
										             IsChecked="{Binding ImportanceLevel,
										                 Converter={StaticResource EnumToBooleanConverter},
										                 ConverterParameter=Custom, Mode=TwoWay}"
										             behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Importance_Custom}"
										             behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Importance_CustomHint}"/>
									</StackPanel>
								</StackPanel>

								<StackPanel Grid.Column="2" Spacing="4"
								            IsVisible="{Binding ImportanceLevel,
								                Converter={StaticResource IsCustomImportanceConverter}}">
									<TextBlock Classes="field-label"
									           Text="{x:Static loc:CharactersStrings.Field_CustomImportanceLabel}"/>
									<TextBox Classes="field"
									         Width="240"
									         Text="{Binding CustomImportanceLabel, Mode=TwoWay}"/>
								</StackPanel>
							</Grid>

							<!-- ── Группа или человек ─────────────────────── -->
							<!-- Флаг был в модели с самого начала, но задать его
							     из карточки было негде: превью цвета зависело
							     от значения, которое нельзя выставить. -->
							<StackPanel Grid.Column="2"
							            Orientation="Horizontal"
							            Spacing="6"
							            VerticalAlignment="Top">
								<CheckBox IsChecked="{Binding IsCollective, Mode=TwoWay}"
								          Content="{x:Static loc:CharactersStrings.Block_Group}"
								          FontSize="11"
								          Foreground="{DynamicResource TextSecondaryBrush}"/>
								<Border Classes="hint"
								        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Block_Group}"
								        behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Group_Hint}">
									<PathIcon Data="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
								</Border>
							</StackPanel>
						</Grid>

						<!-- Заметка — основное содержимое карточки. Поле растёт
						     под текст: карточка главного героя и карточка
						     стражника с двумя репликами занимают разное место. -->
						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Classes="field-label"
								           Text="{x:Static loc:CharactersStrings.Field_Note}"/>
								<Border Classes="hint"
								        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Field_Note}"
								        behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Hint_Note}">
									<PathIcon Data="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
								</Border>
							</StackPanel>
							<!-- Текст пишется сверху вниз: по умолчанию содержимое
							     прижимается к середине, и первая строка оказывается
							     в центре пустого прямоугольника. -->
							<TextBox Classes="field"
							         Text="{Binding Note, Mode=TwoWay}"
							         PlaceholderText="{x:Static loc:CharactersStrings.Placeholder_Note}"
							         AcceptsReturn="True"
							         TextWrapping="Wrap"
							         VerticalContentAlignment="Top"
							         MinHeight="120"/>
						</StackPanel>

					</StackPanel>
				</Border>

				<!-- ── Компонент: классификация ───────────────────────── -->
				<!-- Метки и теги делают одно — раскладывают персонажа по полкам,
				     только метка видна на карточке, а тег живёт в фильтрах. -->
				<Border Classes="block">
					<StackPanel Spacing="10">

						<Border Classes="block-header">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Border Width="3" Height="14" CornerRadius="2"
								        Background="{DynamicResource AccentDefaultBrush}"/>
								<TextBlock Classes="block-title"
								           Text="{x:Static loc:CharactersStrings.Block_Classification}"/>
							</StackPanel>
						</Border>

						<!-- Метки и теги стоят рядом: оба списка короткие, и полная
						     ширина блока под каждый из них уходила в пустоту. -->
						<Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16">
							<!-- Делитель колонок: тонкая линия по центру блока. Не рамка,
							     а подсказка глазу, где кончаются метки и начинаются
							     теги, поэтому приглушена. -->
							<Rectangle Grid.Column="1"
							           Width="1"
							           VerticalAlignment="Stretch"
							           Opacity="0.5"
							           Fill="{DynamicResource BorderDefaultBrush}"/>

							<!-- ── Метки ──────────────────────────────────── -->
							<StackPanel Grid.Column="0" Spacing="4">
								<Grid ColumnDefinitions="Auto,*,Auto">
									<StackPanel Grid.Column="0"
									            Orientation="Horizontal" Spacing="6">
										<TextBlock Classes="subhead"
										           Text="{x:Static loc:CharactersStrings.Field_Labels}"/>
										<Border Classes="hint"
										        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Field_Labels}"
										        behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Hint_Labels}">
											<PathIcon Data="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
										</Border>
									</StackPanel>

									<!-- Быстрая отметка «мёртв»: встроенная метка. Кнопка
									     исчезает, как только метка появилась — состояние
									     дальше показывает её чип, а не два разных органа. -->
									<Button Grid.Column="2"
									    Click="OnMarkDeadClick"
									    IsVisible="{Binding !IsDead}"
									    Background="Transparent"
									    BorderBrush="{DynamicResource BorderDefaultBrush}"
									    BorderThickness="1"
									    CornerRadius="12"
									    Padding="10,3"
									    FontSize="11"
									    Foreground="{DynamicResource TextSecondaryBrush}">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<Border Width="14" Height="14" CornerRadius="7" Background="#B71C1C">
												<Path Data="M12,2C7.03,2 3,6.03 3,11c0,2.85 1.34,5.38 3.42,7.02V21c0,0.55 0.45,1 1,1h1.5v-2h2v2h2v-2h2v2H16c0.55,0 1,-0.45 1,-1v-2.98C19.66,16.38 21,13.85 21,11C21,6.03 16.97,2 12,2zM8.5,13C7.67,13 7,12.33 7,11.5C7,10.67 7.67,10 8.5,10s1.5,0.67 1.5,1.5C10,12.33 9.33,13 8.5,13zM15.5,13c-0.83,0 -1.5,-0.67 -1.5,-1.5c0,-0.83 0.67,-1.5 1.5,-1.5s1.5,0.67 1.5,1.5C17,12.33 16.33,13 15.5,13z"
												      Fill="White" Stretch="Uniform" Margin="2"/>
											</Border>
											<TextBlock Text="{x:Static loc:CharactersStrings.Label_Dead}" VerticalAlignment="Center"/>
										</StackPanel>
									</Button>
								</Grid>

								<ItemsControl ItemsSource="{Binding Labels}" IsVisible="{Binding HasLabels}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="models:CharacterLabel">
											<!-- Чип метки заодно перетаскивается: порядок
											     задавался только стрелками, а на десятке
											     меток это утомительно. Щелчок по-прежнему
											     открывает редактор — перетаскивание
											     начинается только после сдвига мыши
											     на несколько пикселей. -->
											<Button Classes="chip-host" Background="Transparent"
											        BorderThickness="0"
											        Padding="0"
											        Margin="0,0,6,6"
											        Click="OnLabelChipClick"
											        DragDrop.AllowDrop="True"
											        PointerPressed="OnLabelChipPointerPressed"
											        PointerMoved="OnLabelChipPointerMoved"
											        PointerReleased="OnLabelChipPointerReleased"
											        DragDrop.DragOver="OnLabelChipDragOver"
											        DragDrop.Drop="OnLabelChipDrop">
												<Border Classes="chip"
												        Background="{DynamicResource BgSurfaceBrush}"
												        BorderBrush="{DynamicResource BorderDefaultBrush}"
												        BorderThickness="1"
												        CornerRadius="12"
												        Padding="6,4"
												        behaviours:TooltipBehavior.Description="{Binding Description}">
													<StackPanel Orientation="Horizontal" Spacing="6">
														<controls:CharacterLabelIcon
															Label="{Binding}"
															IconSize="16"
															VerticalAlignment="Center"/>
														<TextBlock Text="{Binding Name}"
														           FontSize="11"
														           VerticalAlignment="Center"
														           Foreground="{DynamicResource TextPrimaryBrush}"/>

														<StackPanel Classes="chip-actions"
														            Orientation="Horizontal"
														            Spacing="0"
														            VerticalAlignment="Center">
															<Button Classes="chip-action" Click="OnLabelMoveLeftClick">
																<Path Data="M15.41,7.41 L14,6 8,12 14,18 15.41,16.59 10.83,12z"
																      Fill="{DynamicResource TextSecondaryBrush}"
																      Stretch="Uniform"
																      Width="8" Height="8"/>
															</Button>
															<Button Classes="chip-action" Click="OnLabelMoveRightClick">
																<Path Data="M10,6 L8.59,7.41 13.17,12 8.59,16.59 10,18 16,12z"
																      Fill="{DynamicResource TextSecondaryBrush}"
																      Stretch="Uniform"
																      Width="8" Height="8"/>
															</Button>
															<Button Classes="chip-action" Click="OnLabelRemoveClick">
																<Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
																      Fill="{DynamicResource TextSecondaryBrush}"
																      Stretch="Uniform"
																      Width="8" Height="8"/>
															</Button>
														</StackPanel>
													</StackPanel>
												</Border>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" MaxWidth="240"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<!-- Ввод метки подсказывает уже заведённые в проекте:
									     совпадение по имени подхватывает саму метку
									     со значком и цветом, а не заводит похожую. -->
									<AutoCompleteBox Grid.Column="0"
									                 ItemsSource="{Binding KnownLabelNames}"
									                 FilterMode="ContainsOrdinal"
									                 MinimumPrefixLength="1"
									                 MaxDropDownHeight="180"
									                 PlaceholderText="{x:Static loc:CharactersStrings.Label_AddPlaceholder}"
									                 KeyDown="OnNewLabelKeyDown"
									                 FontSize="12"
									                 Background="{DynamicResource BgSurfaceBrush}"
									                 Foreground="{DynamicResource TextPrimaryBrush}"
									                 BorderBrush="{DynamicResource BorderDefaultBrush}"
									                 BorderThickness="1"
									                 CornerRadius="4"
									                 Padding="8,6"/>
									<Button Grid.Column="1"
									        Margin="6,0,0,0"
									        Content="{x:Static loc:CharactersStrings.Button_AddLabel}"
									        Click="OnAddLabelClick"
									        FontSize="11"
									        Padding="10,6"
									        CornerRadius="4"/>
								</Grid>
							</StackPanel>

							<!-- ── Теги ───────────────────────────────────── -->
							<StackPanel Grid.Column="2" Spacing="4">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Classes="subhead"
									           Text="{x:Static loc:CharactersStrings.Field_Tags}"/>
									<Border Classes="hint"
									        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Field_Tags}"
									        behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Hint_Tags}">
										<PathIcon Data="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
									</Border>
								</StackPanel>

								<ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<!-- Тип элемента указан явно: без него компилируемые
										     привязки взяли бы вьюмодель вместо строки тега. -->
										<DataTemplate x:DataType="sys:String">
											<!-- Тег — короткое слово, и раздувать его в плашку
											     размером с кнопку незачем: отступы вдвое
											     меньше, чем у меток, которые несут значок
											     и цвет. -->
											<Border Classes="chip"
											        Background="{DynamicResource AccentSubtleBrush}"
											        CornerRadius="10"
											        Padding="6,1"
											        Margin="0,0,4,4">
												<StackPanel Orientation="Horizontal" Spacing="2">
													<TextBlock Text="{Binding}"
													           FontSize="11"
													           VerticalAlignment="Center"
													           Foreground="{DynamicResource TextPrimaryBrush}"/>
													<StackPanel Classes="chip-actions"
													            Orientation="Horizontal"
													            VerticalAlignment="Center">
														<Button Classes="chip-action" Click="OnTagRemoveClick">
															<Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
															      Fill="{DynamicResource TextSecondaryBrush}"
															      Stretch="Uniform"
															      Width="8" Height="8"/>
														</Button>
													</StackPanel>
												</StackPanel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<!-- Ввод тега с подсказкой уже заведённых в проекте:
								     список фильтруется по мере набора, выбор из него
								     кладёт готовое значение в поле, Enter добавляет.
								     Это дешёвая защита от трёх написаний одного тега,
								     после которых фильтр списка перестаёт работать. -->
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" MaxWidth="240"/>
									</Grid.ColumnDefinitions>
									<AutoCompleteBox ItemsSource="{Binding KnownTags}"
								                 FilterMode="ContainsOrdinal"
								                 MinimumPrefixLength="1"
								                 MaxDropDownHeight="180"
								                 PlaceholderText="{x:Static loc:CharactersStrings.Tag_AddPlaceholder}"
								                 KeyDown="OnNewTagKeyDown"
								                 FontSize="12"
								                 Background="{DynamicResource BgSurfaceBrush}"
								                 Foreground="{DynamicResource TextPrimaryBrush}"
								                 BorderBrush="{DynamicResource BorderDefaultBrush}"
								                 BorderThickness="1"
									                 CornerRadius="4"
									                 Padding="8,6"/>
								</Grid>
							</StackPanel>
						</Grid>

					</StackPanel>
				</Border>

				<!-- ── Компонент: имена ───────────────────────────────── -->
				<!-- Отображаемое имя правится в шапке, здесь остальные. -->
				<Border Classes="block">
					<StackPanel Spacing="10">

						<Border Classes="block-header">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Border Width="3" Height="14" CornerRadius="2"
								        Background="{DynamicResource AccentDefaultBrush}"/>
								<TextBlock Classes="block-title"
								           Text="{x:Static loc:CharactersStrings.Block_Names}"/>
							</StackPanel>
						</Border>

						<!-- ── Другие имена ───────────────────────────── -->
						<!-- Отображаемое имя правится в шапке, здесь живут
						     остальные: прежние, будущие, прозвища. Поиск идёт
						     по всем сразу, поэтому персонаж, ставший Дианой,
						     находится и по имени Вадим. -->
						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Classes="subhead"
								           Text="{x:Static loc:CharactersStrings.Field_AlternateNames}"/>
								<Border Classes="hint"
								        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Field_AlternateNames}"
								        behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Hint_AlternateNames}">
									<PathIcon Data="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
								</Border>
							</StackPanel>

							<ItemsControl ItemsSource="{Binding AlternateNames}" IsVisible="{Binding HasAlternateNames}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="models:CharacterNameEntry">
										<!-- Щелчок по чипу возвращает имя в поле ввода
										     вместе с пометкой: правка идёт тем же
										     потоком, что и добавление, отдельного
										     редактора под одно поле не заводим. -->
										<Button Classes="chip-host" Background="Transparent"
										        BorderThickness="0"
										        Padding="0"
										        Margin="0,0,6,6"
										        Click="OnNameChipClick">
										<Border Classes="chip"
										        Background="{DynamicResource BgSurfaceBrush}"
										        BorderBrush="{DynamicResource BorderDefaultBrush}"
										        BorderThickness="1"
										        CornerRadius="12"
										        Padding="10,4">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<TextBlock Text="{Binding Value}"
												           FontSize="11"
												           VerticalAlignment="Center"
												           Foreground="{DynamicResource TextPrimaryBrush}"/>

												<!-- Пометка происхождения имени показывается,
												     только если автор её задал. -->
												<TextBlock Text="{Binding Note}"
												           FontSize="11"
												           VerticalAlignment="Center"
												           Foreground="{DynamicResource TextSecondaryBrush}"
												           IsVisible="{Binding Note,
												               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

												<StackPanel Classes="chip-actions"
												            Orientation="Horizontal"
												            Spacing="0"
												            VerticalAlignment="Center">
													<Button Classes="chip-action"
													        Click="OnNameMakePrimaryClick"
													        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Name_MakePrimary}">
														<Path Data="M4,12l1.41,1.41L11,7.83V20h2V7.83l5.58,5.59L20,12l-8-8L4,12z"
														      Fill="{DynamicResource TextSecondaryBrush}"
														      Stretch="Uniform"
														      Width="8" Height="8"/>
													</Button>
													<Button Classes="chip-action" Click="OnNameRemoveClick">
														<Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
														      Fill="{DynamicResource TextSecondaryBrush}"
														      Stretch="Uniform"
														      Width="8" Height="8"/>
													</Button>
												</StackPanel>
											</StackPanel>
										</Border>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Поле без приглашающей надписи: под заголовком
							     «другие имена» и так ясно, что сюда вводят имя,
							     а пример вроде «Алина» в каждой карточке читается
							     как чужое значение. -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" MaxWidth="240"/>
								</Grid.ColumnDefinitions>
								<TextBox Classes="field"
								         x:Name="NewNameBox"
								         KeyDown="OnNewNameKeyDown"/>
							</Grid>
						</StackPanel>

						<!-- Обращения по группам сняты с карточки: кто как кого
						     зовёт — свойство отношений, а не самого персонажа,
						     и на карточке это читалось как отдельная механика
						     без видимой пользы. Модель и разрешение обращений
						     остались нетронутыми, данные никуда не делись. -->

					</StackPanel>
				</Border>

				<!-- ── Компонент: наборы полей ────────────────────────── -->
				<!-- Состав карточки — свойство ядра, поэтому наборы подключаются
				     здесь, а не на вкладке параметров: там живут значения полей.
				     Карточка складывается из наборов, как объект из компонентов.

				     Идёт последним: сперва кто это, потом из чего карточка
				     собрана. Кнопка подключения — в самом низу блока, под
				     списком уже подключённого.

				     Блока нет, пока в проекте нет ни одного набора: пустой
				     раздел про механику, которой человек не пользуется, только
				     отнимает внимание. -->
				<Border Classes="block"
				        IsVisible="{Binding HasAnySets}">
					<StackPanel Spacing="10">

						<Border Classes="block-header">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Border Width="3" Height="14" CornerRadius="2"
								        Background="{DynamicResource AccentDefaultBrush}"/>
								<TextBlock Classes="block-title"
								           Text="{x:Static loc:CharactersStrings.Block_DataSets}"/>
								<Border Classes="hint"
								        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Block_DataSets}"
								        behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Hint_Sets}">
									<PathIcon Data="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
								</Border>
							</StackPanel>
						</Border>

						<ItemsControl ItemsSource="{Binding AttachedAnketas}"
						              IsVisible="{Binding HasAttachedAnketas}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel Orientation="Horizontal"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="models:CharacterAnketa">
									<Border Background="{DynamicResource AccentSubtleBrush}"
									        CornerRadius="12"
									        Padding="10,4"
									        Margin="0,0,6,6"
									        behaviours:TooltipBehavior.Description="{Binding Description}">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="{Binding Name}"
											           FontSize="11"
											           VerticalAlignment="Center"
											           Foreground="{DynamicResource TextPrimaryBrush}"/>
											<Button Click="OnDetachAnketaClick"
											        Background="Transparent"
											        BorderThickness="0"
											        Padding="0"
											        Width="14" Height="14"
											        HorizontalContentAlignment="Center"
											        VerticalContentAlignment="Center"
											        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Anketa_DetachTip}"
											        behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Anketa_DetachHint}">
												<Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
												      Fill="{DynamicResource TextSecondaryBrush}"
												      Stretch="Uniform"
												      Width="8" Height="8"/>
											</Button>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!-- Кнопка вместо выпадающего списка: список того, что
						     можно подключить, разворачивается из неё, а сама
						     она читается как действие, а не как поле выбора. -->
						<Button x:Name="AttachAnketaButton"
						        IsVisible="{Binding CanAttachAnketa}"
						        Content="{x:Static loc:CharactersStrings.Button_AddSet}"
						        HorizontalAlignment="Left">
							<Button.Flyout>
								<Flyout Placement="BottomEdgeAlignedLeft">
									<ItemsControl ItemsSource="{Binding AvailableAnketas}"
									              MinWidth="220">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="models:CharacterAnketa">
												<!-- Видно, что даст подключение: название,
												     для чего набор и сколько полей приедет.
												     Иначе выбор вслепую. -->
												<Button Click="OnAttachAnketaClick"
												        HorizontalAlignment="Stretch"
												        HorizontalContentAlignment="Left"
												        Background="Transparent"
												        BorderThickness="0"
												        Padding="8,6"
												        CornerRadius="4"
												        behaviours:TooltipBehavior.Description="{Binding Description}">
													<StackPanel Spacing="1">
														<TextBlock Text="{Binding Name}" FontSize="12"/>
														<TextBlock FontSize="10"
														           Foreground="{DynamicResource TextSecondaryBrush}">
															<Run Text="{x:Static loc:CharactersStrings.Sets_FieldCount}"/>
															<Run Text="{Binding Fields.Count}"/>
														</TextBlock>
													</StackPanel>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Flyout>
							</Button.Flyout>
						</Button>
					</StackPanel>
				</Border>

			</StackPanel>

			<!-- Правая колонка: картинки. Слева суть персонажа и его состав,
			     справа образ. Галерея сбоку затем, чтобы он был перед глазами,
			     пока правишь остальное, а не в конце длинной прокрутки. -->
			<StackPanel Grid.Column="2" Spacing="12">

				<!-- ── Компонент: галерея ─────────────────────────────── -->
				<!-- Не пикер аватаров: тот про выбор одного значка. Здесь
				     образы, на которые смотрят, когда пишут сцену. -->
				<Border Classes="block">
					<!-- Плитки идут сразу за разделителем: между ними только
					     отступ самого заголовка, без общего просвета блока.
					     Пустой полосы под линией здесь быть не должно —
					     содержимое блока начинается с картинок. -->
					<StackPanel Spacing="0">

						<Border Classes="block-header">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Border Width="3" Height="14" CornerRadius="2"
								        Background="{DynamicResource AccentDefaultBrush}"/>
								<TextBlock Classes="block-title"
								           Text="{x:Static loc:CharactersStrings.Block_Gallery}"/>
								<Border Classes="hint"
								        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Block_Gallery}"
								        behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Gallery_Hint}">
									<PathIcon Data="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
								</Border>
							</StackPanel>
						</Border>

						<!-- Прокрутка начинается после трёх рядов: галерея не должна
						     оттеснять остальное вниз, когда картинок много.
						     Плитка добавления идёт последней в той же сетке,
						     поэтому список виден всегда. -->
						<!-- Высота под четыре ряда: восемь картинок помещаются
						     без прокрутки, дальше она появляется сама.
						     Справа оставлен запас под полосу — в теме она рисуется
						     поверх содержимого и без запаса налезала бы на плитки. -->
						<!-- AllowAutoHide=False заставляет полосу занимать своё место,
						     а не рисоваться поверх плиток. Появляется она только
						     когда картинок больше восьми, поэтому в остальное время
						     галерея занимает всю ширину без дыры справа. -->
						<ScrollViewer Classes="tiles-scroll"
						              x:Name="GalleryScroll"
						              MaxHeight="464"
						              VerticalScrollBarVisibility="Auto"
						              HorizontalScrollBarVisibility="Disabled"
						              AllowAutoHide="False"
						              PointerWheelChanged="OnGalleryWheel">
						<!-- Зазор задаётся отступом плиток во все стороны, а внешние
						     края съедаются отрицательным отступом сетки: иначе
						     справа и снизу зазор есть, а слева и сверху нет.
						     Справа отодвинуто на 2: вместе с отступом плитки это
						     даёт просвет до полосы, но не создаёт заметной
						     разницы с левым краем, где плитка стоит вплотную. -->
						<ItemsControl ItemsSource="{Binding Gallery}"
						              Margin="-4,-4,2,-4">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<!-- Две равные колонки вместо потока: плитки
									     делят ширину поровну и заполняют блок
									     целиком, без хвоста справа. -->
									<UniformGrid Columns="2"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="tabs:CharacterGalleryItemViewModel">
									<!-- Аватар меняется через правую кнопку, а не щелчком
									     по картинке: водя мышью по галерее, сменить его
									     случайно слишком легко. Само действие отменяемое
									     общим Ctrl+Z модуля. -->
									<!-- Аватар ставится через правую кнопку, а не щелчком:
									     водя мышью по галерее, сменить его случайно
									     слишком легко. Крестик оставлен на виду —
									     удаление не должно прятаться в меню.
									     Background обязателен: без заливки панель
									     не участвует в проверке попадания, и меню
									     по правой кнопке не открывается. -->
									<!-- У шаблона один корень: обе плитки — картинка
									     и «добавить» — лежат в общей обёртке
									     и показываются по признаку элемента. -->
									<Panel>

									<!-- Плитка добавления стоит в той же сетке последней:
									     отдельная кнопка под галереей читалась бы как
									     другой орган, а не как следующее место. -->
									<!-- Картинки можно и бросить сюда: из проводника,
									     браузера, откуда угодно, что отдаёт файл. -->
									<!-- Высота равна собственной ширине: ячейка сетки
									     тянется по колонке, и без этого плитка выходит
									     прямоугольной. -->
									<Button Height="{Binding $self.Bounds.Width}"
									        Margin="4"
									        Padding="0"
									        Click="OnGalleryAddClick"
									        IsVisible="{Binding IsAddTile}"
									        DragDrop.AllowDrop="True"
									        DragDrop.DragOver="OnGalleryDragOver"
									        DragDrop.Drop="OnGalleryDrop"
									        HorizontalAlignment="Stretch"
									        Background="{DynamicResource BgSurfaceBrush}"
									        BorderBrush="{DynamicResource BorderDefaultBrush}"
									        BorderThickness="1"
									        CornerRadius="8"
									        HorizontalContentAlignment="Center"
									        VerticalContentAlignment="Center"
									        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Gallery_Add}">
										<StackPanel Spacing="4" HorizontalAlignment="Center">
											<PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
											          Width="20" Height="20"
											          HorizontalAlignment="Center"
											          Foreground="{DynamicResource TextSecondaryBrush}"/>
											<TextBlock Text="{x:Static loc:CharactersStrings.Gallery_Add}"
											           FontSize="10"
											           TextAlignment="Center"
											           Foreground="{DynamicResource TextSecondaryBrush}"/>
										</StackPanel>
									</Button>

									<!-- Размер плитки задан явно: без него обёртка
									     меряется по содержимому, и ряды разъезжаются
									     на пару пикселей каждый. -->
									<!-- Плитка тащится за собой, как карточка персонажа
									     в списке: порог сдвига тот же, поэтому обычный
									     щелчок и меню по правой кнопке работают. -->
									<Panel Classes="tile"
									       Classes.placeholder="{Binding IsPlaceholder}"
									       Height="{Binding $self.Bounds.Width}"
									       Margin="4"
									       IsVisible="{Binding !IsAddTile}"
									       Background="Transparent"
									       DragDrop.AllowDrop="True"
									       DragDrop.DragOver="OnGalleryDragOver"
									       DragDrop.Drop="OnGalleryDrop">

										<!-- Сдвиг с переходом: соседи расступаются перед местом
										     вставки не рывком, а доездом. Вью ставит сюда
										     разницу между старым и новым положением плитки
										     и тут же ведёт её к нулю. -->
										<Panel.RenderTransform>
											<TranslateTransform>
												<TranslateTransform.Transitions>
													<Transitions>
														<DoubleTransition Property="X"
														                  Duration="0:0:0.28"
														                  Easing="CubicEaseOut"/>
														<DoubleTransition Property="Y"
														                  Duration="0:0:0.28"
														                  Easing="CubicEaseOut"/>
													</Transitions>
												</TranslateTransform.Transitions>
											</TranslateTransform>
										</Panel.RenderTransform>

										<Panel.ContextMenu>
											<ContextMenu>
												<MenuItem Header="{x:Static loc:CharactersStrings.Gallery_UseAsAvatar}"
												          Click="OnGalleryUseAsAvatarClick"/>
												<Separator/>
												<MenuItem Header="{x:Static loc:CharactersStrings.Gallery_Remove}"
												          Click="OnGalleryRemoveClick"/>
											</ContextMenu>
										</Panel.ContextMenu>

										<Border CornerRadius="8"
										        ClipToBounds="True"
										        BorderBrush="{DynamicResource BorderDefaultBrush}"
										        BorderThickness="1">
											<Image Source="{Binding Preview}"
											       Stretch="UniformToFill"/>
										</Border>

										<Button Classes="tile-remove"
										        Click="OnGalleryRemoveClick"
										        HorizontalAlignment="Right"
										        VerticalAlignment="Top"
										        Margin="4"
										        Width="18" Height="18"
										        Padding="0"
										        CornerRadius="999"
										        Background="#AA000000"
										        BorderThickness="0"
										        HorizontalContentAlignment="Center"
										        VerticalContentAlignment="Center"
										        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Gallery_Remove}">
											<Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
											      Fill="White"
											      Stretch="Uniform"
											      Width="8" Height="8"/>
										</Button>
									</Panel>

								</Panel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						</ScrollViewer>
					</StackPanel>
				</Border>

			</StackPanel>
		</Grid>
		</ScrollViewer>

		<!-- Призрак перетаскиваемой картинки — как у карточек в списке
		     персонажей: системное перетаскивание перехватывает указатель
		     и своего превью не рисует, поэтому плитка переносится вручную,
		     а под курсором летит эта копия. -->
		<!-- Холст растянут на обе строки: координаты призрака считаются
		     от всей карточки, и в одной строке он уезжал вниз на высоту шапки. -->
		<Canvas Grid.Row="0" Grid.RowSpan="2"
		        x:Name="GalleryGhostCanvas"
		        IsVisible="False"
		        IsHitTestVisible="False">
			<Border x:Name="GalleryGhost"
			        Width="96" Height="96"
			        CornerRadius="8"
			        ClipToBounds="True"
			        Opacity="0.85"
			        BorderBrush="{DynamicResource AccentDefaultBrush}"
			        BorderThickness="2">
				<Image x:Name="GalleryGhostImage" Stretch="UniformToFill"/>
			</Border>
		</Canvas>
	</Grid>
</UserControl>
