<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Characters.ViewModels.Avatars"
             xmlns:loc="using:Writersword.Src.Modules.Characters.Resources"
             x:Class="Writersword.Modules.Characters.Views.Avatars.CharacterAvatarPackManagerOverlay"
             x:DataType="vm:CharacterAvatarPackManagerViewModel">

	<Grid>
		<!-- Затемнение -->
		<Border Background="Black" Opacity="0.55" IsHitTestVisible="True"/>

		<!-- Окно менеджера -->
		<Border MaxWidth="700" MaxHeight="500"
                Margin="40"
                CornerRadius="12"
                Background="{DynamicResource BgBaseBrush}"
                BoxShadow="0 8 32 0 #88000000">
			<Grid RowDefinitions="Auto,*,Auto">

				<!-- Заголовок -->
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,16,10">
					<TextBlock Text="{x:Static loc:CharactersStrings.AvatarPackManager_Title}"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
					<Button Grid.Column="1"
                            Content="✕"
                            Command="{Binding CloseCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,2"/>
				</Grid>

				<!-- Основное содержимое -->
				<Grid Grid.Row="1" ColumnDefinitions="200,*">

					<!-- Левая панель: список паков -->
					<Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="0,1,1,0">
						<Grid RowDefinitions="*,Auto">

							<ScrollViewer Grid.Row="0">
								<ItemsControl ItemsSource="{Binding Packs}">
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="vm:CharacterAvatarPackManagerPackViewModel">
											<Border Margin="4,2" Padding="10,6" CornerRadius="6"
                                                    Cursor="Hand">
												<Border.Styles>
													<Style Selector="Border.pack-selected">
														<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
													</Style>
													<Style Selector="Border.pack-normal">
														<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
													</Style>
													<Style Selector="Border.pack-normal:pointerover">
														<Setter Property="Opacity" Value="0.85"/>
													</Style>
												</Border.Styles>
												<StackPanel>
													<TextBlock Text="{Binding DisplayName}" FontSize="12"/>
													<TextBlock Text="{x:Static loc:CharactersStrings.AvatarPackManager_BuiltInBadge}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               IsVisible="{Binding IsBuiltIn}"/>
												</StackPanel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>

							<!-- Создать / импортировать -->
							<StackPanel Grid.Row="1" Margin="4" Spacing="4">
								<TextBox Text="{Binding NewPackName}"
                                         PlaceholderText="{x:Static loc:CharactersStrings.AvatarPackManager_NewPackPlaceholder}"
                                         FontSize="11" Padding="6,4"/>
								<Button Content="{x:Static loc:CharactersStrings.AvatarPackManager_CreatePack}"
                                        Command="{Binding CreatePackCommand}"
                                        HorizontalAlignment="Stretch"
                                        Padding="6,4" FontSize="11"/>
								<Button Content="{x:Static loc:CharactersStrings.AvatarPackManager_ImportZip}"
                                        Command="{Binding ImportPackCommand}"
                                        HorizontalAlignment="Stretch"
                                        Padding="6,4" FontSize="11"/>
							</StackPanel>
						</Grid>
					</Border>

					<!-- Правая панель: аватарки -->
					<Border Grid.Column="1"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="0,1,0,0">
						<Grid RowDefinitions="*,Auto">

							<ScrollViewer Grid.Row="0">
								<Panel>
									<TextBlock Text="{x:Static loc:CharactersStrings.AvatarPackManager_SelectPackHint}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,40"
                                               IsVisible="{Binding SelectedPack,
                                                   Converter={x:Static ObjectConverters.IsNull}}"/>

									<ItemsControl ItemsSource="{Binding SelectedPack.Items}"
                                                  IsVisible="{Binding HasSelectedPack}"
                                                  Margin="8">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel Orientation="Horizontal"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="vm:CharacterAvatarPackManagerItemViewModel">
												<Border Width="70" Height="82" Margin="4"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource BgPanelBrush}"
                                                        ToolTip.Tip="{Binding ToolTip}">
													<StackPanel Spacing="4" Margin="4"
                                                                VerticalAlignment="Center">
														<Border Width="52" Height="52" CornerRadius="26"
                                                                ClipToBounds="True"
                                                                HorizontalAlignment="Center">
															<Image Source="{Binding Thumbnail}"
                                                                   Stretch="UniformToFill"/>
														</Border>
														<TextBlock Text="{Binding FileName}"
                                                                   FontSize="9"
                                                                   HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="62"/>
													</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Panel>
							</ScrollViewer>

							<!-- Кнопки пака -->
							<StackPanel Grid.Row="1" Orientation="Horizontal"
                                        Spacing="6" Margin="8,6"
                                        IsVisible="{Binding CanEditPack}">
								<Button Content="{x:Static loc:CharactersStrings.AvatarPackManager_ExportZip}"
                                        Command="{Binding ExportPackCommand}"
                                        Padding="8,4" FontSize="11"/>
								<Button Content="{x:Static loc:CharactersStrings.AvatarPackManager_DeletePack}"
                                        Command="{Binding DeletePackCommand}"
                                        Padding="8,4" FontSize="11"
                                        Foreground="OrangeRed"/>
							</StackPanel>
						</Grid>
					</Border>
				</Grid>

				<!-- Подсказка -->
				<Border Grid.Row="2"
                        Padding="16,8"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="0,1,0,0">
					<TextBlock FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="{x:Static loc:CharactersStrings.AvatarPackManager_BuiltInHint}"/>
				</Border>
			</Grid>
		</Border>
	</Grid>
</UserControl>