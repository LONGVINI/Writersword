<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AssemblyName>Writersword.Notes</AssemblyName>
		<RootNamespace>Writersword.Src.Modules.Notes</RootNamespace>
		<!-- SDK сам подхватывает все *.cs и *.axaml из папки проекта.
		     Явные Include не нужны — они создают дубликаты (NETSDK1022). -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\*.resx" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
		<PackageReference Include="Serilog" Version="4.3.2-dev-02419" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Core лежит в Src/ — два уровня вверх от Src/Modules/Notes/ -->
		<ProjectReference Include="..\..\Writersword.Core.csproj" />
		<!-- Общие контролы и поведения оформления: ModalHost, стили ленты,
		     компактный флажок. Без этой ссылки разметка модуля не собирается,
		     а сам модуль рисовался бы штатной Fluent-темой вместо программы. -->
		<ProjectReference Include="..\..\..\Writersword.UI.Shared.csproj" />
	</ItemGroup>

</Project>
