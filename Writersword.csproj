<Project Sdk="Microsoft.NET.Sdk">

	<!-- ========================================
       НАСТРОЙКИ ПРОЕКТА
       ======================================== -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<AssemblyName>Writersword</AssemblyName>
		<RootNamespace>Writersword</RootNamespace>
		<Version>1.0.0</Version>
		<Product>Writersword</Product>
		<Company>Writersword Team</Company>
		<Copyright>Copyright © 2025</Copyright>
		<Description>Multi-modal writing application for writers, poets, screenwriters, and game developers</Description>
		<ApplicationIcon>Resources\Images\icon.ico</ApplicationIcon>

		<!-- Отключаем автоматическое включение .resx (будем управлять вручную) -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	</PropertyGroup>

	<!-- ========================================
       КОНФИГУРАЦИОННЫЕ ФАЙЛЫ
       ======================================== -->
	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- ========================================
       AVALONIA UI + DOCK СИСТЕМА
       ======================================== -->
	<ItemGroup>
		<!-- Основные пакеты Avalonia (версия 11.3.10) -->
		<PackageReference Include="Avalonia" Version="11.3.10" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
		<PackageReference Include="Avalonia.Diagnostics" Version="11.3.10" />
		<PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />
		<PackageReference Include="Avalonia.Xaml.Interactivity" Version="11.3.0.6" />

		<!-- Dock система (11.3.8 совместима с Avalonia 11.3.10) -->
		<PackageReference Include="Dock.Avalonia" Version="11.3.8" />
		<PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="11.3.8" />
		<PackageReference Include="Dock.Model" Version="11.3.8" />
		<PackageReference Include="Dock.Model.Avalonia" Version="11.3.8" />
		<PackageReference Include="Dock.Serializer.Newtonsoft" Version="11.3.8" />
		<PackageReference Include="Dock.Settings" Version="11.3.8" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<!-- ========================================
       MVVM + DEPENDENCY INJECTION
       ======================================== -->
	<ItemGroup>
		<PackageReference Include="ReactiveUI" Version="20.1.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
	</ItemGroup>

	<!-- ========================================
       ЛОКАЛИЗАЦИЯ + JSON
       ======================================== -->
	<ItemGroup>
		<PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<!-- ========================================
       РЕСУРСЫ (картинки, стили)
       ======================================== -->
	<ItemGroup>
		<!-- Включаем все ресурсы КРОМЕ локализации -->
		<AvaloniaResource Include="Resources\**" Exclude="Resources\Localization\**" />
	</ItemGroup>

	<!-- ========================================
       СТИЛИ И ТЕМЫ
       Явное перечисление для надёжного включения в сборку
       ======================================== -->
	<ItemGroup>
		<!-- Стили Dock -->
		<AvaloniaResource Include="Styles\DockStyles.axaml">
			<SubType>Designer</SubType>
		</AvaloniaResource>

		<!-- Базовые токены -->
		<AvaloniaResource Include="Styles\Base\Colors.axaml" />
		<AvaloniaResource Include="Styles\Base\Typography.axaml" />
		<AvaloniaResource Include="Styles\Base\Spacing.axaml" />

		<!-- Темы оформления -->
		<AvaloniaResource Include="Styles\Themes\DarkTheme.axaml" />
		<AvaloniaResource Include="Styles\Themes\LightTheme.axaml" />
		<AvaloniaResource Include="Styles\Themes\SepiaTheme.axaml" />
	</ItemGroup>

	<!-- ========================================
       ЛОКАЛИЗАЦИЯ (resx файлы)
       Включаем вручную, т.к. отключили автоматическое
       ======================================== -->
	<ItemGroup>
		<!-- Основной файл локализации (генерирует .Designer.cs) -->
		<EmbeddedResource Include="Resources\Localization\Strings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>

		<!-- Русская локализация -->
		<EmbeddedResource Include="Resources\Localization\Strings.ru.resx">
			<DependentUpon>Strings.resx</DependentUpon>
		</EmbeddedResource>

		<!-- Армянская локализация -->

		<!-- Модуль Notes -->
		<EmbeddedResource Include="Src\Modules\Notes\Resources\NotesStrings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>NotesStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="Src\Modules\Notes\Resources\NotesStrings.ru.resx" />

		<!-- Модуль Synonyms -->
		<EmbeddedResource Include="Src\Modules\Synonyms\Resources\SynonymsStrings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>SynonymsStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="Src\Modules\Synonyms\Resources\SynonymsStrings.ru.resx" />

		<!-- Модуль TextEditor -->
		<EmbeddedResource Include="Src\Modules\TextEditor\Resources\TextEditorStrings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>TextEditorStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="Src\Modules\TextEditor\Resources\TextEditorStrings.ru.resx" />

		<!-- Модуль Timer -->
		<EmbeddedResource Include="Src\Modules\Timer\Resources\TimerStrings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>TimerStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="Src\Modules\Timer\Resources\TimerStrings.ru.resx" />

		<!-- Тип проекта GameDesign -->
		<EmbeddedResource Include="Src\ProjectTypes\GameDesign\Resources\GameDesignStrings.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>GameDesignStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="Src\ProjectTypes\GameDesign\Resources\GameDesignStrings.ru.resx" />

		<!-- Тип проекта Translation -->
		<EmbeddedResource Include="Src\ProjectTypes\Translation\Resources\TranslationStrings.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>TranslationStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="Src\ProjectTypes\Translation\Resources\TranslationStrings.ru.resx" />

		<!-- Тип проекта Poetry -->
		<EmbeddedResource Include="Src\ProjectTypes\Poetry\Resources\PoetryStrings.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>PoetryStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="Src\ProjectTypes\Poetry\Resources\PoetryStrings.ru.resx" />

		<!-- Тип проекта Screenplay -->
		<EmbeddedResource Include="Src\ProjectTypes\Screenplay\Resources\ScreenplayStrings.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>ScreenplayStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="Src\ProjectTypes\Screenplay\Resources\ScreenplayStrings.ru.resx" />

		<!-- Тип проекта Novel -->
		<EmbeddedResource Include="Src\ProjectTypes\Novel\Resources\NovelStrings.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>NovelStrings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="Src\ProjectTypes\Novel\Resources\NovelStrings.ru.resx" />

		<!-- Авто-генерируемый код для локализации -->
		<Compile Update="Resources\Localization\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<!-- ========================================
       ИСКЛЮЧЕНИЯ (папки не участвующие в сборке)
       ======================================== -->
	<ItemGroup>
		<AvaloniaXaml Remove="Docs\AI_GUIDE V2.0\**" />
		<AvaloniaXaml Remove="Docs\AI_GUIDE V3.0\**" />
		<AvaloniaXaml Remove="Src\Core\Models\Document\**" />
		<AvaloniaXaml Remove="Tests\**" />
		<Compile Remove="Docs\AI_GUIDE V2.0\**" />
		<Compile Remove="Docs\AI_GUIDE V3.0\**" />
		<Compile Remove="Src\Core\Models\Document\**" />
		<Compile Remove="Tests\**" />
		<None Remove="Docs\AI_GUIDE V2.0\**" />
		<None Remove="Docs\AI_GUIDE V3.0\**" />
		<None Remove="Src\Core\Models\Document\**" />
		<None Remove="Tests\**" />
	</ItemGroup>

	<!-- ========================================
       ПРОЧИЕ ФАЙЛЫ
       ======================================== -->
	<ItemGroup>
		<Content Include="Docs\AI_GUIDE V3.0\Configuration_text.txt" />
	</ItemGroup>

	<!-- ========================================
       ПУСТЫЕ ПАПКИ (для структуры проекта)
       ======================================== -->
	<ItemGroup>
		<Folder Include="Docs\Architecture\" />
		<Folder Include="Docs\UserGuide\" />
		<Folder Include="Models\" />
		<Folder Include="Resources\Images\" />
		<Folder Include="Projects\" />
		<Folder Include="Src\Core\Models\Modules\" />
		<Folder Include="Src\Modules\TextEditor\Commands\" />
		<Folder Include="Src\WorkModes\Branching\" />
		<Folder Include="Src\WorkModes\Dialogues\" />
		<Folder Include="Src\WorkModes\GameEconomy\" />
		<Folder Include="Src\WorkModes\Locations\" />
		<Folder Include="Src\WorkModes\Maps\" />
		<Folder Include="Src\WorkModes\PlotPoints\" />
		<Folder Include="Src\WorkModes\Poetry\" />
	</ItemGroup>

	<!-- ========================================
       ЗАВИСИМОСТИ АВТО-ГЕНЕРИРУЕМЫХ ФАЙЛОВ
       ======================================== -->
	<ItemGroup>
		<Compile Update="Src\Modules\Notes\Resources\NotesStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>NotesStrings.resx</DependentUpon>
		</Compile>
		<Compile Update="Src\Modules\Synonyms\Resources\SynonymsStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>SynonymsStrings.resx</DependentUpon>
		</Compile>
		<Compile Update="Src\Modules\TextEditor\Resources\TextEditorStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>TextEditorStrings.resx</DependentUpon>
		</Compile>
		<Compile Update="Src\Modules\Timer\Resources\TimerStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>TimerStrings.resx</DependentUpon>
		</Compile>
		<Compile Update="Src\ProjectTypes\GameDesign\Resources\GameDesignStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>GameDesignStrings.resx</DependentUpon>
		</Compile>
		<Compile Update="Src\ProjectTypes\Poetry\Resources\PoetryStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>PoetryStrings.resx</DependentUpon>
		</Compile>
		<Compile Update="Src\ProjectTypes\Screenplay\Resources\ScreenplayStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>ScreenplayStrings.resx</DependentUpon>
		</Compile>
		<Compile Update="Src\ProjectTypes\Novel\Resources\NovelStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>NovelStrings.resx</DependentUpon>
		</Compile>
		<Compile Update="Src\ProjectTypes\Translation\Resources\TranslationStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>TranslationStrings.resx</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\RecoveryBannerView.axaml.cs">
		  <DependentUpon>RecoveryBannerView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\FloatingWindowView.axaml.cs">
		  <DependentUpon>FloatingWindowView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\MainWindowView.axaml.cs">
		  <DependentUpon>MainWindowView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\MessageBoxView.axaml.cs">
			<DependentUpon>MessageBoxView.axaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<!-- MenuBar Sections -->
	<ItemGroup>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.File.axaml.cs">
			<DependentUpon>MenuBarView.File.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.Edit.axaml.cs">
			<DependentUpon>MenuBarView.Edit.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.View.axaml.cs">
			<DependentUpon>MenuBarView.View.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.Workspace.axaml.cs">
			<DependentUpon>MenuBarView.Workspace.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.Tools.axaml.cs">
			<DependentUpon>MenuBarView.Tools.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\Sections\MenuBarView.Help.axaml.cs">
			<DependentUpon>MenuBarView.Help.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\MenuBar\MenuBarView.axaml.cs">
			<DependentUpon>MenuBarView.axaml</DependentUpon>
		</Compile>
	</ItemGroup>
	
	<ProjectExtensions>
		<VisualStudio>
			<UserProperties />
		</VisualStudio>
	</ProjectExtensions>

</Project>