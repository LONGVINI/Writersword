       РРјРµРЅР° Р±РµСЂСѓС‚СЃСЏ РёР· ProjectReference РЅР° СЌС‚Р°РїРµ СЃР±РѕСЂРєРё Рё РІС€РёРІР°СЋС‚СЃСЏ
       СЂРµСЃСѓСЂСЃРѕРј, РѕС‚РєСѓРґР° РёС… С‡РёС‚Р°РµС‚ App.ReadBuiltInModuleNames.
       ======================================== -->
	<Target Name="WriterswordGenerateModuleList" BeforeTargets="PrepareForBuild">
		<ItemGroup>
			<WriterswordModuleProject Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(Identity)').Contains('Src\Modules\'))" />
		</ItemGroup>
		<PropertyGroup>
			<WriterswordModuleListFile>$(IntermediateOutputPath)BuiltInModules.txt</WriterswordModuleListFile>
		</PropertyGroup>
		<WriteLinesToFile File="$(WriterswordModuleListFile)" Lines="@(WriterswordModuleProject->'%(Filename)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<EmbeddedResource Include="$(WriterswordModuleListFile)" LogicalName="Writersword.BuiltInModules.txt" />
		</ItemGroup>
		<Message Importance="high" Text="Built-in modules: @(WriterswordModuleProject->'%(Filename)', ', ')" />
	</Target>

</Project>