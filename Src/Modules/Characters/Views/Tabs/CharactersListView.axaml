<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Characters.ViewModels"
             xmlns:controls="using:Writersword.Modules.Characters.Controls"
             xmlns:colorControls="using:Writersword.Styles.UserControls"
             xmlns:loc="using:Writersword.Src.Modules.Characters.Resources"
             xmlns:enums="using:Writersword.Modules.Characters.Models.Enums"
             xmlns:conv="using:Writersword.Modules.Characters.Converters"
             xmlns:behaviors="using:Writersword.Infrastructure.Behaviours"
             xmlns:infra="using:Writersword.Infrastructure.Controls"
             x:Class="Writersword.Modules.Characters.Views.Tabs.CharactersListView"
             x:DataType="vm:CharactersViewModel">

	<UserControl.Resources>
		<conv:IntIsZeroConverter x:Key="IntIsZeroConverter"/>
	</UserControl.Resources>

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Панель поиска и инструментов -->
		<Border Grid.Row="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
			<Grid ColumnDefinitions="*,Auto,Auto,Auto">
				<TextBox Grid.Column="0"
                         x:Name="SearchTextBox"
                         Text="{ReflectionBinding SearchQuery}"
                         PlaceholderText="{x:Static loc:CharactersStrings.Search_Placeholder}"
                         FontSize="12"
                         Background="{DynamicResource BgSurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderDefaultBrush}"
                         BorderThickness="1" CornerRadius="6" Padding="7,4"
                         behaviors:ClickOutsideBehavior.Command="{ReflectionBinding UnfocusSearchCommand}"/>
				<Button Grid.Column="1"
                        Command="{ReflectionBinding CreateFolderCommand}"
                        Margin="6,0,0,0" Padding="8,4"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="6"
                        ToolTip.Tip="{x:Static loc:CharactersStrings.Folder_CreateTooltip}">
					<StackPanel Orientation="Horizontal" Spacing="5">
						<PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                  Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
						<TextBlock Text="{x:Static loc:CharactersStrings.Folder_CreateButton}"
                                   FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button Grid.Column="2"
                        Command="{ReflectionBinding SwitchViewModeCommand}"
                        CommandParameter="{x:Static enums:CharactersViewMode.List}"
                        Margin="4,0,0,0" Padding="7,4"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="6"
                        ToolTip.Tip="{x:Static loc:CharactersStrings.ViewMode_List}">
					<PathIcon Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"
                              Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
				</Button>
				<Button Grid.Column="3"
                        Command="{ReflectionBinding SwitchViewModeCommand}"
                        CommandParameter="{x:Static enums:CharactersViewMode.Grid}"
                        Margin="4,0,0,0" Padding="7,4"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="6"
                        ToolTip.Tip="{x:Static loc:CharactersStrings.ViewMode_Grid}">
					<PathIcon Data="M3 3h8v8H3zm0 10h8v8H3zm10-10h8v8h-8zm0 10h8v8h-8z"
                              Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
				</Button>
			</Grid>
		</Border>

		<!-- Список папок и персонажей -->
		<ScrollViewer Grid.Row="1" Focusable="False">
			<StackPanel>

				<TextBlock Text="{x:Static loc:CharactersStrings.Placeholder_NoCharacters}"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="32,32" TextWrapping="Wrap" TextAlignment="Center"
                           IsVisible="{Binding Folders.Count, Converter={StaticResource IntIsZeroConverter}}"/>

				<ItemsControl ItemsSource="{Binding Folders}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="vm:CharacterFolderViewModel">
							<StackPanel Margin="0,0,0,4">

								<!-- Заголовок папки -->
								<Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Background="{DynamicResource BgPanelBrush}">
									<Panel>
										<Border IsVisible="{Binding IsSelected}" Background="#22FFFFFF"/>

										<!-- Подсветка когда папка закрыта и над ней висит drag -->
										<Border IsVisible="{Binding IsDragOver}"
                                                Background="#22FFFFFF"
                                                BorderBrush="{DynamicResource AccentDefaultBrush}"
                                                BorderThickness="0,0,0,2"/>

										<Grid MinHeight="36">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<colorControls:ColorPickerButton
                                                Grid.Column="0"
                                                HexColor="{Binding Color, Mode=TwoWay}"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"/>

											<controls:CharactersFolderHeaderPanel Grid.Column="1"
                                                                              LeftMinWidth="55"
                                                                              RightMinWidth="90"
                                                                              LeftPreferredWidth="260"
                                                                              RightPreferredWidth="210">

												<!-- Child[0]: имя папки.
                                                     SelectOrRenameCommand: первый клик выбирает папку,
                                                     повторный клик на уже выбранной — начинает переименование. -->
												<Panel Margin="0,0,12,0" ClipToBounds="True">
													<Button Command="{Binding SelectOrRenameCommand}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Padding="0" VerticalAlignment="Center"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            IsVisible="{Binding !IsRenaming}">
														<Button.Styles>
															<Style Selector="Button:pointerover /template/ ContentPresenter">
																<Setter Property="Background" Value="Transparent"/>
															</Style>
															<Style Selector="Button:pressed /template/ ContentPresenter">
																<Setter Property="Background" Value="Transparent"/>
															</Style>
														</Button.Styles>
														<TextBlock Text="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Name}"
                                                                   ToolTip.ShowDelay="500"/>
													</Button>
													<TextBox Name="FolderRenameBox"
                                                             Text="{ReflectionBinding Name}"
                                                             FontSize="13" FontWeight="SemiBold"
                                                             Padding="4,2,16,2"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding IsRenaming}"
                                                             behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsRenaming}"
                                                             behaviors:ClickOutsideBehavior.Command="{ReflectionBinding ConfirmRenameCommand}"/>
												</Panel>

												<!-- Child[1]: комментарий -->
												<Grid Margin="8,0,8,0">
													<Button Command="{Binding StartEditCommentCommand}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Padding="4,0" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            ToolTip.Tip="{x:Static loc:CharactersStrings.Folder_CommentTooltip}"
                                                            IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNullOrEmpty}}">
														<PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                                                                  Width="12" Height="12"
                                                                  Foreground="{DynamicResource TextMutedBrush}"
                                                                  Opacity="0.4"/>
													</Button>
													<Button Command="{Binding StartEditCommentCommand}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Padding="0" VerticalAlignment="Center"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
														<Button.Styles>
															<Style Selector="Button:pointerover /template/ ContentPresenter">
																<Setter Property="Background" Value="Transparent"/>
															</Style>
															<Style Selector="Button:pressed /template/ ContentPresenter">
																<Setter Property="Background" Value="Transparent"/>
															</Style>
														</Button.Styles>
														<TextBlock Text="{Binding Comment}"
                                                                   FontSize="11" FontStyle="Italic"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Comment}"
                                                                   ToolTip.ShowDelay="500"/>
													</Button>
													<infra:ItalicCaretTextBox Name="FolderCommentBox"
                                                         Classes="italic"
                                                         Text="{ReflectionBinding Comment}"
                                                         FontStyle="Italic"
                                                         PlaceholderText="{x:Static loc:CharactersStrings.Folder_CommentPlaceholder}"
                                                         Padding="4,2,4,2"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding IsEditingComment}"
                                                         behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsEditingComment}"
                                                         behaviors:ClickOutsideBehavior.Command="{ReflectionBinding ConfirmCommentCommand}"/>
												</Grid>

											</controls:CharactersFolderHeaderPanel>

											<Grid Grid.Column="2"
                                                  ColumnDefinitions="Auto,Auto,Auto"
                                                  VerticalAlignment="Center">

												<!-- Корзина для папки -->
												<Button Grid.Column="0"
                                                        Command="{Binding RequestDeleteCommand}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="8,0" Height="36"
                                                        VerticalAlignment="Stretch"
                                                        VerticalContentAlignment="Center"
                                                        IsVisible="{Binding !IsUngrouped}"
                                                        ToolTip.Tip="Удалить папку">
													<Button.Styles>
														<Style Selector="Button:pointerover /template/ ContentPresenter">
															<Setter Property="Background" Value="Transparent"/>
														</Style>
													</Button.Styles>
													<PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                              Width="13" Height="13"
                                                              Foreground="{DynamicResource TextSecondaryBrush}"/>
												</Button>

												<TextBlock Grid.Column="1"
                                                           Text="{Binding Count}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           MinWidth="20"
                                                           TextAlignment="Center"/>

												<Button Grid.Column="2"
                                                        Command="{Binding ToggleExpandCommand}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="8,0" Margin="0,0,4,0"
                                                        VerticalAlignment="Stretch">
													<TextBlock Text="{Binding IsExpanded, Converter={x:Static conv:BoolToCollapseArrowConverter.Instance}}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
												</Button>

											</Grid>
										</Grid>
									</Panel>
								</Border>

								<!-- Карточки персонажей.
                                     IsDragging=true → Opacity=0.25 и IsHitTestVisible=false,
                                     чтобы карточка не мешала hit-тесту при определении цели. -->
								<ItemsControl ItemsSource="{Binding Characters}"
                                              Margin="12,8"
                                              IsVisible="{Binding IsExpanded}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="vm:CharacterListItemViewModel">

											<Border Width="148" CornerRadius="10"
                                                    Background="{DynamicResource BgPanelBrush}"
                                                    BorderBrush="{Binding Color}"
                                                    BorderThickness="2"
                                                    ClipToBounds="True"
                                                    Margin="6"
                                                    Cursor="Hand"
                                                    Opacity="{Binding DragOpacity}"
                                                    IsHitTestVisible="{Binding !IsDragging}">

												<Grid RowDefinitions="60,Auto">

													<!-- Верхняя цветная область -->
													<Panel Grid.Row="0">
														<Border Background="{Binding Color}"/>

														<TextBlock Text="{Binding FallbackIcon}"
                                                                   FontSize="30"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="White"
                                                                   IsHitTestVisible="False"/>

														<!-- Выбор цвета — сверху-слева -->
														<colorControls:ColorPickerButton
                                                            HexColor="{Binding Color, Mode=TwoWay}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="5"
                                                            Width="20" Height="20"
                                                            ToolTip.Tip="Изменить цвет"/>

														<!-- Редактировать + крестик удаления — сверху-справа -->
														<StackPanel Orientation="Horizontal"
                                                                    Spacing="2"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="4"
                                                                    IsVisible="{Binding IsShowingNameDisplay}">
															<Button Command="{ReflectionBinding $parent[UserControl].DataContext.EditCharacterCommand}"
                                                                    CommandParameter="{Binding Id}"
                                                                    Padding="4,3"
                                                                    Background="#88000000"
                                                                    BorderThickness="0" CornerRadius="4"
                                                                    ToolTip.Tip="{x:Static loc:CharactersStrings.Character_EditTooltip}">
																<PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                                          Width="11" Height="11" Foreground="White"/>
															</Button>
															<!-- Крестик для персонажа -->
															<Button Command="{Binding RequestDeleteCommand}"
                                                                    Padding="4,3"
                                                                    Background="#88000000"
                                                                    BorderThickness="0" CornerRadius="4"
                                                                    ToolTip.Tip="Удалить персонажа">
																<Button.Styles>
																	<Style Selector="Button:pointerover /template/ ContentPresenter">
																		<Setter Property="Background" Value="#BB660000"/>
																	</Style>
																</Button.Styles>
																<PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                                          Width="11" Height="11" Foreground="White"/>
															</Button>
														</StackPanel>
													</Panel>

													<!-- Нижняя зона имени -->
													<Panel Grid.Row="1" MinHeight="40">

														<!-- Состояние 1: ввод имени нового персонажа.
                                                             Без ClickOutsideBehavior — сохранение через LostFocus в code-behind. -->
														<TextBox Text="{ReflectionBinding InlineName}"
                                                                 PlaceholderText="{x:Static loc:CharactersStrings.Character_NamePlaceholder}"
                                                                 FontSize="12" FontWeight="Medium"
                                                                 TextAlignment="Center"
                                                                 Background="{DynamicResource BgPanelBrush}"
                                                                 BorderBrush="{DynamicResource AccentDefaultBrush}"
                                                                 BorderThickness="0,1,0,0"
                                                                 CornerRadius="0,0,8,8"
                                                                 Padding="8,0"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 VerticalAlignment="Stretch"
                                                                 MinHeight="40"
                                                                 IsVisible="{Binding IsBeingNamed}"
                                                                 behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsBeingNamed}"/>

														<!-- Состояние 2: переименование существующего персонажа.
                                                             Без ClickOutsideBehavior — сохранение через LostFocus в code-behind. -->
														<TextBox Text="{ReflectionBinding PendingRename}"
                                                                 FontSize="12" FontWeight="Medium"
                                                                 TextAlignment="Center"
                                                                 Background="{DynamicResource BgPanelBrush}"
                                                                 BorderBrush="{DynamicResource AccentDefaultBrush}"
                                                                 BorderThickness="0,1,0,0"
                                                                 CornerRadius="0,0,8,8"
                                                                 Padding="8,0"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 VerticalAlignment="Stretch"
                                                                 MinHeight="40"
                                                                 IsVisible="{Binding IsRenaming}"
                                                                 behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsRenaming}"/>

														<!-- Состояние 3: нормальное отображение, клик = переименование -->
														<Button Command="{Binding StartRenameCommand}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="6,4"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center"
                                                                IsVisible="{Binding IsShowingNameDisplay}"
                                                                ToolTip.Tip="Нажмите для переименования">
															<Button.Styles>
																<Style Selector="Button:pointerover /template/ ContentPresenter">
																	<Setter Property="Background" Value="Transparent"/>
																</Style>
																<Style Selector="Button:pressed /template/ ContentPresenter">
																	<Setter Property="Background" Value="Transparent"/>
																</Style>
															</Button.Styles>
															<TextBlock Text="{Binding Name}"
                                                                       FontSize="12" FontWeight="Medium"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       ToolTip.Tip="{Binding Name}"
                                                                       ToolTip.ShowDelay="600"/>
														</Button>

													</Panel>
												</Grid>
											</Border>

										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

		<!-- Кнопки создания -->
		<Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
			<Grid ColumnDefinitions="3*,*">
				<Button Grid.Column="0"
                        Command="{ReflectionBinding CreateCharacterCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Height="40" CornerRadius="8"
                        Background="{DynamicResource AccentDefaultBrush}"
                        Foreground="White" Margin="0,0,6,0">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                  Width="16" Height="16" Foreground="White"/>
						<TextBlock Text="{x:Static loc:CharactersStrings.Button_CreateCharacter}"
                                   FontSize="13" VerticalAlignment="Center" Foreground="White"/>
					</StackPanel>
				</Button>
				<Button Grid.Column="1"
                        Command="{ReflectionBinding CreateCollectiveCharacterCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Height="40" CornerRadius="8"
                        Background="{DynamicResource AccentDefaultBrush}"
                        Foreground="White"
                        ToolTip.Tip="{x:Static loc:CharactersStrings.Button_CreateCollective}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<PathIcon Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                  Width="16" Height="16" Foreground="White"/>
						<TextBlock Text="{x:Static loc:CharactersStrings.Button_CreateCollectiveShort}"
                                   FontSize="12" VerticalAlignment="Center" Foreground="White"/>
					</StackPanel>
				</Button>
			</Grid>
		</Border>

		<!-- Призрак перетаскивания — полноразмерная копия карточки, следует за курсором.
             IsHitTestVisible=false чтобы не мешать InputHitTest при определении цели. -->
		<Canvas x:Name="DragGhostCanvas"
                Grid.Row="0" Grid.RowSpan="3"
                IsHitTestVisible="False"
                IsVisible="False">
			<Border x:Name="DragGhostBorder"
                    Width="148" Height="100"
                    CornerRadius="10"
                    Opacity="0.85"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="2">
				<Border.Effect>
					<DropShadowEffect BlurRadius="16" OffsetX="0" OffsetY="6" Opacity="0.4"/>
				</Border.Effect>
				<Grid RowDefinitions="60,40">
					<!-- Цветная верхняя часть с "?" -->
					<Panel Grid.Row="0">
						<Border x:Name="DragGhostTopBg" CornerRadius="8,8,0,0"/>
						<TextBlock Text="?" FontSize="28" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
					</Panel>
					<!-- Нижняя часть с именем -->
					<Border Grid.Row="1"
                            Background="{DynamicResource BgPanelBrush}"
                            CornerRadius="0,0,8,8">
						<TextBlock x:Name="DragGhostText"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0"/>
					</Border>
				</Grid>
			</Border>
		</Canvas>

	</Grid>
</UserControl>