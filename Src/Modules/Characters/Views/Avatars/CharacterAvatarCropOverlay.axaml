<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:colorControls="using:Writersword.Styles.UserControls"
             xmlns:controls="using:Writersword.Modules.Characters.Controls"
             xmlns:models="using:Writersword.Modules.Characters.Models"
             xmlns:icv="using:Writersword.Infrastructure.Converters"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             x:Class="Writersword.Modules.Characters.Views.Avatars.CharacterAvatarCropOverlay"
             IsVisible="False">

	<!-- Обрезка аватарки: оформление то же, что у выбора аватарки и настроек
	     карточки — скрим на модуль (клик не закрывает), центральная панель
	     BgBase со скруглением 16 и тенью.

	     Кадр в окне неподвижен, а картинка ездит и масштабируется под ним.
	     Обратный порядок — подвижная рамка поверх неподвижной картинки —
	     требует восьми ручек по краям и отдельного разбора, за какую из них
	     тянут; здесь то же самое делают перетаскивание и колесо.

	     Итог правки — кадр в долях исходной картинки: он уходит в ссылку
	     персонажа, а файл в проекте остаётся один. Поэтому одну фотографию
	     можно поставить двум карточкам, вырезав из неё разных людей.

	     Справа стоит не голая вырезка, а карточка целиком — с рамкой в цвете
	     персонажа, кольцом вокруг аватарки и подписью имени. Кадр выбирают не
	     сам по себе, а под то место, где он будет жить. Цветопикер там же и
	     тот же самый, что на карточке: цвет и кольцо уезжают персонажу сразу,
	     как при нажатии на самой карточке. -->

	<UserControl.Resources>
		<!-- Прозрачный фон и трек скроллбара: серая подложка Fluent спорит с
		     фоном панели. Ключи переопределены на уровне окна и за его
		     пределы не выходят. -->
		<SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
		<SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent"/>
		<SolidColorBrush x:Key="ScrollBarBackgroundDisabled" Color="Transparent"/>
		<SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
		<SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
		<SolidColorBrush x:Key="ScrollBarPanningBackground" Color="Transparent"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Переключатель кадра: свой кружку, свой полоске. Та же дорожка,
		     что у областей папок аватарок. -->
		<Style Selector="Border.segTrack">
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Padding" Value="2"/>
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.seg">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Foreground" Duration="0:0:0.2"/>
				</Transitions>
			</Setter>
			<Setter Property="Padding" Value="14,4"/>
			<Setter Property="MinWidth" Value="86"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="Button.seg /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.seg:not(.active):pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
		<!-- Выбранный сегмент только светлеет буквами: подложку под ним
		     рисует бегунок, который переезжает с кнопки на кнопку.

		     Жирность здесь не меняется намеренно. От неё надпись становится
		     шире, соседняя кнопка сдвигается, и бегунок едет к цели, которая
		     во время переезда сама уползает. -->
		<Style Selector="Button.seg.active">
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- Бегунок выбранного сегмента. Ширину и сдвиг ставит код по
		     границам самой кнопки: надписи разной длины, и делить дорожку
		     пополам значило бы промахиваться мимо той, что длиннее. -->
		<Style Selector="Border.segThumb">
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform"
					                               Duration="0:0:0.22" Easing="CubicEaseOut"/>
					<DoubleTransition Property="Width"
					                  Duration="0:0:0.22" Easing="CubicEaseOut"/>
				</Transitions>
			</Setter>
		</Style>

		<!-- Круглая кнопка-значок. Тот же вид, что у кнопок в управлении
		     папками аватарок: 28 точек, обводка в полторы, прозрачная
		     середина. -->
		<Style Selector="Button.iconBtn">
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.iconBtn /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15"/>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Кнопка-значок во включённом состоянии: обводка и значок берут
		     цвет подсветки, чтобы состояние читалось с одного взгляда. -->
		<Style Selector="Button.iconBtn.on">
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.iconBtn.on /template/ ContentPresenter">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Подпись над коробкой превью. -->
		<Style Selector="TextBlock.previewCaption">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
	</UserControl.Styles>

	<Grid>
		<!-- Скрим: затемняет и блокирует модуль. Клик НЕ закрывает. Лёгкая
		     прозрачность оставлена намеренно — под окном видно, из какого
		     места модуля его открыли. -->
		<Border Background="#F2000000" PointerPressed="OnScrimPressed"/>

		<!-- Тень висит на отдельной неподвижной подложке, а не на самой
		     панели: эффект на панели заставляет перерисовывать её содержимое
		     целиком при каждом движении кадра. Подложка повторяет размер
		     панели по её Bounds — так же, как в редакторе цвета. -->
		<Border x:Name="PanelShadow"
		        HorizontalAlignment="Center" VerticalAlignment="Center"
		        CornerRadius="16"
		        Background="{DynamicResource BgBaseBrush}"
		        IsHitTestVisible="False">
			<Border.Effect>
				<DropShadowEffect BlurRadius="32" OffsetX="0" OffsetY="12" Opacity="0.55" Color="#000000"/>
			</Border.Effect>
		</Border>

		<Border x:Name="CropPanel"
		        HorizontalAlignment="Center" VerticalAlignment="Center"
		        Margin="24"
		        Background="{DynamicResource BgBaseBrush}"
		        BorderBrush="{DynamicResource BorderDefaultBrush}"
		        BorderThickness="1"
		        CornerRadius="16"
		        ClipToBounds="True">

			<Grid RowDefinitions="Auto,*,Auto">

				<!-- Заголовок + крестик -->
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,12,0">
					<TextBlock Grid.Column="0" x:Name="TitleText"
					           Text="Обрезка аватарки"
					           FontSize="16" FontWeight="SemiBold"
					           Foreground="{DynamicResource TextPrimaryBrush}"
					           VerticalAlignment="Center"/>
					<Button Grid.Column="1" Content="✕"
					        Click="OnCancelClick"
					        Background="Transparent" BorderThickness="0"
					        Foreground="{DynamicResource TextSecondaryBrush}"
					        FontSize="14" Padding="6,2"
					        behaviours:TooltipBehavior.Tip="Закрыть"
					        behaviours:TooltipBehavior.Description="Кадр не сохранится"/>
				</Grid>

				<!-- Рабочая область: слева кадр, справа карточка. Полотно
				     кадра фиксированное, поэтому при узком модуле середина
				     окна прокручивается, а кнопки внизу остаются на месте. -->
				<ScrollViewer Grid.Row="1"
				              HorizontalScrollBarVisibility="Auto"
				              VerticalScrollBarVisibility="Auto"
				              Margin="16,12,16,0">
					<Grid ColumnDefinitions="Auto,Auto">

						<StackPanel Grid.Column="0" Spacing="12">

						<!-- Кадров два: свой кружку, свой полоске. Кружку нужен
						     квадрат вокруг лица, полоске — широкая полоса, и
						     один кадр на оба вида означал бы, что один из них
						     всегда обрезан не туда. Правится тот, что выбран
						     здесь; второй всё это время виден в превью справа. -->
						<Border Classes="segTrack" HorizontalAlignment="Center">
							<Panel>
								<!-- Бегунок объявлен раньше кнопок: на панели
								     позже объявленное рисуется поверх, а
								     подложка обязана быть под буквами. -->
								<Border x:Name="SegThumb" Classes="segThumb" IsVisible="False"/>

								<StackPanel x:Name="SegButtons" Orientation="Horizontal" Spacing="2">
									<Button x:Name="ModeCircleButton" Classes="seg"
									        Content="Кадр кружка"
									        Click="OnModeCircleClick"
									        behaviours:TooltipBehavior.Tip="Кадр для кружка"
									        behaviours:TooltipBehavior.Description="Квадрат. Из него берут картинку кружок на карточке и мелкая плитка в списках"/>
									<Button x:Name="ModeStripButton" Classes="seg"
									        Content="Кадр полоски"
									        Click="OnModeStripClick"
									        behaviours:TooltipBehavior.Tip="Кадр для полоски"
									        behaviours:TooltipBehavior.Description="Широкая полоса по пропорциям цветной зоны карточки. Пока свой кадр не задан, полоска берёт кадр кружка"/>
								</StackPanel>
							</Panel>
						</Border>

						<!-- Полотно кадра. Размер постоянный: вся геометрия
						     кадра считается в его координатах, и зависеть от
						     прохода раскладки ей незачем.

						     Скругление у полотна раньше срезало углы белой
						     рамки кадра: рамка доходила до самого края и
						     обрывалась, а углы выглядели загнутыми. Теперь
						     рамка отступает от края полотна на FrameInset и в
						     скругление не попадает вовсе, поэтому полотну
						     скругление вернулось. -->
						<Border Width="420" Height="420"
						        CornerRadius="10"
						        ClipToBounds="True"
						        Background="{DynamicResource BgSurfaceBrush}"
						        BorderBrush="{DynamicResource BorderDefaultBrush}"
						        BorderThickness="1">
							<Panel x:Name="Viewport"
							       Background="Transparent"
							       PointerPressed="OnViewportPointerPressed"
							       PointerMoved="OnViewportPointerMoved"
							       PointerReleased="OnViewportPointerReleased"
							       PointerWheelChanged="OnViewportWheel">

								<Canvas x:Name="ImageCanvas" ClipToBounds="True">
									<Image x:Name="SourceImage" IsHitTestVisible="False"/>
								</Canvas>

								<!-- Затемнение вне кадра: одна фигура с дыркой
								     по кадру, геометрию ей считает код.

								     Раньше здесь стояли четыре полосы вокруг
								     рамки. Стыковались они по дробной
								     координате — сторона кадра у полоски
								     нацело не делится, — и растеризация клала
								     полупрозрачный чёрный на стыковую строку
								     дважды. Вдоль верхнего и нижнего края
								     кадра, слева и справа от него, оставались
								     тёмные чёрточки: там, где боковая полоса
								     встречалась с верхней и нижней. Одна
								     фигура этого не умеет по построению. -->
								<Path x:Name="ShadePath"
								      Fill="#99000000"
								      IsHitTestVisible="False"
								      HorizontalAlignment="Left"
								      VerticalAlignment="Top"/>

								<!-- Направляющие внутри кадра: центральные оси
								     или сетка по третям. Объявлены до рамки,
								     чтобы белая рамка шла поверх них — линии
								     помогают выровнять лицо, а не спорить с
								     границей кадра.

								     Четыре полосы на оба вида: осям хватает
								     первой пары, сетке нужны обе. Отдельной
								     канвы на каждый вид не заводим — полосы
								     всё равно переставляются кодом при каждой
								     отрисовке. -->
								<Canvas x:Name="GuideCanvas" IsHitTestVisible="False">
									<Border x:Name="GuideV1" Background="#4DFFFFFF" IsVisible="False"/>
									<Border x:Name="GuideV2" Background="#4DFFFFFF" IsVisible="False"/>
									<Border x:Name="GuideH1" Background="#4DFFFFFF" IsVisible="False"/>
									<Border x:Name="GuideH2" Background="#4DFFFFFF" IsVisible="False"/>
								</Canvas>

								<Canvas x:Name="FrameCanvas" IsHitTestVisible="False">
									<!-- Вторая тонкая линия снаружи белой рамки,
									     через промежуток в три точки. Идёт по
									     затемнению вне кадра, поэтому взята
									     приглушённо-белой: тёмная линия по
									     тёмному фону не читалась бы вовсе.
									     Объявлена раньше белой рамки: на канве
									     позже объявленное рисуется поверх. -->
									<Border x:Name="FrameOuter"
									        BorderBrush="#59FFFFFF"
									        BorderThickness="1"
									        CornerRadius="10"
									        Background="Transparent"/>
									<Border x:Name="FrameBorder"
									        BorderBrush="#FFFFFFFF"
									        BorderThickness="2"
									        CornerRadius="8"
									        Background="Transparent"/>
									<Border x:Name="FrameCircleHint"
									        BorderBrush="#FFFFFFFF"
									        BorderThickness="1"
									        CornerRadius="999"
									        Background="Transparent"/>
								</Canvas>
							</Panel>
						</Border>

						<!-- Масштаб. Стоит под самой фотографией и по её
						     середине: тянут кадр здесь же, и уводить рычаг
						     масштаба на другой край окна незачем.

						     Кнопок формы кадра рядом больше нет. Рамка всегда
						     квадратная — и кружок карточки, и мелкая плитка
						     квадратные, а полоска в любом случае режет кадр
						     по-своему. Кнопка «вся картинка» же формой кадра и
						     не была: она означала «не выбираю, пусть карточка
						     берёт середину сама», то есть отказ от обрезки в
						     окне обрезки. -->
						<!-- Сетка, а не стопка: ползунок забирает то, что
						     осталось от подписи, поля и кнопок, и ряд держится
						     в своих 420 точках при любой ширине надписей. -->
						<Grid Width="420" HorizontalAlignment="Center"
						      ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
						      ColumnSpacing="8">
							<TextBlock Grid.Column="0" Text="Масштаб" FontSize="11"
							           VerticalAlignment="Center"
							           Foreground="{DynamicResource TextSecondaryBrush}"/>

							<!-- Границы ползунка ставит код: они зависят от
							     сторон картинки и рамки. Числа здесь — только
							     до первого показа. -->
							<Slider Grid.Column="1" x:Name="ZoomSlider"
							        Minimum="100" Maximum="600" Value="100"
							        VerticalAlignment="Center"
							        ValueChanged="OnZoomSliderChanged"/>

							<!-- Масштаб числом: точка картинки на точку экрана
							     — это сто процентов. Мера не зависит ни от
							     рамки, ни от поворота, поэтому одно и то же
							     число всегда означает одно и то же.

							     Поле нужно не для удобства, а чтобы снять
							     потолок: у ползунка он привычный, в шесть раз
							     от вписанного в рамку, а здесь можно набрать
							     столько, сколько в картинке есть точек. -->
							<StackPanel Grid.Column="2" Orientation="Horizontal"
							            Spacing="3" VerticalAlignment="Center">
								<NumericUpDown x:Name="ZoomBox"
								               Width="62"
								               ShowButtonSpinner="False"
								               Increment="10"
								               FormatString="0"
								               Minimum="1" Maximum="10000" Value="100"
								               ValueChanged="OnZoomBoxChanged"
								               behaviours:TooltipBehavior.Tip="Масштаб в процентах"
								               behaviours:TooltipBehavior.Description="Сто процентов — точка картинки на точку экрана. Ползунок ограничен привычным пределом, здесь его нет"/>
								<TextBlock Text="%" FontSize="11"
								           VerticalAlignment="Center"
								           Foreground="{DynamicResource TextSecondaryBrush}"/>
							</StackPanel>

							<Button Grid.Column="3" Content="Сбросить" Click="OnResetClick"
							        VerticalAlignment="Center"
							        behaviours:TooltipBehavior.Tip="Вернуть кадр"
							        behaviours:TooltipBehavior.Description="Масштаб становится наименьшим, кадр встаёт по центру картинки"/>

							<!-- Поворот. Стоит в одном ряду с масштабом, потому
							     что делает то же самое — правит саму картинку
							     под неподвижной рамкой, а не кадр.

							     Одна кнопка, а не две: четверть за нажатие,
							     четыре нажатия возвращают на место, и обратная
							     кнопка сэкономила бы два нажатия из трёх раз в
							     жизни. Поворот запоминается в ссылке рядом с
							     кадрами и принадлежит персонажу — тот же файл у
							     другого персонажа остаётся как лежал. -->
							<Button Grid.Column="4" x:Name="RotateButton" Classes="iconBtn"
							        Click="OnRotateClick"
							        VerticalAlignment="Center"
							        behaviours:TooltipBehavior.Tip="Повернуть"
							        behaviours:TooltipBehavior.Description="Четверть оборота по часовой стрелке за нажатие. Кадр поворачивается вместе с картинкой и остаётся на том же её месте">
								<PathIcon Width="14" Height="14"
								          Data="M15.55 5.55L11 1v3.07C7.06 4.56 4 7.92 4 12s3.05 7.44 7 7.93v-2.02c-2.84-.48-5-2.94-5-5.91s2.16-5.43 5-5.91V10l4.55-4.45zM19.93 11c-.17-1.39-.72-2.73-1.62-3.89l-1.42 1.42c.54.75.88 1.6 1.02 2.47h2.02zM13 17.9v2.02c1.39-.17 2.74-.71 3.9-1.61l-1.44-1.44c-.75.54-1.59.89-2.46 1.03zm3.89-2.42l1.42 1.41c.9-1.16 1.45-2.5 1.62-3.89h-2.02c-.14.87-.48 1.72-1.02 2.48z"/>
							</Button>

							<!-- Направляющие. Одна кнопка на три состояния:
							     сначала центральные оси, потом сетка по третям,
							     потом ничего. Оси ставят лицо по середине
							     кружка, сетка — по правилу третей у полоски;
							     нужны они по очереди, а не вместе, поэтому и
							     кнопка одна.

							     Линии только подсказка кадрирующему: в ссылку
							     они не уезжают и на картинке не остаются. -->
							<Button Grid.Column="5" x:Name="GuidesButton" Classes="iconBtn"
							        Click="OnGuidesClick"
							        VerticalAlignment="Center"
							        behaviours:TooltipBehavior.Tip="Направляющие"
							        behaviours:TooltipBehavior.Description="Нажатие переключает: центральные оси, сетка по третям, ничего. Линии видны только здесь и в картинку не попадают">
								<PathIcon Width="14" Height="14"
								          Data="F1 M2,8.5 H22 V9.5 H2 Z M2,14.5 H22 V15.5 H2 Z M8.5,2 H9.5 V22 H8.5 Z M14.5,2 H15.5 V22 H14.5 Z"/>
							</Button>
						</Grid>

						</StackPanel>

						<!-- Превью: карточка целиком, как она встанет в списке.
						     Контекст данных ставит код — это тот же
						     CharacterListItemViewModel, что у настоящей
						     карточки, поэтому цвет, кольцо и имя здесь живые,
						     а не срисованные. -->
						<StackPanel x:Name="CardPreviewHost"
						            Grid.Column="1" Margin="16,0,0,0" Spacing="12" Width="164">

							<TextBlock Text="Как встанет в карточку"
							           FontSize="11" FontWeight="SemiBold"
							           Foreground="{DynamicResource TextSecondaryBrush}"/>

							<!-- Плитка. Разметка повторяет настоящую карточку:
							     корень со скруглением 10 и рамкой в цвете
							     персонажа толщиной CardBorderThickness, поверх
							     закладка группы, внутри цветная зона с кружком,
							     кольцом и метками по дуге, снизу подпись имени.

							     Размеры взяты не с потолка, а те, что считает
							     CharactersViewModel при карточке по умолчанию:
							     верхняя зона 60, аватарка 60-12=48, кольцо
							     48+8=56, значок метки max(12, 48*0.3)=14.4,
							     радиус дуги 48/2+14.4*0.15=26.16, подпись 40.
							     Оттого превью и мелкое: ровно такой карточка и
							     будет.

							     Обрезки по корню нет — она была на нём и
							     срезала подпись по прямому углу поверх рамки.
							     Режут теперь сами зоны, как в карточке. -->
							<StackPanel Spacing="6">
								<TextBlock Classes="previewCaption" Text="Плитка"/>
								<Border Width="152"
								        CornerRadius="10"
								        ClipToBounds="False"
								        HorizontalAlignment="Left"
								        Background="{DynamicResource BgPanelBrush}"
								        BorderBrush="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
								        BorderThickness="{Binding CardBorderThickness}">
									<Panel>
										<Path IsVisible="{Binding ShowGroupBookmark}"
										      IsHitTestVisible="False"
										      ZIndex="6"
										      HorizontalAlignment="Right"
										      VerticalAlignment="Top"
										      Margin="0,-1,12,0"
										      Data="M0,0 H14 V20 L7,14 L0,20 Z"
										      Fill="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>

										<DockPanel>
											<Panel DockPanel.Dock="Top" Height="60" ZIndex="1">

												<Panel HorizontalAlignment="Center"
												       VerticalAlignment="Center"
												       ZIndex="2">
													<Ellipse Width="48" Height="48"
													         Fill="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>
													<Border Width="48" Height="48" CornerRadius="24"
													        ClipToBounds="True">
														<Canvas x:Name="PreviewCircleCanvas" ClipToBounds="True">
															<Image x:Name="PreviewCircleImage" IsHitTestVisible="False"/>
														</Canvas>
													</Border>
													<Border CornerRadius="999"
													        BorderThickness="2"
													        IsHitTestVisible="False"
													        IsVisible="{Binding AvatarRing}"
													        BorderBrush="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
													        Width="56" Height="56"
													        HorizontalAlignment="Center"
													        VerticalAlignment="Center"/>
												</Panel>

												<ItemsControl ItemsSource="{Binding CardLabels}"
												              ZIndex="3"
												              ClipToBounds="False">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<controls:LabelArcPanel ItemSize="14.4"
															                        ArcRadius="26.16"
															                        Straight="False"/>
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="models:CharacterLabel">
															<controls:CharacterLabelIcon
																Label="{Binding}"
																IconSize="14.4"
																RimBrush="{DynamicResource BgPanelBrush}"
																RimThickness="1"/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>

												<ItemsControl ItemsSource="{Binding DeadLabels}"
												              ZIndex="3"
												              ClipToBounds="False"
												              HorizontalAlignment="Right"
												              VerticalAlignment="Top"
												              Margin="0,4,4,0">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="models:CharacterLabel">
															<controls:CharacterLabelIcon
																Label="{Binding}"
																IconSize="14.4"
																RimBrush="{DynamicResource BgPanelBrush}"
																RimThickness="1"/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</Panel>

											<Panel Height="40">
												<TextBlock Text="{Binding Name}"
												           FontSize="12" FontWeight="Medium"
												           TextWrapping="NoWrap"
												           TextTrimming="CharacterEllipsis"
												           TextAlignment="Center"
												           Margin="8,0"
												           VerticalAlignment="Center"
												           Foreground="{DynamicResource TextPrimaryBrush}"/>
											</Panel>
										</DockPanel>
									</Panel>
								</Border>
							</StackPanel>

							<!-- Полоска. Та же карточка, но цветная зона занята
							     картинкой целиком, а метки идут не по дуге, а
							     строкой — Straight, как и в настоящей карточке
							     при виде аватара «полоска». Скругление зоны
							     8,8,0,0 — то самое CardZoneCornerRadius для
							     плиточной раскладки.

							     Размер картинки в зоне считает код по её
							     настоящим границам, а не по числу в разметке:
							     ширина зоны зависит от толщины рамки карточки,
							     а она у персонажа своя. -->
							<StackPanel Spacing="6">
								<TextBlock Classes="previewCaption" Text="Полоска"/>
								<Border Width="152"
								        CornerRadius="10"
								        ClipToBounds="False"
								        HorizontalAlignment="Left"
								        Background="{DynamicResource BgPanelBrush}"
								        BorderBrush="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
								        BorderThickness="{Binding CardBorderThickness}">
									<Panel>
										<Path IsVisible="{Binding ShowGroupBookmark}"
										      IsHitTestVisible="False"
										      ZIndex="6"
										      HorizontalAlignment="Right"
										      VerticalAlignment="Top"
										      Margin="0,-1,12,0"
										      Data="M0,0 H14 V20 L7,14 L0,20 Z"
										      Fill="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>

										<DockPanel>
											<Panel DockPanel.Dock="Top" Height="60" ZIndex="1">
												<Border x:Name="PreviewStripBox"
												        CornerRadius="8,8,0,0"
												        ClipToBounds="True"
												        ZIndex="2">
													<Panel>
														<Border Background="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>
														<Canvas x:Name="PreviewStripCanvas" ClipToBounds="True">
															<Image x:Name="PreviewStripImage" IsHitTestVisible="False"/>
														</Canvas>
													</Panel>
												</Border>

												<ItemsControl ItemsSource="{Binding CardLabels}"
												              ZIndex="3"
												              ClipToBounds="False">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<controls:LabelArcPanel ItemSize="14.4"
															                        ArcRadius="26.16"
															                        Straight="True"/>
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="models:CharacterLabel">
															<controls:CharacterLabelIcon
																Label="{Binding}"
																IconSize="14.4"
																RimBrush="{DynamicResource BgPanelBrush}"
																RimThickness="1"/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>

												<ItemsControl ItemsSource="{Binding DeadLabels}"
												              ZIndex="3"
												              ClipToBounds="False"
												              HorizontalAlignment="Right"
												              VerticalAlignment="Top"
												              Margin="0,4,4,0">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="models:CharacterLabel">
															<controls:CharacterLabelIcon
																Label="{Binding}"
																IconSize="14.4"
																RimBrush="{DynamicResource BgPanelBrush}"
																RimThickness="1"/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</Panel>

											<Panel Height="40">
												<TextBlock Text="{Binding Name}"
												           FontSize="12" FontWeight="Medium"
												           TextWrapping="NoWrap"
												           TextTrimming="CharacterEllipsis"
												           TextAlignment="Center"
												           Margin="8,0"
												           VerticalAlignment="Center"
												           Foreground="{DynamicResource TextPrimaryBrush}"/>
											</Panel>
										</DockPanel>
									</Panel>
								</Border>
							</StackPanel>

							<!-- Мелкая плитка: как аватарка выглядит в списках
							     и подсказках, где карточки нет вовсе. -->
							<StackPanel Spacing="6" Orientation="Horizontal">
								<Border Width="44" Height="44" CornerRadius="22"
								        ClipToBounds="True"
								        VerticalAlignment="Center"
								        Background="{DynamicResource BgSurfaceBrush}">
									<Canvas x:Name="PreviewTinyCanvas" ClipToBounds="True">
										<Image x:Name="PreviewTinyImage" IsHitTestVisible="False"/>
									</Canvas>
								</Border>
								<TextBlock Classes="previewCaption"
								           Text="Мелкая плитка"
								           TextWrapping="Wrap" Width="90"
								           VerticalAlignment="Center" Margin="6,0,0,0"/>
							</StackPanel>

							<Border Height="1" Margin="0,2,0,0"
							        Background="{DynamicResource BorderSubtleBrush}"/>

							<!-- Цвет карточки и кольцо. Кнопка та же, что стоит
							     на самой карточке, со своей палитрой, кольцом,
							     закладкой и переходом в полный редактор — не
							     копия разметки, а тот же контрол. Правка уходит
							     персонажу сразу: HexColor и RingEnabled связаны
							     с карточкой в обе стороны. -->
							<Grid x:Name="CardColorRow" ColumnDefinitions="Auto,*" ColumnSpacing="8">
								<colorControls:ColorPickerButton
									Grid.Column="0"
									ShowCardPreview="True"
									HexColor="{Binding Color, Mode=TwoWay}"
									PreviewImage="{Binding AvatarBitmap}"
									PreviewName="{Binding Name}"
									PreviewFallback="{Binding FallbackIcon}"
									RingEnabled="{Binding AvatarRing, Mode=TwoWay}"
									PreviewIsGroup="{Binding IsCollective}"
									BookmarkEnabled="{Binding GroupBookmark, Mode=TwoWay}"
									ApplyRingToAllCommand="{Binding ApplyRingToAllCommand}"
									Width="22" Height="22"
									VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1"
								           Text="Цвет карточки и кольцо"
								           FontSize="11"
								           TextWrapping="Wrap"
								           VerticalAlignment="Center"
								           Foreground="{DynamicResource TextSecondaryBrush}"/>
							</Grid>

						</StackPanel>
					</Grid>
				</ScrollViewer>

				<!-- Нижняя панель -->
				<Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto"
				      Margin="16,14,16,16" ColumnSpacing="8">
					<TextBlock Grid.Column="0" x:Name="HintText"
					           Text="Тяните картинку мышью, колесо меняет масштаб"
					           FontSize="11" VerticalAlignment="Center"
					           Foreground="{DynamicResource TextSecondaryBrush}"/>
					<Button Grid.Column="1" Content="Отмена"
					        Click="OnCancelClick" Padding="14,6"/>
					<Button Grid.Column="2" Content="Готово"
					        Click="OnApplyClick" Padding="14,6"
					        Background="{DynamicResource AccentDefaultBrush}"
					        Foreground="White"/>
				</Grid>

			</Grid>
		</Border>
	</Grid>
</UserControl>
