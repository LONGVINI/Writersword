<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Characters.ViewModels"
             xmlns:tmpl="using:Writersword.Modules.Characters.Views.Templates"
             xmlns:graph="using:Writersword.Modules.Characters.Views.Graph"
             xmlns:onb="using:Writersword.Modules.Characters.Views.Onboarding"
             xmlns:views="using:Writersword.Modules.Characters.Views"
             xmlns:loc="using:Writersword.Modules.Characters.Resources"
             xmlns:enums="using:Writersword.Modules.Characters.Models.Enums"
             xmlns:conv="using:Writersword.Modules.Characters.Converters"
             xmlns:behaviors="using:Writersword.Infrastructure.Behaviours"
             x:Class="Writersword.Modules.Characters.Views.CharactersView"
             x:DataType="vm:CharactersViewModel"
             Background="{DynamicResource BgSurfaceBrush}">

    <UserControl.Resources>
        <conv:IntIsZeroConverter x:Key="IntIsZeroConverter"/>
        <conv:IntIsNotZeroConverter x:Key="IntIsNotZeroConverter"/>
    </UserControl.Resources>

    <Grid>

        <!-- Онбординг поверх всего -->
        <Border ZIndex="100"
                Background="#CC000000"
                IsVisible="{Binding ShowOnboarding}">
            <onb:CharactersOnboardingView DataContext="{Binding OnboardingViewModel}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          MaxWidth="520"/>
        </Border>

        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Панель вкладок модуля -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="4,0">
                <Border.Styles>
                    <Style Selector="Button.tab-active">
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
                    </Style>
                    <Style Selector="Button.tab-active:pointerover">
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
                    </Style>
                </Border.Styles>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static loc:CharactersStrings.Tab_Characters}"
                            Command="{ReflectionBinding GoToCharactersCommand}"
                            Classes.tab-active="{Binding IsTab0Active}"
                            FontSize="12" Padding="12,8"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="{x:Static loc:CharactersStrings.Tab_Edit}"
                            Command="{ReflectionBinding GoToEditCommand}"
                            Classes.tab-active="{Binding IsTab1Active}"
                            FontSize="12" Padding="12,8"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="{x:Static loc:CharactersStrings.Tab_Relationships}"
                            Command="{ReflectionBinding GoToRelationshipsCommand}"
                            Classes.tab-active="{Binding IsTab2Active}"
                            FontSize="12" Padding="12,8"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="{x:Static loc:CharactersStrings.Tab_Templates}"
                            Command="{ReflectionBinding GoToTemplatesCommand}"
                            Classes.tab-active="{Binding IsTab3Active}"
                            FontSize="12" Padding="12,8"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Мини-риббон вкладки 0 -->
            <Border Grid.Row="1"
                    x:Name="Tab0Ribbon"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBox Grid.Column="0"
                             x:Name="SearchTextBox"
                             Text="{ReflectionBinding SearchQuery}"
                             Watermark="{x:Static loc:CharactersStrings.Search_Placeholder}"
                             FontSize="12"
                             Background="{DynamicResource BgSurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDefaultBrush}"
                             BorderThickness="1" CornerRadius="6" Padding="7,4"/>
                    <Button Grid.Column="1"
                            Command="{ReflectionBinding CreateFolderCommand}"
                            Margin="6,0,0,0" Padding="8,4"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="6"
                            ToolTip.Tip="Создать папку">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                      Width="14" Height="14"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="+ Папка" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Command="{ReflectionBinding SwitchViewModeCommand}"
                            CommandParameter="{x:Static enums:CharactersViewMode.List}"
                            Margin="4,0,0,0" Padding="7,4"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="6"
                            ToolTip.Tip="{x:Static loc:CharactersStrings.ViewMode_List}">
                        <PathIcon Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Grid.Column="3"
                            Command="{ReflectionBinding SwitchViewModeCommand}"
                            CommandParameter="{x:Static enums:CharactersViewMode.Grid}"
                            Margin="4,0,0,0" Padding="7,4"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="6"
                            ToolTip.Tip="{x:Static loc:CharactersStrings.ViewMode_Grid}">
                        <PathIcon Data="M3 3h8v8H3zm0 10h8v8H3zm10-10h8v8h-8zm0 10h8v8h-8z"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Контент -->
            <Panel Grid.Row="2">

                <!-- Вкладка 0: Персонажи -->
                <Grid x:Name="Tab0Panel"
                      RowDefinitions="*,Auto">

                    <ScrollViewer Grid.Row="0">
                        <StackPanel>

                            <TextBlock Text="{x:Static loc:CharactersStrings.Placeholder_NoCharacters}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="32,32" TextWrapping="Wrap" TextAlignment="Center"
                                       IsVisible="{Binding Folders.Count,
                                           Converter={StaticResource IntIsZeroConverter}}"/>

                            <ItemsControl ItemsSource="{Binding Folders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:CharacterFolderViewModel">
                                        <StackPanel Margin="0,0,0,4">
                                            <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Background="{DynamicResource BgPanelBrush}">
                                                <Grid MinHeight="36">
                                                   <Grid.ColumnDefinitions>
                                                      <ColumnDefinition Width="Auto"/>
                                                      <ColumnDefinition Width="Auto" MinWidth="150" MaxWidth="280"/>
                                                      <ColumnDefinition Width="*" MinWidth="40"/>
                                                      <ColumnDefinition Width="Auto"/>
                                                   </Grid.ColumnDefinitions>

                                                    <!-- Цветной кружок -->
                                                    <Border Grid.Column="0"
                                                            Width="10" Height="10" CornerRadius="5"
                                                            Background="{Binding Color}"
                                                            VerticalAlignment="Center"
                                                            Margin="12,0,8,0"/>

                                                    <!--
                                                        Имя папки — Col 1 (Auto, MinWidth=150).
  
                                                        чтобы ширина колонки не прыгала при
                                                        переключении между режимами отображения.
                                                        Margin="0,0,16,0" — отступ справа.
                                                    -->
                                                    <Panel Grid.Column="1" Margin="0,0,16,0">
                                                        <Button Command="{ReflectionBinding StartRenameCommand}"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="0" VerticalAlignment="Center"
                                                                HorizontalAlignment="Left"
                                                                IsVisible="{Binding !IsRenaming}">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MinWidth="150"
                                                                       ToolTip.Tip="{Binding Name}"
                                                                       ToolTip.ShowDelay="500"/>
                                                        </Button>
                                                        <TextBox Name="FolderRenameBox"
                                                                 Text="{ReflectionBinding Name}"
                                                                 FontSize="13" FontWeight="SemiBold"
                                                                 MinWidth="150"
                                                                 VerticalAlignment="Center"
                                                                 IsVisible="{Binding IsRenaming}"
                                                                 behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsRenaming}"/>
                                                    </Panel>

                                                    <!-- Col 2: TextBox комментария — right-aligned, растёт влево -->
                                                    <TextBox Grid.Column="2"
                                                             Name="FolderCommentBox"
                                                             Text="{ReflectionBinding Comment}"
                                                             FontStyle="Italic"
                                                             Watermark="комментарий..."
                                                             HorizontalAlignment="Right"
                                                             MinWidth="190"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding IsEditingComment}"
                                                             behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsEditingComment}"/>

                                                    <!-- Col 3: иконка комментария + счётчик + стрелка -->
                                                    <StackPanel Grid.Column="3"
                                                                Orientation="Horizontal"
                                                                Spacing="0"
                                                                VerticalAlignment="Center">

                                                        <!-- Текст комментария (если есть) или иконка-подсказка (если нет) -->
                                                        <Button Command="{ReflectionBinding StartEditCommentCommand}"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="4,0" VerticalAlignment="Center"
                                                                ToolTip.Tip="Добавить комментарий"
                                                                IsVisible="{Binding IsEditingComment, Converter={x:Static BoolConverters.Not}}">
                                                            <Panel>
                                                                <!-- Иконка если комментарий пустой -->
                                                                <PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                                                                          Width="12" Height="12"
                                                                          Foreground="{DynamicResource TextMutedBrush}"
                                                                          Opacity="0.4"
                                                                          IsVisible="{Binding Comment,
                                                                              Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                                                <!-- Текст комментария если не пустой -->
                                                                <TextBlock Text="{Binding Comment}"
                                                                           FontSize="11" FontStyle="Italic"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="200"
                                                                           ToolTip.Tip="{Binding Comment}"
                                                                           ToolTip.ShowDelay="500"
                                                                           IsVisible="{Binding Comment,
                                                                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                            </Panel>
                                                        </Button>

                                                        <TextBlock Text="{Binding Count}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0,4,0"/>
                                                        <Button Command="{ReflectionBinding ToggleExpandCommand}"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="8,0" Margin="0,0,4,0"
                                                                VerticalAlignment="Stretch">
                                                            <TextBlock Text="{Binding IsExpanded,
                                                                           Converter={x:Static conv:BoolToCollapseArrowConverter.Instance}}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Карточки персонажей -->
                                            <ItemsControl ItemsSource="{Binding Characters}"
                                                          Margin="12,8"
                                                          IsVisible="{Binding IsExpanded}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:CharacterListItemViewModel">
                                                        <Border Width="148" CornerRadius="10"
                                                                Background="{DynamicResource BgPanelBrush}"
                                                                BorderBrush="{Binding Color}"
                                                                BorderThickness="2"
                                                                ClipToBounds="True"
                                                                Margin="6">
                                                            <Grid RowDefinitions="Auto,40">

                                                                <!-- Аватар -->
                                                                <Grid Grid.Row="0" Height="60">
                                                                    <Border Background="{Binding Color}">
                                                                        <TextBlock Text="{Binding FallbackIcon}"
                                                                                   FontSize="30"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="White"/>
                                                                    </Border>
                                                                    <Button Command="{ReflectionBinding $parent[UserControl].DataContext.EditCharacterCommand}"
                                                                            CommandParameter="{Binding Id}"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="4" Padding="4,2"
                                                                            Background="#88000000"
                                                                            BorderThickness="0"
                                                                            CornerRadius="4"
                                                                            ToolTip.Tip="Редактировать"
                                                                            IsVisible="{Binding !IsBeingNamed}">
                                                                        <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                                                  Width="11" Height="11"
                                                                                  Foreground="White"/>
                                                                    </Button>
                                                                </Grid>

                                                                <!-- Inline ввод имени при создании -->
                                                                <TextBox Grid.Row="1"
                                                                         Text="{ReflectionBinding InlineName}"
                                                                         Watermark="Безымянный"
                                                                         FontSize="12" FontWeight="Medium"
                                                                         TextAlignment="Center"
                                                                         Background="Transparent"
                                                                         BorderBrush="{DynamicResource AccentDefaultBrush}"
                                                                         BorderThickness="0,0,0,1"
                                                                         CornerRadius="0"
                                                                         Padding="6,0"
                                                                         Margin="4,0"
                                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                                         VerticalAlignment="Center"
                                                                         IsVisible="{Binding IsBeingNamed}"
                                                                         behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsBeingNamed}"/>

                                                                <!-- Имя — клик = редактировать, 2 строки -->
                                                                <Button Grid.Row="1"
                                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.EditCharacterCommand}"
                                                                        CommandParameter="{Binding Id}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Center"
                                                                        IsVisible="{Binding !IsBeingNamed}">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="12" FontWeight="Medium"
                                                                               TextWrapping="Wrap"
                                                                               TextAlignment="Center"
                                                                               MaxLines="2"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="8,0"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               ToolTip.Tip="{Binding Name}"
                                                                               ToolTip.ShowDelay="500"/>
                                                                </Button>

                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки создания снизу -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <Grid ColumnDefinitions="3*,*">
                            <Button Grid.Column="0"
                                    Command="{ReflectionBinding CreateCharacterCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Height="40" CornerRadius="8"
                                    Background="{DynamicResource AccentDefaultBrush}"
                                    Foreground="White" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                              Width="16" Height="16" Foreground="White"/>
                                    <TextBlock Text="{x:Static loc:CharactersStrings.Button_CreateCharacter}"
                                               FontSize="13" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Command="{ReflectionBinding CreateCollectiveCharacterCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Height="40" CornerRadius="8"
                                    Background="{DynamicResource AccentDefaultBrush}"
                                    Foreground="White"
                                    ToolTip.Tip="{x:Static loc:CharactersStrings.Button_CreateCollective}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                              Width="16" Height="16" Foreground="White"/>
                                    <TextBlock Text="Группа" FontSize="12" VerticalAlignment="Center"
                                               Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Вкладка 1: Редактирование персонажа -->
                <Grid x:Name="Tab1Panel"
                      ColumnDefinitions="240,*"
                      IsVisible="False">

                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="Auto,*"
                              Background="{DynamicResource BgPanelBrush}">
                            <Border Grid.Row="0" Padding="8,8"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <TextBox Text="{ReflectionBinding SearchQuery}"
                                         Watermark="{x:Static loc:CharactersStrings.Search_Placeholder}"
                                         FontSize="12"
                                         Background="{DynamicResource BgSurfaceBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderDefaultBrush}"
                                         BorderThickness="1" CornerRadius="6" Padding="7,5"/>
                            </Border>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding FilteredCharacters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{ReflectionBinding $parent[UserControl].DataContext.EditCharacterCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="0">
                                                <Grid ColumnDefinitions="4,34,*" MinHeight="52">
                                                    <Border Grid.Column="0" Background="{Binding Color}"/>
                                                    <Border Grid.Column="1"
                                                            Width="24" Height="24" CornerRadius="12"
                                                            Background="{Binding Color}" Margin="5,0">
                                                        <TextBlock Text="{Binding FallbackIcon}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="2"
                                                                Margin="0,8,8,8"
                                                                VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12" FontWeight="Medium"
                                                                   MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding ShortDescription}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding ShortDescription,
                                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Panel Grid.Column="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding !IsCardOpen}">
                            <TextBlock Text="{x:Static loc:CharactersStrings.Placeholder_SelectCharacter}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Grid RowDefinitions="Auto,*"
                              IsVisible="{Binding IsCardOpen, FallbackValue=False}">
                            <Border Grid.Row="0" Padding="12,8"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="{DynamicResource BgPanelBrush}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0"
                                            Width="12" Height="12" CornerRadius="6"
                                            Background="{Binding SelectedCharacterCard.Color, FallbackValue='#607D8B'}"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedCharacterCard.DisplayName, FallbackValue=''}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2"
                                            Content="{x:Static loc:CharactersStrings.Button_Save}"
                                            Command="{Binding SelectedCharacterCard.SaveCommand}"
                                            FontSize="11" Padding="10,4"
                                            Background="{DynamicResource AccentDefaultBrush}"
                                            Foreground="White" CornerRadius="6"/>
                                </Grid>
                            </Border>
                            <views:CharacterCardView Grid.Row="1"
                                                     DataContext="{Binding SelectedCharacterCard}"
                                                     Background="{DynamicResource BgSurfaceBrush}"/>
                        </Grid>
                    </Panel>
                </Grid>

                <!-- Вкладка 2: Связи -->
                <graph:CharactersGraphView x:Name="Tab2Panel"
                                           DataContext="{Binding GraphViewModel}"
                                           Background="{DynamicResource BgSurfaceBrush}"
                                           IsVisible="False"/>

                <!-- Вкладка 3: Шаблоны -->
                <tmpl:CharactersTemplatesView x:Name="Tab3Panel"
                                              DataContext="{Binding TemplatesViewModel}"
                                              Background="{DynamicResource BgSurfaceBrush}"
                                              IsVisible="False"/>

            </Panel>
        </Grid>
    </Grid>
</UserControl>
