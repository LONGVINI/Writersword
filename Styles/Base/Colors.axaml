<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Фоны -->
	<Color x:Key="BgBase">#0D0D0D</Color>
	<Color x:Key="BgApp">#1E1E1E</Color>
	<Color x:Key="BgSurface">#252526</Color>
	<Color x:Key="BgPanel">#2D2D30</Color>
	<Color x:Key="BgHover">#3A3A3C</Color>

	<SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}"/>
	<SolidColorBrush x:Key="BgAppBrush" Color="{StaticResource BgApp}"/>
	<SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}"/>
	<SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}"/>
	<SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}"/>

	<!-- Текст -->
	<Color x:Key="TextPrimary">#FFFFFF</Color>
	<Color x:Key="TextSecondary">#CCCCCC</Color>
	<Color x:Key="TextMuted">#999999</Color>
	<Color x:Key="TextDisabled">#555555</Color>

	<SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
	<SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
	<SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
	<SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}"/>

	<!-- Акцент -->
	<Color x:Key="AccentDefault">#007ACC</Color>
	<Color x:Key="AccentHover">#1C86C8</Color>
	<Color x:Key="AccentPressed">#005A9E</Color>

	<SolidColorBrush x:Key="AccentDefaultBrush" Color="{StaticResource AccentDefault}"/>
	<SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
	<SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}"/>

	<!-- Границы -->
	<Color x:Key="BorderDefault">#3E3E42</Color>
	<Color x:Key="BorderSubtle">#2D2D30</Color>

	<SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefault}"/>
	<SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>

</ResourceDictionary>