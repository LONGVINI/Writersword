<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Notes.ViewModels"
             xmlns:views="using:Writersword.Modules.Notes.Views"
             xmlns:loc="using:Writersword.Modules.Notes.Resources"
             xmlns:ui="using:Writersword.Styles.UserControls"
             x:Class="Writersword.Modules.Notes.Views.NotesView"
             x:DataType="vm:NotesViewModel"
             ui:ModalHost.IsHost="True"
             Background="{DynamicResource BgSurfaceBrush}"
             Tag="Notes">

    <!--
        Заметки.

        Сверху лента, собранная по образцу вкладок ленты редактора: группы в
        рамках с подписями, значки того же набора, буквы Ж, К и З вместо
        значков для начертания и галерея стилей с образцами вместо кнопок с
        названиями уровней заголовка.

        Слева список страниц с поиском, справа страница: заголовок, подпись о
        времени правки и строки. Каждая строка — отдельное поле ввода; вид
        строки рисует разметка, а не служебные символы в тексте.
    -->

    <UserControl.Styles>

        <!-- ── Лента ──────────────────────────────────────────────────────
             Рамка группы, подпись группы и цвета кнопок приходят общими
             стилями RibbonGroup и RibbonBtn из UI.Shared. Здесь — только
             размер кнопки-слова и признак нажатого состояния.

             Кнопки вида строки — обычные Button с классом active, а не
             ToggleButton. У тумблера своё внутреннее состояние: он
             переключался от щелчка сам, односторонняя привязка возвращала его
             обратно только при смене свойства, и без выбранной строки кнопка
             оставалась вдавленной, ничего не сделав. -->
        <Style Selector="Button.notesWord">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Лента не забирает ввод: каретка остаётся в строке, и после
                 нажатия можно продолжать печатать. -->
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.notesWord.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.notesWord.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="Button.notesWord:disabled PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
        </Style>
        <Style Selector="Button.notesWord PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <!-- ── Галерея стилей ─────────────────────────────────────────────
             Карточки с образцом начертания — тот же приём, что в группе
             «Стили» ленты редактора: на карточке написано название тем самым
             начертанием, которое применится. -->
        <Style Selector="ListBox.StyleGallery">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem Border.StyleCard">
            <Setter Property="Background" Value="#F8F6F0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem:pointerover Border.StyleCard">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ListBox.StyleGallery ListBoxItem:selected Border.StyleCard">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Ряд кнопок внутри группы: два ряда по 24 точки — то же тело
             группы в 56 точек, что и на вкладках редактора. -->
        <Style Selector="StackPanel.notesRow">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="4"/>
        </Style>

        <!-- ── Список страниц ─────────────────────────────────────────────
             Выбранная страница держит акцент и под курсором, и при смене
             цветовой темы. -->
        <Style Selector="ListBox.notesPages ListBoxItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox.notesPages ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox.notesPages ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.notesPages ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>
        <Style Selector="ListBox.notesPages ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>

        <!-- Разделитель ширины панели -->
        <Style Selector="Thumb.notesSplitter">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Cursor" Value="SizeWestEast"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- ── Строка страницы ────────────────────────────────────────────
             Строка целиком лежит в рамке: рамка красит подсветку и показывает,
             где стоит каретка. -->
        <Style Selector="Border.noteRow">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.noteRow.highlighted">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>
        <Style Selector="Border.noteRow.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
        </Style>

        <!-- Поле ввода строки: без рамки, без своего фона, без подсветки при
             наведении. Общий стиль поля рисует всё это на каждой строке, и
             страница превращалась в лестницу из рамок. -->
        <Style Selector="TextBox.noteEditor">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeM}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <!-- Перевод строки разбирает модуль: Enter делит строку надвое и
                 заводит следующую того же вида. Своя обработка поля сработала
                 бы первой и вставила бы перевод внутрь строки. -->
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style Selector="TextBox.noteEditor /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.noteEditor:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.noteEditor:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.noteEditor:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.noteEditor:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Поле под отрисованной надписью: текст рисует надпись, поле в это
             время прозрачное, иначе строка двоится. -->
        <Style Selector="TextBox.noteEditor.behindOverlay">
            <Setter Property="Foreground" Value="Transparent"/>
        </Style>

        <!-- Отрисованная надпись поверх поля -->
        <Style Selector="views|MarkdownText">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeM}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Кегли заголовков. Один набор на поле и на надпись: они лежат друг
             на друге и обязаны совпадать до точки. -->
        <Style Selector="TextBox.noteEditor.h1">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeXXL}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="views|MarkdownText.h1">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeXXL}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBox.noteEditor.h2">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeXL}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="views|MarkdownText.h2">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeXL}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBox.noteEditor.h3">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeL}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="views|MarkdownText.h3">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeL}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBox.noteEditor.h4">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="views|MarkdownText.h4">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBox.noteEditor.h5">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="views|MarkdownText.h5">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBox.noteEditor.h6">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeS}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="views|MarkdownText.h6">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeS}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="TextBox.noteEditor.quoteText">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="views|MarkdownText.quoteText">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style Selector="TextBox.noteEditor.codeText">
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeS}"/>
        </Style>
        <Style Selector="views|MarkdownText.codeText">
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeS}"/>
        </Style>

        <!-- Обрамление текста: полоска цитаты, подложка кода -->
        <Style Selector="Border.noteContent">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="0,2"/>
        </Style>
        <Style Selector="Border.noteContent.quote">
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style Selector="Border.noteContent.code">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <!-- Поле слева от текста: точка списка, номер, коробочка задачи -->
        <Style Selector="TextBlock.noteMarker">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeS}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="CheckBox.noteCheck">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Строка — горизонтальная черта -->
        <Style Selector="Border.noteDivider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BorderDefaultBrush}"/>
        </Style>

        <!-- Заголовок страницы -->
        <Style Selector="TextBox.noteTitle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeXXL}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBox.noteTitle /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.noteTitle:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.noteTitle:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

    </UserControl.Styles>

    <Grid>
        <Grid RowDefinitions="Auto,*">

            <!-- ══════════════════════════════════════════════════════════
                 ЛЕНТА
                 ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <ui:RibbonScrollContainer Height="88">
                    <ui:RibbonScrollContainer.RibbonContent>
                        <StackPanel Orientation="Horizontal">

                            <Border Classes="RibbonGroup">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                                        <TextBlock Classes="RibbonGroupLabel" Text="{x:Static loc:NotesStrings.Group_Pages}"/>
                                    </Grid>
                                    <StackPanel Spacing="4" VerticalAlignment="Top">
                                        <StackPanel Classes="notesRow">
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Action_NewPage}"
                                                    IsEnabled="{Binding IsEditable}"
                                                    Click="OnAddPageClick">
                                                <PathIcon Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 14h-3v3h-2v-3H8v-2h3v-3h2v3h3v2zm-3-7V3.5L18.5 9H13z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Action_DuplicatePage}"
                                                    IsEnabled="{Binding IsEditable}"
                                                    Click="OnDuplicatePageClick">
                                                <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Action_CopyPage}"
                                                    Click="OnCopyPageClick">
                                                <PathIcon Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Classes="notesRow">
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Action_RemovePage}"
                                                    IsEnabled="{Binding IsEditable}"
                                                    Click="OnRemovePageClick">
                                                <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Action_PageUp}"
                                                    IsEnabled="{Binding CanMovePageUp}"
                                                    Click="OnMovePageUpClick">
                                                <PathIcon Data="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Action_PageDown}"
                                                    IsEnabled="{Binding CanMovePageDown}"
                                                    Click="OnMovePageDownClick">
                                                <PathIcon Data="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    Classes.active="{Binding IsWidePagePanelVisible}"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Action_TogglePages}"
                                                    Click="OnTogglePagesClick">
                                                <PathIcon Data="M3 15h6v-2H3v2zm0 4h6v-2H3v2zm0-8h6V9H3v2zm0-4h6V5H3v2zm8 8h10v-2H11v2zm0 4h10v-2H11v2zm0-6h10V9H11v2zm0-6v2h10V5H11z"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Classes="RibbonGroup">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                                        <TextBlock Classes="RibbonGroupLabel" Text="{x:Static loc:NotesStrings.Group_Styles}"/>
                                    </Grid>
                                    <ListBox Classes="StyleGallery"
                                             Height="56"
                                             IsEnabled="{Binding CanEditBlock}"
                                             ItemsSource="{Binding BlockStyles}"
                                             SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="2"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NoteStyleViewModel">
                                                <Border Classes="StyleCard" Width="68" Height="52" Padding="4,3">
                                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="{Binding PreviewSize}"
                                                                   FontWeight="{Binding PreviewWeight}"
                                                                   FontStyle="{Binding PreviewStyle}"
                                                                   FontFamily="{Binding PreviewFont}"
                                                                   Foreground="#1A1A1A"
                                                                   TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="8"
                                                                   Foreground="#6A6A6A"
                                                                   TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Classes="RibbonGroup">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                                        <TextBlock Classes="RibbonGroupLabel" Text="{x:Static loc:NotesStrings.Group_Lists}"/>
                                    </Grid>
                                    <StackPanel Spacing="4" VerticalAlignment="Top">
                                        <StackPanel Classes="notesRow">
                                            <Button Classes="RibbonBtn notesWord"
                                                    Classes.active="{Binding IsBulletSelected}"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Block_Bullet}"
                                                    Tag="Bullet"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnBlockTypeClick">
                                                <PathIcon Data="M4 10.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5zm0-6c-.83 0-1.5.67-1.5 1.5S3.17 7.5 4 7.5 5.5 6.83 5.5 6 4.83 4.5 4 4.5zm0 12c-.83 0-1.5.68-1.5 1.5s.68 1.5 1.5 1.5 1.5-.68 1.5-1.5-.67-1.5-1.5-1.5zM7 19h14v-2H7v2zm0-6h14v-2H7v2zm0-8v2h14V5H7z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    Classes.active="{Binding IsNumberedSelected}"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Block_Numbered}"
                                                    Tag="Numbered"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnBlockTypeClick">
                                                <PathIcon Data="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Classes="notesRow">
                                            <Button Classes="RibbonBtn notesWord"
                                                    Classes.active="{Binding IsChecklistSelected}"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Block_Checklist}"
                                                    Tag="Checklist"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnBlockTypeClick">
                                                <PathIcon Data="M22 7h-9v2h9V7zm0 8h-9v2h9v-2zM5.54 11L2 7.46l1.41-1.41 2.12 2.12 4.24-4.24 1.41 1.41L5.54 11zm0 8L2 15.46l1.41-1.41 2.12 2.12 4.24-4.24 1.41 1.41L5.54 19z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    Classes.active="{Binding IsDividerSelected}"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Block_Divider}"
                                                    Tag="Divider"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnBlockTypeClick">
                                                <PathIcon Data="M4 11h16v2H4z"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Classes="RibbonGroup">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                                        <TextBlock Classes="RibbonGroupLabel" Text="{x:Static loc:NotesStrings.Group_Inline}"/>
                                    </Grid>
                                    <StackPanel Spacing="4" VerticalAlignment="Top">
                                        <StackPanel Classes="notesRow">
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Inline_Bold}"
                                                    Tag="**"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnWrapClick">
                                                <TextBlock Text="{x:Static loc:NotesStrings.Inline_Bold_Letter}" FontWeight="Bold"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Inline_Italic}"
                                                    Tag="*"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnWrapClick">
                                                <TextBlock Text="{x:Static loc:NotesStrings.Inline_Italic_Letter}" FontStyle="Italic" FontFamily="Georgia"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Inline_Strike}"
                                                    Tag="~~"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnWrapClick">
                                                <Grid Width="14" Height="14">
                                                    <TextBlock Text="{x:Static loc:NotesStrings.Inline_Strike_Letter}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Rectangle Height="1.5" Fill="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Classes="notesRow">
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Inline_Code}"
                                                    Tag="`"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnWrapClick">
                                                <PathIcon Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Inline_Mark}"
                                                    Tag="=="
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnWrapClick">
                                                <PathIcon Data="M23.06 18.17l-4.58-4.58-.01.01L9.27 4.42C8.9 4.05 8.43 3.86 7.96 3.86c-.47 0-.94.19-1.31.55l-1.27 1.27c-.37.37-.56.84-.55 1.31 0 .47.19.95.56 1.31L9.7 12.6l-4.1 4.1C4.4 17.9 4 19 4 20h2c0-.48.2-1.02.64-1.46l4.1-4.1 3.72 3.72c.37.37.84.55 1.31.55.47 0 .94-.18 1.31-.55l1.27-1.27c.72-.73.73-1.9.01-2.62 0-.03-.02-.04-.03-.06z"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Classes="RibbonGroup">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                                        <TextBlock Classes="RibbonGroupLabel" Text="{x:Static loc:NotesStrings.Group_Line}"/>
                                    </Grid>
                                    <StackPanel Spacing="4" VerticalAlignment="Top">
                                        <StackPanel Classes="notesRow">
                                            <Button Classes="RibbonBtn notesWord"
                                                    Classes.active="{Binding IsStrikeSelected}"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Line_Strike}"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnStrikeClick">
                                                <PathIcon Data="M10 19h4v-3h-4v3zM5 4v3h5v3h4V7h5V4H5zM3 14h18v-2H3v2z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    Classes.active="{Binding IsHighlightSelected}"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Line_Highlight}"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnHighlightClick">
                                                <PathIcon Data="M18 4V3c0-.55-.45-1-1-1H5c-.55 0-1 .45-1 1v4c0 .55.45 1 1 1h12c.55 0 1-.45 1-1V6h1v4H9v11c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-9h8V4h-3z"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Classes="notesRow">
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Line_Up}"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnMoveBlockUpClick">
                                                <PathIcon Data="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Line_Down}"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnMoveBlockDownClick">
                                                <PathIcon Data="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"/>
                                            </Button>
                                            <Button Classes="RibbonBtn notesWord"
                                                    ToolTip.Tip="{x:Static loc:NotesStrings.Line_Remove}"
                                                    IsEnabled="{Binding CanEditBlock}"
                                                    Click="OnRemoveBlockClick">
                                                <PathIcon Data="M22 3H7c-.69 0-1.23.35-1.59.88L0 12l5.41 8.11c.36.53.9.89 1.59.89h15c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-3 12.59L17.59 17 14 13.41 10.41 17 9 15.59 12.59 12 9 8.41 10.41 7 14 10.59 17.59 7 19 8.41 15.41 12 19 15.59z"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                        </StackPanel>
                    </ui:RibbonScrollContainer.RibbonContent>
                </ui:RibbonScrollContainer>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 ТЕЛО
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">

                <!-- Панель страниц -->
                <Border Grid.Column="0"
                        Width="{Binding PagePanelWidth}"
                        IsVisible="{Binding IsWidePagePanelVisible}"
                        Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="{DynamicResource PaddingS}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">

                        <TextBlock Grid.Row="0"
                                   Margin="2,0,2,6"
                                   Text="{x:Static loc:NotesStrings.Pages_Header}"
                                   FontSize="{DynamicResource FontSizeS}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBox Grid.Row="1"
                                 Margin="0,0,0,6"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="{x:Static loc:NotesStrings.Pages_SearchWatermark}"/>

                        <ListBox Grid.Row="2"
                                 Classes="notesPages"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding FilteredPages}"
                                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NotePageViewModel">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="{DynamicResource FontSizeS}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}"
                                                   FontSize="{DynamicResource FontSizeXS}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Preview,
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="3"
                                   Margin="2,6,2,0"
                                   Text="{Binding PageCountText}"
                                   FontSize="{DynamicResource FontSizeXS}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>

                    </Grid>
                </Border>

                <Thumb Grid.Column="1"
                       Classes="notesSplitter"
                       IsVisible="{Binding IsWidePagePanelVisible}"
                       DragDelta="OnPanelResize"/>

                <!-- Страница -->
                <Grid Grid.Column="2"
                      Margin="{DynamicResource PaddingM}"
                      RowDefinitions="Auto,Auto,*"
                      IsVisible="{Binding HasSelectedPage}">

                    <TextBox Grid.Row="0"
                             Classes="noteTitle"
                             Text="{Binding SelectedPage.Title, Mode=TwoWay}"
                             PlaceholderText="{x:Static loc:NotesStrings.Page_TitleWatermark}"
                             IsEnabled="{Binding IsEditable}"
                             KeyDown="OnTitleKeyDown"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <TextBlock Text="{Binding SelectedPage.UpdatedAtText}"
                                   FontSize="{DynamicResource FontSizeXS}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedPage.TaskCountText}"
                                   IsVisible="{Binding SelectedPage.HasTasks}"
                                   FontSize="{DynamicResource FontSizeXS}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="0,10,0,0"
                            Background="{DynamicResource BgPanelBrush}"
                            CornerRadius="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <!-- Полотно ведёт себя как одно поле: оно занимает
                                 всю видимую высоту, и щелчок по пустому месту
                                 под строками ставит каретку в конец текста, а
                                 не проваливается в никуда. Высота берётся у
                                 области прокрутки, а не задана числом: иначе
                                 на короткой странице появлялась бы полоса
                                 прокрутки под пустотой. -->
                            <Grid Background="Transparent"
                                  RowDefinitions="Auto,Auto,*"
                                  Margin="{DynamicResource PaddingL}"
                                  MinHeight="{Binding $parent[ScrollViewer].Bounds.Height}"
                                  PointerPressed="OnCanvasPointerPressed">

                                <ItemsControl Grid.Row="0"
                                              x:Name="BlocksHost"
                                              ItemsSource="{Binding SelectedPage.Blocks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NoteBlockViewModel">
                                            <Border Classes="noteRow"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Classes.highlighted="{Binding IsHighlighted}"
                                                    Background="Transparent"
                                                    PointerPressed="OnRowPointerPressed">
                                                <Grid ColumnDefinitions="28,*">

                                                    <Panel Grid.Column="0" MinHeight="22" VerticalAlignment="Top">
                                                        <TextBlock Classes="noteMarker"
                                                                   Text="{Binding Marker}"
                                                                   IsVisible="{Binding HasMarker}"/>
                                                        <CheckBox Classes="RibbonCheck noteCheck"
                                                                  IsVisible="{Binding IsChecklist}"
                                                                  IsEnabled="{Binding IsEditable}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                    </Panel>

                                                    <Border Grid.Column="1"
                                                            Classes="noteDivider"
                                                            IsVisible="{Binding IsDivider}"/>

                                                    <Border Grid.Column="1"
                                                            Classes="noteContent"
                                                            Classes.quote="{Binding IsQuote}"
                                                            Classes.code="{Binding IsCode}"
                                                            IsVisible="{Binding HasText}">
                                                        <Panel>
                                                            <TextBox Classes="noteEditor"
                                                                     Classes.h1="{Binding IsHeading1}"
                                                                     Classes.h2="{Binding IsHeading2}"
                                                                     Classes.h3="{Binding IsHeading3}"
                                                                     Classes.h4="{Binding IsHeading4}"
                                                                     Classes.h5="{Binding IsHeading5}"
                                                                     Classes.h6="{Binding IsHeading6}"
                                                                     Classes.quoteText="{Binding IsQuote}"
                                                                     Classes.codeText="{Binding IsCode}"
                                                                     Classes.behindOverlay="{Binding ShowFormatted}"
                                                                     Text="{Binding Text, Mode=TwoWay}"
                                                                     IsReadOnly="{Binding IsReadOnly}"
                                                                     GotFocus="OnBlockGotFocus"
                                                                     LostFocus="OnBlockLostFocus"/>
                                                            <views:MarkdownText
                                                                Classes.h1="{Binding IsHeading1}"
                                                                Classes.h2="{Binding IsHeading2}"
                                                                Classes.h3="{Binding IsHeading3}"
                                                                Classes.h4="{Binding IsHeading4}"
                                                                Classes.h5="{Binding IsHeading5}"
                                                                Classes.h6="{Binding IsHeading6}"
                                                                Classes.quoteText="{Binding IsQuote}"
                                                                Classes.codeText="{Binding IsCode}"
                                                                IsHitTestVisible="False"
                                                                IsVisible="{Binding ShowFormatted}"
                                                                IsStruck="{Binding IsVisuallyStruck}"
                                                                Markdown="{Binding Text}"
                                                                CodeBrush="{DynamicResource TextMutedBrush}"
                                                                MarkBrush="{DynamicResource AccentDefaultBrush}"/>
                                                        </Panel>
                                                    </Border>

                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Подсказка на чистой странице: разметка
                                     набирается с клавиатуры, и сказать об этом
                                     надо там, где её набирают. -->
                                <Border Grid.Row="1"
                                        Margin="30,10,0,0"
                                        IsVisible="{Binding SelectedPage.IsEmpty}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Static loc:NotesStrings.Hint_Header}"
                                                   FontSize="{DynamicResource FontSizeXS}"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{x:Static loc:NotesStrings.Hint_Blocks}"
                                                   FontSize="{DynamicResource FontSizeXS}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                                        <TextBlock Text="{x:Static loc:NotesStrings.Hint_Inline}"
                                                   FontSize="{DynamicResource FontSizeXS}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Плашка отмены: удаление страницы или строки уносит текст, и
             вернуть его должно быть нечем иным, как одним нажатием. -->
        <Border ZIndex="50"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,18"
                Padding="14,8,8,8"
                CornerRadius="8"
                Background="#E0161616"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                IsVisible="{Binding HasUndoMessage}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" OffsetX="0" OffsetY="4" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding UndoMessage}"
                           FontSize="{DynamicResource FontSizeS}"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="{x:Static loc:NotesStrings.Action_Undo}"
                        Background="#33FFFFFF"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="{DynamicResource FontSizeS}"
                        Padding="8,3"
                        MinHeight="0"
                        VerticalAlignment="Center"
                        Click="OnUndoClick"/>
                <Button Content="{x:Static loc:NotesStrings.Action_Dismiss}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,3"
                        MinHeight="0"
                        Foreground="#88FFFFFF"
                        FontSize="{DynamicResource FontSizeS}"
                        VerticalAlignment="Center"
                        Click="OnDismissUndoClick"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
