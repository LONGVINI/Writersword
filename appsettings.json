{
  // Уровни логирования.
  //
  // Всё, чего нет в Override, пишется от Warning и выше — то есть только когда
  // что-то пошло не так. Поднимать до Debug имеет смысл ровно то, что сейчас
  // разбирают: Debug при живом интерфейсе — это тысячи строк в секунду, среди
  // которых нужная теряется, а сама запись начинает тормозить отрисовку.
  //
  // Заглушённые области оставлены строками с комментарием, а не удалены: имена
  // длинные, и вспоминать их заново при следующем разборе не придётся — хватит
  // снять две косые черты.
  //
  // Комментарии здесь допустимы: файл читает провайдер конфигурации .NET, а он
  // их пропускает.
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Avalonia": "Warning",

        // ── Что разбираем сейчас ──────────────────────────────────────
        "Writersword.Modules.TextEditor": "Debug",
        "Writersword.Modules.Characters": "Debug",

        // Файлы проекта: укладка картинок и шрифтов, проверка перед передачей,
        // уборка. Служба живёт в Infrastructure, а команды меню — во вьюмодели
        // строки меню, поэтому областей две.
        "Writersword.Infrastructure.Services.Storage.ProjectAssetService": "Debug",
        "Writersword.ViewModels.Components.MenuBar.MenuBarViewModel": "Debug",

        // ── Запуск и завершение ───────────────────────────────────────
        // Information, а не Debug: событий немного, зато они разовые и по ним
        // видно, дошло ли приложение до рабочего состояния.
        "Writersword.Program": "Information",
        "Writersword.App": "Information"

        // ── Заглушено. Снять комментарий, когда разбирают именно это ───
        //
        // "Writersword.Infrastructure.Rendering": "Debug",
        // "Writersword.Infrastructure.Services.DataComparisonService": "Debug",
        // "Writersword.Infrastructure.Services.Project.ProjectWorkflow": "Debug",
        // "Writersword.Infrastructure.Services.Storage": "Debug",
        // "Writersword.Infrastructure.Services.Storage.ProjectService": "Debug",
        // "Writersword.Infrastructure.Services.Storage.LocalSettingsStorageService": "Debug",
        // "Writersword.Infrastructure.Services.Modules.ModuleStateCollectorService": "Debug",
        // "Writersword.Infrastructure.Services.Project.AutoSaveService": "Debug",
        // "Writersword.Infrastructure.Dock": "Debug",
        // "Writersword.Infrastructure.WorkFlows": "Debug",
        // "Writersword.Infrastructure.Controls": "Debug",
        // "Writersword.ViewModels": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{ShortSourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "path": "logs/writersword-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [{ShortSourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithShortSourceContext" ]
  }
}
