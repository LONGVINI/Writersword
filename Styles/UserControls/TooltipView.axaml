<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:img="using:AnimatedImage.Avalonia"
             x:Class="Writersword.Styles.UserControls.TooltipView"
             x:Name="RootView"
             Background="Transparent"
             MinWidth="160"
             MaxWidth="320">

	<UserControl.Styles>
		<Style Selector="PopupRoot">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
	</UserControl.Styles>

	<StackPanel Background="Transparent">

		<!-- Треугольник сверху (подсказка под кнопкой) -->
		<Path IsVisible="{Binding !ArrowAtBottom, ElementName=RootView}"
              HorizontalAlignment="Left"
              Fill="{Binding TooltipBackground, ElementName=RootView}"
              Stroke="{Binding TooltipBorderBrush, ElementName=RootView}"
              StrokeThickness="1"
              Data="M 0,6 L 6,0 L 12,6 Z"
              Margin="0 0 0 -1">
			<Path.RenderTransform>
				<TranslateTransform X="{Binding ArrowHorizontalOffset, ElementName=RootView}"/>
			</Path.RenderTransform>
		</Path>

		<!-- Основной блок -->
		<Border Background="{Binding TooltipBackground, ElementName=RootView}"
                BorderBrush="{Binding TooltipBorderBrush, ElementName=RootView}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12 10"
                BoxShadow="0 4 16 0 #44000000">

			<StackPanel Spacing="0">

				<!-- Картинка/гифка -->
				<Border IsVisible="{Binding PreviewPath, ElementName=RootView,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Margin="0 0 0 8"
                        CornerRadius="4"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">
					<Image img:ImageBehavior.AnimatedSource="{Binding PreviewPath, ElementName=RootView}"
                           MaxWidth="280"
                           MaxHeight="160"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
				</Border>

				<!-- Разделитель между картинкой и текстом -->
				<Separator IsVisible="{Binding PreviewPath, ElementName=RootView,
                                      Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Height="1"
                           Background="{Binding TooltipBorderBrush, ElementName=RootView}"
                           Margin="0 0 0 8"
                           Opacity="0.4"/>

				<!-- Заголовок и описание. Отступ между ними задан Spacing:
				     скрытый заголовок не оставляет пустого места сверху. -->
				<StackPanel Spacing="4">

					<!-- Заголовок. Скрывается если не задан: у значка рядом
					     с подписью раздела он лишь повторял бы эту подпись. -->
					<TextBlock Text="{Binding Title, ElementName=RootView}"
                               IsVisible="{Binding Title, ElementName=RootView,
                                          Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{Binding TooltipForeground, ElementName=RootView}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

					<!-- Описание. Текст собирается в code-behind: поддерживаются
					     переносы строк и выделение фрагментов звёздочками. -->
					<TextBlock x:Name="DescriptionText"
                               IsVisible="{Binding Description, ElementName=RootView,
                                          Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{Binding TooltipForeground, ElementName=RootView}"
                               FontSize="11"
                               Opacity="0.75"
                               TextWrapping="Wrap"/>

				</StackPanel>

				<!-- Горячие клавиши — заполняется программно из code-behind -->
				<StackPanel x:Name="HotKeysContainer"
                            IsVisible="False"
                            HorizontalAlignment="Right"
                            Spacing="3"
                            Margin="0 8 0 0"/>

			</StackPanel>
		</Border>

		<!-- Треугольник снизу (подсказка над кнопкой) -->
		<Path IsVisible="{Binding ArrowAtBottom, ElementName=RootView}"
              HorizontalAlignment="Left"
              Fill="{Binding TooltipBackground, ElementName=RootView}"
              Stroke="{Binding TooltipBorderBrush, ElementName=RootView}"
              StrokeThickness="1"
              Data="M 0,0 L 6,6 L 12,0 Z"
              Margin="0 -1 0 0">
			<Path.RenderTransform>
				<TranslateTransform X="{Binding ArrowHorizontalOffset, ElementName=RootView}"/>
			</Path.RenderTransform>
		</Path>

	</StackPanel>

</UserControl>