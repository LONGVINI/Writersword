{
  // Уровни логирования.
  //
  // Обычный режим: Default на Warning. Разбор истории с пропажей данных у
  // модулей закончен, и держать весь свой код на Debug больше незачем — журнал
  // за день работы от этого становится нечитаемым.
  //
  // Чтобы снова что-то разбирать, поднимать до Debug нужно точечно: либо
  // Default, либо конкретную область через Override — например
  // "Writersword.Modules.TextEditor": "Debug".
  //
  // Комментарии здесь допустимы: файл читает провайдер конфигурации .NET, а он
  // их пропускает.
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      // Чужие сборки остаются на Warning, и это не полумера. Debug у Avalonia —
      // это трассировка разметки и привязок на каждый кадр, тысячи строк в
      // секунду; нужная запись в них не находится, а сама запись начинает
      // тормозить отрисовку. Ровно та причина, по которой LogToTrace в Program.cs
      // держат на Warning.
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Avalonia": "Warning",

        // Рендер текста и вёрстка страниц шумят на каждый кадр и к нынешнему
        // разбору отношения не имеют.
        "Writersword.Infrastructure.Rendering": "Warning",

        // РАЗБОР ЗАЛИПАНИЯ ввода. Всё это вернуть на Warning, когда закончим.
        "Writersword.Modules.TextEditor": "Debug",

        // Пробы пишутся под своими короткими именами, а не под Writersword.*,
        // поэтому их глушил бы Default. Разрешаем поимённо.
        "PointerProbe": "Debug",
        "UiStall": "Debug",
        "FontDropdown": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          // РАЗБОР: консоль пропускает Debug, иначе пробы видны только в файле,
          // а копируют обычно из консоли. Вернуть на Information, когда закончим.
          "restrictedToMinimumLevel": "Debug",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{ShortSourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "path": "logs/writersword-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [{ShortSourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithShortSourceContext" ]
  }
}
