<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Style Selector="Button.RibbonScrollArrow">
		<Setter Property="Background"                 Value="{DynamicResource BgPanelBrush}"/>
		<Setter Property="BorderBrush"                Value="{DynamicResource BorderDefaultBrush}"/>
		<Setter Property="BorderThickness"            Value="0 0 1 0"/>
		<Setter Property="Padding"                    Value="3 0"/>
		<Setter Property="Width"                      Value="16"/>
		<Setter Property="MinHeight"                  Value="0"/>
		<Setter Property="VerticalAlignment"          Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment"   Value="Center"/>
		<Setter Property="Foreground"                 Value="{DynamicResource TextSecondaryBrush}"/>
		<Setter Property="Cursor"                     Value="Hand"/>
		<Setter Property="IsVisible"                  Value="False"/>
	</Style>
	<Style Selector="Button.RibbonScrollArrow /template/ ContentPresenter">
		<Setter Property="Background"      Value="{DynamicResource BgPanelBrush}"/>
		<Setter Property="BorderBrush"     Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CornerRadius"    Value="0"/>
	</Style>
	<Style Selector="Button.RibbonScrollArrow:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
	</Style>
	<Style Selector="Button.RibbonScrollArrow:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
	</Style>
	<Style Selector="Button.RibbonScrollArrowRight">
		<Setter Property="BorderThickness" Value="1 0 0 0"/>
	</Style>

</Styles>