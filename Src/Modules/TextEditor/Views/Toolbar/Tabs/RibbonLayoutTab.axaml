<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.Toolbar"
             xmlns:converters="using:Writersword.Modules.TextEditor.Converters"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             xmlns:loc="using:Writersword.Modules.TextEditor.Resources"
             xmlns:controls="using:Writersword.Styles.UserControls"
             x:Class="Writersword.Modules.TextEditor.Views.Toolbar.Tabs.RibbonLayoutTab"
             x:DataType="vm:RibbonLayoutTabViewModel">

	<UserControl.Styles>

		<Style Selector="Button.RibbonBtn">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="4"/>
			<Setter Property="MinWidth"                   Value="26"/>
			<Setter Property="MinHeight"                  Value="26"/>
			<Setter Property="VerticalAlignment"          Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="Button.RibbonBtn /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="Button.RibbonBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.RibbonBtn:pressed /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<Style Selector="Button.RibbonBtnLarge">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="4 2"/>
			<Setter Property="MinWidth"                   Value="40"/>
			<!-- 56 — общая для всех вкладок высота тела группы: столько занимают
			     два ряда кнопок по 26 в группах «Шрифт» и «Абзац» на «Главной». -->
			<Setter Property="MinHeight"                  Value="56"/>
			<Setter Property="VerticalAlignment"          Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="Button.RibbonBtnLarge /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="Button.RibbonBtnLarge:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.RibbonBtnLarge:pressed /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<Style Selector="ToggleButton.RibbonToggle">
			<Setter Property="Background"                 Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="3"/>
			<Setter Property="Padding"                    Value="4"/>
			<Setter Property="MinWidth"                   Value="26"/>
			<Setter Property="MinHeight"                  Value="26"/>
			<Setter Property="VerticalAlignment"          Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggle /template/ ContentPresenter">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="3"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggle:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggle:pressed /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggle:checked /template/ ContentPresenter">
			<Setter Property="Background"             Value="{DynamicResource AccentSubtleBrush}"/>
			<Setter Property="BorderBrush"            Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="TextElement.Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.RibbonToggle:checked:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<Style Selector="SplitButton.RibbonSplit">
			<Setter Property="Background"        Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"       Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness"   Value="1"/>
			<Setter Property="CornerRadius"      Value="3"/>
			<Setter Property="Padding"           Value="4 4 2 4"/>
			<Setter Property="MinWidth"          Value="26"/>
			<Setter Property="MinHeight"         Value="26"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"            Value="Hand"/>
		</Style>
		<Style Selector="SplitButton.RibbonSplit:pointerover">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="SplitButton.RibbonSplit:pressed">
			<Setter Property="Background"  Value="{DynamicResource AccentPressedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<Style Selector="ComboBox.LayoutField">
			<Setter Property="FontSize"          Value="11"/>
			<Setter Property="MinHeight"         Value="26"/>
			<Setter Property="Padding"           Value="8 0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<Style Selector="Border.RibbonGroup">
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="4"/>
			<Setter Property="Padding"         Value="6 4 6 0"/>
			<Setter Property="Margin"          Value="2 3"/>
		</Style>

		<Style Selector="Border.RibbonGroupCollapsed">
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="4"/>
			<Setter Property="Padding"         Value="2 4 2 0"/>
			<Setter Property="Margin"          Value="2 3"/>
		</Style>

		<Style Selector="Grid.RibbonGroupLabelGrid">
			<Setter Property="Margin" Value="0 3 0 2"/>
		</Style>

		<Style Selector="TextBlock.RibbonGroupLabel">
			<Setter Property="FontSize"            Value="10"/>
			<Setter Property="Foreground"          Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="TextAlignment"       Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment"   Value="Center"/>
		</Style>

	</UserControl.Styles>

	<controls:RibbonScrollContainer x:Name="ScrollContainer">
		<controls:RibbonScrollContainer.RibbonContent>
			<StackPanel Orientation="Horizontal">

				<!-- ═══════════════════════════════════════════════════════
                     СТРАНИЦА — развёрнутая
                     ═══════════════════════════════════════════════════════ -->
				<Border Classes="RibbonGroup"
                        IsVisible="{Binding IsPageGroupExpanded}">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Layout_Page_Group}"/>
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
							<SplitButton Classes="RibbonSplit"
                                         Command="{Binding SetSizeA4Command}"
                                         behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_PageSize}">
								<SplitButton.Content>
									<StackPanel Spacing="2" HorizontalAlignment="Center">
										<PathIcon Data="M6 2c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6H6zm7 7V3.5L18.5 9H13z" Width="20" Height="20"/>
										<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_PageSize}" FontSize="9" TextAlignment="Center"/>
									</StackPanel>
								</SplitButton.Content>
								<SplitButton.Flyout>
									<MenuFlyout>
										<MenuItem Header="A4 (210 x 297 mm)"    Command="{Binding SetSizeA4Command}"/>
										<MenuItem Header="A3 (297 x 420 mm)"    Command="{Binding SetSizeA3Command}"/>
										<MenuItem Header="A5 (148 x 210 mm)"    Command="{Binding SetSizeA5Command}"/>
										<MenuItem Header="Letter (8.5 x 11 in)" Command="{Binding SetSizeLetterCommand}"/>
										<Separator/>
										<MenuItem Header="Ко всему разделу" ToggleType="Radio"
										          IsChecked="{Binding ApplyToSection, Mode=TwoWay}"
										          behaviours:TooltipBehavior.Tip="Размер, ориентация, поля и колонки меняются у всего раздела, в котором стоит каретка"/>
										<MenuItem Header="Только к выделенному" ToggleType="Radio"
										          IsChecked="{Binding ApplyToSelection, Mode=TwoWay}"
										          behaviours:TooltipBehavior.Tip="Выделенные абзацы (без выделения — абзац под кареткой) становятся отдельным разделом: разрывы раздела ставятся сами, остальной текст остаётся как был"/>
									</MenuFlyout>
								</SplitButton.Flyout>
							</SplitButton>
							<SplitButton Classes="RibbonSplit"
                                         Command="{Binding SetOrientationPortraitCommand}"
                                         behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_Orientation}">
								<SplitButton.Content>
									<StackPanel Spacing="2" HorizontalAlignment="Center">
										<PathIcon Data="M17 1H7c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm0 18H7V5h10v14z" Width="20" Height="20"/>
										<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_Orientation}" FontSize="9" TextAlignment="Center"/>
									</StackPanel>
								</SplitButton.Content>
								<SplitButton.Flyout>
									<MenuFlyout>
										<MenuItem Header="{x:Static loc:TextEditorStrings.Orientation_Portrait}"  Command="{Binding SetOrientationPortraitCommand}"/>
										<MenuItem Header="{x:Static loc:TextEditorStrings.Orientation_Landscape}" Command="{Binding SetOrientationLandscapeCommand}"/>
										<Separator/>
										<MenuItem Header="Ко всему разделу" ToggleType="Radio"
										          IsChecked="{Binding ApplyToSection, Mode=TwoWay}"
										          behaviours:TooltipBehavior.Tip="Размер, ориентация, поля и колонки меняются у всего раздела, в котором стоит каретка"/>
										<MenuItem Header="Только к выделенному" ToggleType="Radio"
										          IsChecked="{Binding ApplyToSelection, Mode=TwoWay}"
										          behaviours:TooltipBehavior.Tip="Выделенные абзацы (без выделения — абзац под кареткой) становятся отдельным разделом: разрывы раздела ставятся сами, остальной текст остаётся как был"/>
									</MenuFlyout>
								</SplitButton.Flyout>
							</SplitButton>
							<!-- Поля страницы и переплёт: числа в миллиметрах, правка сразу
							     ложится на документ. -->
							<Button Classes="RibbonBtnLarge"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_Margins}">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Data="M3 3v18h18V3H3zm16 16H5V5h14v14z" Width="20" Height="20"/>
									<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_Margins}" FontSize="9" TextAlignment="Center"/>
								</StackPanel>
								<Button.Flyout>
									<Flyout Placement="Bottom" ShowMode="Standard" Opening="OnMarginsFlyoutOpening">
										<Grid Margin="4" RowSpacing="6" ColumnSpacing="8"
											  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
											  ColumnDefinitions="Auto,Auto">
											<TextBlock Grid.Row="0" Grid.Column="0" Text="Верхнее, мм" FontSize="11" VerticalAlignment="Center"
													   Foreground="{DynamicResource TextSecondaryBrush}"/>
											<NumericUpDown Grid.Row="0" Grid.Column="1" Classes="Ribbon" Width="86"
														   Minimum="0" Maximum="200" Increment="1"
														   FormatString="0.##" ClipValueToMinMax="True"
														   Value="{Binding MarginTopMm, Mode=TwoWay}"/>
											<TextBlock Grid.Row="1" Grid.Column="0" Text="Нижнее, мм" FontSize="11" VerticalAlignment="Center"
													   Foreground="{DynamicResource TextSecondaryBrush}"/>
											<NumericUpDown Grid.Row="1" Grid.Column="1" Classes="Ribbon" Width="86"
														   Minimum="0" Maximum="200" Increment="1"
														   FormatString="0.##" ClipValueToMinMax="True"
														   Value="{Binding MarginBottomMm, Mode=TwoWay}"/>
											<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding MarginLeftLabel}" FontSize="11" VerticalAlignment="Center"
													   Foreground="{DynamicResource TextSecondaryBrush}"/>
											<NumericUpDown Grid.Row="2" Grid.Column="1" Classes="Ribbon" Width="86"
														   Minimum="0" Maximum="200" Increment="1"
														   FormatString="0.##" ClipValueToMinMax="True"
														   Value="{Binding MarginLeftMm, Mode=TwoWay}"/>
											<TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding MarginRightLabel}" FontSize="11" VerticalAlignment="Center"
													   Foreground="{DynamicResource TextSecondaryBrush}"/>
											<NumericUpDown Grid.Row="3" Grid.Column="1" Classes="Ribbon" Width="86"
														   Minimum="0" Maximum="200" Increment="1"
														   FormatString="0.##" ClipValueToMinMax="True"
														   Value="{Binding MarginRightMm, Mode=TwoWay}"/>
											<TextBlock Grid.Row="4" Grid.Column="0" Text="Переплёт, мм" FontSize="11" VerticalAlignment="Center"
													   Foreground="{DynamicResource TextSecondaryBrush}"/>
											<NumericUpDown Grid.Row="4" Grid.Column="1" Classes="Ribbon" Width="86"
														   Minimum="0" Maximum="100" Increment="1"
														   FormatString="0.##" ClipValueToMinMax="True"
														   Value="{Binding GutterMm, Mode=TwoWay}"
														   behaviours:TooltipBehavior.Tip="Полоса под сшивку у корешка: прибавляется к полю. При разных колонтитулах чётных и нечётных страниц переплёт на нечётных листах слева, на чётных справа"/>
											<CheckBox Classes="compact" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Зеркальные поля"
											          IsChecked="{Binding MirrorMargins, Mode=TwoWay}"
											          behaviours:TooltipBehavior.Tip="Левое поле становится внутренним, правое — внешним: на чётных листах они меняются местами вместе с переплётом, как в развороте книги. Настройка всего документа"/>
											<StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2" Margin="0 4 0 0">
												<TextBlock Text="Область применения" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
												<RadioButton Classes="compact" Content="Ко всему разделу"
												             IsChecked="{Binding ApplyToSection, Mode=TwoWay}"/>
												<RadioButton Classes="compact" Content="Только к выделенному"
												             IsChecked="{Binding ApplyToSelection, Mode=TwoWay}"
												             behaviours:TooltipBehavior.Tip="Выделенные абзацы (без выделения — абзац под кареткой) становятся отдельным разделом со своими полями"/>
											</StackPanel>
										</Grid>
									</Flyout>
								</Button.Flyout>
							</Button>
							<!-- Параметры раздела: свой размер листа, выравнивание по высоте, начало
							     раздела, номера строк и рамка страницы. Ложатся одним шагом отмены по
							     «Применить». -->
							<Button Classes="RibbonBtnLarge"
							        behaviours:TooltipBehavior.Tip="Параметры раздела"
							        behaviours:TooltipBehavior.Description="Свой размер листа, выравнивание по высоте, начало раздела, нумерация строк и рамка страницы">
								<StackPanel Spacing="2" HorizontalAlignment="Center">
									<PathIcon Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 7h10v2H7V7zm0 4h10v2H7v-2zm0 4h7v2H7v-2z" Width="20" Height="20"/>
									<TextBlock Text="Раздел" FontSize="9" TextAlignment="Center"/>
								</StackPanel>
								<Button.Flyout>
									<Flyout Placement="Bottom" ShowMode="Standard" Opening="OnSectionSetupFlyoutOpening">
										<ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
											<StackPanel Width="310" Spacing="8" Margin="4">
												<TextBlock Text="Размер листа" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
												<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="8">
													<TextBlock Grid.Row="0" Grid.Column="0" Text="Ширина, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<NumericUpDown Grid.Row="0" Grid.Column="1" Classes="Ribbon" Width="96"
													               Minimum="10" Maximum="1000" Increment="1"
													               FormatString="0.#" ClipValueToMinMax="True"
													               Value="{Binding PageWidthMm, Mode=TwoWay}"/>
													<TextBlock Grid.Row="1" Grid.Column="0" Text="Высота, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<NumericUpDown Grid.Row="1" Grid.Column="1" Classes="Ribbon" Width="96"
													               Minimum="10" Maximum="1000" Increment="1"
													               FormatString="0.#" ClipValueToMinMax="True"
													               Value="{Binding PageHeightMm, Mode=TwoWay}"/>
												</Grid>

												<TextBlock Text="Раздел" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
												<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="8">
													<TextBlock Grid.Row="0" Grid.Column="0" Text="Выравнивание по высоте" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<ComboBox Grid.Row="0" Grid.Column="1" Classes="LayoutField" Width="170"
													          SelectedIndex="{Binding VerticalAlignmentIndex, Mode=TwoWay}">
														<ComboBoxItem>Сверху</ComboBoxItem>
														<ComboBoxItem>По центру</ComboBoxItem>
														<ComboBoxItem>По высоте</ComboBoxItem>
														<ComboBoxItem>Снизу</ComboBoxItem>
													</ComboBox>
													<TextBlock Grid.Row="1" Grid.Column="0" Text="Начало раздела" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<ComboBox Grid.Row="1" Grid.Column="1" Classes="LayoutField" Width="170"
													          IsEnabled="{Binding HasSectionStart}"
													          SelectedIndex="{Binding SectionStartIndex, Mode=TwoWay}"
													          behaviours:TooltipBehavior.Tip="Вид разрыва раздела перед этим разделом. У первого раздела документа разрыва перед ним нет">
														<ComboBoxItem>Со следующей страницы</ComboBoxItem>
														<ComboBoxItem>На текущей странице</ComboBoxItem>
														<ComboBoxItem>С чётной страницы</ComboBoxItem>
														<ComboBoxItem>С нечётной страницы</ComboBoxItem>
													</ComboBox>
												</Grid>

												<CheckBox Classes="compact" Content="Нумерация строк"
												          IsChecked="{Binding LineNumbersOn, Mode=TwoWay}"/>
												<Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="8"
												      IsEnabled="{Binding LineNumbersOn}" Margin="16 0 0 0">
													<TextBlock Grid.Row="0" Grid.Column="0" Text="Начать с" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<NumericUpDown Grid.Row="0" Grid.Column="1" Classes="Ribbon" Width="96"
													               Minimum="1" Maximum="32767" Increment="1"
													               FormatString="0" ClipValueToMinMax="True"
													               Value="{Binding LineNumberStart, Mode=TwoWay}"/>
													<TextBlock Grid.Row="1" Grid.Column="0" Text="Шаг" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<NumericUpDown Grid.Row="1" Grid.Column="1" Classes="Ribbon" Width="96"
													               Minimum="1" Maximum="100" Increment="1"
													               FormatString="0" ClipValueToMinMax="True"
													               Value="{Binding LineNumberCountBy, Mode=TwoWay}"
													               behaviours:TooltipBehavior.Tip="Показывается каждый n-й номер"/>
													<TextBlock Grid.Row="2" Grid.Column="0" Text="От текста, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<NumericUpDown Grid.Row="2" Grid.Column="1" Classes="Ribbon" Width="96"
													               Minimum="0" Maximum="100" Increment="0.5"
													               FormatString="0.#" ClipValueToMinMax="True"
													               Value="{Binding LineNumberDistanceMm, Mode=TwoWay}"
													               behaviours:TooltipBehavior.Tip="0 — по умолчанию"/>
													<TextBlock Grid.Row="3" Grid.Column="0" Text="Нумерация" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<ComboBox Grid.Row="3" Grid.Column="1" Classes="LayoutField" Width="170"
													          SelectedIndex="{Binding LineNumberRestartIndex, Mode=TwoWay}">
														<ComboBoxItem>На каждой странице</ComboBoxItem>
														<ComboBoxItem>В каждом разделе</ComboBoxItem>
														<ComboBoxItem>Непрерывная</ComboBoxItem>
													</ComboBox>
												</Grid>

												<TextBlock Text="Рамка страницы" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
												<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="8">
													<TextBlock Grid.Row="0" Grid.Column="0" Text="Линия" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<ComboBox Grid.Row="0" Grid.Column="1" Classes="LayoutField" Width="170"
													          SelectedIndex="{Binding BorderStyleIndex, Mode=TwoWay}">
														<ComboBoxItem>Нет</ComboBoxItem>
														<ComboBoxItem>Одинарная</ComboBoxItem>
														<ComboBoxItem>Двойная</ComboBoxItem>
														<ComboBoxItem>Точками</ComboBoxItem>
														<ComboBoxItem>Штрихами</ComboBoxItem>
														<ComboBoxItem>Толстая и тонкая</ComboBoxItem>
														<ComboBoxItem>Тонкая и толстая</ComboBoxItem>
													</ComboBox>
													<TextBlock Grid.Row="1" Grid.Column="0" Text="Толщина, пт" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<NumericUpDown Grid.Row="1" Grid.Column="1" Classes="Ribbon" Width="96"
													               Minimum="0.25" Maximum="6" Increment="0.25"
													               FormatString="0.##" ClipValueToMinMax="True"
													               IsEnabled="{Binding HasBorder}"
													               Value="{Binding BorderWidthPt, Mode=TwoWay}"
													               behaviours:TooltipBehavior.Tip="У двойной линии — толщина каждой из двух линий"/>
													<TextBlock Grid.Row="2" Grid.Column="0" Text="Цвет" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<ComboBox Grid.Row="2" Grid.Column="1" Classes="LayoutField" Width="170"
													          IsEnabled="{Binding HasBorder}"
													          ItemsSource="{Binding BorderColorNames}"
													          SelectedIndex="{Binding BorderColorIndex, Mode=TwoWay}"/>
													<TextBlock Grid.Row="3" Grid.Column="0" Text="Отступ, пт" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<NumericUpDown Grid.Row="3" Grid.Column="1" Classes="Ribbon" Width="96"
													               Minimum="0" Maximum="31" Increment="1"
													               FormatString="0.#" ClipValueToMinMax="True"
													               IsEnabled="{Binding HasBorder}"
													               Value="{Binding BorderSpacePt, Mode=TwoWay}"/>
													<TextBlock Grid.Row="4" Grid.Column="0" Text="Отступ от" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<ComboBox Grid.Row="4" Grid.Column="1" Classes="LayoutField" Width="170"
													          IsEnabled="{Binding HasBorder}"
													          SelectedIndex="{Binding BorderFromIndex, Mode=TwoWay}">
														<ComboBoxItem>Края листа</ComboBoxItem>
														<ComboBoxItem>Текста</ComboBoxItem>
													</ComboBox>
													<TextBlock Grid.Row="5" Grid.Column="0" Text="Показывать" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<ComboBox Grid.Row="5" Grid.Column="1" Classes="LayoutField" Width="170"
													          IsEnabled="{Binding HasBorder}"
													          SelectedIndex="{Binding BorderDisplayIndex, Mode=TwoWay}">
														<ComboBoxItem>На всех страницах</ComboBoxItem>
														<ComboBoxItem>Только на первой</ComboBoxItem>
														<ComboBoxItem>Кроме первой</ComboBoxItem>
													</ComboBox>
												</Grid>
												<StackPanel Spacing="4" IsEnabled="{Binding HasBorder}">
													<TextBlock Text="Стороны" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<WrapPanel Orientation="Horizontal">
														<CheckBox Classes="compact" Content="Сверху" Margin="0 0 10 0" IsChecked="{Binding BorderTop, Mode=TwoWay}"/>
														<CheckBox Classes="compact" Content="Снизу"  Margin="0 0 10 0" IsChecked="{Binding BorderBottom, Mode=TwoWay}"/>
														<CheckBox Classes="compact" Content="Слева"  Margin="0 0 10 0" IsChecked="{Binding BorderLeft, Mode=TwoWay}"/>
														<CheckBox Classes="compact" Content="Справа" IsChecked="{Binding BorderRight, Mode=TwoWay}"/>
													</WrapPanel>
													<CheckBox Classes="compact" Content="Под текстом"
													          IsChecked="{Binding BorderBehind, Mode=TwoWay}"
													          behaviours:TooltipBehavior.Tip="Рамка рисуется под текстом и картинками; иначе — поверх них"/>
												</StackPanel>

												<StackPanel Spacing="2">
													<TextBlock Text="Область применения" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<RadioButton Classes="compact" Content="Ко всему разделу"
													             IsChecked="{Binding ApplyToSection, Mode=TwoWay}"/>
													<RadioButton Classes="compact" Content="Только к выделенному"
													             IsChecked="{Binding ApplyToSelection, Mode=TwoWay}"
													             behaviours:TooltipBehavior.Tip="Выделенные абзацы (без выделения — абзац под кареткой) становятся отдельным разделом со своими параметрами"/>
												</StackPanel>
												<Button Classes="standard primary" HorizontalAlignment="Right" Margin="0 4 0 0"
												        Content="Применить"
												        Command="{Binding ApplySectionSetupCommand}"/>
											</StackPanel>
										</ScrollViewer>
									</Flyout>
								</Button.Flyout>
							</Button>
						</StackPanel>
					</DockPanel>
				</Border>

				<!-- СТРАНИЦА — свёрнутая -->
				<Border Classes="RibbonGroupCollapsed"
                        IsVisible="{Binding !IsPageGroupExpanded}">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Layout_Page_Group}"/>
						</Grid>
						<Button Classes="RibbonBtnLarge" VerticalAlignment="Top"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_Page_Group}">
							<Button.Flyout>
								<Flyout Placement="Bottom">
									<StackPanel Orientation="Horizontal" Spacing="4" Margin="8">
										<SplitButton Classes="RibbonSplit"
                                                     Command="{Binding SetSizeA4Command}"
                                                     behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_PageSize}">
											<SplitButton.Content>
												<StackPanel Spacing="2" HorizontalAlignment="Center">
													<PathIcon Data="M6 2c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6H6zm7 7V3.5L18.5 9H13z" Width="20" Height="20"/>
													<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_PageSize}" FontSize="9" TextAlignment="Center"/>
												</StackPanel>
											</SplitButton.Content>
											<SplitButton.Flyout>
												<MenuFlyout>
													<MenuItem Header="A4 (210 x 297 mm)"    Command="{Binding SetSizeA4Command}"/>
													<MenuItem Header="A3 (297 x 420 mm)"    Command="{Binding SetSizeA3Command}"/>
													<MenuItem Header="A5 (148 x 210 mm)"    Command="{Binding SetSizeA5Command}"/>
													<MenuItem Header="Letter (8.5 x 11 in)" Command="{Binding SetSizeLetterCommand}"/>
													<Separator/>
													<MenuItem Header="Ко всему разделу" ToggleType="Radio"
													          IsChecked="{Binding ApplyToSection, Mode=TwoWay}"
													          behaviours:TooltipBehavior.Tip="Размер, ориентация, поля и колонки меняются у всего раздела, в котором стоит каретка"/>
													<MenuItem Header="Только к выделенному" ToggleType="Radio"
													          IsChecked="{Binding ApplyToSelection, Mode=TwoWay}"
													          behaviours:TooltipBehavior.Tip="Выделенные абзацы (без выделения — абзац под кареткой) становятся отдельным разделом: разрывы раздела ставятся сами, остальной текст остаётся как был"/>
												</MenuFlyout>
											</SplitButton.Flyout>
										</SplitButton>
										<SplitButton Classes="RibbonSplit"
                                                     Command="{Binding SetOrientationPortraitCommand}"
                                                     behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_Orientation}">
											<SplitButton.Content>
												<StackPanel Spacing="2" HorizontalAlignment="Center">
													<PathIcon Data="M17 1H7c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm0 18H7V5h10v14z" Width="20" Height="20"/>
													<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_Orientation}" FontSize="9" TextAlignment="Center"/>
												</StackPanel>
											</SplitButton.Content>
											<SplitButton.Flyout>
												<MenuFlyout>
													<MenuItem Header="{x:Static loc:TextEditorStrings.Orientation_Portrait}"  Command="{Binding SetOrientationPortraitCommand}"/>
													<MenuItem Header="{x:Static loc:TextEditorStrings.Orientation_Landscape}" Command="{Binding SetOrientationLandscapeCommand}"/>
													<Separator/>
													<MenuItem Header="Ко всему разделу" ToggleType="Radio"
													          IsChecked="{Binding ApplyToSection, Mode=TwoWay}"
													          behaviours:TooltipBehavior.Tip="Размер, ориентация, поля и колонки меняются у всего раздела, в котором стоит каретка"/>
													<MenuItem Header="Только к выделенному" ToggleType="Radio"
													          IsChecked="{Binding ApplyToSelection, Mode=TwoWay}"
													          behaviours:TooltipBehavior.Tip="Выделенные абзацы (без выделения — абзац под кареткой) становятся отдельным разделом: разрывы раздела ставятся сами, остальной текст остаётся как был"/>
												</MenuFlyout>
											</SplitButton.Flyout>
										</SplitButton>
										<Button Classes="RibbonBtnLarge"
                                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_Margins}">
											<StackPanel Spacing="2" HorizontalAlignment="Center">
												<PathIcon Data="M3 3v18h18V3H3zm16 16H5V5h14v14z" Width="20" Height="20"/>
												<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_Margins}" FontSize="9" TextAlignment="Center"/>
											</StackPanel>
											<Button.Flyout>
												<Flyout Placement="Bottom" ShowMode="Standard" Opening="OnMarginsFlyoutOpening">
													<Grid Margin="4" RowSpacing="6" ColumnSpacing="8"
														  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
														  ColumnDefinitions="Auto,Auto">
														<TextBlock Grid.Row="0" Grid.Column="0" Text="Верхнее, мм" FontSize="11" VerticalAlignment="Center"
																   Foreground="{DynamicResource TextSecondaryBrush}"/>
														<NumericUpDown Grid.Row="0" Grid.Column="1" Classes="Ribbon" Width="86"
																	   Minimum="0" Maximum="200" Increment="1"
																	   FormatString="0.##" ClipValueToMinMax="True"
																	   Value="{Binding MarginTopMm, Mode=TwoWay}"/>
														<TextBlock Grid.Row="1" Grid.Column="0" Text="Нижнее, мм" FontSize="11" VerticalAlignment="Center"
																   Foreground="{DynamicResource TextSecondaryBrush}"/>
														<NumericUpDown Grid.Row="1" Grid.Column="1" Classes="Ribbon" Width="86"
																	   Minimum="0" Maximum="200" Increment="1"
																	   FormatString="0.##" ClipValueToMinMax="True"
																	   Value="{Binding MarginBottomMm, Mode=TwoWay}"/>
														<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding MarginLeftLabel}" FontSize="11" VerticalAlignment="Center"
																   Foreground="{DynamicResource TextSecondaryBrush}"/>
														<NumericUpDown Grid.Row="2" Grid.Column="1" Classes="Ribbon" Width="86"
																	   Minimum="0" Maximum="200" Increment="1"
																	   FormatString="0.##" ClipValueToMinMax="True"
																	   Value="{Binding MarginLeftMm, Mode=TwoWay}"/>
														<TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding MarginRightLabel}" FontSize="11" VerticalAlignment="Center"
																   Foreground="{DynamicResource TextSecondaryBrush}"/>
														<NumericUpDown Grid.Row="3" Grid.Column="1" Classes="Ribbon" Width="86"
																	   Minimum="0" Maximum="200" Increment="1"
																	   FormatString="0.##" ClipValueToMinMax="True"
																	   Value="{Binding MarginRightMm, Mode=TwoWay}"/>
														<TextBlock Grid.Row="4" Grid.Column="0" Text="Переплёт, мм" FontSize="11" VerticalAlignment="Center"
																   Foreground="{DynamicResource TextSecondaryBrush}"/>
														<NumericUpDown Grid.Row="4" Grid.Column="1" Classes="Ribbon" Width="86"
																	   Minimum="0" Maximum="100" Increment="1"
																	   FormatString="0.##" ClipValueToMinMax="True"
																	   Value="{Binding GutterMm, Mode=TwoWay}"
																	   behaviours:TooltipBehavior.Tip="Полоса под сшивку у корешка: прибавляется к полю. При разных колонтитулах чётных и нечётных страниц переплёт на нечётных листах слева, на чётных справа"/>
														<CheckBox Classes="compact" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Зеркальные поля"
														          IsChecked="{Binding MirrorMargins, Mode=TwoWay}"
														          behaviours:TooltipBehavior.Tip="Левое поле становится внутренним, правое — внешним: на чётных листах они меняются местами вместе с переплётом, как в развороте книги. Настройка всего документа"/>
														<StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2" Margin="0 4 0 0">
															<TextBlock Text="Область применения" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
															<RadioButton Classes="compact" Content="Ко всему разделу"
															             IsChecked="{Binding ApplyToSection, Mode=TwoWay}"/>
															<RadioButton Classes="compact" Content="Только к выделенному"
															             IsChecked="{Binding ApplyToSelection, Mode=TwoWay}"
															             behaviours:TooltipBehavior.Tip="Выделенные абзацы (без выделения — абзац под кареткой) становятся отдельным разделом со своими полями"/>
														</StackPanel>
													</Grid>
												</Flyout>
											</Button.Flyout>
										</Button>
										<!-- Параметры раздела: свой размер листа, выравнивание по высоте, начало
										     раздела, номера строк и рамка страницы. Ложатся одним шагом отмены по
										     «Применить». -->
										<Button Classes="RibbonBtnLarge"
										        behaviours:TooltipBehavior.Tip="Параметры раздела"
										        behaviours:TooltipBehavior.Description="Свой размер листа, выравнивание по высоте, начало раздела, нумерация строк и рамка страницы">
											<StackPanel Spacing="2" HorizontalAlignment="Center">
												<PathIcon Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 7h10v2H7V7zm0 4h10v2H7v-2zm0 4h7v2H7v-2z" Width="20" Height="20"/>
												<TextBlock Text="Раздел" FontSize="9" TextAlignment="Center"/>
											</StackPanel>
											<Button.Flyout>
												<Flyout Placement="Bottom" ShowMode="Standard" Opening="OnSectionSetupFlyoutOpening">
													<ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
														<StackPanel Width="310" Spacing="8" Margin="4">
															<TextBlock Text="Размер листа" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
															<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="8">
																<TextBlock Grid.Row="0" Grid.Column="0" Text="Ширина, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<NumericUpDown Grid.Row="0" Grid.Column="1" Classes="Ribbon" Width="96"
																               Minimum="10" Maximum="1000" Increment="1"
																               FormatString="0.#" ClipValueToMinMax="True"
																               Value="{Binding PageWidthMm, Mode=TwoWay}"/>
																<TextBlock Grid.Row="1" Grid.Column="0" Text="Высота, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<NumericUpDown Grid.Row="1" Grid.Column="1" Classes="Ribbon" Width="96"
																               Minimum="10" Maximum="1000" Increment="1"
																               FormatString="0.#" ClipValueToMinMax="True"
																               Value="{Binding PageHeightMm, Mode=TwoWay}"/>
															</Grid>

															<TextBlock Text="Раздел" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
															<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="8">
																<TextBlock Grid.Row="0" Grid.Column="0" Text="Выравнивание по высоте" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<ComboBox Grid.Row="0" Grid.Column="1" Classes="LayoutField" Width="170"
																          SelectedIndex="{Binding VerticalAlignmentIndex, Mode=TwoWay}">
																	<ComboBoxItem>Сверху</ComboBoxItem>
																	<ComboBoxItem>По центру</ComboBoxItem>
																	<ComboBoxItem>По высоте</ComboBoxItem>
																	<ComboBoxItem>Снизу</ComboBoxItem>
																</ComboBox>
																<TextBlock Grid.Row="1" Grid.Column="0" Text="Начало раздела" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<ComboBox Grid.Row="1" Grid.Column="1" Classes="LayoutField" Width="170"
																          IsEnabled="{Binding HasSectionStart}"
																          SelectedIndex="{Binding SectionStartIndex, Mode=TwoWay}"
																          behaviours:TooltipBehavior.Tip="Вид разрыва раздела перед этим разделом. У первого раздела документа разрыва перед ним нет">
																	<ComboBoxItem>Со следующей страницы</ComboBoxItem>
																	<ComboBoxItem>На текущей странице</ComboBoxItem>
																	<ComboBoxItem>С чётной страницы</ComboBoxItem>
																	<ComboBoxItem>С нечётной страницы</ComboBoxItem>
																</ComboBox>
															</Grid>

															<CheckBox Classes="compact" Content="Нумерация строк"
															          IsChecked="{Binding LineNumbersOn, Mode=TwoWay}"/>
															<Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="8"
															      IsEnabled="{Binding LineNumbersOn}" Margin="16 0 0 0">
																<TextBlock Grid.Row="0" Grid.Column="0" Text="Начать с" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<NumericUpDown Grid.Row="0" Grid.Column="1" Classes="Ribbon" Width="96"
																               Minimum="1" Maximum="32767" Increment="1"
																               FormatString="0" ClipValueToMinMax="True"
																               Value="{Binding LineNumberStart, Mode=TwoWay}"/>
																<TextBlock Grid.Row="1" Grid.Column="0" Text="Шаг" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<NumericUpDown Grid.Row="1" Grid.Column="1" Classes="Ribbon" Width="96"
																               Minimum="1" Maximum="100" Increment="1"
																               FormatString="0" ClipValueToMinMax="True"
																               Value="{Binding LineNumberCountBy, Mode=TwoWay}"
																               behaviours:TooltipBehavior.Tip="Показывается каждый n-й номер"/>
																<TextBlock Grid.Row="2" Grid.Column="0" Text="От текста, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<NumericUpDown Grid.Row="2" Grid.Column="1" Classes="Ribbon" Width="96"
																               Minimum="0" Maximum="100" Increment="0.5"
																               FormatString="0.#" ClipValueToMinMax="True"
																               Value="{Binding LineNumberDistanceMm, Mode=TwoWay}"
																               behaviours:TooltipBehavior.Tip="0 — по умолчанию"/>
																<TextBlock Grid.Row="3" Grid.Column="0" Text="Нумерация" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<ComboBox Grid.Row="3" Grid.Column="1" Classes="LayoutField" Width="170"
																          SelectedIndex="{Binding LineNumberRestartIndex, Mode=TwoWay}">
																	<ComboBoxItem>На каждой странице</ComboBoxItem>
																	<ComboBoxItem>В каждом разделе</ComboBoxItem>
																	<ComboBoxItem>Непрерывная</ComboBoxItem>
																</ComboBox>
															</Grid>

															<TextBlock Text="Рамка страницы" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
															<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="8">
																<TextBlock Grid.Row="0" Grid.Column="0" Text="Линия" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<ComboBox Grid.Row="0" Grid.Column="1" Classes="LayoutField" Width="170"
																          SelectedIndex="{Binding BorderStyleIndex, Mode=TwoWay}">
																	<ComboBoxItem>Нет</ComboBoxItem>
																	<ComboBoxItem>Одинарная</ComboBoxItem>
																	<ComboBoxItem>Двойная</ComboBoxItem>
																	<ComboBoxItem>Точками</ComboBoxItem>
																	<ComboBoxItem>Штрихами</ComboBoxItem>
																	<ComboBoxItem>Толстая и тонкая</ComboBoxItem>
																	<ComboBoxItem>Тонкая и толстая</ComboBoxItem>
																</ComboBox>
																<TextBlock Grid.Row="1" Grid.Column="0" Text="Толщина, пт" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<NumericUpDown Grid.Row="1" Grid.Column="1" Classes="Ribbon" Width="96"
																               Minimum="0.25" Maximum="6" Increment="0.25"
																               FormatString="0.##" ClipValueToMinMax="True"
																               IsEnabled="{Binding HasBorder}"
																               Value="{Binding BorderWidthPt, Mode=TwoWay}"
																               behaviours:TooltipBehavior.Tip="У двойной линии — толщина каждой из двух линий"/>
																<TextBlock Grid.Row="2" Grid.Column="0" Text="Цвет" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<ComboBox Grid.Row="2" Grid.Column="1" Classes="LayoutField" Width="170"
																          IsEnabled="{Binding HasBorder}"
																          ItemsSource="{Binding BorderColorNames}"
																          SelectedIndex="{Binding BorderColorIndex, Mode=TwoWay}"/>
																<TextBlock Grid.Row="3" Grid.Column="0" Text="Отступ, пт" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<NumericUpDown Grid.Row="3" Grid.Column="1" Classes="Ribbon" Width="96"
																               Minimum="0" Maximum="31" Increment="1"
																               FormatString="0.#" ClipValueToMinMax="True"
																               IsEnabled="{Binding HasBorder}"
																               Value="{Binding BorderSpacePt, Mode=TwoWay}"/>
																<TextBlock Grid.Row="4" Grid.Column="0" Text="Отступ от" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<ComboBox Grid.Row="4" Grid.Column="1" Classes="LayoutField" Width="170"
																          IsEnabled="{Binding HasBorder}"
																          SelectedIndex="{Binding BorderFromIndex, Mode=TwoWay}">
																	<ComboBoxItem>Края листа</ComboBoxItem>
																	<ComboBoxItem>Текста</ComboBoxItem>
																</ComboBox>
																<TextBlock Grid.Row="5" Grid.Column="0" Text="Показывать" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<ComboBox Grid.Row="5" Grid.Column="1" Classes="LayoutField" Width="170"
																          IsEnabled="{Binding HasBorder}"
																          SelectedIndex="{Binding BorderDisplayIndex, Mode=TwoWay}">
																	<ComboBoxItem>На всех страницах</ComboBoxItem>
																	<ComboBoxItem>Только на первой</ComboBoxItem>
																	<ComboBoxItem>Кроме первой</ComboBoxItem>
																</ComboBox>
															</Grid>
															<StackPanel Spacing="4" IsEnabled="{Binding HasBorder}">
																<TextBlock Text="Стороны" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<WrapPanel Orientation="Horizontal">
																	<CheckBox Classes="compact" Content="Сверху" Margin="0 0 10 0" IsChecked="{Binding BorderTop, Mode=TwoWay}"/>
																	<CheckBox Classes="compact" Content="Снизу"  Margin="0 0 10 0" IsChecked="{Binding BorderBottom, Mode=TwoWay}"/>
																	<CheckBox Classes="compact" Content="Слева"  Margin="0 0 10 0" IsChecked="{Binding BorderLeft, Mode=TwoWay}"/>
																	<CheckBox Classes="compact" Content="Справа" IsChecked="{Binding BorderRight, Mode=TwoWay}"/>
																</WrapPanel>
																<CheckBox Classes="compact" Content="Под текстом"
																          IsChecked="{Binding BorderBehind, Mode=TwoWay}"
																          behaviours:TooltipBehavior.Tip="Рамка рисуется под текстом и картинками; иначе — поверх них"/>
															</StackPanel>

															<StackPanel Spacing="2">
																<TextBlock Text="Область применения" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<RadioButton Classes="compact" Content="Ко всему разделу"
																             IsChecked="{Binding ApplyToSection, Mode=TwoWay}"/>
																<RadioButton Classes="compact" Content="Только к выделенному"
																             IsChecked="{Binding ApplyToSelection, Mode=TwoWay}"
																             behaviours:TooltipBehavior.Tip="Выделенные абзацы (без выделения — абзац под кареткой) становятся отдельным разделом со своими параметрами"/>
															</StackPanel>
															<Button Classes="standard primary" HorizontalAlignment="Right" Margin="0 4 0 0"
															        Content="Применить"
															        Command="{Binding ApplySectionSetupCommand}"/>
														</StackPanel>
													</ScrollViewer>
												</Flyout>
											</Button.Flyout>
										</Button>
									</StackPanel>
								</Flyout>
							</Button.Flyout>
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Data="M6 2c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6H6zm7 7V3.5L18.5 9H13z" Width="20" Height="20"/>
								<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_Page_Group}" FontSize="9" TextAlignment="Center"/>
							</StackPanel>
						</Button>
					</DockPanel>
				</Border>

				<!-- ═══════════════════════════════════════════════════════
                     КОЛОНКИ — развёрнутая
                     ═══════════════════════════════════════════════════════ -->
				<Border Classes="RibbonGroup"
                        IsVisible="{Binding IsColumnsGroupExpanded}">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Layout_Columns}"/>
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<ToggleButton IsChecked="{Binding CurrentColumnCount, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=1}"
                                          Command="{Binding Set1ColumnCommand}"
                                          Classes="RibbonToggle"
                                          behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Columns_One}">
								<PathIcon Data="M3 3h18v18H3V3zm2 2v14h14V5H5z" Width="18" Height="18"/>
							</ToggleButton>
							<ToggleButton IsChecked="{Binding CurrentColumnCount, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=2}"
                                          Command="{Binding Set2ColumnsCommand}"
                                          Classes="RibbonToggle"
                                          behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Columns_Two}">
								<PathIcon Data="M3 3h8v18H3V3zm10 0h8v18h-8V3z" Width="18" Height="18"/>
							</ToggleButton>
							<ToggleButton IsChecked="{Binding CurrentColumnCount, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=3}"
                                          Command="{Binding Set3ColumnsCommand}"
                                          Classes="RibbonToggle"
                                          behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Columns_Three}">
								<PathIcon Data="M3 3h5v18H3V3zm7 0h4v18h-4V3zm6 0h5v18h-5V3z" Width="18" Height="18"/>
							</ToggleButton>
							<!-- Колонки разной ширины: заготовки «Слева» и «Справа» у Word -->
							<Button Command="{Binding SetColumnsLeftCommand}"
							        Classes="RibbonBtn"
							        behaviours:TooltipBehavior.Tip="Слева: две колонки, левая уже">
								<PathIcon Data="M3 3h5v18H3V3zm7 0h11v18H10V3z" Width="18" Height="18"/>
							</Button>
							<Button Command="{Binding SetColumnsRightCommand}"
							        Classes="RibbonBtn"
							        behaviours:TooltipBehavior.Tip="Справа: две колонки, правая уже">
								<PathIcon Data="M3 3h11v18H3V3zm13 0h5v18h-5V3z" Width="18" Height="18"/>
							</Button>
							<!-- Другие колонки: число, одинаковая ли ширина, промежутки, ширина каждой
							     колонки и черта между ними. -->
							<Button Classes="RibbonBtn"
							        behaviours:TooltipBehavior.Tip="Другие колонки"
							        behaviours:TooltipBehavior.Description="Число колонок, их ширина и промежутки, черта между колонками">
								<PathIcon Data="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" Width="18" Height="18"/>
								<Button.Flyout>
									<Flyout Placement="Bottom" ShowMode="Standard" Opening="OnColumnsFlyoutOpening">
										<ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
											<StackPanel Width="320" Spacing="10" Margin="4">
												<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
													<TextBlock Grid.Column="0" Text="Число колонок" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<NumericUpDown Grid.Column="1" Classes="Ribbon" Width="96"
													               Minimum="1" Maximum="{Binding MaxColumnCount}" Increment="1"
													               FormatString="0" ClipValueToMinMax="True"
													               Value="{Binding ColumnCountValue, Mode=TwoWay}"/>
												</Grid>
												<!-- Черта и её цвет. Цвет — стандартной кнопкой подборщика: сплошной, с
												     прозрачностью, градиент (полный подборщик — правой кнопкой). -->
												<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasSeveralColumns}">
													<CheckBox Grid.Column="0" Classes="compact" Content="Черта между колонками"
													          IsChecked="{Binding ColumnSeparator, Mode=TwoWay}"/>
													<controls:ColorPickerButton Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center"
													                            HexColor="{Binding ColumnSeparatorColor, Mode=TwoWay}"
													                            IsEnabled="{Binding ColumnSeparator}"
													                            behaviours:TooltipBehavior.Tip="Цвет черты"
													                            behaviours:TooltipBehavior.Description="У Word черта между колонками всегда чёрная: в .docx цвет сохраняется для Writersword, Word покажет чёрную"/>
												</Grid>

												<!-- Ширина колонок — одним блоком: флажок «одинаковой ширины» решает, как
												     задаются числа под ним. Одинаковые колонки задаются одним промежутком, а
												     ширина каждой выводится из него; у разных ширина и промежуток — у каждой
												     колонки свои, в таблице. Поэтому под флажком видно только то, что в его
												     состоянии правится. -->
												<Border Background="{DynamicResource BgSurfaceBrush}"
												        BorderBrush="{DynamicResource BorderSubtleBrush}"
												        BorderThickness="1" CornerRadius="6" Padding="10 8"
												        IsVisible="{Binding HasSeveralColumns}">
													<StackPanel Spacing="8">
														<TextBlock Text="Ширина колонок" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
														<CheckBox Classes="compact" Content="Все одинаковой ширины"
														          IsChecked="{Binding ColumnsEqualWidth, Mode=TwoWay}"/>
														<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEditColumnGap}">
															<TextBlock Grid.Column="0" Text="Промежуток, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
															<NumericUpDown Grid.Column="1" Classes="Ribbon" Width="96"
															               Minimum="0" Maximum="{Binding MaxColumnGapMm}" Increment="0.5"
															               FormatString="0.##" ClipValueToMinMax="True"
															               Value="{Binding ColumnGapMm, Mode=TwoWay}"/>
														</Grid>
														<Grid ColumnDefinitions="*,96,96" ColumnSpacing="8" IsVisible="{Binding ShowColumnTable}">
															<TextBlock Grid.Column="0" Text="Колонка" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
															<TextBlock Grid.Column="1" Text="Ширина, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
															<TextBlock Grid.Column="2" Text="Промежуток, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
														</Grid>
														<ItemsControl ItemsSource="{Binding ColumnRows}" IsVisible="{Binding ShowColumnTable}">
															<ItemsControl.ItemTemplate>
																<DataTemplate DataType="vm:ColumnRowViewModel">
																	<Grid ColumnDefinitions="*,96,96" ColumnSpacing="8" Margin="0 2">
																		<TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																		<NumericUpDown Grid.Column="1" Classes="Ribbon" Width="96"
																		               Minimum="1" Maximum="1000" Increment="1"
																		               FormatString="0.##" ClipValueToMinMax="True"
																		               IsEnabled="{Binding IsEditable}"
																		               Value="{Binding WidthMm, Mode=TwoWay}"/>
																		<NumericUpDown Grid.Column="2" Classes="Ribbon" Width="96"
																		               Minimum="0" Maximum="200" Increment="0.5"
																		               FormatString="0.##" ClipValueToMinMax="True"
																		               IsVisible="{Binding HasSpace}"
																		               IsEnabled="{Binding IsSpaceEditable}"
																		               Value="{Binding SpaceMm, Mode=TwoWay}"/>
																	</Grid>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
														<TextBlock Text="{Binding ColumnsTotalInfo}" FontSize="10" TextWrapping="Wrap"
														           Foreground="{DynamicResource TextMutedBrush}"/>
													</StackPanel>
												</Border>

												<StackPanel Spacing="4">
													<TextBlock Text="Область применения" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
													<RadioButton Classes="compact" Content="Ко всему разделу"
													             IsChecked="{Binding ApplyToSection, Mode=TwoWay}"/>
													<RadioButton Classes="compact" Content="Только к выделенному"
													             IsChecked="{Binding ApplyToSelection, Mode=TwoWay}"
													             behaviours:TooltipBehavior.Tip="Выделенные абзацы (без выделения — абзац под кареткой) становятся отдельным разделом со своими колонками; разрывы — непрерывные"/>
												</StackPanel>
												<Button Classes="standard primary" HorizontalAlignment="Right" Margin="0 4 0 0"
												        Content="Применить"
												        Command="{Binding ApplyColumnsCommand}"/>
											</StackPanel>
										</ScrollViewer>
									</Flyout>
								</Button.Flyout>
							</Button>
						</StackPanel>
					</DockPanel>
				</Border>

				<!-- КОЛОНКИ — свёрнутая -->
				<Border Classes="RibbonGroupCollapsed"
                        IsVisible="{Binding !IsColumnsGroupExpanded}">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Layout_Columns}"/>
						</Grid>
						<Button Classes="RibbonBtnLarge" VerticalAlignment="Top"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_Columns}">
							<Button.Flyout>
								<Flyout Placement="Bottom">
									<StackPanel Orientation="Horizontal" Spacing="4" Margin="8">
										<ToggleButton IsChecked="{Binding CurrentColumnCount, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=1}"
                                                      Command="{Binding Set1ColumnCommand}" Classes="RibbonToggle"
                                                      behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Columns_One}">
											<PathIcon Data="M3 3h18v18H3V3zm2 2v14h14V5H5z" Width="18" Height="18"/>
										</ToggleButton>
										<ToggleButton IsChecked="{Binding CurrentColumnCount, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=2}"
                                                      Command="{Binding Set2ColumnsCommand}" Classes="RibbonToggle"
                                                      behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Columns_Two}">
											<PathIcon Data="M3 3h8v18H3V3zm10 0h8v18h-8V3z" Width="18" Height="18"/>
										</ToggleButton>
										<ToggleButton IsChecked="{Binding CurrentColumnCount, Converter={x:Static converters:EqualityConverter.Instance}, ConverterParameter=3}"
                                                      Command="{Binding Set3ColumnsCommand}" Classes="RibbonToggle"
                                                      behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Columns_Three}">
											<PathIcon Data="M3 3h5v18H3V3zm7 0h4v18h-4V3zm6 0h5v18h-5V3z" Width="18" Height="18"/>
										</ToggleButton>
										<!-- Колонки разной ширины: заготовки «Слева» и «Справа» у Word -->
										<Button Command="{Binding SetColumnsLeftCommand}"
										        Classes="RibbonBtn"
										        behaviours:TooltipBehavior.Tip="Слева: две колонки, левая уже">
											<PathIcon Data="M3 3h5v18H3V3zm7 0h11v18H10V3z" Width="18" Height="18"/>
										</Button>
										<Button Command="{Binding SetColumnsRightCommand}"
										        Classes="RibbonBtn"
										        behaviours:TooltipBehavior.Tip="Справа: две колонки, правая уже">
											<PathIcon Data="M3 3h11v18H3V3zm13 0h5v18h-5V3z" Width="18" Height="18"/>
										</Button>
										<!-- Другие колонки: число, одинаковая ли ширина, промежутки, ширина каждой
										     колонки и черта между ними. -->
										<Button Classes="RibbonBtn"
										        behaviours:TooltipBehavior.Tip="Другие колонки"
										        behaviours:TooltipBehavior.Description="Число колонок, их ширина и промежутки, черта между колонками">
											<PathIcon Data="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" Width="18" Height="18"/>
											<Button.Flyout>
												<Flyout Placement="Bottom" ShowMode="Standard" Opening="OnColumnsFlyoutOpening">
													<ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
														<StackPanel Width="320" Spacing="10" Margin="4">
															<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
																<TextBlock Grid.Column="0" Text="Число колонок" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<NumericUpDown Grid.Column="1" Classes="Ribbon" Width="96"
																               Minimum="1" Maximum="{Binding MaxColumnCount}" Increment="1"
																               FormatString="0" ClipValueToMinMax="True"
																               Value="{Binding ColumnCountValue, Mode=TwoWay}"/>
															</Grid>
															<!-- Черта и её цвет. Цвет — стандартной кнопкой подборщика: сплошной, с
															     прозрачностью, градиент (полный подборщик — правой кнопкой). -->
															<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasSeveralColumns}">
																<CheckBox Grid.Column="0" Classes="compact" Content="Черта между колонками"
																          IsChecked="{Binding ColumnSeparator, Mode=TwoWay}"/>
																<controls:ColorPickerButton Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center"
																                            HexColor="{Binding ColumnSeparatorColor, Mode=TwoWay}"
																                            IsEnabled="{Binding ColumnSeparator}"
																                            behaviours:TooltipBehavior.Tip="Цвет черты"
																                            behaviours:TooltipBehavior.Description="У Word черта между колонками всегда чёрная: в .docx цвет сохраняется для Writersword, Word покажет чёрную"/>
															</Grid>

															<!-- Ширина колонок — одним блоком: флажок «одинаковой ширины» решает, как
															     задаются числа под ним. Одинаковые колонки задаются одним промежутком, а
															     ширина каждой выводится из него; у разных ширина и промежуток — у каждой
															     колонки свои, в таблице. Поэтому под флажком видно только то, что в его
															     состоянии правится. -->
															<Border Background="{DynamicResource BgSurfaceBrush}"
															        BorderBrush="{DynamicResource BorderSubtleBrush}"
															        BorderThickness="1" CornerRadius="6" Padding="10 8"
															        IsVisible="{Binding HasSeveralColumns}">
																<StackPanel Spacing="8">
																	<TextBlock Text="Ширина колонок" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
																	<CheckBox Classes="compact" Content="Все одинаковой ширины"
																	          IsChecked="{Binding ColumnsEqualWidth, Mode=TwoWay}"/>
																	<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEditColumnGap}">
																		<TextBlock Grid.Column="0" Text="Промежуток, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																		<NumericUpDown Grid.Column="1" Classes="Ribbon" Width="96"
																		               Minimum="0" Maximum="{Binding MaxColumnGapMm}" Increment="0.5"
																		               FormatString="0.##" ClipValueToMinMax="True"
																		               Value="{Binding ColumnGapMm, Mode=TwoWay}"/>
																	</Grid>
																	<Grid ColumnDefinitions="*,96,96" ColumnSpacing="8" IsVisible="{Binding ShowColumnTable}">
																		<TextBlock Grid.Column="0" Text="Колонка" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																		<TextBlock Grid.Column="1" Text="Ширина, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																		<TextBlock Grid.Column="2" Text="Промежуток, мм" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																	</Grid>
																	<ItemsControl ItemsSource="{Binding ColumnRows}" IsVisible="{Binding ShowColumnTable}">
																		<ItemsControl.ItemTemplate>
																			<DataTemplate DataType="vm:ColumnRowViewModel">
																				<Grid ColumnDefinitions="*,96,96" ColumnSpacing="8" Margin="0 2">
																					<TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																					<NumericUpDown Grid.Column="1" Classes="Ribbon" Width="96"
																					               Minimum="1" Maximum="1000" Increment="1"
																					               FormatString="0.##" ClipValueToMinMax="True"
																					               IsEnabled="{Binding IsEditable}"
																					               Value="{Binding WidthMm, Mode=TwoWay}"/>
																					<NumericUpDown Grid.Column="2" Classes="Ribbon" Width="96"
																					               Minimum="0" Maximum="200" Increment="0.5"
																					               FormatString="0.##" ClipValueToMinMax="True"
																					               IsVisible="{Binding HasSpace}"
																					               IsEnabled="{Binding IsSpaceEditable}"
																					               Value="{Binding SpaceMm, Mode=TwoWay}"/>
																				</Grid>
																			</DataTemplate>
																		</ItemsControl.ItemTemplate>
																	</ItemsControl>
																	<TextBlock Text="{Binding ColumnsTotalInfo}" FontSize="10" TextWrapping="Wrap"
																	           Foreground="{DynamicResource TextMutedBrush}"/>
																</StackPanel>
															</Border>

															<StackPanel Spacing="4">
																<TextBlock Text="Область применения" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
																<RadioButton Classes="compact" Content="Ко всему разделу"
																             IsChecked="{Binding ApplyToSection, Mode=TwoWay}"/>
																<RadioButton Classes="compact" Content="Только к выделенному"
																             IsChecked="{Binding ApplyToSelection, Mode=TwoWay}"
																             behaviours:TooltipBehavior.Tip="Выделенные абзацы (без выделения — абзац под кареткой) становятся отдельным разделом со своими колонками; разрывы — непрерывные"/>
															</StackPanel>
															<Button Classes="standard primary" HorizontalAlignment="Right" Margin="0 4 0 0"
															        Content="Применить"
															        Command="{Binding ApplyColumnsCommand}"/>
														</StackPanel>
													</ScrollViewer>
												</Flyout>
											</Button.Flyout>
										</Button>
									</StackPanel>
								</Flyout>
							</Button.Flyout>
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Data="M3 3h8v18H3V3zm10 0h8v18h-8V3z" Width="20" Height="20"/>
								<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_Columns}" FontSize="9" TextAlignment="Center"/>
							</StackPanel>
						</Button>
					</DockPanel>
				</Border>

				<!-- ═══════════════════════════════════════════════════════
                     РАЗРЫВЫ — развёрнутая
                     ═══════════════════════════════════════════════════════ -->
				<Border Classes="RibbonGroup"
                        IsVisible="{Binding IsBreaksGroupExpanded}">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Layout_Breaks_Group}"/>
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
							<SplitButton Classes="RibbonSplit"
							             Command="{Binding InsertPageBreakCommand}"
							             behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Insert_PageBreak}">
								<SplitButton.Content>
									<StackPanel Spacing="2" HorizontalAlignment="Center">
										<PathIcon Data="M5 3v12h2v-2h2v2h2V3H5zm2 8V5h2v6H7zm8 2h2V3h-4v12h2v-2zm0-8h2v6h-2V5zM3 19h18v2H3v-2z" Width="20" Height="20"/>
										<TextBlock Text="{x:Static loc:TextEditorStrings.Insert_PageBreak}" FontSize="9" TextAlignment="Center"/>
									</StackPanel>
								</SplitButton.Content>
								<SplitButton.Flyout>
									<MenuFlyout>
										<MenuItem Header="Разрыв страницы" Command="{Binding InsertPageBreakCommand}"/>
										<MenuItem Header="Разрыв колонки" Command="{Binding InsertColumnBreakCommand}"/>
									</MenuFlyout>
								</SplitButton.Flyout>
							</SplitButton>
							<SplitButton Classes="RibbonSplit"
							             Command="{Binding InsertSectionBreakCommand}"
							             behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_SectionBreak}">
								<SplitButton.Content>
									<StackPanel Spacing="2" HorizontalAlignment="Center">
										<PathIcon Data="M3 19h18v2H3v-2zm5-6h2V5H8v8zm6 0h2V5h-2v8z" Width="20" Height="20"/>
										<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_SectionBreak}" FontSize="9" TextAlignment="Center"/>
									</StackPanel>
								</SplitButton.Content>
								<SplitButton.Flyout>
									<MenuFlyout>
										<MenuItem Header="Со следующей страницы" Command="{Binding InsertSectionBreakNextPageCommand}"/>
										<MenuItem Header="На текущей странице"   Command="{Binding InsertSectionBreakContinuousCommand}"/>
										<MenuItem Header="С чётной страницы"     Command="{Binding InsertSectionBreakEvenPageCommand}"/>
										<MenuItem Header="С нечётной страницы"   Command="{Binding InsertSectionBreakOddPageCommand}"/>
									</MenuFlyout>
								</SplitButton.Flyout>
							</SplitButton>
						</StackPanel>
					</DockPanel>
				</Border>

				<!-- РАЗРЫВЫ — свёрнутая -->
				<Border Classes="RibbonGroupCollapsed"
                        IsVisible="{Binding !IsBreaksGroupExpanded}">
					<DockPanel>
						<Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
							<TextBlock Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Layout_Breaks_Group}"/>
						</Grid>
						<Button Classes="RibbonBtnLarge" VerticalAlignment="Top"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_Breaks_Group}">
							<Button.Flyout>
								<Flyout Placement="Bottom">
									<StackPanel Orientation="Horizontal" Spacing="4" Margin="8">
										<SplitButton Classes="RibbonSplit"
										             Command="{Binding InsertPageBreakCommand}"
										             behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Insert_PageBreak}">
											<SplitButton.Content>
												<StackPanel Spacing="2" HorizontalAlignment="Center">
													<PathIcon Data="M5 3v12h2v-2h2v2h2V3H5zm2 8V5h2v6H7zm8 2h2V3h-4v12h2v-2zm0-8h2v6h-2V5zM3 19h18v2H3v-2z" Width="20" Height="20"/>
													<TextBlock Text="{x:Static loc:TextEditorStrings.Insert_PageBreak}" FontSize="9" TextAlignment="Center"/>
												</StackPanel>
											</SplitButton.Content>
											<SplitButton.Flyout>
												<MenuFlyout>
													<MenuItem Header="Разрыв страницы" Command="{Binding InsertPageBreakCommand}"/>
													<MenuItem Header="Разрыв колонки" Command="{Binding InsertColumnBreakCommand}"/>
												</MenuFlyout>
											</SplitButton.Flyout>
										</SplitButton>
										<SplitButton Classes="RibbonSplit"
										             Command="{Binding InsertSectionBreakCommand}"
										             behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Layout_SectionBreak}">
											<SplitButton.Content>
												<StackPanel Spacing="2" HorizontalAlignment="Center">
													<PathIcon Data="M3 19h18v2H3v-2zm5-6h2V5H8v8zm6 0h2V5h-2v8z" Width="20" Height="20"/>
													<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_SectionBreak}" FontSize="9" TextAlignment="Center"/>
												</StackPanel>
											</SplitButton.Content>
											<SplitButton.Flyout>
												<MenuFlyout>
													<MenuItem Header="Со следующей страницы" Command="{Binding InsertSectionBreakNextPageCommand}"/>
													<MenuItem Header="На текущей странице"   Command="{Binding InsertSectionBreakContinuousCommand}"/>
													<MenuItem Header="С чётной страницы"     Command="{Binding InsertSectionBreakEvenPageCommand}"/>
													<MenuItem Header="С нечётной страницы"   Command="{Binding InsertSectionBreakOddPageCommand}"/>
												</MenuFlyout>
											</SplitButton.Flyout>
										</SplitButton>
									</StackPanel>
								</Flyout>
							</Button.Flyout>
							<StackPanel Spacing="2" HorizontalAlignment="Center">
								<PathIcon Data="M5 3v12h2v-2h2v2h2V3H5zm2 8V5h2v6H7zm8 2h2V3h-4v12h2v-2zm0-8h2v6h-2V5zM3 19h18v2H3v-2z" Width="20" Height="20"/>
								<TextBlock Text="{x:Static loc:TextEditorStrings.Layout_Breaks_Group}" FontSize="9" TextAlignment="Center"/>
							</StackPanel>
						</Button>
					</DockPanel>
				</Border>

			</StackPanel>
		</controls:RibbonScrollContainer.RibbonContent>
	</controls:RibbonScrollContainer>

</UserControl>