<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Горячие клавиши конфликты -->
	<SolidColorBrush x:Key="HotKeyConflictCriticalBrush">#D94F4F</SolidColorBrush>
	<SolidColorBrush x:Key="HotKeyConflictCriticalRowBrush">#2A1818</SolidColorBrush>
	<SolidColorBrush x:Key="HotKeyConflictWarningBrush">#C8963C</SolidColorBrush>
	<SolidColorBrush x:Key="HotKeyConflictWarningRowBrush">#2A2010</SolidColorBrush>
	<!-- Значок предупреждения на вкладке модуля: чего-то не хватает,
	     и модуль показывает не то, что задумал автор. -->
	<SolidColorBrush x:Key="ModuleWarningBrush">#E05A5A</SolidColorBrush>

	<SolidColorBrush x:Key="AccentSubtleBrush">#0D2233</SolidColorBrush>

	<!-- Фоны -->
	<SolidColorBrush x:Key="BgBaseBrush">#0D0D0D</SolidColorBrush>
	<SolidColorBrush x:Key="BgAppBrush">#1E1E1E</SolidColorBrush>
	<SolidColorBrush x:Key="BgSurfaceBrush">#252526</SolidColorBrush>
	<SolidColorBrush x:Key="BgPanelBrush">#2D2D30</SolidColorBrush>
	<SolidColorBrush x:Key="BgHoverBrush">#3A3A3C</SolidColorBrush>
	<!-- Фон плоских блоков-баннеров в списках. -->
	<SolidColorBrush x:Key="BgListBlockBrush">#353538</SolidColorBrush>
	<!-- Ползунок скроллбара в списках. -->
	<SolidColorBrush x:Key="ScrollThumbBrush">#D8D8DC</SolidColorBrush>

	<!-- Текст -->
	<SolidColorBrush x:Key="TextPrimaryBrush">#FFFFFF</SolidColorBrush>
	<SolidColorBrush x:Key="TextSecondaryBrush">#CCCCCC</SolidColorBrush>
	<SolidColorBrush x:Key="TextMutedBrush">#999999</SolidColorBrush>
	<SolidColorBrush x:Key="TextDisabledBrush">#555555</SolidColorBrush>

	<!-- Акцент -->
	<SolidColorBrush x:Key="AccentDefaultBrush">#007ACC</SolidColorBrush>
	<SolidColorBrush x:Key="AccentHoverBrush">#1C86C8</SolidColorBrush>
	<SolidColorBrush x:Key="AccentPressedBrush">#005A9E</SolidColorBrush>

	<!-- Границы -->
	<SolidColorBrush x:Key="BorderDefaultBrush">#3E3E42</SolidColorBrush>
	<SolidColorBrush x:Key="BorderSubtleBrush">#2D2D30</SolidColorBrush>

	<!-- Семантические цвета секций: синий — общее для всех проектов,
	     янтарный — своё для открытого проекта. Пара «фон + текст» подобрана
	     так, чтобы плашка отличалась от дорожки переключателя (контраст не
	     ниже 1.3), а надпись на ней читалась (не ниже 4.5). Меняя одно,
	     проверяйте оба: раньше плашка отличалась от фона на 1.14 и на тёмной
	     теме была почти неразличима. -->
	<SolidColorBrush x:Key="SectionGlobalBgBrush">#283654</SolidColorBrush>
	<SolidColorBrush x:Key="SectionGlobalFgBrush">#8FB8F0</SolidColorBrush>
	<SolidColorBrush x:Key="SectionProjectBgBrush">#4A3510</SolidColorBrush>
	<SolidColorBrush x:Key="SectionProjectFgBrush">#F0B44A</SolidColorBrush>

	<!-- Дорожка переключателя области. Темнее плашек и отделена от панели,
	     иначе «пилюля» сливается с тем, на чём лежит. -->
	<SolidColorBrush x:Key="ScopeTrackBrush">#141416</SolidColorBrush>

	<!-- Переопределение токенов FluentTheme для Menu и MenuItem -->
	<SolidColorBrush x:Key="MenuFlyoutBackground">#252526</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutBorderBrush">#3E3E42</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemBackground">Transparent</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver">#007ACC</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed">#005A9E</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemForeground">#FFFFFF</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver">#FFFFFF</SolidColorBrush>
	<SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled">#555555</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarBackground">#2D2D30</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarItemBackground">Transparent</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver">#007ACC</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarItemBackgroundPressed">#005A9E</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarItemForeground">#FFFFFF</SolidColorBrush>
	<SolidColorBrush x:Key="MenuBarItemForegroundPointerOver">#FFFFFF</SolidColorBrush>

	<!-- Подсказки -->
	<SolidColorBrush x:Key="AppTooltipBackground">#2D2D30</SolidColorBrush>
	<SolidColorBrush x:Key="AppTooltipBorderBrush">#3E3E42</SolidColorBrush>
	<SolidColorBrush x:Key="AppTooltipForeground">#FFFFFF</SolidColorBrush>
	<SolidColorBrush x:Key="AppTooltipKeyBackground">#3C3C3F</SolidColorBrush>

</ResourceDictionary>