<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Writersword.App"
             RequestedThemeVariant="Dark">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!-- Тема грузится только через ThemeService при старте -->
				<ResourceInclude Source="avares://Writersword/Styles/Base/Typography.axaml"/>
				<ResourceInclude Source="avares://Writersword/Styles/Base/Spacing.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
	<Application.Styles>
		<FluentTheme />
		<!-- Fluent тема для Dock -->
		<StyleInclude Source="avares://Dock.Avalonia.Themes.Fluent/DockFluentTheme.axaml"/>
		<!-- Кастомные стили контролов -->
		<StyleInclude Source="avares://Writersword/Styles/Controls.axaml"/>
		<!-- Кастомные стили -->
		<StyleInclude Source="/Styles/DockStyles.axaml"/>
		<!--
            Отключение контекстного меню Dock библиотеки на вкладках модулей.
            Библиотека Dock.Avalonia по умолчанию показывает контекстное меню с командами
            Float, Close, Tab Layout и т.д. при ПКМ на заголовке вкладки.
            Этот стиль полностью скрывает это меню.
            НЕ влияет на контекстные меню ВНУТРИ модулей (текстовый редактор, списки и т.д.)
        -->
		<Style Selector="DockControl ContextMenu">
			<Setter Property="IsVisible" Value="False"/>
		</Style>
	</Application.Styles>
</Application>