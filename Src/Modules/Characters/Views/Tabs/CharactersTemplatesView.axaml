<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Characters.ViewModels.Templates"
             xmlns:avm="using:Writersword.Modules.Characters.ViewModels.Anketas"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             xmlns:controls="using:Writersword.Modules.Characters.Controls"
             xmlns:colorControls="using:Writersword.Styles.UserControls"
             xmlns:conv="using:Writersword.Modules.Characters.Converters"
             xmlns:infra="using:Writersword.Infrastructure.Controls"
             x:Class="Writersword.Modules.Characters.Views.Tabs.CharactersTemplatesView"
             x:DataType="vm:CharactersTemplatesViewModel"
             Background="{DynamicResource BgSurfaceBrush}">

	<!-- Шаблоны блоками — по образцу карточек персонажей: цветная рамка,
	     картинка, название с описанием, кнопки в углу под курсором, белая
	     окантовка у выбранного. В блоке — до десяти значков анкет, остальное
	     раскрывается на месте.

	     У каждого значка под курсором карандаш (слева сверху) — открыть
	     анкету в редакторе — и крестик (справа сверху) — убрать из шаблона.
	     «+» в конце ряда добавляет анкету; одна анкета в шаблоне бывает
	     только раз. Встроенный шаблон не меняется: правка уходит в его копию.

	     Кнопки, поля и подсказки — общие стили программы (Styles/Controls). -->

	<UserControl.DataTemplates>
		<DataTemplate DataType="{x:Type vm:TemplateBlockViewModel}">
			<Panel Margin="6" IsVisible="{Binding IsMatch}">
				<Border Classes="tpl-block"
				        Classes.active="{Binding IsActive}"
				        Classes.hidden-tpl="{Binding IsHidden}"
				        Classes.drag-source="{Binding IsDragSource}"
				        BorderBrush="{Binding ColorBrush}"
				        PointerPressed="OnBlockPressed">
					<!-- Сдвиг на время перестановки: блок, которому пришлось
					     уступить место, доезжает до нового места, как карточка
					     персонажа, а не прыгает. -->
					<Border.RenderTransform>
						<TranslateTransform>
							<TranslateTransform.Transitions>
								<Transitions>
									<DoubleTransition Property="X" Duration="0:0:0.28" Easing="CubicEaseOut"/>
									<DoubleTransition Property="Y" Duration="0:0:0.28" Easing="CubicEaseOut"/>
								</Transitions>
							</TranslateTransform.Transitions>
						</TranslateTransform>
					</Border.RenderTransform>
					<Panel>
						<StackPanel>
							<!-- Шапка: картинка, название, описание. Блок перетаскивают
							     за любое место, как карточку персонажа: зажать и повести. -->
							<Grid Classes="tpl-head"
							      ColumnDefinitions="Auto,*"
							      ColumnSpacing="12"
							      Margin="12"
							      Background="Transparent">
								<!-- Картинка шаблона. Щелчок — окно значков: значок, цвет,
								     подложка, рамка, свои картинки. Бросок файла прямо на
								     плитку — картинка шаблона; рамка акцентом показывает, что
								     плитка примет файл. Правый щелчок — картинка из файла или
								     убрать её. У встроенного шаблона всё достаётся его своей
								     копии: сам он не меняется. -->
								<Button Grid.Column="0" Classes="ghost tpl-image"
								        Click="OnImageClick"
								        DragDrop.AllowDrop="True"
								        DragDrop.DragEnter="OnImageDragOver"
								        DragDrop.DragOver="OnImageDragOver"
								        DragDrop.DragLeave="OnImageDragLeave"
								        DragDrop.Drop="OnImageDrop"
								        behaviours:TooltipBehavior.Tip="Значок и цвет шаблона"
								        behaviours:TooltipBehavior.Description="Щелчок — значок, цвет, подложка и рамка. Картинку можно бросить прямо сюда, правый щелчок — картинка из файла. Встроенный шаблон не меняется — настраивается его своя копия">
									<Panel Width="64" Height="64">
										<!-- Значок шаблона — тот же контрол, что в окне значков:
										     превью там совпадает с этой плиткой точь-в-точь -->
										<controls:AnketaIconBadge Size="64" Look="Tile"
										                          IsVisible="{Binding HasNoImage}"
										                          Icon="{Binding Icon}" IconColor="{Binding IconColor}"
										                          IconBackground="{Binding IconBackground}" IconBorder="{Binding IconBorder}"/>
										<Border CornerRadius="8" ClipToBounds="True" IsVisible="{Binding HasImage}">
											<Image Source="{Binding Image}" Stretch="UniformToFill"/>
										</Border>
										<Border Classes="tpl-drop" CornerRadius="8" BorderThickness="2" IsHitTestVisible="False"/>
									</Panel>
									<Button.ContextFlyout>
										<MenuFlyout Placement="BottomEdgeAlignedLeft">
											<MenuItem Header="Значок и цвет…" Click="OnImageClick"/>
											<MenuItem Header="Картинка из файла…" Click="OnPickImageClick"
											          IsVisible="{Binding $parent[UserControl].DataContext.CanUseImages}"/>
											<MenuItem Header="Убрать картинку" Click="OnClearImageClick"
											          IsVisible="{Binding HasImage}"/>
										</MenuFlyout>
									</Button.ContextFlyout>
								</Button>

								<!-- Название и описание. У своего шаблона это сами поля
								     ввода: щелчок ставит курсор, запись — по Enter или
								     уходу из поля, Esc возвращает как было. Встроенный
								     шаблон не меняется — у него просто текст. -->
								<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top" Margin="0,0,72,0">
									<!-- Длинное название — одной строкой с многоточием, длинное
									     описание — двумя; целиком — нашей подсказкой, и только
									     когда текст правда обрезан. -->
									<controls:TrimmedTextBlock Text="{Binding Name}"
									                           IsVisible="{Binding IsBuiltIn}"
									                           Margin="0,2,0,0"
									                           FontSize="13" FontWeight="Medium"
									                           TextTrimming="CharacterEllipsis"
									                           Foreground="{DynamicResource TextPrimaryBrush}"/>
									<controls:TrimmedTextBlock Text="{Binding Description}"
									                           Margin="0,1,0,0"
									                           FontSize="11"
									                           TextWrapping="Wrap" MaxLines="2"
									                           TextTrimming="CharacterEllipsis"
									                           Foreground="{DynamicResource TextSecondaryBrush}">
										<controls:TrimmedTextBlock.IsVisible>
											<MultiBinding Converter="{x:Static BoolConverters.And}">
												<Binding Path="IsBuiltIn"/>
												<Binding Path="HasDescription"/>
											</MultiBinding>
										</controls:TrimmedTextBlock.IsVisible>
									</controls:TrimmedTextBlock>

									<!-- Название своего шаблона — как описание: в покое показ
									     одной строкой с многоточием поверх поля, длинное — целиком
									     подсказкой; в правке — само поле. Показ лежит поверх
									     поля и указатель не ловит: подсветка поля под курсором его
									     не закрывает, щелчок идёт в поле. -->
									<Panel Classes="tpl-name-slot" Background="Transparent"
									       IsVisible="{Binding IsEditable}">
										<TextBox Classes="tpl-inline tpl-name"
										         Text="{Binding EditName, Mode=TwoWay}"
										         PlaceholderText="Название шаблона"
										         FontSize="13" FontWeight="Medium"
										         TextWrapping="NoWrap" AcceptsReturn="False"
										         GotFocus="OnInlineGotFocus"
										         LostFocus="OnInlineLostFocus"
										         KeyDown="OnInlineKeyDown"
										         behaviours:SelectAllBehavior.Enabled="True"/>
										<controls:TrimmedTextBlock Classes="tpl-name-view"
										                           Text="{Binding EditName}"
										                           FontSize="13" FontWeight="Medium"
										                           TextWrapping="NoWrap"
										                           TextTrimming="CharacterEllipsis"
										                           Foreground="{DynamicResource TextPrimaryBrush}"
										                           IsHitTestVisible="False"/>
									</Panel>
									<!-- Пока описания нет, на его месте значок строк текста,
									     как в шапке карточки персонажа: слово «Описание» под
									     названием читается как само описание шаблона. Щелчок
									     по значку ставит курсор в поле, в правке значок гаснет.

									     Описание видно двумя строками с многоточием, целиком —
									     нашей подсказкой, если не влезло. Пишут его в одну
									     строку: поле в правке однострочное, а две строки поверх
									     него — только показ, мимо которого щелчок идёт в само
									     поле. Показ лежит поверх поля, чтобы подсветка поля под
									     курсором его не закрывала, и в правке держит место —
									     блок не прыгает по высоте. -->
									<Panel Classes="tpl-desc-slot" Background="Transparent"
									       IsVisible="{Binding IsEditable}">
										<TextBox Classes="tpl-inline tpl-desc"
										         Text="{Binding EditDescription, Mode=TwoWay}"
										         FontSize="11" TextWrapping="NoWrap" AcceptsReturn="False"
										         Foreground="{DynamicResource TextSecondaryBrush}"
										         GotFocus="OnInlineGotFocus"
										         LostFocus="OnInlineLostFocus"
										         KeyDown="OnInlineKeyDown"
										         behaviours:SelectAllBehavior.Enabled="True"/>
										<controls:TrimmedTextBlock Classes="tpl-desc-view"
										                           Text="{Binding EditDescription}"
										                           FontSize="11"
										                           TextWrapping="Wrap" MaxLines="2"
										                           TextTrimming="CharacterEllipsis"
										                           Foreground="{DynamicResource TextSecondaryBrush}"
										                           IsHitTestVisible="False"/>
										<Button Classes="tpl-desc-icon"
										        Click="OnDescriptionIconClick"
										        IsVisible="{Binding EditDescription,
										            Converter={x:Static StringConverters.IsNullOrEmpty}}"
										        behaviours:TooltipBehavior.Tip="Описание">
											<PathIcon Data="M14 17H4v2h10v-2zm6-8H4v2h16V9zM4 15h16v-2H4v2zM4 5v2h16V5H4z"
											          Width="13" Height="13"
											          Foreground="{DynamicResource TextSecondaryBrush}"/>
										</Button>
									</Panel>
								</StackPanel>
							</Grid>

							<!-- Анкеты -->
							<Border BorderBrush="{DynamicResource BorderDefaultBrush}"
							        BorderThickness="0,1,0,0"
							        Padding="12,12,12,6">
								<Grid ColumnDefinitions="*,Auto">
									<WrapPanel Grid.Column="0" Orientation="Horizontal">
										<ItemsControl Classes="tpl-icons" ItemsSource="{Binding Anketas}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="vm:TemplateAnketaItemViewModel">
													<Panel Classes="tpl-ic"
													       Classes.drag-source="{Binding IsDragSource}"
													       Width="42" Height="42"
													       Background="Transparent"
													       PointerPressed="OnIconPressed"
													       PointerMoved="OnIconMoved"
													       PointerReleased="OnIconReleased"
													       PointerCaptureLost="OnIconCaptureLost"
													       DoubleTapped="OnIconDoubleTapped"
													       behaviours:TooltipBehavior.Tip="{Binding Name}"
													       behaviours:TooltipBehavior.Description="{Binding Description}"
													       behaviours:TooltipBehavior.ShowDelay="450">
														<controls:AnketaIconBadge Size="32" Icon="{Binding Icon}" IconColor="{Binding IconColor}"
														                          IconBackground="{Binding IconBackground}" IconBorder="{Binding IconBorder}"
														                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
														<!-- Кнопки — как у карточки персонажа: тёмная подложка, белый значок -->
														<Button Classes="ic-mini ro-allow"
														        HorizontalAlignment="Left" VerticalAlignment="Top"
														        Padding="3" MinWidth="0" MinHeight="0"
														        Background="#88000000"
														        BorderThickness="0" CornerRadius="4"
														        Click="OnEditAnketaClick"
														        behaviours:TooltipBehavior.Tip="Открыть в редакторе анкет">
															<Button.Styles>
																<Style Selector="Button:pointerover /template/ ContentPresenter">
																	<Setter Property="Background" Value="#BB000000"/>
																</Style>
															</Button.Styles>
															<PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
															          Width="8" Height="8" Foreground="White"/>
														</Button>
														<Button Classes="ic-mini"
														        HorizontalAlignment="Right" VerticalAlignment="Top"
														        Padding="3" MinWidth="0" MinHeight="0"
														        Background="#88000000"
														        BorderThickness="0" CornerRadius="4"
														        Click="OnRemoveAnketaClick"
														        behaviours:TooltipBehavior.Tip="Убрать из шаблона"
														        behaviours:TooltipBehavior.Description="Сама анкета остаётся. У встроенного шаблона появится его копия без неё">
															<Button.Styles>
																<Style Selector="Button:pointerover /template/ ContentPresenter">
																	<Setter Property="Background" Value="#BB660000"/>
																</Style>
															</Button.Styles>
															<PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
															          Width="8" Height="8" Foreground="White"/>
														</Button>
														<!-- Глубина анкеты в шаблоне — значок-полоски: одна, две, три
														     полоски — кратко, подробно, глубоко; контур — по важности
														     персонажа. Заданная видна всегда, «по важности» — под курсором.
														     Щелчок открывает меню уровней с пояснениями. -->
														<Button Classes="ic-depth"
														        Classes.fixed="{Binding HasFixedDepth}"
														        IsVisible="{Binding HasLevels}"
														        HorizontalAlignment="Right" VerticalAlignment="Bottom"
														        Width="16" Height="16"
														        Padding="0" MinWidth="0" MinHeight="0"
														        Background="#88000000"
														        BorderThickness="0" CornerRadius="4"
														        HorizontalContentAlignment="Center"
														        VerticalContentAlignment="Center"
														        behaviours:TooltipBehavior.Tip="Глубина анкеты в шаблоне"
														        behaviours:TooltipBehavior.Description="{Binding DepthTip}">
															<Button.Styles>
																<Style Selector="Button:pointerover /template/ ContentPresenter">
																	<Setter Property="Background" Value="#BB000000"/>
																</Style>
															</Button.Styles>
															<controls:DepthGlyph Level="{Binding GlyphLevel}" Size="10" Foreground="White"/>
															<Button.Flyout>
																<Flyout Placement="BottomEdgeAlignedLeft">
																	<StackPanel Width="280" Spacing="2" Margin="2">
																		<TextBlock Text="Глубина в шаблоне" FontSize="11" FontWeight="SemiBold"
																		           Margin="6,2,6,4"
																		           Foreground="{DynamicResource TextSecondaryBrush}"/>
																		<ItemsControl ItemsSource="{Binding DepthChoices}">
																			<ItemsControl.ItemTemplate>
																				<DataTemplate x:DataType="vm:TemplateDepthChoiceViewModel">
																					<Button Classes="depth-choice"
																					        Classes.selected="{Binding IsSelected}"
																					        Click="OnTemplateDepthChoiceClick">
																						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
																							<controls:DepthGlyph Grid.Column="0" Level="{Binding Level}" Size="14"
																							                     VerticalAlignment="Top" Margin="0,2,0,0"/>
																							<StackPanel Grid.Column="1" Spacing="1">
																								<TextBlock Text="{Binding Name}" FontSize="12"/>
																								<TextBlock Text="{Binding Hint}" FontSize="10" TextWrapping="Wrap"
																								           Foreground="{DynamicResource TextMutedBrush}"/>
																							</StackPanel>
																						</Grid>
																					</Button>
																				</DataTemplate>
																			</ItemsControl.ItemTemplate>
																		</ItemsControl>
																	</StackPanel>
																</Flyout>
															</Button.Flyout>
														</Button>
													</Panel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<Button Classes="tpl-add"
										        IsVisible="{Binding CanAddAnketas}"
										        behaviours:TooltipBehavior.Tip="Добавить анкету"
										        behaviours:TooltipBehavior.Description="Из анкет проекта и встроенных. У встроенного шаблона появится его копия">
											<Panel Width="32" Height="32">
												<Rectangle Classes="tpl-add-frame" RadiusX="6" RadiusY="6"/>
												<PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z" Width="12" Height="12"
												          HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Panel>
											<Button.Flyout>
												<Flyout Placement="BottomEdgeAlignedLeft" Opening="OnPickerOpening" Opened="OnPickerOpened">
													<StackPanel Width="300" Spacing="6" Margin="2">
														<Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
															<Button Grid.Column="0" Classes="primary"
															        Height="30" Padding="12,0"
															        HorizontalAlignment="Stretch" VerticalAlignment="Center"
															        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
															        Click="OnNewAnketaForTemplateClick"
															        behaviours:TooltipBehavior.Tip="Новая анкета"
															        behaviours:TooltipBehavior.Description="Откроется в редакторе анкет. После сохранения встанет в этот шаблон">
																<StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
																	<PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z" Width="12" Height="12" Foreground="White"
																	          VerticalAlignment="Center"/>
																	<TextBlock Text="Новая анкета" Foreground="White" FontWeight="SemiBold"
																	           VerticalAlignment="Center"/>
																</StackPanel>
															</Button>
															<ToggleButton Grid.Column="1" Classes="RibbonToggle"
															              Width="30" Height="30" VerticalAlignment="Center"
															              IsChecked="{Binding $parent[UserControl].DataContext.PickerAsList, Mode=TwoWay}"
															              behaviours:TooltipBehavior.Tip="Списком с названиями"
															              behaviours:TooltipBehavior.Description="Повторный щелчок — снова значками">
																<PathIcon Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"
																          Width="13" Height="13"/>
															</ToggleButton>
														</Grid>
														<TextBox Classes="picker-search"
														         Text="{Binding PickerQuery, Mode=TwoWay}"
														         PlaceholderText="Поиск анкеты"/>
														<ScrollViewer MaxHeight="340">
															<Panel>
																<!-- Значками: название и описание — в подсказке -->
																<ItemsControl ItemsSource="{Binding PickerItems}"
																              IsVisible="{Binding !$parent[UserControl].DataContext.PickerAsList}">
																	<ItemsControl.ItemsPanel>
																		<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
																	</ItemsControl.ItemsPanel>
																	<ItemsControl.ItemTemplate>
																		<DataTemplate x:DataType="vm:TemplatePickItemViewModel">
																			<Button Classes="ghost pick-tile" Click="OnPickAnketaClick"
																			        behaviours:TooltipBehavior.Tip="{Binding Name}"
																			        behaviours:TooltipBehavior.Description="{Binding Description}"
																			        behaviours:TooltipBehavior.ShowDelay="450">
																				<controls:AnketaIconBadge Size="32" Icon="{Binding Icon}" IconColor="{Binding IconColor}"
																				                          IconBackground="{Binding IconBackground}" IconBorder="{Binding IconBorder}"/>
																			</Button>
																		</DataTemplate>
																	</ItemsControl.ItemTemplate>
																</ItemsControl>

																<!-- Списком -->
																<ItemsControl ItemsSource="{Binding PickerItems}"
																              IsVisible="{Binding $parent[UserControl].DataContext.PickerAsList}">
																	<ItemsControl.ItemTemplate>
																		<DataTemplate x:DataType="vm:TemplatePickItemViewModel">
																			<Button Classes="ghost pick-row" Click="OnPickAnketaClick"
																			        behaviours:TooltipBehavior.Tip="{Binding Name}"
																			        behaviours:TooltipBehavior.Description="{Binding Description}"
																			        behaviours:TooltipBehavior.ShowDelay="450">
																				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
																					<controls:AnketaIconBadge Grid.Column="0" Size="22"
																					                          Icon="{Binding Icon}" IconColor="{Binding IconColor}"
																					                          IconBackground="{Binding IconBackground}" IconBorder="{Binding IconBorder}"/>
																					<TextBlock Grid.Column="1" Text="{Binding Name}"
																					           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
																					           Foreground="{DynamicResource TextPrimaryBrush}"/>
																				</Grid>
																			</Button>
																		</DataTemplate>
																	</ItemsControl.ItemTemplate>
																</ItemsControl>
															</Panel>
														</ScrollViewer>
														<TextBlock Text="Ничего не найдено"
														           IsVisible="{Binding !HasPickerItems}"
														           Margin="4,2"
														           Foreground="{DynamicResource TextMutedBrush}"/>
													</StackPanel>
												</Flyout>
											</Button.Flyout>
										</Button>
									</WrapPanel>

									<Button Grid.Column="1" Classes="ghost more ro-allow"
									        VerticalAlignment="Bottom" Margin="0,0,0,8"
									        IsVisible="{Binding HasMore}"
									        Click="OnMoreClick"
									        behaviours:TooltipBehavior.Tip="{Binding MoreCaption}">
										<PathIcon Classes="more-chevron"
										          Classes.open="{Binding IsExpanded}"
										          Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z"
										          Width="12" Height="12"/>
									</Button>
								</Grid>
							</Border>
						</StackPanel>

						<!-- Кнопки блока: как у карточки персонажа, видны под курсором -->
						<StackPanel Classes="card-edit-btns"
						            Orientation="Horizontal" Spacing="2"
						            HorizontalAlignment="Right" VerticalAlignment="Top"
						            Margin="0,8,8,0" ZIndex="4">
							<Button Classes="card-btn" Click="OnDuplicateClick"
							        behaviours:TooltipBehavior.Tip="Дублировать шаблон"
							        behaviours:TooltipBehavior.Description="Копия встаёт в конец своих шаблонов, список прокручивается к ней, курсор — в её названии">
								<PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
								          Width="11" Height="11" Foreground="White"/>
							</Button>
							<!-- Скрыть: шаблон остаётся на месте бледнее, но поиск его
							     не находит и в списке шаблонов карточки его нет. -->
							<Button Classes="card-btn" Click="OnHideClick"
							        behaviours:TooltipBehavior.Tip="{Binding HideTip}"
							        behaviours:TooltipBehavior.Description="Скрытый шаблон стоит на своём месте бледнее, но поиск его не находит и в списке шаблонов карточки персонажа его нет">
								<Panel>
									<PathIcon IsVisible="{Binding !IsHidden}"
									          Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"
									          Width="12" Height="12" Foreground="White"/>
									<PathIcon IsVisible="{Binding IsHidden}"
									          Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
									          Width="12" Height="12" Foreground="White"/>
								</Panel>
							</Button>
							<Button Classes="card-btn danger"
							        IsVisible="{Binding IsEditable}"
							        behaviours:TooltipBehavior.Tip="Удалить шаблон"
							        behaviours:TooltipBehavior.Description="Анкеты останутся">
								<PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
								          Width="11" Height="11" Foreground="White"/>
								<Button.Flyout>
									<Flyout Placement="BottomEdgeAlignedRight">
										<StackPanel Spacing="8" Margin="2">
											<TextBlock Text="Удалить шаблон?" FontWeight="SemiBold"/>
											<Button Classes="standard primary" Content="Удалить" Click="OnDeleteClick" HorizontalAlignment="Right"/>
										</StackPanel>
									</Flyout>
								</Button.Flyout>
							</Button>
						</StackPanel>
					</Panel>
				</Border>
			</Panel>
		</DataTemplate>
	</UserControl.DataTemplates>

	<UserControl.Styles>

		<!-- Блок шаблона — как карточка персонажа (CharactersListView) -->
		<!-- Ширины своей у блока нет: ряд делится поровну между блоками
		     (StretchWrapPanel), и справа не остаётся дыры. -->
		<Style Selector="Border.tpl-block">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="ClipToBounds" Value="False"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.tpl-block:pointerover">
			<Setter Property="BoxShadow" Value="0 0 10 1 #55FFFFFF"/>
			<Setter Property="ZIndex" Value="10"/>
		</Style>
		<Style Selector="Border.tpl-block.active">
			<Setter Property="BoxShadow" Value="0 0 0 2 #FF12151A, 0 0 0 5 #FFFFFFFF"/>
			<Setter Property="ZIndex" Value="15"/>
		</Style>
		<Style Selector="Border.tpl-block.active:pointerover">
			<Setter Property="BoxShadow" Value="0 0 0 2 #FF12151A, 0 0 0 5 #FFFFFFFF"/>
			<Setter Property="ZIndex" Value="16"/>
		</Style>
		<!-- Скрытый шаблон — чуть серее остальных, но на своём месте -->
		<Style Selector="Border.tpl-block.hidden-tpl">
			<Setter Property="Opacity" Value="0.45"/>
		</Style>
		<Style Selector="Border.tpl-block.hidden-tpl:pointerover">
			<Setter Property="Opacity" Value="0.75"/>
		</Style>
		<Style Selector="Border.tpl-block.drag-source">
			<Setter Property="Opacity" Value="0.35"/>
		</Style>
		<!-- Блок «взят»: приподнят тенью с первого мгновения зажатия, как
		     карточка персонажа. -->
		<Style Selector="Border.tpl-block.picked">
			<Setter Property="BoxShadow" Value="0 0 16 2 #99FFFFFF"/>
			<Setter Property="ZIndex" Value="20"/>
		</Style>
		<Style Selector="Grid.tpl-head">
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<!-- Кнопки в углу блока — как у карточки персонажа -->
		<Style Selector="Border.tpl-block StackPanel.card-edit-btns">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.tpl-block:pointerover StackPanel.card-edit-btns">
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="Button.card-btn">
			<Setter Property="Padding" Value="4,3"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Background" Value="#88000000"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="Button.card-btn /template/ ContentPresenter">
			<Setter Property="Background" Value="#88000000"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="Button.card-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#BB000000"/>
		</Style>
		<Style Selector="Button.card-btn.danger:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#BB660000"/>
		</Style>

		<!-- Картинка шаблона — кнопка без своей подложки -->
		<Style Selector="Button.tpl-image">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
		</Style>
		<Style Selector="Button.tpl-image:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="Button.more">
			<Setter Property="Padding" Value="4"/>
			<Setter Property="MinHeight" Value="0"/>
		</Style>
		<Style Selector="PathIcon.more-chevron.open">
			<Setter Property="RenderTransform" Value="rotate(180deg)"/>
		</Style>

		<!-- «+» в ряду значков — тех же размеров, что значок анкеты -->
		<Style Selector="Button.tpl-add">
			<Setter Property="Width" Value="32"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="Button.tpl-add /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>
		<Style Selector="Button.tpl-add:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
		<Style Selector="Button.tpl-add:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<!-- Пунктирная рамка «+» — та же, что у пустой ячейки в редакторе анкет -->
		<Style Selector="Rectangle.tpl-add-frame">
			<Setter Property="Stroke" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="StrokeThickness" Value="1"/>
			<Setter Property="StrokeDashArray" Value="4,3"/>
		</Style>
		<Style Selector="Button.tpl-add:pointerover Rectangle.tpl-add-frame">
			<Setter Property="Stroke" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Значок анкеты: карандаш и крестик появляются под курсором -->
		<Style Selector="Panel.tpl-ic">
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Panel.tpl-ic.drag-source">
			<Setter Property="Opacity" Value="0.3"/>
		</Style>
		<Style Selector="Button.ic-mini">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
			<Setter Property="ZIndex" Value="2"/>
		</Style>
		<Style Selector="Panel.tpl-ic:pointerover Button.ic-mini">
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>
		<!-- Плитка картинки шаблона принимает файл: рамка акцентом -->
		<Style Selector="Border.tpl-drop">
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.tpl-image.drop Border.tpl-drop">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<!-- Название и описание своего шаблона — поля ввода, которые
		     выглядят текстом, пока их не трогают: под курсором подсвечены,
		     в фокусе — обычная рамка поля. -->
		<Style Selector="TextBox.tpl-inline">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Padding" Value="6,3"/>
			<Setter Property="Margin" Value="-7,0,0,0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="CornerRadius" Value="4"/>
		</Style>
		<Style Selector="TextBox.tpl-inline:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<!-- Поле описания подсвечивается наведением на всю ячейку: поверх
		     пустого поля лежит значок, и курсор на нём гасил бы подсветку. -->
		<Style Selector="Panel.tpl-desc-slot:pointerover TextBox.tpl-inline /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="TextBox.tpl-inline:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="TextBox.tpl-name">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<!-- Описание: в покое поле растянуто под оба ряда показа — подсветка
		     наведением и щелчок покрывают весь текст, а свой текст поля скрыт
		     под показом. В правке поле — одна строка сверху, показ гаснет,
		     но место держит. Отступы показа — те же, что у текста поля. -->
		<Style Selector="TextBox.tpl-desc">
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Top"/>
		</Style>
		<Style Selector="TextBox.tpl-desc:focus">
			<Setter Property="VerticalAlignment" Value="Top"/>
		</Style>
		<Style Selector="TextBox.tpl-desc:not(:focus) /template/ TextPresenter#PART_TextPresenter">
			<Setter Property="Opacity" Value="0"/>
		</Style>
		<Style Selector="TextBlock.tpl-desc-view">
			<Setter Property="Margin" Value="0,4,7,4"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
		</Style>
		<Style Selector="Panel.tpl-desc-slot:focus-within TextBlock.tpl-desc-view">
			<Setter Property="Opacity" Value="0"/>
		</Style>
		<!-- Название своего шаблона: в покое свой текст поля скрыт под
		     показом в одну строку, в правке показ гаснет. Подпись-заглушка
		     пустого поля видна как есть. -->
		<Style Selector="TextBox.tpl-name:not(:focus) /template/ TextPresenter#PART_TextPresenter">
			<Setter Property="Opacity" Value="0"/>
		</Style>
		<Style Selector="TextBlock.tpl-name-view">
			<Setter Property="Margin" Value="0,4,7,4"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
		</Style>
		<Style Selector="Panel.tpl-name-slot:focus-within TextBlock.tpl-name-view">
			<Setter Property="Opacity" Value="0"/>
		</Style>
		<Style Selector="Button.tpl-desc-icon">
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="-2,0,0,0"/>
			<Setter Property="Padding" Value="2"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Ibeam"/>
		</Style>
		<Style Selector="Button.tpl-desc-icon /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.tpl-desc-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.tpl-desc-icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Panel.tpl-desc-slot:focus-within Button.tpl-desc-icon">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
		</Style>

		<Style Selector="Button.ic-depth">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
			<Setter Property="ZIndex" Value="2"/>
		</Style>
		<Style Selector="Button.ic-depth.fixed, Panel.tpl-ic:pointerover Button.ic-depth">
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>

		<!-- Строка меню уровней: значок-полоски, название, пояснение -->
		<Style Selector="Button.depth-choice">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="Button.depth-choice:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
		<Style Selector="Button.depth-choice.selected">
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.depth-choice.selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
		</Style>

		<Style Selector="Button.pick-tile">
			<Setter Property="Width" Value="42"/>
			<Setter Property="Height" Value="42"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0,0,2,2"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.pick-row">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="6,4"/>
			<Setter Property="Margin" Value="0,1"/>
		</Style>

		<Style Selector="TextBlock.section">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="Margin" Value="8,6,0,0"/>
		</Style>

		<!-- Панель поиска — те же размеры, что у поиска и кнопок на вкладке
		     персонажей (CharactersListView): одна высота, скругление 6. -->
		<!-- Поле и кнопки — одной высоты ровно: высота задана, а не набрана
		     из отступов, иначе у кнопки со значком и у поля с текстом она
		     выходит разной. -->
		<Style Selector="TextBox.tpl-toolbar">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="7,0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
		</Style>
		<Style Selector="Button.tpl-toolbar">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.tpl-toolbar /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>
		<Style Selector="Button.tpl-toolbar:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>

		<!-- Папки — как у персонажей (CharactersListView) -->
		<Style Selector="Button.folder-hdr-btn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.folder-hdr-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#1FFFFFFF"/>
		</Style>
		<Style Selector="Button.folder-hdr-btn:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="#33FFFFFF"/>
		</Style>
		<Style Selector="Button.folder-hdr-btn:disabled">
			<Setter Property="Opacity" Value="0.3"/>
		</Style>
		<!-- Пара стрелок порядка разделов: тонкая рамка вокруг обеих, между
		     ними черта. Погасшая стрелка — без фона, только бледный значок. -->
		<Style Selector="Border.folder-move">
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="ClipToBounds" Value="True"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.folder-move-sep">
			<Setter Property="Width" Value="1"/>
			<Setter Property="Margin" Value="0,4"/>
			<Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
		</Style>
		<Style Selector="Button.folder-move-btn">
			<Setter Property="Padding" Value="6,4"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="0"/>
		</Style>
		<Style Selector="Button.folder-move-btn /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="0"/>
		</Style>
		<Style Selector="Button.folder-move-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#1FFFFFFF"/>
		</Style>
		<Style Selector="Button.folder-move-btn:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="#33FFFFFF"/>
		</Style>
		<Style Selector="Button.folder-move-btn:disabled /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.folder-move-btn:disabled PathIcon">
			<Setter Property="Opacity" Value="0.25"/>
		</Style>
		<Style Selector="Border.tpl-empty">
			<Setter Property="Margin" Value="12,8,12,6"/>
			<Setter Property="MinHeight" Value="64"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<!-- Перетаскивание -->
		<Style Selector="Border.ghost">
			<Setter Property="Padding" Value="6,4,10,4"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
			<Setter Property="BoxShadow" Value="0 0 16 2 #66000000"/>
		</Style>
		<!-- Призрак блока: шапка шаблона — картинка, название, описание —
		     в рамке его цвета. Ширина — как у самого блока. -->
		<Style Selector="Border.block-ghost">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
			<Setter Property="Opacity" Value="0.9"/>
		</Style>
		<Style Selector="Border.insert-mark">
			<Setter Property="Width" Value="3"/>
			<Setter Property="CornerRadius" Value="2"/>
			<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">

		<!-- ── Панель: поиск и новый шаблон ───────────────────────────── -->
		<!-- Поиск и кнопки — того же вида, что на вкладке персонажей; левый
		     край вровень с переключателем «Шаблоны / Редактор анкет». Панель —
		     продолжение полосы с переключателем: черты между ними нет, сверху
		     отступа нет, и до переключателя ровно столько же, сколько от него
		     до верха (7). -->
		<Border Grid.Row="0"
		        Background="{DynamicResource BgPanelBrush}"
		        BorderBrush="{DynamicResource BorderDefaultBrush}"
		        BorderThickness="0,0,0,1"
		        Padding="10,0,10,7">
			<Grid ColumnDefinitions="260,Auto,*,Auto" ColumnSpacing="6">
				<TextBox Grid.Column="0" Classes="ro-allow tpl-toolbar"
				         Text="{Binding SearchQuery, Mode=TwoWay}"
				         PlaceholderText="Поиск"/>

				<!-- Новая папка — как у персонажей: встаёт в конце папок, сразу
				     с полем названия. -->
				<Button Grid.Column="1" Classes="tpl-toolbar" Click="OnNewFolderClick"
				        behaviours:TooltipBehavior.Tip="Новая папка"
				        behaviours:TooltipBehavior.Description="Папка для своих шаблонов. Шаблоны перетаскивают между папками, разделы — любые, и «Мои шаблоны», и «Встроенные» — двигают стрелками в их шапке">
					<StackPanel Orientation="Horizontal" Spacing="5">
						<PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
						          Width="14" Height="14"/>
						<TextBlock Text="Папка" FontSize="12" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

				<Button Grid.Column="3" Classes="tpl-toolbar" Click="OnNewTemplateClick"
				        behaviours:TooltipBehavior.Tip="Новый шаблон"
				        behaviours:TooltipBehavior.Description="Встаёт в конец текущей папки — той, где выбран шаблон или по которой щёлкнули последней">
					<PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z" Width="12" Height="12"/>
				</Button>
			</Grid>
		</Border>

		<!-- ── Разделы: «Мои шаблоны», папки, «Встроенные» ──────────────── -->
		<!-- Как папки персонажей: шапка с цветом, названием, подписью, числом
		     и стрелкой сворачивания, под ней блоки рядами во всю ширину.
		     Прозрачный фон — чтобы щелчок по пустому месту между блоками
		     доходил до списка и снимал выбор. -->
		<ScrollViewer Grid.Row="1" x:Name="BlocksScroll" Background="Transparent"
		              HorizontalScrollBarVisibility="Disabled"
		              VerticalScrollBarVisibility="Auto"
		              AllowAutoHide="False">
			<ItemsControl x:Name="FoldersList" ItemsSource="{Binding Folders}"
			              Background="Transparent" Margin="0,0,0,16">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:TemplateFolderViewModel">
						<StackPanel Classes="tpl-section" Margin="0,0,0,4"
						            Background="Transparent"
						            IsVisible="{Binding IsShown}">

							<!-- Шапка раздела. Щелчок по ней делает папку текущей:
							     новый шаблон встанет в неё. -->
							<Border Classes="tpl-folder-head"
							        BorderBrush="{DynamicResource BorderDefaultBrush}"
							        BorderThickness="0,0,0,1"
							        Background="{DynamicResource BgPanelBrush}"
							        PointerPressed="OnFolderHeadPressed">
								<Panel>
									<Border IsVisible="{Binding IsSelected}" Background="#22FFFFFF" IsHitTestVisible="False"/>
									<Border IsVisible="{Binding IsDragOver}"
									        Background="#22FFFFFF"
									        BorderBrush="{DynamicResource AccentDefaultBrush}"
									        BorderThickness="0,0,0,2"
									        IsHitTestVisible="False"/>
									<Grid MinHeight="36" Margin="0,0,8,0" ColumnDefinitions="Auto,*,Auto">

										<!-- Цвет своей папки; у «Моих шаблонов» и «Встроенных» — значок -->
										<Panel Grid.Column="0" MinWidth="24" Margin="12,0,8,0" VerticalAlignment="Center">
											<colorControls:ColorPickerButton IsVisible="{Binding IsCustom}"
											                                 HexColor="{Binding Color, Mode=TwoWay}"
											                                 VerticalAlignment="Center"/>
											<PathIcon IsVisible="{Binding IsUngrouped}"
											          Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
											          Width="15" Height="15"
											          HorizontalAlignment="Center" VerticalAlignment="Center"
											          Foreground="{DynamicResource TextSecondaryBrush}"/>
											<PathIcon IsVisible="{Binding IsBuiltIn}"
											          Data="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"
											          Width="14" Height="14"
											          HorizontalAlignment="Center" VerticalAlignment="Center"
											          Foreground="{DynamicResource TextSecondaryBrush}"/>
										</Panel>

										<controls:CharactersFolderHeaderPanel Grid.Column="1"
										                                      LeftMinWidth="55"
										                                      RightMinWidth="90"
										                                      LeftPreferredWidth="260"
										                                      RightPreferredWidth="210">
											<!-- Название: первый щелчок делает папку текущей,
											     второй — правка названия (у своей папки) -->
											<Panel Margin="0,0,12,0" ClipToBounds="True">
												<Button Classes="flat ro-allow"
												        Command="{Binding SelectOrRenameCommand}"
												        Background="Transparent" BorderThickness="0"
												        Padding="0" VerticalAlignment="Center"
												        HorizontalAlignment="Stretch"
												        HorizontalContentAlignment="Stretch"
												        IsVisible="{Binding !IsRenaming}">
													<TextBlock Text="{Binding Name}"
													           FontSize="13" FontWeight="SemiBold"
													           Foreground="{DynamicResource TextPrimaryBrush}"
													           TextTrimming="CharacterEllipsis"/>
												</Button>
												<TextBox Text="{Binding Name, Mode=TwoWay}"
												         FontSize="13" FontWeight="SemiBold"
												         Padding="4,2,16,2"
												         VerticalAlignment="Center"
												         IsVisible="{Binding IsRenaming}"
												         KeyDown="OnFolderRenameKeyDown"
												         LostFocus="OnFolderRenameLostFocus"
												         behaviours:FocusOnVisibleBehavior.Enabled="{Binding IsRenaming}"
												         behaviours:SelectAllBehavior.Enabled="True"/>
											</Panel>

											<!-- Подпись своей папки -->
											<Grid Margin="8,0,8,0" IsVisible="{Binding IsCustom}">
												<Button Classes="folder-hdr-btn"
												        Command="{Binding StartEditCommentCommand}"
												        Padding="4"
												        HorizontalAlignment="Right"
												        behaviours:TooltipBehavior.Tip="Подпись папки"
												        IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNullOrEmpty}}">
													<PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
													          Width="12" Height="12"
													          Foreground="{DynamicResource TextMutedBrush}"
													          Opacity="0.4"/>
												</Button>
												<Button Classes="flat"
												        Command="{Binding StartEditCommentCommand}"
												        Background="Transparent" BorderThickness="0"
												        Padding="0" VerticalAlignment="Center"
												        HorizontalAlignment="Stretch"
												        HorizontalContentAlignment="Stretch"
												        IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
													<TextBlock Text="{Binding Comment}"
													           FontSize="11" FontStyle="Italic"
													           Foreground="{DynamicResource TextSecondaryBrush}"
													           TextTrimming="CharacterEllipsis"/>
												</Button>
												<infra:ItalicCaretTextBox Classes="italic"
												                          Text="{Binding Comment, Mode=TwoWay}"
												                          FontStyle="Italic"
												                          PlaceholderText="Подпись папки"
												                          Padding="4,2,4,2"
												                          HorizontalAlignment="Stretch"
												                          VerticalAlignment="Center"
												                          IsVisible="{Binding IsEditingComment}"
												                          KeyDown="OnFolderCommentKeyDown"
												                          LostFocus="OnFolderCommentLostFocus"
												                          behaviours:FocusOnVisibleBehavior.Enabled="{Binding IsEditingComment}"
												                          behaviours:SelectAllBehavior.Enabled="True"/>
											</Grid>
										</controls:CharactersFolderHeaderPanel>

										<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
											<!-- Порядок разделов — стрелками, одной парой: любой
											     раздел, и «Мои шаблоны», и «Встроенные», встаёт
											     выше или ниже соседа. Крайнему некуда — его стрелка
											     гаснет, а место пары остаётся. -->
											<Border Classes="folder-move" Margin="0,0,6,0">
												<StackPanel Orientation="Horizontal">
													<Button Classes="folder-move-btn"
													        Command="{Binding MoveUpCommand}"
													        IsEnabled="{Binding CanMoveUp}"
													        behaviours:TooltipBehavior.Tip="Раздел выше">
														<PathIcon Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"
														          Width="12" Height="12"
														          Foreground="{DynamicResource TextSecondaryBrush}"/>
													</Button>
													<Border Classes="folder-move-sep"/>
													<Button Classes="folder-move-btn"
													        Command="{Binding MoveDownCommand}"
													        IsEnabled="{Binding CanMoveDown}"
													        behaviours:TooltipBehavior.Tip="Раздел ниже">
														<PathIcon Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"
														          Width="12" Height="12"
														          Foreground="{DynamicResource TextSecondaryBrush}"/>
													</Button>
												</StackPanel>
											</Border>
											<Button Classes="folder-hdr-btn"
											        IsVisible="{Binding IsCustom}"
											        Padding="8"
											        behaviours:TooltipBehavior.Tip="Удалить папку"
											        behaviours:TooltipBehavior.Description="Шаблоны папки не удаляются — они перейдут в «Мои шаблоны»">
												<PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
												          Width="13" Height="13"
												          Foreground="{DynamicResource TextSecondaryBrush}"/>
												<Button.Flyout>
													<Flyout Placement="BottomEdgeAlignedRight">
														<StackPanel Spacing="8" Margin="2" MaxWidth="260">
															<TextBlock Text="Удалить папку?" FontWeight="SemiBold"/>
															<TextBlock Text="Шаблоны из неё перейдут в «Мои шаблоны»"
															           FontSize="11" TextWrapping="Wrap"
															           Foreground="{DynamicResource TextSecondaryBrush}"/>
															<Button Classes="standard primary" Content="Удалить" Click="OnDeleteFolderClick" HorizontalAlignment="Right"/>
														</StackPanel>
													</Flyout>
												</Button.Flyout>
											</Button>
											<TextBlock Text="{Binding Count}"
											           FontSize="11"
											           Foreground="{DynamicResource TextSecondaryBrush}"
											           VerticalAlignment="Center"
											           MinWidth="20"
											           TextAlignment="Center"/>
											<Button Classes="folder-hdr-btn ro-allow"
											        Command="{Binding ToggleExpandCommand}"
											        Padding="6,4" Margin="0,0,4,0">
												<TextBlock Text="{Binding IsExpanded, Converter={x:Static conv:BoolToCollapseArrowConverter.Instance}}"
												           FontSize="10"
												           Foreground="{DynamicResource TextSecondaryBrush}"
												           VerticalAlignment="Center"/>
											</Button>
										</StackPanel>
									</Grid>
								</Panel>
							</Border>

							<!-- Блоки раздела: ряды во всю ширину, без дыры справа -->
							<ItemsControl Classes="tpl-blocks"
							              ItemsSource="{Binding Blocks}"
							              IsVisible="{Binding ShowBlocks}"
							              Margin="6,6,6,2">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<controls:StretchWrapPanel MinItemWidth="380"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
							</ItemsControl>

							<!-- Пустой раздел: подсказка, и сюда же бросают блок -->
							<Border Classes="tpl-empty" IsVisible="{Binding ShowEmptyHint}">
								<TextBlock Text="{Binding EmptyHint}"
								           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
								           HorizontalAlignment="Center" VerticalAlignment="Center"
								           Margin="12,8"
								           Foreground="{DynamicResource TextMutedBrush}"/>
							</Border>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<!-- ── Слой перетаскивания ────────────────────────────────────── -->
		<Canvas Grid.Row="0" Grid.RowSpan="2" x:Name="DragLayer" IsHitTestVisible="False">
			<Border x:Name="InsertMark" Classes="insert-mark" IsVisible="False"/>
			<Border x:Name="BlockGhost" Classes="block-ghost" IsVisible="False">
				<Border.Effect>
					<DropShadowEffect BlurRadius="16" OffsetX="0" OffsetY="6" Opacity="0.4"/>
				</Border.Effect>
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="12">
					<Panel Grid.Column="0" Width="64" Height="64">
						<controls:AnketaIconBadge x:Name="BlockGhostBadge" Size="64" Look="Tile"/>
						<Border x:Name="BlockGhostImageHost" CornerRadius="8" ClipToBounds="True">
							<Image x:Name="BlockGhostImage" Stretch="UniformToFill"/>
						</Border>
					</Panel>
					<StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Top" Margin="0,2,0,0">
						<TextBlock x:Name="BlockGhostName"
						           FontSize="13" FontWeight="Medium"
						           TextTrimming="CharacterEllipsis"
						           Foreground="{DynamicResource TextPrimaryBrush}"/>
						<TextBlock x:Name="BlockGhostDescription"
						           FontSize="11"
						           TextWrapping="Wrap" MaxLines="2"
						           TextTrimming="CharacterEllipsis"
						           Foreground="{DynamicResource TextSecondaryBrush}"/>
					</StackPanel>
				</Grid>
			</Border>
			<Border x:Name="Ghost" Classes="ghost" IsVisible="False">
				<StackPanel Orientation="Horizontal" Spacing="7">
					<controls:AnketaIconBadge x:Name="GhostBadge" Size="22"/>
					<TextBlock x:Name="GhostText" VerticalAlignment="Center"
					           Foreground="{DynamicResource TextPrimaryBrush}"/>
				</StackPanel>
			</Border>
		</Canvas>
	</Grid>
</UserControl>
