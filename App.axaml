<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockFluent="using:Dock.Avalonia.Themes.Fluent"
             x:Class="Writersword.App"
             RequestedThemeVariant="Dark">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!-- Тема грузится только через ThemeService при старте -->
				<ResourceInclude Source="avares://Writersword/Styles/Base/Typography.axaml"/>
				<ResourceInclude Source="avares://Writersword/Styles/Base/Spacing.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
	<Application.Styles>
		<FluentTheme />
		<!-- Тема контролов выбора цвета. FluentTheme её не несёт: ColorView,
		     ColorSpectrum и ColorSlider живут в отдельной сборке со своей
		     темой, и без этой строки они строятся без шаблона — то есть
		     занимают ноль места и не видны вовсе. -->
		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
		<!-- Fluent тема для Dock. CacheDocumentTabContent держит вьюхи документов
		     живыми при переключении вкладок — без пересоздания контента. -->
		<dockFluent:DockFluentTheme CacheDocumentTabContent="True"/>
		<!-- Кастомные стили контролов -->
		<StyleInclude Source="avares://Writersword/Styles/Controls.axaml"/>
		<!-- Кастомные стили -->
		<StyleInclude Source="/Styles/DockStyles.axaml"/>
		<!--
            Отключение контекстного меню Dock библиотеки на вкладках модулей.
            Библиотека Dock.Avalonia по умолчанию показывает контекстное меню с командами
            Float, Close, Tab Layout и т.д. при ПКМ на заголовке вкладки.
            Этот стиль полностью скрывает это меню.
            НЕ влияет на контекстные меню ВНУТРИ модулей (текстовый редактор, списки и т.д.)
        -->
		<Style Selector="DockControl ContextMenu">
			<Setter Property="IsVisible" Value="False"/>
		</Style>
	</Application.Styles>
</Application>