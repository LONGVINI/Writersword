<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Writersword.Modules.Characters.Views"
             xmlns:icv="using:Writersword.Infrastructure.Converters"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             x:Class="Writersword.Modules.Characters.Views.CardSettingsOverlay"
             x:DataType="views:CardSettingsDraft"
             IsVisible="False">

	<!-- Окно настроек карточки. Оформление и поведение — как у редактора цвета:
	     скрим на модуль (клик не закрывает), центральная панель BgBase со
	     скруглением 16 и тенью. Все изменения живут в черновике (DataContext =
	     CardSettingsDraft) и видны только в превью; к карточке применяются по OK,
	     «Отмена»/крестик просто закрывают окно, ничего не меняя. -->

	<UserControl.Styles>
		<!-- Вкладки «вид аватара» — как вкладки коллекций в редакторе цвета. -->
		<Style Selector="Button.tab">
			<Setter Property="Padding" Value="9,6"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="Button.tab.active">
			<Setter Property="Background" Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<!-- «Ко всем»: переключатель с подсветкой — включён значит применится
		     ко всем при OK. Взведённое состояние — акцентная рамка и текст. -->
		<Style Selector="ToggleButton.applyAll">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="ToggleButton.applyAll:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="ToggleButton.applyAll:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="ToggleButton.applyAll:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
	</UserControl.Styles>

	<Grid>
		<!-- Скрим: затемняет и блокирует модуль. Клик НЕ закрывает (как в
		     редакторе цвета). -->
		<Border Background="#F2000000" PointerPressed="OnScrimPressed"/>

		<Border HorizontalAlignment="Center" VerticalAlignment="Center"
		        Margin="24" Width="440"
		        Background="{DynamicResource BgBaseBrush}"
		        BorderBrush="{DynamicResource BorderDefaultBrush}"
		        BorderThickness="1"
		        CornerRadius="16"
		        Padding="20">
			<Border.Effect>
				<DropShadowEffect BlurRadius="32" OffsetX="0" OffsetY="12" Opacity="0.55" Color="#000000"/>
			</Border.Effect>

			<StackPanel Spacing="14">

				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Grid.Column="0" Text="Настройки карточки"
					           FontSize="16" FontWeight="SemiBold"
					           Foreground="{DynamicResource TextPrimaryBrush}"
					           VerticalAlignment="Center"/>
					<Button Grid.Column="1" Content="✕" Click="OnCancelClick"
					        Background="Transparent" BorderThickness="0"
					        Foreground="{DynamicResource TextSecondaryBrush}"
					        FontSize="14" Padding="6,2"/>
				</Grid>

				<!-- Превью карточки: показывает черновик настроек, реальная
				     карточка не меняется до OK. -->
				<Border Width="124" CornerRadius="10"
				        Background="{DynamicResource BgPanelBrush}"
				        BorderBrush="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
				        BorderThickness="{Binding BorderThickness}"
				        HorizontalAlignment="Center"
				        ClipToBounds="False">
					<Panel>
						<Path IsVisible="{Binding ShowBookmark}" IsHitTestVisible="False"
						      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,10,0"
						      Data="M0,0 H12 V17 L6,12 L0,17 Z"
						      Fill="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
						      ZIndex="2"/>
						<StackPanel>
							<Panel Height="56">
								<!-- Вид «полоска»: картинка или заливка на всю зону -->
								<Panel IsVisible="{Binding AvatarStrip}">
									<Border Background="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
									        CornerRadius="8,8,0,0"/>
									<Border CornerRadius="8,8,0,0" ClipToBounds="True"
									        IsVisible="{Binding AvatarBitmap, Converter={x:Static ObjectConverters.IsNotNull}}">
										<Image Source="{Binding AvatarBitmap}" Stretch="UniformToFill"/>
									</Border>
									<TextBlock Text="{Binding FallbackIcon}" Foreground="White" FontSize="20"
									           HorizontalAlignment="Center" VerticalAlignment="Center"
									           IsVisible="{Binding AvatarBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
								</Panel>
								<!-- Вид «кружок». Аватар и кольцо вокруг него рисуются формой
								     Ellipse, а не имитацией круга через Border с CornerRadius="999":
								     на некоторых компьютерах такая имитация рендерится неровно,
								     «кривым» кругом. Тот же приём с Ellipse уже используется для
								     аватарки в списке персонажей (CharactersListView), и там такой
								     проблемы нет. -->
								<Panel Width="44" Height="44" IsVisible="{Binding !AvatarStrip}"
								       HorizontalAlignment="Center" VerticalAlignment="Center">
									<Ellipse Width="44" Height="44"
									         Fill="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>
									<Ellipse Width="44" Height="44"
									         IsVisible="{Binding AvatarBitmap, Converter={x:Static ObjectConverters.IsNotNull}}">
										<Ellipse.Fill>
											<ImageBrush Source="{Binding AvatarBitmap}" Stretch="UniformToFill"/>
										</Ellipse.Fill>
									</Ellipse>
									<TextBlock Text="{Binding FallbackIcon}" Foreground="White" FontSize="20"
									           HorizontalAlignment="Center" VerticalAlignment="Center"
									           IsVisible="{Binding AvatarBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
								</Panel>
								<Ellipse Width="52" Height="52" StrokeThickness="2"
								         IsVisible="{Binding ShowRing}" IsHitTestVisible="False"
								         Stroke="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
								         HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Panel>
							<Border Height="34">
								<TextBlock Text="{Binding Name}"
								           FontSize="12" Margin="6,0"
								           HorizontalAlignment="Center" VerticalAlignment="Center"
								           TextTrimming="CharacterEllipsis"
								           Foreground="{DynamicResource TextPrimaryBrush}"/>
							</Border>
						</StackPanel>
					</Panel>
				</Border>

				<!-- Вид аватара: кружок или полоска на всю ширину -->
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Grid.Column="0" Text="Вид аватара" FontSize="13"
					           Foreground="{DynamicResource TextPrimaryBrush}"
					           VerticalAlignment="Center"/>
					<Border Grid.Column="1" Background="{DynamicResource BgSurfaceBrush}"
					        CornerRadius="8" Padding="3">
						<StackPanel Orientation="Horizontal">
							<Button Classes="tab" Classes.active="{Binding !AvatarStrip}"
							        Content="Кружок" Click="OnViewCircleClick"/>
							<Button Classes="tab" Classes.active="{Binding AvatarStrip}"
							        Content="Полоска" Click="OnViewStripClick"/>
						</StackPanel>
					</Border>
				</Grid>

				<!-- Кольцо вокруг аватара -->
				<Grid ColumnDefinitions="*,Auto">
					<CheckBox Grid.Column="0" IsChecked="{Binding Ring, Mode=TwoWay}"
					          Content="Кольцо вокруг аватара" FontSize="13"
					          VerticalAlignment="Center"/>
					<ToggleButton Grid.Column="1" x:Name="RingAllToggle" Classes="applyAll"
					              Content="Ко всем" VerticalAlignment="Center"
					              behaviours:TooltipBehavior.Tip="Кольцо ко всем персонажам"
					              behaviours:TooltipBehavior.Description="Состояние кольца применится ко всем карточкам проекта после нажатия OK."/>
				</Grid>

				<!-- Закладка-ленточка (только у групп) -->
				<Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCollective}">
					<CheckBox Grid.Column="0" IsChecked="{Binding Bookmark, Mode=TwoWay}"
					          Content="Закладка группы" FontSize="13"
					          VerticalAlignment="Center"/>
					<ToggleButton Grid.Column="1" x:Name="BookmarkAllToggle" Classes="applyAll"
					              Content="Ко всем группам" VerticalAlignment="Center"
					              behaviours:TooltipBehavior.Tip="Закладка ко всем группам"
					              behaviours:TooltipBehavior.Description="Состояние закладки применится ко всем групповым карточкам после нажатия OK."/>
				</Grid>

				<!-- Толщина рамки -->
				<StackPanel Spacing="4">
					<Grid ColumnDefinitions="*,Auto,Auto">
						<TextBlock Grid.Column="0" Text="Толщина рамки" FontSize="13"
						           Foreground="{DynamicResource TextPrimaryBrush}"
						           VerticalAlignment="Center"/>
						<TextBlock Grid.Column="1" Text="{Binding Thickness, StringFormat={}{0:0}}"
						           FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"
						           Foreground="{DynamicResource TextSecondaryBrush}"/>
						<ToggleButton Grid.Column="2" x:Name="ThicknessAllToggle" Classes="applyAll"
						              Content="Ко всем" VerticalAlignment="Center"
						              behaviours:TooltipBehavior.Tip="Толщина рамки ко всем"
						              behaviours:TooltipBehavior.Description="Толщина рамки применится ко всем карточкам проекта после нажатия OK."/>
					</Grid>
					<Slider Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
					        Value="{Binding Thickness, Mode=TwoWay}"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
					<Button Content="Отмена" Click="OnCancelClick" Padding="14,6" CornerRadius="6"
					        Background="{DynamicResource BgSurfaceBrush}"
					        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"/>
					<Button Content="OK" Click="OnOkClick" Padding="18,6" CornerRadius="6"
					        Background="{DynamicResource AccentDefaultBrush}" Foreground="White"/>
				</StackPanel>

			</StackPanel>
		</Border>
	</Grid>
</UserControl>
