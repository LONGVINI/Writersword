<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:Writersword.Infrastructure.Behaviours">

	<!-- Завершение ввода щелчком мимо поля и клавишей Enter — во всех окнах.
	     Поведение вешается на окно и покрывает все поля внутри, включая поле
	     ввода редактируемого списка. -->
	<Style Selector="Window">
		<Setter Property="b:FocusReleaseBehavior.Enabled" Value="True"/>
	</Style>

	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/Button.axaml"/>
	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/TextBox.axaml"/>
	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/NumericUpDown.axaml"/>
	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/ComboBox.axaml"/>
	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/CheckBox.axaml"/>
	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/ToggleSwitch.axaml"/>
	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/DocumentTextBox.axaml"/>
	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/RibbonScrollArrow.axaml"/>
	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/Flyout.axaml"/>
	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/UnitToggle.axaml"/>
	<StyleInclude Source="avares://Writersword.UI.Shared/Styles/Controls/ScopeToggle.axaml"/>

	<!-- Скролл: тонкий, скруглённый бегунок, без стрелок, подсветка при наведении. -->
	<Style Selector="ScrollBar:vertical">
		<Setter Property="Width" Value="10"/>
	</Style>
	<Style Selector="ScrollBar:horizontal">
		<Setter Property="Height" Value="10"/>
	</Style>
	<Style Selector="ScrollBar">
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="ScrollBar /template/ Border#Root">
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="ScrollBar /template/ Grid#Root">
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="ScrollBar /template/ Thumb">
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{DynamicResource BorderDefaultBrush}" CornerRadius="5" Margin="2"/>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="ScrollBar /template/ Thumb:pointerover /template/ Border">
		<Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
	</Style>
	<Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
		<Setter Property="IsVisible" Value="False"/>
	</Style>
	<Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
		<Setter Property="IsVisible" Value="False"/>
	</Style>
	<Style Selector="ScrollBar /template/ RepeatButton#PART_LineLeftButton">
		<Setter Property="IsVisible" Value="False"/>
	</Style>
	<Style Selector="ScrollBar /template/ RepeatButton#PART_LineRightButton">
		<Setter Property="IsVisible" Value="False"/>
	</Style>
</Styles>
