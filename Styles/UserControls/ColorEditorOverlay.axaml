<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Writersword.Styles.UserControls"
             x:Class="Writersword.Styles.UserControls.ColorEditorOverlay"
             x:Name="OverlayRoot">

	<UserControl.Styles>
		<Style Selector="Border.paletteSwatch">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="Margin" Value="3"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Border.paletteSwatch:pointerover">
			<Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="BorderThickness" Value="2.5"/>
		</Style>

		<Style Selector="Button.tab">
			<Setter Property="Padding" Value="16,6"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="Button.tab.active">
			<Setter Property="Background" Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<Style Selector="Button.addtile">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Margin" Value="3"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Content" Value="+"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
	</UserControl.Styles>

	<Grid>

		<!-- Скрим: затемняет и блокирует только модуль. Клик НЕ закрывает. -->
		<Border Background="#66000000"/>

		<!-- Панель редактора -->
		<Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource BgBaseBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                MinWidth="600">
			<Border.Effect>
				<DropShadowEffect BlurRadius="32" OffsetX="0" OffsetY="12" Opacity="0.55" Color="#000000"/>
			</Border.Effect>

			<Grid RowDefinitions="Auto,Auto,Auto">

				<!-- Заголовок + крестик -->
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto">
					<TextBlock Grid.Column="0"
                               Text="{x:Static res:SharedStrings.ColorEditor_Title}"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
					<Button Grid.Column="1" Content="✕" Click="OnCloseClick"
                            Background="Transparent" BorderThickness="0"
                            Padding="8,2" FontSize="15"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>
				</Grid>

				<!-- Контент -->
				<Grid Grid.Row="1" ColumnDefinitions="Auto,24,Auto" Margin="0,16">

					<!-- Левая колонка: выбор цвета -->
					<StackPanel Grid.Column="0" Width="276" Spacing="12">

						<Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="8"
                                Padding="3" HorizontalAlignment="Left">
							<StackPanel Orientation="Horizontal" Spacing="2">
								<Button x:Name="TabSpectrumBtn" Classes="tab active"
                                        Click="OnTabSpectrum"
                                        Content="{x:Static res:SharedStrings.ColorEditor_TabSpectrum}"/>
								<Button x:Name="TabHoneycombBtn" Classes="tab"
                                        Click="OnTabHoneycomb"
                                        Content="{x:Static res:SharedStrings.ColorEditor_TabHoneycomb}"/>
							</StackPanel>
						</Border>

						<Panel Height="230">

							<!-- Режим «Спектр»: SV-квадрат + полоса оттенка -->
							<StackPanel x:Name="SpectrumPanel" Orientation="Horizontal"
                                        Spacing="14" HorizontalAlignment="Center">

								<Panel x:Name="SvSquare" Width="220" Height="220"
                                       Background="Transparent"
                                       PointerPressed="OnSvPressed"
                                       PointerMoved="OnSvMoved"
                                       PointerReleased="OnSvReleased">
									<Border x:Name="SvHueLayer" CornerRadius="8"/>
									<Border CornerRadius="8" IsHitTestVisible="False">
										<Border.Background>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
												<GradientStop Offset="0" Color="#FFFFFFFF"/>
												<GradientStop Offset="1" Color="#00FFFFFF"/>
											</LinearGradientBrush>
										</Border.Background>
									</Border>
									<Border CornerRadius="8" IsHitTestVisible="False">
										<Border.Background>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
												<GradientStop Offset="0" Color="#00000000"/>
												<GradientStop Offset="1" Color="#FF000000"/>
											</LinearGradientBrush>
										</Border.Background>
									</Border>
									<Canvas IsHitTestVisible="False">
										<Border x:Name="SvThumb" Width="16" Height="16"
                                                CornerRadius="999" Background="Transparent"
                                                BorderBrush="White" BorderThickness="2">
											<Border.Effect>
												<DropShadowEffect BlurRadius="3" OffsetX="0" OffsetY="0"
                                                                  Opacity="0.7" Color="#000000"/>
											</Border.Effect>
										</Border>
									</Canvas>
								</Panel>

								<Panel x:Name="HueBar" Width="22" Height="220"
                                       Background="Transparent"
                                       PointerPressed="OnHuePressed"
                                       PointerMoved="OnHueMoved"
                                       PointerReleased="OnHueReleased">
									<Border CornerRadius="6" IsHitTestVisible="False">
										<Border.Background>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
												<GradientStop Offset="0" Color="#FF0000"/>
												<GradientStop Offset="0.1667" Color="#FFFF00"/>
												<GradientStop Offset="0.3333" Color="#00FF00"/>
												<GradientStop Offset="0.5" Color="#00FFFF"/>
												<GradientStop Offset="0.6667" Color="#0000FF"/>
												<GradientStop Offset="0.8333" Color="#FF00FF"/>
												<GradientStop Offset="1" Color="#FF0000"/>
											</LinearGradientBrush>
										</Border.Background>
									</Border>
									<Canvas IsHitTestVisible="False">
										<Border x:Name="HueThumb" Width="26" Height="6"
                                                CornerRadius="3" Background="White"
                                                BorderBrush="#333333" BorderThickness="1"/>
									</Canvas>
								</Panel>
							</StackPanel>

							<!-- Режим «Соты»: строится в коде -->
							<Border x:Name="HoneycombPanel" IsVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource BgSurfaceBrush}"
                                    CornerRadius="10" Padding="8">
								<Canvas x:Name="HoneycombCanvas"/>
							</Border>
						</Panel>
					</StackPanel>

					<!-- Правая колонка: значения, пипетка, палитра, превью -->
					<StackPanel Grid.Column="2" Width="300" Spacing="14">

						<Grid ColumnDefinitions="Auto,*">
							<Border x:Name="PreviewSwatch" Grid.Column="0"
                                    Width="56" Height="56" CornerRadius="10"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"/>
							<StackPanel Grid.Column="1" Margin="12,0,0,0"
                                        VerticalAlignment="Center" Spacing="4">
								<TextBlock Text="HEX" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
								<TextBox x:Name="HexBox" MaxLength="7" FontSize="13"
                                         KeyDown="OnHexKeyDown" LostFocus="OnHexCommit"/>
							</StackPanel>
						</Grid>

						<Button x:Name="EyedropperButton" Click="OnEyedropperClick"
                                HorizontalAlignment="Stretch" Padding="10,8" CornerRadius="8"
                                Background="{DynamicResource BgSurfaceBrush}"
                                BorderBrush="{DynamicResource AccentDefaultBrush}"
                                BorderThickness="1"
                                ToolTip.Tip="{x:Static res:SharedStrings.ColorEditor_EyedropperHint}">
							<StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center">
								<Viewbox Width="17" Height="17">
									<Canvas Width="24" Height="24">
										<Path Fill="{DynamicResource AccentDefaultBrush}"
                                              Data="M17.66 5.41l.92.92-2.69 2.69-.92-.92 2.69-2.69M17.67 3c-.26 0-.51.1-.71.29l-3.12 3.12-1.93-1.91-1.41 1.41 1.42 1.42L3 16.25V21h4.75l8.92-8.92 1.42 1.42 1.41-1.41-1.92-1.92 3.12-3.12c.4-.4.4-1.03.01-1.42l-2.34-2.34c-.2-.19-.45-.29-.71-.29zM6.92 19L5 17.08l8.06-8.06 1.92 1.92L6.92 19z"/>
									</Canvas>
								</Viewbox>
								<TextBlock Text="{x:Static res:SharedStrings.ColorEditor_Eyedropper}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentDefaultBrush}"/>
							</StackPanel>
						</Button>

						<Grid ColumnDefinitions="18,*,40" RowDefinitions="Auto,Auto,Auto">
							<TextBlock Grid.Row="0" Grid.Column="0" Text="R" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
							<Slider Grid.Row="0" Grid.Column="1" x:Name="SliderR"
                                    Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                    ValueChanged="OnRgbChanged"/>
							<TextBlock Grid.Row="0" Grid.Column="2" x:Name="LabelR"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

							<TextBlock Grid.Row="1" Grid.Column="0" Text="G" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
							<Slider Grid.Row="1" Grid.Column="1" x:Name="SliderG"
                                    Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                    ValueChanged="OnRgbChanged"/>
							<TextBlock Grid.Row="1" Grid.Column="2" x:Name="LabelG"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

							<TextBlock Grid.Row="2" Grid.Column="0" Text="B" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
							<Slider Grid.Row="2" Grid.Column="1" x:Name="SliderB"
                                    Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                    ValueChanged="OnRgbChanged"/>
							<TextBlock Grid.Row="2" Grid.Column="2" x:Name="LabelB"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
						</Grid>

						<StackPanel Spacing="6">
							<TextBlock Text="{x:Static res:SharedStrings.ColorEditor_MyColors}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
							<Border Background="{DynamicResource BgSurfaceBrush}"
                                    CornerRadius="10" Padding="6" MinHeight="44">
								<StackPanel Orientation="Horizontal">
									<ItemsControl x:Name="PaletteItems"
                                                  ItemsSource="{Binding Palette, ElementName=OverlayRoot}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Classes="paletteSwatch" Background="{Binding}"
                                                        PointerPressed="OnPalettePressed"
                                                        PointerMoved="OnPaletteMoved"
                                                        PointerReleased="OnPaletteReleased"/>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<Button Classes="addtile" Click="OnAddCurrentClick"
                                            VerticalAlignment="Top"
                                            ToolTip.Tip="{x:Static res:SharedStrings.ColorEditor_AddCurrent}"/>
								</StackPanel>
							</Border>
						</StackPanel>

						<StackPanel x:Name="PreviewPanel" Spacing="8"
                                    IsVisible="False">
							<TextBlock Text="{x:Static res:SharedStrings.ColorEditor_Preview}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
							<Border x:Name="PreviewCardBorder"
                                    Width="150" Height="112" CornerRadius="10"
                                    Background="{DynamicResource BgPanelBrush}"
                                    BorderThickness="2"
                                    HorizontalAlignment="Left" ClipToBounds="True">
								<StackPanel>
									<Panel Height="68">
										<Border x:Name="PreviewAvatar"
                                                Width="46" Height="46" CornerRadius="999"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
											<TextBlock Text="?" Foreground="White" FontSize="22"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Border>
									</Panel>
									<Border Height="44">
										<TextBlock Text="Aa" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
									</Border>
								</StackPanel>
							</Border>
						</StackPanel>
					</StackPanel>
				</Grid>

				<!-- Кнопки -->
				<StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Spacing="8">
					<Button Content="{x:Static res:SharedStrings.Common_Cancel}"
                            Click="OnCancelClick" Padding="14,6" CornerRadius="6"/>
					<Button Content="{x:Static res:SharedStrings.Common_Ok}"
                            Click="OnOkClick" Padding="18,6" CornerRadius="6"
                            Background="{DynamicResource AccentDefaultBrush}" Foreground="White"/>
				</StackPanel>

			</Grid>
		</Border>
	</Grid>
</UserControl>
