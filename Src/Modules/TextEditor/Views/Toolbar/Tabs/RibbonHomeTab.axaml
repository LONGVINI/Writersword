                                    <TextBlock Text="{x:Static loc:TextEditorStrings.Edit_SelectAll}" FontSize="9" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ПРАВКА — свёрнутая -->
                <Border Grid.Column="4" Classes="RibbonGroupCollapsed"
                        IsVisible="{Binding !IsEditGroupExpanded}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Classes="RibbonGroupLabelGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="RibbonGroupLabel"
                                       Text="{x:Static loc:TextEditorStrings.Edit_Group}"/>
                            <Button Grid.Column="1" Classes="RibbonGroupSettings"
                                    behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Edit_Group}"
                                    behaviours:TooltipBehavior.ShowDelay="700">
                                <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <Button Classes="RibbonBtnLarge" VerticalAlignment="Top"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Edit_Group}"
                                behaviours:TooltipBehavior.ShowDelay="700">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="8">
                                        <Button Command="{Binding FindCommand}" Classes="RibbonBtnLarge" Width="44"
                                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Find_Title}"
                                                behaviours:TooltipBehavior.HotKey="Ctrl+F" behaviours:TooltipBehavior.ShowDelay="700">
                                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Width="20" Height="20"/>
                                                <TextBlock Text="{x:Static loc:TextEditorStrings.Find_Title}" FontSize="9" TextAlignment="Center"/>
                                            </StackPanel>
