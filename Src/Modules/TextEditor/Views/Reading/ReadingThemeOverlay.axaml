<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Writersword.Styles.UserControls"
             xmlns:infra="using:Writersword.Infrastructure.Controls"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             x:Class="Writersword.Modules.TextEditor.Views.Reading.ReadingThemeOverlay">

	<UserControl.Styles>

		<Style Selector="Border.card">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="CornerRadius"    Value="10"/>
			<Setter Property="Padding"         Value="12"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<Style Selector="TextBlock.cardTitle">
			<Setter Property="FontSize"          Value="12"/>
			<Setter Property="FontWeight"        Value="SemiBold"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Значок раздела слева от заголовка. Разделов в окне много, и без
		     значков они сливаются в одну ленту одинаковых карточек: взгляду не за
		     что зацепиться, чтобы найти бумагу, свет или фон. -->
		<Style Selector="PathIcon.cardGlyph">
			<Setter Property="Width"             Value="13"/>
			<Setter Property="Height"            Value="13"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground"        Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Карточка, над которой несут файлы: рамка загорается — сюда их можно
		     бросить. -->
		<Style Selector="Border.card.dropTarget">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Плитки наборов картинок — тем же порядком, что галерея персонажа.
		     Плитка на месте вставки бледнеет: пока картинку несут, в сетке стоит
		     её тусклая копия, а сама картинка летит под курсором. Соседи при этом
		     расступаются по-настоящему — их перемещение доигрывает переход у
		     сдвига, заведённого при создании плитки. -->
		<Style Selector="Panel.galleryTile">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Panel.galleryTile.placeholder">
			<Setter Property="Opacity" Value="0.35"/>
			<Setter Property="ZIndex"  Value="10"/>
		</Style>

		<Style Selector="Border.galleryTileImage">
			<Setter Property="CornerRadius"    Value="4"/>
			<Setter Property="ClipToBounds"    Value="True"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
		</Style>

		<!-- Первая картинка набора отмечена: у фона на экране показывается она,
		     у бумаги с неё начинается очередь. -->
		<Style Selector="Border.galleryTileImage.first">
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Крестик виден только под курсором: в покое набор — это картинки, а не
		     картинки с кнопками поверх. Прячется прозрачностью, а не IsVisible:
		     скрытый элемент нельзя анимировать, он просто исчезает. -->
		<Style Selector="Button.galleryTileRemove">
			<Setter Property="Opacity"          Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Panel.galleryTile:pointerover Button.galleryTileRemove">
			<Setter Property="Opacity"          Value="1"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>

		<!-- Плитка добавления стоит в той же сетке последней: отдельная кнопка
		     над набором читалась бы как другой орган, а не как следующее место. -->
		<Style Selector="Button.galleryAdd">
			<Setter Property="Background"                 Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="BorderBrush"                Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness"            Value="1"/>
			<Setter Property="CornerRadius"               Value="4"/>
			<Setter Property="Padding"                    Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Foreground"                 Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="Cursor"                     Value="Hand"/>
		</Style>
		<Style Selector="Button.galleryAdd:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<Style Selector="TextBlock.FieldLabel">
			<Setter Property="FontSize"          Value="12"/>
			<Setter Property="Foreground"        Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="TextBlock.Hint">
			<Setter Property="FontSize"     Value="11"/>
			<Setter Property="Foreground"   Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<Style Selector="TextBox.Field">
			<Setter Property="Background"      Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="6"/>
			<Setter Property="MinHeight"       Value="28"/>
			<Setter Property="Padding"         Value="10 3"/>
			<Setter Property="FontSize"        Value="12"/>
		</Style>

		<Style Selector="ComboBox.Field">
			<Setter Property="Background"          Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="BorderBrush"         Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness"     Value="1"/>
			<Setter Property="CornerRadius"        Value="6"/>
			<Setter Property="MinHeight"           Value="28"/>
			<Setter Property="Padding"             Value="10 0"/>
			<Setter Property="FontSize"            Value="12"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<Style Selector="Button.mini">
			<Setter Property="Padding"         Value="12 5"/>
			<Setter Property="CornerRadius"    Value="6"/>
			<Setter Property="FontSize"        Value="11"/>
			<Setter Property="Background"      Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"          Value="Hand"/>
		</Style>
		<Style Selector="Button.mini:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<!-- Иконочное действие над видом: дублировать, удалить. Стоят в шапке
		     карточки имени, где человек и правит вид, а не в конце длинной
		     прокрутки, куда ещё нужно доехать. -->
		<Style Selector="Button.iconAction">
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Width"           Value="26"/>
			<Setter Property="Height"          Value="26"/>
			<Setter Property="CornerRadius"    Value="6"/>
			<Setter Property="Padding"         Value="0"/>
			<Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Cursor"          Value="Hand"/>
		</Style>
		<Style Selector="Button.iconAction:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.iconAction.danger:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource HotKeyConflictCriticalBrush}"/>
		</Style>
		<Style Selector="Button.iconAction.danger:pointerover /template/ ContentPresenter">
			<Setter Property="BorderBrush" Value="{DynamicResource HotKeyConflictCriticalBrush}"/>
		</Style>
		<Style Selector="Button.iconAction:disabled">
			<Setter Property="Opacity" Value="0.4"/>
		</Style>

		<Style Selector="Button.IconClose">
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width"           Value="28"/>
			<Setter Property="Height"          Value="28"/>
			<Setter Property="CornerRadius"    Value="999"/>
			<Setter Property="Padding"         Value="0"/>
			<Setter Property="Foreground"      Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment"   Value="Center"/>
			<Setter Property="Cursor"          Value="Hand"/>
		</Style>
		<Style Selector="Button.IconClose:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>

		<Style Selector="Button.Dialog">
			<Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius"    Value="8"/>
			<Setter Property="Padding"         Value="18 8"/>
			<Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Cursor"          Value="Hand"/>
		</Style>
		<Style Selector="Button.Dialog:pointerover /template/ ContentPresenter">
			<Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>

		<Style Selector="Button.DialogAccent">
			<Setter Property="Background"      Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius"    Value="8"/>
			<Setter Property="Padding"         Value="20 8"/>
			<Setter Property="Foreground"      Value="White"/>
			<Setter Property="FontWeight"      Value="SemiBold"/>
			<Setter Property="Cursor"          Value="Hand"/>
		</Style>

		<!-- Сегментированный переключатель области — форма из палитр. Здесь оба
		     сегмента могут гореть сразу: вид умеет лежать и в документе, и везде. -->
		<Style Selector="Border.scopeTrack">
			<Setter Property="CornerRadius"      Value="999"/>
			<Setter Property="Padding"           Value="2"/>
			<Setter Property="Background"        Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="ToggleButton.scope">
			<Setter Property="Padding"            Value="14 5"/>
			<Setter Property="MinWidth"           Value="96"/>
			<Setter Property="CornerRadius"       Value="999"/>
			<Setter Property="BorderThickness"    Value="0"/>
			<Setter Property="FontSize"           Value="11"/>
			<Setter Property="Cursor"             Value="Hand"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Foreground"         Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="ToggleButton.scope /template/ ContentPresenter">
			<Setter Property="Background"   Value="Transparent"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="ToggleButton.scope:not(:checked):pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
		<Style Selector="ToggleButton.scope.local:checked">
			<Setter Property="Foreground" Value="{DynamicResource SectionProjectFgBrush}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="ToggleButton.scope.local:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SectionProjectBgBrush}"/>
		</Style>
		<Style Selector="ToggleButton.scope.global:checked">
			<Setter Property="Foreground" Value="{DynamicResource SectionGlobalFgBrush}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="ToggleButton.scope.global:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SectionGlobalBgBrush}"/>
		</Style>

		<!-- Строка вида в списке. -->
		<Style Selector="Border.themeRow">
			<Setter Property="Background"      Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="CornerRadius"    Value="8"/>
			<Setter Property="Padding"         Value="8"/>
			<Setter Property="Margin"          Value="0 2"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush"     Value="Transparent"/>
			<Setter Property="Cursor"          Value="Hand"/>
		</Style>
		<Style Selector="Border.themeRow:pointerover">
			<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
		</Style>
		<Style Selector="Border.themeRow.active">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Background"  Value="{DynamicResource BgSurfaceBrush}"/>
		</Style>

		<Style Selector="Border.scopeBadge">
			<Setter Property="CornerRadius"      Value="999"/>
			<Setter Property="Padding"           Value="7 1"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Щелчок в любую точку дорожки переносит бегунок туда же — как у полосок
		     R, G, B в палитре. Половинки трека — RepeatButton'ы — иначе перехватывают
		     нажатие раньше ползунка и отрабатывают свой шаг. -->
		<Style Selector="Slider.Neat /template/ RepeatButton">
			<Setter Property="IsHitTestVisible" Value="False"/>
		</Style>

		<Style Selector="Slider.Neat">
			<Setter Property="MinHeight"         Value="0"/>
			<Setter Property="Height"            Value="18"/>
			<Setter Property="Padding"           Value="0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Grid Margin="7 0">
						<Border Height="4" CornerRadius="2" VerticalAlignment="Center"
						        Background="{DynamicResource BorderDefaultBrush}"/>
						<Track Name="PART_Track"
						       Orientation="Horizontal"
						       Minimum="{TemplateBinding Minimum}"
						       Maximum="{TemplateBinding Maximum}"
						       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
							<Track.DecreaseButton>
								<RepeatButton Name="PART_DecreaseButton" Focusable="False"
								              Height="4" VerticalAlignment="Center">
									<RepeatButton.Template>
										<ControlTemplate>
											<Border Height="4" CornerRadius="2" VerticalAlignment="Center"
											        Background="{DynamicResource AccentDefaultBrush}"/>
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.DecreaseButton>
							<Track.IncreaseButton>
								<RepeatButton Name="PART_IncreaseButton" Focusable="False"
								              Height="4" VerticalAlignment="Center">
									<RepeatButton.Template>
										<ControlTemplate><Border Background="Transparent"/></ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.IncreaseButton>
							<Thumb Name="thumb" Width="14" Height="14">
								<Thumb.Template>
									<ControlTemplate>
										<Border Width="14" Height="14" CornerRadius="7"
										        Background="{DynamicResource AccentDefaultBrush}"
										        BorderBrush="{DynamicResource BgSurfaceBrush}"
										        BorderThickness="2"/>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Track>
					</Grid>
				</ControlTemplate>
			</Setter>
		</Style>

		<!-- Полоса прокрутки.

		     Своя, а не из темы: та живёт ниткой в два пиксела и раздувается под
		     указателем, подменяя дорожку серой плашкой. Пока её не поймаешь — не
		     видно, где стоишь, а поймав, получаешь прыжок ширины под курсором.
		     Здесь бегунок сразу толстый и один и тот же всегда, дорожка прозрачна, а
		     место под него отведено в вёрстке — наезжать на поля ему не надо. -->
		<Style Selector="ScrollBar:vertical">
			<Setter Property="Width"      Value="10"/>
			<Setter Property="MinWidth"   Value="10"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Grid Background="Transparent">
						<Track Name="PART_Track"
						       Orientation="Vertical"
						       IsDirectionReversed="True"
						       Minimum="{TemplateBinding Minimum}"
						       Maximum="{TemplateBinding Maximum}"
						       ViewportSize="{TemplateBinding ViewportSize}"
						       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
							<Track.DecreaseButton>
								<RepeatButton Name="PART_PageUpButton" Focusable="False">
									<RepeatButton.Template>
										<ControlTemplate><Border Background="Transparent"/></ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.DecreaseButton>
							<Track.IncreaseButton>
								<RepeatButton Name="PART_PageDownButton" Focusable="False">
									<RepeatButton.Template>
										<ControlTemplate><Border Background="Transparent"/></ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.IncreaseButton>
							<Thumb Name="thumb" MinHeight="28">
								<Thumb.Template>
									<ControlTemplate>
										<Border Width="8" Margin="1 0" CornerRadius="4"
										        Background="{DynamicResource BorderDefaultBrush}"/>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Track>
					</Grid>
				</ControlTemplate>
			</Setter>
		</Style>

		<Style Selector="ScrollBar:vertical /template/ Thumb:pointerover /template/ Border">
			<Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
		</Style>

		<!-- Общая панель окна: в неё убрано всё, что стоит между шапкой и нижней
		     строкой. Прежде список видов и колонка полей висели в окне порознь, и на
		     невысоком окне это читалось как оборванная вёрстка: карточки просто
		     кончались у нижнего края, ничем не подхваченные. -->
		<Style Selector="Border.shell">
			<Setter Property="Background"      Value="{DynamicResource BgBaseBrush}"/>
			<Setter Property="CornerRadius"    Value="12"/>
			<Setter Property="Padding"         Value="10"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<!-- Заголовок-переключатель примера: обычная строка, а не кнопка на вид.
		     Нажимается вся ширина, чтобы не целиться в стрелку. -->
		<Style Selector="Button.previewToggle">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.previewToggle:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="Button.previewToggle:pointerover PathIcon">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<Style Selector="Button.previewToggle PathIcon">
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
		</Style>

	</UserControl.Styles>

	<Grid>
		<!-- Затемнение плотное: под окном лежит книга, и просвечивающий сквозь
		     настройку текст мешает разглядеть то, что настраиваешь. -->
		<Border x:Name="Scrim" Background="#E0000000"/>

		<!-- Окно непрозрачно целиком: фон берётся у темы сплошным цветом.

		     По высоте оно тянется во весь свободный рост и упирается только в
		     потолок: полей у вида много, и при жёстких шестистах точках нижние
		     карточки уходили под обрез в любом окне, даже развёрнутом на весь
		     экран. Отступ в 24 точки остаётся с каждой стороны, поэтому в тесном
		     окне рамка не срезается, а окно просто становится ниже. -->
		<Border HorizontalAlignment="Center" VerticalAlignment="Stretch"
		        Margin="24" Width="760" MaxHeight="980" MinHeight="320"
		        Background="{DynamicResource BgAppBrush}"
		        BorderBrush="{DynamicResource BorderDefaultBrush}"
		        BorderThickness="1" CornerRadius="14" Padding="18">

			<DockPanel>

				<!-- Шапка -->
				<Grid DockPanel.Dock="Top" ColumnDefinitions="Auto Auto * Auto" Margin="0 0 0 12">
					<TextBlock Grid.Column="0" Text="Виды чтения"
					           FontSize="16" FontWeight="SemiBold"
					           VerticalAlignment="Center"
					           Foreground="{DynamicResource TextPrimaryBrush}"/>
					<Button Grid.Column="3" x:Name="CloseBtn" Classes="IconClose">
						<PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
						          Width="14" Height="14"/>
					</Button>
				</Grid>

				<!-- Низ -->
				<Grid DockPanel.Dock="Bottom" ColumnDefinitions="* Auto Auto" ColumnSpacing="8" Margin="0 14 0 0">
					<TextBlock Grid.Column="0" x:Name="FooterHint" Classes="Hint"
					           VerticalAlignment="Center"
					           Text="Изменения применяются к книге сразу; сохранятся при нажатии «Готово»."/>
					<Button Grid.Column="1" x:Name="CancelBtn" Classes="Dialog" Content="Отмена"/>
					<Button Grid.Column="2" x:Name="OkBtn" Classes="DialogAccent" Content="Готово"/>
				</Grid>

				<Border Classes="shell">
				<Grid ColumnDefinitions="240 12 *">

					<!-- ── Список видов ─────────────────────────────────── -->
					<Border Grid.Column="0" Classes="card" Padding="8">
						<DockPanel>
							<Grid DockPanel.Dock="Top" ColumnDefinitions="* Auto" Margin="4 2 4 8">
								<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
									<PathIcon Classes="cardGlyph" Data="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
									<TextBlock Classes="cardTitle" Text="Виды"/>
								</StackPanel>
								<Button Grid.Column="1" x:Name="AddBtn" Classes="mini" Padding="8 3"
								        behaviours:TooltipBehavior.Tip="Создать вид"
								        behaviours:TooltipBehavior.Description="Новый вид создаётся копией выбранного — от знакомой точки настраивать проще, чем от белого листа">
									<StackPanel Orientation="Horizontal" Spacing="4">
										<PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="12" Height="12"/>
										<TextBlock Text="Создать" FontSize="11"/>
									</StackPanel>
								</Button>
							</Grid>

							<ScrollViewer VerticalScrollBarVisibility="Auto"
							              AllowAutoHide="False"
							              HorizontalScrollBarVisibility="Disabled">
								<ItemsControl x:Name="ThemeList" Margin="0 0 12 0">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Classes="themeRow"
											        Classes.active="{Binding IsSelected}"
											        PointerPressed="OnThemeRowPressed"
											        Tag="{Binding}">
												<Grid ColumnDefinitions="Auto * Auto" ColumnSpacing="8">
													<!-- Кружок с цветами вида: лист и буква на нём -->
													<Border Grid.Column="0"
													        Width="26" Height="26"
													        CornerRadius="999"
													        Background="{Binding SheetBrush}"
													        BorderBrush="{DynamicResource BorderDefaultBrush}"
													        BorderThickness="1">
														<TextBlock Text="A" FontSize="12" FontWeight="SemiBold"
														           HorizontalAlignment="Center"
														           VerticalAlignment="Center"
														           Foreground="{Binding InkBrush}"/>
													</Border>

													<TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
													           VerticalAlignment="Center"
													           Foreground="{DynamicResource TextPrimaryBrush}"
													           TextTrimming="CharacterEllipsis"/>

													<!-- Где вид сохранён — значками, теми же, что у наборов
													     аватарок: замок у встроенного, папка у приложенного к
													     рукописи, глобус у общего для всех проектов. Вид может
													     лежать сразу в двух местах — тогда и значка два. -->
													<StackPanel Grid.Column="2" Orientation="Horizontal"
													            Spacing="4" VerticalAlignment="Center"
													            behaviours:TooltipBehavior.Tip="{Binding ScopeHint}">
														<PathIcon Width="13" Height="13"
														          IsVisible="{Binding IsBuiltIn}"
														          Foreground="{DynamicResource TextMutedBrush}"
														          Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10z"/>
														<PathIcon Width="13" Height="13"
														          IsVisible="{Binding IsLocalScope}"
														          Foreground="{DynamicResource SectionProjectFgBrush}"
														          Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
														<PathIcon Width="13" Height="13"
														          IsVisible="{Binding IsGlobalScope}"
														          Foreground="{DynamicResource SectionGlobalFgBrush}"
														          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
													</StackPanel>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</DockPanel>
					</Border>

					<!-- ── Правка выбранного вида ───────────────────────── -->
					<DockPanel Grid.Column="2">

						<!-- Пример вида.

						     Стоит внизу и с прокруткой не уезжает: настраивая цвет листа,
						     шрифт и свет, смотреть нужно на бумагу, а не искать её где-то
						     выше по списку полей. Порядок слоёв тот же, что и на странице:
						     цвет листа, картинка бумаги, буквы, свет поверх всего. -->
						<Border DockPanel.Dock="Bottom" Classes="card" Margin="0 10 0 0">
							<StackPanel Spacing="8">
								<!-- Заголовок сворачивает пример. Полей у вида много, и на невысоком
								     окне бумага съедает треть места; убрал — и список полей стал
								     длиннее ровно на её высоту. Прячется скольжением, а не рывком:
								     мгновенно исчезнувшая панель читается как поломка вёрстки. -->
								<Button x:Name="PreviewToggleBtn" Classes="previewToggle"
								        HorizontalAlignment="Stretch"
								        HorizontalContentAlignment="Stretch"
								        behaviours:TooltipBehavior.Tip="Свернуть пример"
								        behaviours:TooltipBehavior.Description="Бумага уезжает вниз, освобождая место под поля. Развернуть — тем же щелчком">
									<Grid ColumnDefinitions="Auto * Auto">
										<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
											<PathIcon Classes="cardGlyph" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
											<TextBlock Classes="cardTitle" Text="Пример"/>
										</StackPanel>
										<PathIcon Grid.Column="2" x:Name="PreviewChevron"
										          Width="9" Height="9"
										          VerticalAlignment="Center"
										          RenderTransformOrigin="50%,50%"
										          Data="M7 10l5 5 5-5z">
											<PathIcon.Transitions>
												<Transitions>
													<TransformOperationsTransition Property="RenderTransform"
													                               Duration="0:0:0.18"
													                               Easing="CubicEaseOut"/>
												</Transitions>
											</PathIcon.Transitions>
										</PathIcon>
									</Grid>
								</Button>

								<Border x:Name="PreviewFrame" Height="118" CornerRadius="8"
								        ClipToBounds="True"
								        BorderBrush="{DynamicResource BorderSubtleBrush}"
								        BorderThickness="1">
									<Border.Transitions>
										<Transitions>
											<DoubleTransition Property="Height" Duration="0:0:0.20"
											                  Easing="CubicEaseOut"/>
											<DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
										</Transitions>
									</Border.Transitions>
									<Grid>
										<!-- Поле вокруг книги. На настоящем экране его больше, чем
										     самой бумаги, и пример без него показывал вид наполовину:
										     заливка и картинка фона настраивались вслепую. -->
										<Border x:Name="PreviewBackdrop"/>
										<Border x:Name="PreviewBackdropImage" IsVisible="False"/>

										<!-- Лист лежит НА поле, с полями по бокам и тенью под ним —
										     как в книге. -->
										<Border x:Name="PreviewSheet"
										        Margin="30 9"
										        CornerRadius="2"
										        ClipToBounds="True"
										        BoxShadow="0 2 9 0 #40000000">
											<Grid>
												<Border x:Name="PreviewPaper"/>
												<Border x:Name="PreviewPaperImage" IsVisible="False"/>

												<StackPanel Margin="13 9" Spacing="3">
													<TextBlock x:Name="PreviewHead" Text="Глава первая"
													           FontSize="12" FontWeight="SemiBold"/>
													<TextBlock x:Name="PreviewBody" TextWrapping="Wrap"
													           FontSize="11" LineHeight="16"
													           Text="Он читал до рассвета, и строки ложились ровно так, как ложится свет от лампы: без резкости, без крика, ровным тёплым полем."/>
												</StackPanel>

												<!-- Рамка листа — поверх бумаги и букв, по самому краю листа. -->
												<Border x:Name="PreviewSheetFrame"
												        IsHitTestVisible="False"
												        IsVisible="False"
												        CornerRadius="2"
												        BorderThickness="1"/>
											</Grid>
										</Border>

										<!-- Свет ложится поверх всего — и поверх букв, и поверх поля,
										     ровно как в книге: сперва тёплая плёнка, затем приглушение. -->
										<Border x:Name="PreviewWarm" IsHitTestVisible="False"/>
										<Border x:Name="PreviewDim" IsHitTestVisible="False"/>
									</Grid>
								</Border>
							</StackPanel>
						</Border>

						<ScrollViewer x:Name="FieldsScroll"
						              VerticalScrollBarVisibility="Auto"
						              AllowAutoHide="False"
						              HorizontalScrollBarVisibility="Disabled">
							<StackPanel Spacing="10" Margin="0 0 10 2">

								<!-- Имя и область -->
								<Border Classes="card">
									<StackPanel Spacing="10">
										<Grid ColumnDefinitions="Auto Auto * Auto Auto" ColumnSpacing="6">
											<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
												<PathIcon Classes="cardGlyph" Data="M17.63 5.84C17.27 5.33 16.67 5 16 5L5 5.01C3.9 5.01 3 5.9 3 7v10c0 1.1.9 1.99 2 1.99L16 19c.67 0 1.27-.33 1.63-.84L22 12l-4.37-6.16z"/>
												<TextBlock Classes="FieldLabel" Text="Название"/>
											</StackPanel>
											<Button Grid.Column="3" x:Name="DuplicateBtn" Classes="iconAction"
											        behaviours:TooltipBehavior.Tip="Дублировать вид"
											        behaviours:TooltipBehavior.Description="Копия под новым именем. Встроенный вид иначе не изменить — его копию править можно">
												<PathIcon Width="13" Height="13"
												          Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
											</Button>
											<Button Grid.Column="4" x:Name="DeleteBtn" Classes="iconAction danger"
											        behaviours:TooltipBehavior.Tip="Удалить вид"
											        behaviours:TooltipBehavior.Description="Убирает вид из обеих областей. Встроенные виды удалить нельзя">
												<PathIcon Width="13" Height="13"
												          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
											</Button>
										</Grid>
										<TextBox x:Name="NameBox" Classes="Field" PlaceholderText="Например: Ночная тёплая"/>

										<Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>

										<Grid ColumnDefinitions="Auto Auto *" ColumnSpacing="6">
											<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Где хранить"/>
										</Grid>
										<!-- Область одна из двух, а не две галочки. Вид, лежащий сразу
										     в документе и в общих настройках, — это две его копии, которые
										     разойдутся при первой же правке одной из них. Кому нужен вид и
										     здесь, и всюду, делает дубль кнопкой рядом с названием: тогда
										     видно, что копий две, и какая из них какая. -->
										<Border Classes="scopeTrack" HorizontalAlignment="Left">
											<Panel>
												<Border x:Name="ScopeThumb" Classes="scopeThumb"/>
												<StackPanel Orientation="Horizontal">
													<Button x:Name="ScopeDocBtn" Classes="scope local" Content="Локально"/>
													<Button x:Name="ScopeGlobalBtn" Classes="scope global" Content="Глобально"/>
												</StackPanel>
											</Panel>
										</Border>
										<TextBlock x:Name="ScopeHint" Classes="Hint"
										           Text="Вид нигде не сохранён — включите хотя бы одну область."/>
									</StackPanel>
								</Border>

								<!-- Цвета -->
								<Border Classes="card">
									<StackPanel Spacing="10">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<PathIcon Classes="cardGlyph" Data="M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8z"/>
											<TextBlock Classes="cardTitle" Text="Цвета"/>
										</StackPanel>

										<!-- Три цвета в ряд: лист слева, рамка ровно посередине, текст
										     справа. Крайние колонки делят остаток поровну, поэтому
										     средняя стоит точно по центру карточки, какой бы ширины ни
										     были подписи по краям. -->
										<Grid ColumnDefinitions="* Auto *" ColumnSpacing="8">
											<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
											            HorizontalAlignment="Left">
												<TextBlock Classes="FieldLabel" Text="Лист" VerticalAlignment="Center"/>
												<ui:ColorPickerButton x:Name="SheetColorBtn"
												                      Width="26" Height="26"
												                      VerticalAlignment="Center"/>
											</StackPanel>

											<!-- Рамка листа: линия в пиксель вокруг страницы. «Без цвета»
											     в палитре — рамки нет, так у вида по умолчанию. -->
											<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
											            HorizontalAlignment="Center">
												<TextBlock Classes="FieldLabel" Text="Рамка" VerticalAlignment="Center"/>
												<infra:HintMark VerticalAlignment="Center"
												                behaviours:TooltipBehavior.Tip="Рамка листа"
												                behaviours:TooltipBehavior.Description="Линия в один пиксель вокруг страницы. «Без цвета» в палитре — рамки нет"/>
												<ui:ColorPickerButton x:Name="FrameColorBtn"
												                      Width="26" Height="26"
												                      VerticalAlignment="Center"/>
											</StackPanel>

											<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
											            HorizontalAlignment="Right">
												<TextBlock Classes="FieldLabel" Text="Текст" VerticalAlignment="Center"/>
												<ui:ColorPickerButton x:Name="InkColorBtn"
												                      Width="26" Height="26"
												                      VerticalAlignment="Center"/>
											</StackPanel>
										</Grid>
									</StackPanel>
								</Border>

								<!-- Свет. Гарнитуры здесь нет намеренно: вид один и тот же за
								     письмом и за чтением, и держит он только то, что не доедет
								     до печати — цвета, бумагу, поле. Начертание чтения живёт в
								     ленте чтения, рядом со ступенью размера: это поправка под
								     глаза, а не оформление книги. -->
								<Border Classes="card">
									<StackPanel Spacing="10">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<PathIcon Classes="cardGlyph" Data="M6.76 4.84l-1.8-1.79-1.41 1.41 1.79 1.79 1.42-1.41zM4 10.5H1v2h3v-2zm9-9.95h-2V3.5h2V.55zm7.45 3.91l-1.41-1.41-1.79 1.79 1.41 1.41 1.79-1.79zm-3.21 13.7l1.79 1.8 1.41-1.41-1.8-1.79-1.4 1.4zM20 10.5v2h3v-2h-3zm-8-5c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm-1 16.95h2V19.5h-2v2.95zm-7.45-3.91l1.41 1.41 1.79-1.8-1.41-1.41-1.79 1.8z"/>
											<TextBlock Classes="cardTitle" Text="Свет"/>
										</StackPanel>

										<Grid ColumnDefinitions="Auto Auto * Auto" ColumnSpacing="8" RowDefinitions="Auto Auto Auto" RowSpacing="6">
											<TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Яркость"/>
											<Slider Grid.Row="0" Grid.Column="2" x:Name="BrightnessSlider" Classes="Neat"
											        Minimum="35" Maximum="100"/>
											<TextBlock Grid.Row="0" Grid.Column="3" x:Name="BrightnessValue"
											           Classes="FieldLabel" Width="42" TextAlignment="Right"/>

											<TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Контраст"/>
											<Slider Grid.Row="1" Grid.Column="2" x:Name="ContrastSlider" Classes="Neat"
											        Minimum="60" Maximum="160"/>
											<TextBlock Grid.Row="1" Grid.Column="3" x:Name="ContrastValue"
											           Classes="FieldLabel" Width="42" TextAlignment="Right"/>

											<TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Теплота"/>
											<Slider Grid.Row="2" Grid.Column="2" x:Name="WarmthSlider" Classes="Neat"
											        Minimum="0" Maximum="100"/>
											<TextBlock Grid.Row="2" Grid.Column="3" x:Name="WarmthValue"
											           Classes="FieldLabel" Width="42" TextAlignment="Right"/>
										</Grid>
									</StackPanel>
								</Border>

								<!-- Картинка бумаги. Файлы можно бросить на всю карточку. -->
								<Border Classes="card" x:Name="PaperCard" DragDrop.AllowDrop="True">
									<StackPanel Spacing="10">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<PathIcon Classes="cardGlyph" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
											<TextBlock Classes="cardTitle" Text="Картинка бумаги"/>
										</StackPanel>

										<!-- Картинки бумаги. Их может быть сколько угодно: листы в
										     книге разные, и набор для того и заведён. Плитки
										     переставляются перетаскиванием, крестик убирает. -->
										<Grid ColumnDefinitions="* Auto" ColumnSpacing="6">
											<TextBlock Grid.Column="0" x:Name="PaperGalleryHint" Classes="Hint"
											           VerticalAlignment="Center"
											           Text="Картинок нет — лист заливается цветом. Перетащите картинки сюда или нажмите «Добавить»."/>
											<Button Grid.Column="1" x:Name="ClearImageBtn" Classes="iconAction danger"
											        behaviours:TooltipBehavior.Tip="Убрать все картинки"
											        behaviours:TooltipBehavior.Description="Набор очищается целиком, цвет листа остаётся">
												<PathIcon Width="13" Height="13"
												          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
											</Button>
										</Grid>

										<WrapPanel x:Name="PaperGallery" Orientation="Horizontal"/>

										<Grid ColumnDefinitions="Auto Auto *" ColumnSpacing="8"
										      x:Name="PaperFlowRow">
											<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Показывать"/>
											<infra:HintMark Grid.Column="1" VerticalAlignment="Center"
											                behaviours:TooltipBehavior.Tip="Как разбирать набор"
											                behaviours:TooltipBehavior.Description="Одну — всегда первая картинка набора. По очереди — каждый следующий лист берёт следующую, по кругу. Вразнобой — лист берёт свою картинку по жребию, но всегда одну и ту же: один и тот же лист обязан выглядеть одинаково, сколько бы раз к нему ни вернулись"/>
											<ComboBox Grid.Column="2" x:Name="PaperFlowCombo"
											          MinWidth="150" FontSize="12"/>
										</Grid>

										<!-- Появляется только когда с картинкой что-то не так (см. UpdateImageInfo). -->
										<TextBlock x:Name="ImageInfoText" Classes="Hint"
										           IsVisible="False"/>

										<Grid ColumnDefinitions="Auto Auto * Auto" ColumnSpacing="8">
											<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Плотность"/>
											<infra:HintMark Grid.Column="1" VerticalAlignment="Center"
											                behaviours:TooltipBehavior.Tip="Плотность картинки"
											                behaviours:TooltipBehavior.Description="Насколько картинка перекрывает цвет листа. Для текстуры бумаги обычно хватает трети — иначе она спорит с текстом"/>
											<Slider Grid.Column="2" x:Name="OpacitySlider" Classes="Neat"
											        Minimum="0" Maximum="100"/>
											<TextBlock Grid.Column="3" x:Name="OpacityValue" Classes="FieldLabel"
											           Width="42" TextAlignment="Right"/>
										</Grid>

										<StackPanel Orientation="Horizontal" Spacing="6">
											<CheckBox x:Name="TileCheck" FontSize="12"
											          Content="Замостить вместо растягивания"/>
											<infra:HintMark VerticalAlignment="Center"
											                behaviours:TooltipBehavior.Tip="Замостить"
											                behaviours:TooltipBehavior.Description="Картинка повторяется в своём размере вместо растягивания на весь лист. Для мелкой текстуры — единственный годный способ: растянутая мелкая картинка превращается в мыло"/>
										</StackPanel>
									</StackPanel>
								</Border>

								<!-- Поле вокруг книги.

								     Отдельной подсекцией: у поля своя заливка и своя картинка,
								     и в карточке цветов это была бы строка из шести полей.

								     Своих видов заливки нет намеренно: градиенты уже есть у
								     цветов, и поле принимает выбранное значение как есть. -->
								<Border Classes="card" x:Name="BackCard" DragDrop.AllowDrop="True">
									<StackPanel Spacing="10">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<PathIcon Classes="cardGlyph" Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
											<TextBlock Classes="cardTitle" Text="Фон вокруг книги"/>
										</StackPanel>

										<Grid ColumnDefinitions="Auto Auto Auto * Auto" ColumnSpacing="8">
											<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Заливка"/>
											<ui:ColorPickerButton Grid.Column="1" x:Name="BackColorBtn"
											                      Width="26" Height="26"
											                      VerticalAlignment="Center"/>
											<Button Grid.Column="4" x:Name="BackResetBtn" Classes="mini"
											        Content="От бумаги"/>
										</Grid>

										<!-- Картинки поля. Набор, а не одна: собирается он так же,
										     как у бумаги, но на экране показывается первая — разным
										     картинкам на одном поле взяться неоткуда. Первой картинку
										     делает перетаскивание или пункт меню по правой кнопке. -->
										<Grid ColumnDefinitions="* Auto" ColumnSpacing="6">
											<TextBlock Grid.Column="0" x:Name="BackGalleryHint" Classes="Hint"
											           VerticalAlignment="Center"
											           Text="Картинки нет — поле заливается цветом. Перетащите картинки сюда или нажмите «Добавить»."/>
											<Button Grid.Column="1" x:Name="BackClearImageBtn" Classes="iconAction danger"
											        behaviours:TooltipBehavior.Tip="Убрать все картинки"
											        behaviours:TooltipBehavior.Description="Набор очищается целиком, заливка вида остаётся">
												<PathIcon Width="13" Height="13"
												          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
											</Button>
										</Grid>

										<WrapPanel x:Name="BackGallery" Orientation="Horizontal"/>

										<Grid ColumnDefinitions="Auto Auto Auto * Auto" ColumnSpacing="8">
											<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Как лечь"/>
											<ComboBox Grid.Column="1" x:Name="BackFitCombo"
											          MinWidth="130" FontSize="12"/>
											<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Плотность"/>
											<Slider Grid.Column="3" x:Name="BackOpacitySlider" Classes="Neat"
											        Minimum="0" Maximum="100"/>
											<TextBlock Grid.Column="4" x:Name="BackOpacityValue" Classes="FieldLabel"
											           Width="42" TextAlignment="Right"/>
										</Grid>
									</StackPanel>
								</Border>

								<!-- Только при правке.
								     Отдельным разделом внизу, потому что всё в нём про рабочее
								     место, а не про книгу: в чтении нет ни каретки, ни линейки,
								     ни позиций табуляции, и ни один из этих цветов туда не
								     доедет. Пусто в поле — цвет выводится из бумаги и чернил,
								     как и раньше; кнопка рядом возвращает вывод обратно. -->
								<Border Classes="card">
									<StackPanel Spacing="10">
										<!-- Пояснения раздела — в значке у заголовка, а не строками текста:
										     в карточке остаются только сами цвета. -->
										<StackPanel Orientation="Horizontal" Spacing="6">
											<PathIcon Classes="cardGlyph" Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
											<TextBlock Classes="cardTitle" Text="Только при правке"/>
											<infra:HintMark VerticalAlignment="Center"
											                behaviours:TooltipBehavior.Tip="Только при правке"
											                behaviours:TooltipBehavior.Description="Каретка, линейка и позиции табуляции. В чтении ничего этого нет — на книгу эти цвета не влияют"/>
										</StackPanel>

										<Grid ColumnDefinitions="Auto Auto Auto *"
										      RowDefinitions="Auto Auto Auto Auto Auto"
										      ColumnSpacing="8" RowSpacing="8">
											<TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Каретка"/>
											<ui:ColorPickerButton Grid.Row="0" Grid.Column="1" x:Name="CaretColorBtn"
											                      Width="26" Height="26"
											                      VerticalAlignment="Center"/>
											<Button Grid.Row="0" Grid.Column="2" x:Name="CaretResetBtn" Classes="mini"
											        Padding="8 3" Content="Как текст"
											        VerticalAlignment="Center"/>

											<TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Полоса линейки"/>
											<ui:ColorPickerButton Grid.Row="1" Grid.Column="1" x:Name="RulerSheetColorBtn"
											                      Width="26" Height="26"
											                      VerticalAlignment="Center"/>
											<Button Grid.Row="1" Grid.Column="2" x:Name="RulerSheetResetBtn" Classes="mini"
											        Padding="8 3" Content="Как бумага"
											        VerticalAlignment="Center"/>

											<TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Деления и цифры"/>
											<ui:ColorPickerButton Grid.Row="2" Grid.Column="1" x:Name="RulerInkColorBtn"
											                      Width="26" Height="26"
											                      VerticalAlignment="Center"/>
											<Button Grid.Row="2" Grid.Column="2" x:Name="RulerInkResetBtn" Classes="mini"
											        Padding="8 3" Content="Как текст"
											        VerticalAlignment="Center"/>

											<TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="За краем листа"/>
											<ui:ColorPickerButton Grid.Row="3" Grid.Column="1" x:Name="RulerFieldColorBtn"
											                      Width="26" Height="26"
											                      VerticalAlignment="Center"/>
											<Button Grid.Row="3" Grid.Column="2" x:Name="RulerFieldResetBtn" Classes="mini"
											        Padding="8 3" Content="Как поле"
											        VerticalAlignment="Center"/>

											<StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="6">
												<TextBlock Classes="FieldLabel" Text="Табуляция"/>
												<infra:HintMark VerticalAlignment="Center"
												                behaviours:TooltipBehavior.Tip="Табуляция"
												                behaviours:TooltipBehavior.Description="Засечки позиций табуляции на линейке и квадрат в её углу, которым выбирают тип позиции"/>
											</StackPanel>
											<ui:ColorPickerButton Grid.Row="4" Grid.Column="1" x:Name="TabMarkColorBtn"
											                      Width="26" Height="26"
											                      VerticalAlignment="Center"/>
											<Button Grid.Row="4" Grid.Column="2" x:Name="TabMarkResetBtn" Classes="mini"
											        Padding="8 3" Content="Обычный"
											        VerticalAlignment="Center"/>
										</Grid>
									</StackPanel>
								</Border>

							</StackPanel>
						</ScrollViewer>
					</DockPanel>
				</Grid>
				</Border>
			</DockPanel>
		</Border>

		<!-- Призрак переносимой картинки набора — как у галереи персонажа:
		     системное перетаскивание забирает указатель и своего превью не
		     рисует, поэтому плитка переносится вручную, а под курсором летит эта
		     копия. Холст накрывает всё окно: координаты призрака считаются от
		     него самого. -->
		<Canvas x:Name="GalleryGhostCanvas"
		        IsVisible="False"
		        IsHitTestVisible="False">
			<Border x:Name="GalleryGhost"
			        Width="74" Height="52"
			        CornerRadius="4"
			        ClipToBounds="True"
			        Opacity="0.85"
			        BorderBrush="{DynamicResource AccentDefaultBrush}"
			        BorderThickness="2"/>
		</Canvas>
	</Grid>
</UserControl>
