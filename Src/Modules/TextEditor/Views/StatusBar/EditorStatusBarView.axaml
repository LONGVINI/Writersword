<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.StatusBar"
             xmlns:converters="using:Writersword.Modules.TextEditor.Converters"
             xmlns:loc="using:Writersword.Modules.TextEditor.Resources"
             xmlns:sb="using:Writersword.Modules.TextEditor.Views.StatusBar"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             x:Class="Writersword.Modules.TextEditor.Views.StatusBar.EditorStatusBarView"
             x:DataType="vm:StatusBarViewModel"
             Height="30">

	<UserControl.Styles>
		<Style Selector="Button.ViewModeBtn">
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding"         Value="5 2"/>
			<Setter Property="CornerRadius"    Value="3"/>
			<Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="Button.ViewModeBtn Viewbox">
			<Setter Property="Opacity" Value="0.55"/>
		</Style>
		<Style Selector="Button.ViewModeBtn.Active">
			<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Foreground" Value="#242424"/>
		</Style>
		<Style Selector="Button.ViewModeBtn.Active Viewbox">
			<Setter Property="Opacity" Value="1.0"/>
		</Style>
		<Style Selector="Button.ViewModeBtn:pointerover">
			<Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
		</Style>
		<Style Selector="Button.ViewModeBtn:pointerover Viewbox">
			<Setter Property="Opacity" Value="1.0"/>
		</Style>
		<Style Selector="Button.FitSizeBtn">
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush"     Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Padding"         Value="5 1"/>
			<Setter Property="FontSize"        Value="10"/>
			<Setter Property="Foreground"      Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="CornerRadius"    Value="2"/>
			<Setter Property="Cursor"          Value="Hand"/>
		</Style>
		<Style Selector="Button.FitSizeBtn:pointerover">
			<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</UserControl.Styles>

	<Border Background="{DynamicResource StatusBarBackground}"
            BorderBrush="{DynamicResource StatusBarBorder}"
            BorderThickness="0 1 0 0">

		<Grid ColumnDefinitions="* Auto">

			<StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="8 0"
                        VerticalAlignment="Center">

				<StackPanel Orientation="Horizontal" Spacing="4">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Status_Page}"
                               FontSize="11"
                               Foreground="{DynamicResource StatusBarForeground}"/>
					<TextBlock FontSize="11" Foreground="{DynamicResource StatusBarForeground}">
						<TextBlock.Text>
							<MultiBinding StringFormat="{}{0} / {1}">
								<Binding Path="CurrentPage"/>
								<Binding Path="PageCount"/>
							</MultiBinding>
						</TextBlock.Text>
					</TextBlock>
				</StackPanel>

				<Separator Width="1" Height="12" Background="{DynamicResource StatusBarSeparator}"/>

				<StackPanel Orientation="Horizontal" Spacing="4">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Status_Words}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
					<TextBlock Text="{Binding WordCount}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
				</StackPanel>

				<Separator Width="1" Height="12" Background="{DynamicResource StatusBarSeparator}"/>

				<StackPanel Orientation="Horizontal" Spacing="4">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Status_Chars}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
					<TextBlock Text="{Binding CharCount}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
				</StackPanel>

				<Separator Width="1" Height="12" Background="{DynamicResource StatusBarSeparator}"/>

				<StackPanel Orientation="Horizontal" Spacing="4">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Status_Paragraphs}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
					<TextBlock Text="{Binding ParagraphCount}"
                               FontSize="11" Foreground="{DynamicResource StatusBarForeground}"/>
				</StackPanel>

				<Separator Width="1" Height="12" Background="{DynamicResource StatusBarSeparator}"/>

				<TextBlock Text="{Binding Language}"
                           FontSize="11"
                           Foreground="{DynamicResource StatusBarForeground}"
                           VerticalAlignment="Center"/>

				<Border IsVisible="{Binding IsSpellCheckActive}"
                        Background="{DynamicResource AccentDefaultBrush}"
                        CornerRadius="2" Padding="4 1">
					<TextBlock Text="{x:Static loc:TextEditorStrings.SpellCheck_Active}"
                               FontSize="10" Foreground="White"/>
				</Border>

				<Border IsVisible="{Binding IsReadOnly}"
                        Background="{DynamicResource WarningColor}"
                        CornerRadius="2" Padding="4 1">
					<TextBlock Text="{x:Static loc:TextEditorStrings.Editor_ReadOnly}"
                               FontSize="10" Foreground="White"/>
				</Border>

			</StackPanel>

			<StackPanel Grid.Column="1"
						Orientation="Horizontal"
						Spacing="0"
						Margin="0 0 8 0"
						MinWidth="260"
						VerticalAlignment="Center">

				<Border CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource StatusBarSeparator}"
                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                        Margin="0 0 6 0"
                        Padding="2 0"
                        Cursor="Hand">
					<StackPanel Orientation="Horizontal" Spacing="0">

						<Button Classes="ViewModeBtn"
                                Classes.Active="{Binding IsSinglePageMode}"
                                Command="{Binding SetPageModeCommand}"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.View_PageMode}">
							<Viewbox Width="14" Height="14">
								<Canvas Width="16" Height="16">
									<Path Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.3"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Fill="Transparent"
                                          Data="M 3,1 L 10,1 L 13,4 L 13,15 L 3,15 Z M 10,1 L 10,4 L 13,4 M 5,7 L 11,7 M 5,9.5 L 11,9.5 M 5,12 L 9,12"/>
								</Canvas>
							</Viewbox>
						</Button>

						<Button Classes="ViewModeBtn"
                                Classes.Active="{Binding IsTwoPagesMode}"
                                Command="{Binding SetTwoPagesModeCommand}"
                                behaviours:TooltipBehavior.Tip="Две страницы рядом">
							<Viewbox Width="14" Height="14">
								<Canvas Width="16" Height="16">
									<Path Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.3"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Fill="Transparent"
                                          Data="M 1.5,2.5 L 7,2.5 L 7,13.5 L 1.5,13.5 Z M 9,2.5 L 14.5,2.5 L 14.5,13.5 L 9,13.5 Z M 3,5.5 L 5.5,5.5 M 3,8 L 5.5,8 M 10.5,5.5 L 13,5.5 M 10.5,8 L 13,8"/>
								</Canvas>
							</Viewbox>
						</Button>

						<Button Classes="ViewModeBtn"
                                Classes.Active="{Binding IsDraftMode}"
                                Command="{Binding SetDraftModeCommand}"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.View_DraftMode}">
							<Viewbox Width="14" Height="14">
								<Canvas Width="16" Height="16">
									<Path Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          Data="M 2,4 L 14,4 M 2,8 L 14,8 M 2,12 L 10,12"/>
								</Canvas>
							</Viewbox>
						</Button>

						<Button Classes="ViewModeBtn"
                                Classes.Active="{Binding IsWebMode}"
                                Command="{Binding SetWebModeCommand}"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.View_WebMode}">
							<Viewbox Width="14" Height="14">
								<Canvas Width="16" Height="16">
									<Path Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.3"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          Data="M 8,2 A 6,6 0 1 0 8.001,2 Z M 2,8 L 14,8 M 6,2.5 C 4.5,5 4.5,11 6,13.5 M 10,2.5 C 11.5,5 11.5,11 10,13.5"/>
								</Canvas>
							</Viewbox>
						</Button>

						<Button Classes="ViewModeBtn"
                                Classes.Active="{Binding IsReadingMode}"
                                Command="{Binding SetReadingModeCommand}"
                                behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.View_ReadingMode}">
							<Viewbox Width="14" Height="14">
								<Canvas Width="16" Height="16">
									<Path Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.3"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Fill="Transparent"
                                          Data="M 8,13 L 8,3 M 8,13 L 14,11.5 L 14,2.5 L 8,4 Z M 8,13 L 2,11.5 L 2,2.5 L 8,4 Z"/>
								</Canvas>
							</Viewbox>
						</Button>

					</StackPanel>
				</Border>

				<Button Classes="FitSizeBtn"
                        IsVisible="{Binding HasRecommendedZoom}"
                        Command="{Binding FitToPhysicalSizeCommand}"
                        Margin="0 0 4 0"
                        VerticalAlignment="Center"
                        behaviours:TooltipBehavior.Tip="{x:Static loc:TextEditorStrings.Status_FitToPhysicalSize}">
					<TextBlock Text="{Binding RecommendedZoomPercent, StringFormat='{}{0}%'}"/>
				</Button>

				<!-- ТЕСТОВАЯ КНОПКА -->
				<Button behaviours:TooltipBehavior.Tip="Режим страницы"
						behaviours:TooltipBehavior.Description="Отображает документ постранично как при печати"
						behaviours:TooltipBehavior.HotKeyId="HotKey_Edit_Undo"
						behaviours:TooltipBehavior.PreviewPath="avares://Writersword/Resources/Images/TestImages/test_033_1400x787_anim.gif"
						Margin="4 0"
						FontSize="11">
					Тест
				</Button>
				<!-- КОНЕЦ ТЕСТОВАЯ КНОПКА -->
				
				<TextBox Name="ZoomTextBox"
						 FontSize="12"
						 Foreground="{DynamicResource StatusBarForeground}"
						 Background="Transparent"
						 BorderThickness="0"
						 BorderBrush="Transparent"
						 Padding="0"
						 Width="38"
						 Height="18"
						 VerticalAlignment="Center"
						 VerticalContentAlignment="Center"
						 TextAlignment="Center"
						 Margin="0 0 4 0"
						 Text="{Binding ZoomPercent, Mode=OneWay, StringFormat={}{0}%}"/>

				<sb:ZoomSlider Minimum="25"
							   Maximum="500"
							   Value="{Binding Zoom,
                   Converter={x:Static converters:ZoomPercentConverter.Instance},
                   Mode=TwoWay}"
							   VerticalAlignment="Center"/>
			</StackPanel>

		</Grid>
	</Border>

</UserControl>