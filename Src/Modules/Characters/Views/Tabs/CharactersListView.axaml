<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Characters.ViewModels"
             xmlns:res="using:Writersword.Src.Modules.Characters.Resources"
             xmlns:controls="using:Writersword.Modules.Characters.Controls"
             xmlns:colorControls="using:Writersword.Styles.UserControls"
             xmlns:loc="using:Writersword.Src.Modules.Characters.Resources"
             xmlns:enums="using:Writersword.Modules.Characters.Models.Enums"
             xmlns:models="using:Writersword.Modules.Characters.Models"
             xmlns:conv="using:Writersword.Modules.Characters.Converters"
             xmlns:behaviors="using:Writersword.Infrastructure.Behaviours"
             xmlns:infra="using:Writersword.Infrastructure.Controls"
             xmlns:icv="using:Writersword.Infrastructure.Converters"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             x:Class="Writersword.Modules.Characters.Views.Tabs.CharactersListView"
             x:DataType="vm:CharactersViewModel">

    <UserControl.Resources>
        <conv:IntIsZeroConverter x:Key="IntIsZeroConverter"/>
    </UserControl.Resources>

    <!-- Стили карточек вынесены из шаблона на уровень вью: стили, объявленные
         внутри DataTemplate, создаются заново для каждой карточки (свой набор
         Style и Transitions на каждый экземпляр из сотен), а здесь существуют
         в одном экземпляре и применяются селекторами точно так же. -->
    <UserControl.Styles>
        <!-- Карточка «взята»: приподнимаем тенью при зажатии. -->
        <Style Selector="Border.card-root.picked">
            <Setter Property="BoxShadow" Value="0 0 16 2 #99FFFFFF"/>
            <Setter Property="ZIndex" Value="20"/>
        </Style>
        <!-- При наведении карточка слегка приподнимается — видно, что её можно двигать. -->
        <Style Selector="Border.card-root:pointerover">
            <Setter Property="BoxShadow" Value="0 0 10 1 #55FFFFFF"/>
            <Setter Property="ZIndex" Value="10"/>
        </Style>
        <!-- Кнопки edit/delete появляются только при наведении. Это освобождает
             пространство в маленьких карточках и улучшает UX. -->
        <Style Selector="Border.card-root StackPanel.card-edit-btns">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card-root:pointerover StackPanel.card-edit-btns">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Закладка группы гаснет при наведении — уступает место
             кнопкам правки/удаления, чтобы не перекрывать их. -->
        <Style Selector="Border.card-root Path.group-bookmark">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card-root:pointerover Path.group-bookmark">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <!-- Цветопикер тоже только при наведении на карточку. -->
        <Style Selector="Border.card-root colorControls|ColorPickerButton">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card-root:pointerover colorControls|ColorPickerButton">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Шестерёнка настроек карточки — тоже только при наведении. -->
        <Style Selector="Border.card-root Button.card-cfg">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card-root:pointerover Button.card-cfg">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- «Плоские» кнопки: без подсветки фона при наведении и нажатии.
             Заменяет одинаковые инлайновые Button.Styles в шаблонах карточки
             и заголовка папки. -->
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.flat:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Круговой ободок аватара при наведении на кнопку-кружок. -->
        <Style Selector="Button.avatar-btn:pointerover Border.avatar-ring">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Кнопки-иконки в шапке папки (комментарий, удаление, сворачивание):
             ровный скруглённый ховер-фон вокруг иконки, единый вид. -->
        <Style Selector="Button.folder-hdr-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.folder-hdr-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
        <Style Selector="Button.folder-hdr-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                <TextBox Grid.Column="0"
                         x:Name="SearchTextBox"
                         Text="{ReflectionBinding SearchQuery}"
                         PlaceholderText="{x:Static loc:CharactersStrings.Search_Placeholder}"
                         FontSize="12"
                         Background="{DynamicResource BgSurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderDefaultBrush}"
                         BorderThickness="1" CornerRadius="6" Padding="7,4"
                         behaviors:ClickOutsideBehavior.Command="{ReflectionBinding UnfocusSearchCommand}"/>

                <Button Grid.Column="1"
                        Command="{ReflectionBinding CreateFolderCommand}"
                        Margin="6,0,0,0" Padding="8,4"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="6"
                        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Folder_CreateButton}"
                        behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Folder_CreateTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                  Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{x:Static loc:CharactersStrings.Folder_CreateButton}"
                                   FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Сравнение показанных: фильтр и поиск уже сделали выбор,
                     второй механизм выделения заводить незачем. -->
                <Button Grid.Column="3"
                        Content="{x:Static loc:CharactersStrings.Compare_Button}"
                        Click="OnCompareClick"
                        Margin="4,0,0,0" Padding="8,4"
                        FontSize="12"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="6"
                        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Compare_Button}"
                        behaviours:TooltipBehavior.Description="{x:Static loc:CharactersStrings.Compare_Hint}"/>

                <!-- выбор режима отображения: список / размеры плиток -->
                <ComboBox Grid.Column="2"
                          SelectedIndex="{ReflectionBinding ViewModeIndex}"
                          Margin="4,0,0,0"
                          Padding="7,4"
                          FontSize="12"
                          MinWidth="100"
                          Background="{DynamicResource BgSurfaceBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}"
                          BorderThickness="1"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.ViewMode_Tooltip}">
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"
                                      Width="12" Height="12" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{x:Static loc:CharactersStrings.ViewMode_List}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M3 3h8v8H3zm0 10h8v8H3zm10-10h8v8h-8zm0 10h8v8h-8z"
                                      Width="10" Height="10" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{x:Static loc:CharactersStrings.ViewMode_Small}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M3 3h8v8H3zm0 10h8v8H3zm10-10h8v8h-8zm0 10h8v8h-8z"
                                      Width="12" Height="12" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{x:Static loc:CharactersStrings.ViewMode_Medium}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M3 3h8v8H3zm0 10h8v8H3zm10-10h8v8h-8zm0 10h8v8h-8z"
                                      Width="14" Height="14" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{x:Static loc:CharactersStrings.ViewMode_Large}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M3 3h8v8H3zm0 10h8v8H3zm10-10h8v8h-8zm0 10h8v8h-8z"
                                      Width="16" Height="16" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{x:Static loc:CharactersStrings.ViewMode_Huge}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

            </Grid>
        </Border>

        <!-- список папок и карточек -->
        <Panel Grid.Row="1">
            <ScrollViewer Focusable="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Visible">
                <StackPanel>

                    <TextBlock Text="{x:Static loc:CharactersStrings.Placeholder_NoCharacters}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="32,32" TextWrapping="Wrap" TextAlignment="Center"
                               IsVisible="{Binding Folders.Count, Converter={StaticResource IntIsZeroConverter}}"/>

                    <ItemsControl x:Name="FoldersContainer" ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CharacterFolderViewModel">
                                <StackPanel Margin="0,0,0,4">

                                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="0,0,0,1"
                                            Background="{DynamicResource BgPanelBrush}">
                                        <Panel>
                                            <Border IsVisible="{Binding IsSelected}" Background="#22FFFFFF"/>
                                            <Border IsVisible="{Binding IsDragOver}"
                                                    Background="#22FFFFFF"
                                                    BorderBrush="{DynamicResource AccentDefaultBrush}"
                                                    BorderThickness="0,0,0,2"/>
                                            <Grid MinHeight="36" Margin="0,0,16,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <colorControls:ColorPickerButton
                                                    Grid.Column="0"
                                                    HexColor="{Binding Color, Mode=TwoWay}"
                                                    Margin="12,0,8,0"
                                                    VerticalAlignment="Center"/>

                                                <controls:CharactersFolderHeaderPanel Grid.Column="1"
                                                                              LeftMinWidth="55"
                                                                              RightMinWidth="90"
                                                                              LeftPreferredWidth="260"
                                                                              RightPreferredWidth="210">
                                                    <Panel Margin="0,0,12,0" ClipToBounds="True">
                                                        <Button Classes="flat"
                                                                Command="{Binding SelectOrRenameCommand}"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="0" VerticalAlignment="Center"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                IsVisible="{Binding !IsRenaming}">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding Name}"
                                                                       ToolTip.ShowDelay="500"/>
                                                        </Button>
                                                        <TextBox Name="FolderRenameBox"
                                                                 Text="{ReflectionBinding Name}"
                                                                 FontSize="13" FontWeight="SemiBold"
                                                                 Padding="4,2,16,2"
                                                                 VerticalAlignment="Center"
                                                                 IsVisible="{Binding IsRenaming}"
                                                                 behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsRenaming}"
                                                                 behaviors:ClickOutsideBehavior.Command="{ReflectionBinding ConfirmRenameCommand}"/>
                                                    </Panel>

                                                    <Grid Margin="8,0,8,0">
                                                        <Button Classes="folder-hdr-btn"
                                                                Command="{Binding StartEditCommentCommand}"
                                                                Padding="4"
                                                                HorizontalAlignment="Right"
                                                                ToolTip.Tip="{x:Static loc:CharactersStrings.Folder_CommentTooltip}"
                                                                IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                            <PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                                                                      Width="12" Height="12"
                                                                      Foreground="{DynamicResource TextMutedBrush}"
                                                                      Opacity="0.4"/>
                                                        </Button>
                                                        <Button Classes="flat"
                                                                Command="{Binding StartEditCommentCommand}"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="0" VerticalAlignment="Center"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <TextBlock Text="{Binding Comment}"
                                                                       FontSize="11" FontStyle="Italic"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding Comment}"
                                                                       ToolTip.ShowDelay="500"/>
                                                        </Button>
                                                        <infra:ItalicCaretTextBox Name="FolderCommentBox"
                                                             Classes="italic"
                                                             Text="{ReflectionBinding Comment}"
                                                             FontStyle="Italic"
                                                             PlaceholderText="{x:Static loc:CharactersStrings.Folder_CommentPlaceholder}"
                                                             Padding="4,2,4,2"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding IsEditingComment}"
                                                             behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsEditingComment}"
                                                             behaviors:ClickOutsideBehavior.Command="{ReflectionBinding ConfirmCommentCommand}"/>
                                                    </Grid>
                                                </controls:CharactersFolderHeaderPanel>

                                                <Grid Grid.Column="2"
                                                      ColumnDefinitions="Auto,Auto,Auto"
                                                      VerticalAlignment="Center">
                                                    <Button Grid.Column="0"
                                                            Classes="folder-hdr-btn"
                                                            Command="{Binding RequestDeleteCommand}"
                                                            Padding="8"
                                                            IsVisible="{Binding !IsUngrouped}"
                                                            ToolTip.Tip="{x:Static loc:CharactersStrings.Folder_DeleteTooltip}">
                                                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                                  Width="13" Height="13"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Button>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Count}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               MinWidth="20"
                                                               TextAlignment="Center"/>
                                                    <Button Grid.Column="2"
                                                            Classes="folder-hdr-btn"
                                                            Command="{Binding ToggleExpandCommand}"
                                                            Padding="6,4" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding IsExpanded, Converter={x:Static conv:BoolToCollapseArrowConverter.Instance}}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Panel>
                                    </Border>

                                    <!-- карточки персонажей -->
                                    <!-- PerfItemsRepeater — временная замена ItemsRepeater
                                         с замером времени Measure/Arrange (диагностика лагов).
                                         Вернуть ItemsRepeater после расследования. -->
                                    <controls:PerfItemsRepeater ItemsSource="{Binding VisibleCharacters}"
                                                   IsVisible="{Binding IsExpanded}"
                                                   Margin="12,8">
                                            <controls:PerfItemsRepeater.Layout>
                                                <UniformGridLayout MaximumRowsOrColumns="20"
                                                                   MinItemWidth="152"
                                                                   MinColumnSpacing="0"
                                                                   MinRowSpacing="0"
                                                                   ItemsStretch="Fill"/>
                                            </controls:PerfItemsRepeater.Layout>
                                            <controls:PerfItemsRepeater.ItemTemplate>
                                                <DataTemplate DataType="vm:CharacterListItemViewModel">

                                                    <Border Classes="card-root"
                                                            CornerRadius="10"
                                                            Background="{DynamicResource BgPanelBrush}"
                                                            BorderBrush="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
                                                            BorderThickness="{Binding CardBorderThickness}"
                                                            ClipToBounds="False"
                                                            Margin="6"
                                                            Cursor="Hand"
                                                            Opacity="{Binding DragOpacity}"
                                                            IsHitTestVisible="{Binding !IsDragging}">

                                                        <!-- Стили hover карточки объявлены на уровне UserControl
                                                             (UserControl.Styles) — один экземпляр на весь список
                                                             вместо копии на каждую карточку. -->

                                                        <Border.RenderTransform>
                                                            <TranslateTransform>
                                                                <TranslateTransform.Transitions>
                                                                    <Transitions>
                                                                        <DoubleTransition Property="X"
                                                                                          Duration="0:0:0.28"
                                                                                          Easing="CubicEaseOut"/>
                                                                        <DoubleTransition Property="Y"
                                                                                          Duration="0:0:0.28"
                                                                                          Easing="CubicEaseOut"/>
                                                                    </Transitions>
                                                                </TranslateTransform.Transitions>
                                                            </TranslateTransform>
                                                        </Border.RenderTransform>

                                                        <Panel>

                                                        <!-- Эффект Dim (у «Мёртв» и любых пользовательских меток):
                                                             затемнение карточки — усилитель; носитель смысла —
                                                             бейдж-череп или значок метки. Слой не перехватывает
                                                             клики. -->
                                                        <Border ZIndex="7"
                                                                IsVisible="{Binding HasDimEffect}"
                                                                IsHitTestVisible="False"
                                                                Background="#59000000"
                                                                CornerRadius="9"/>
                                                        <!-- Череп, а не крестик: крестиком в интерфейсе обозначается
                                                             удаление, и бейдж читался как кнопка «убрать». -->
                                                        <Border ZIndex="8"
                                                                IsVisible="{Binding IsDead}"
                                                                IsHitTestVisible="False"
                                                                Width="18" Height="18"
                                                                CornerRadius="9"
                                                                Background="#CC202020"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Margin="8">
                                                            <Path Data="M12,2C7.03,2 3,6.03 3,11c0,2.85 1.34,5.38 3.42,7.02V21c0,0.55 0.45,1 1,1h1.5v-2h2v2h2v-2h2v2H16c0.55,0 1,-0.45 1,-1v-2.98C19.66,16.38 21,13.85 21,11C21,6.03 16.97,2 12,2zM8.5,13C7.67,13 7,12.33 7,11.5C7,10.67 7.67,10 8.5,10s1.5,0.67 1.5,1.5C10,12.33 9.33,13 8.5,13zM15.5,13c-0.83,0 -1.5,-0.67 -1.5,-1.5c0,-0.83 0.67,-1.5 1.5,-1.5s1.5,0.67 1.5,1.5C17,12.33 16.33,13 15.5,13z"
                                                                  Fill="#FF5252"
                                                                  Stretch="Uniform"
                                                                  Margin="3"/>
                                                        </Border>

                                                        <!-- Метки персонажа: значки первых меток (порядок задаёт
                                                             пользователь) + «+N» для остальных. Полный набор виден
                                                             в карточке; подсказка на значке — имя метки. -->
                                                        <StackPanel ZIndex="8"
                                                                    Orientation="Horizontal"
                                                                    Spacing="3"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Bottom"
                                                                    Margin="8,0,0,8">
                                                            <ItemsControl ItemsSource="{Binding CardLabels}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:CharacterLabel">
                                                                        <Border Width="16" Height="16"
                                                                                CornerRadius="8"
                                                                                ClipToBounds="True"
                                                                                Background="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
                                                                                ToolTip.Tip="{Binding Name}">
                                                                            <!-- Своя картинка метки, если автор её задал. -->
                                                                            <Panel>
                                                                                <Path Data="{Binding Icon, Converter={x:Static conv:LabelIconToGeometryConverter.Instance}}"
                                                                                      Fill="White"
                                                                                      Stretch="Uniform"
                                                                                      Margin="3.5"
                                                                                      IsVisible="{Binding !HasCustomIcon}"/>
                                                                                <Image Source="{Binding IconImage, Converter={x:Static conv:LabelIconToImageConverter.Instance}}"
                                                                                       Stretch="UniformToFill"
                                                                                       IsVisible="{Binding HasCustomIcon}"/>
                                                                            </Panel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Border Height="16"
                                                                    CornerRadius="8"
                                                                    Background="#CC202020"
                                                                    Padding="5,0"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding HasCardLabelsOverflow}">
                                                                <TextBlock Text="{Binding CardLabelsOverflowText}"
                                                                           FontSize="9"
                                                                           Foreground="White"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Признак группы: закладка-ленточка, свисающая с верхнего края
                                                             карточки, цветом персонажа. Управляется настройкой GroupBookmark;
                                                             при наведении гаснет, чтобы не спорить с кнопками правки. -->
                                                        <Path Classes="group-bookmark"
                                                              IsVisible="{Binding ShowGroupBookmark}"
                                                              IsHitTestVisible="False"
                                                              ZIndex="6"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Top"
                                                              Margin="0,-1,12,0"
                                                              Data="M0,0 H14 V20 L7,14 L0,20 Z"
                                                              Fill="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>

                                                        <DockPanel>

                                                            <!-- цветная зона: сверху у плитки, слева у строки списка -->
                                                            <Panel DockPanel.Dock="{Binding $parent[UserControl].DataContext.CardZoneDock}"
                                                                   Width="{Binding $parent[UserControl].DataContext.CardZoneWidth}"
                                                                   Height="{Binding $parent[UserControl].DataContext.CardTopHeight, FallbackValue=60}">

                                                                <!-- Полоса-аватар: картинка (или заливка цветом) на всю цветную
                                                                     зону. Включается настройкой «Вид аватара: полоска». -->
                                                                <Button Classes="flat"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        VerticalContentAlignment="Stretch"
                                                                        ZIndex="2"
                                                                        IsVisible="{Binding ShowAvatarStrip}">
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="Bottom">
                                                                            <StackPanel Spacing="6" Margin="4" MinWidth="140">
                                                                                <TextBlock Text="{x:Static res:CharactersStrings.AvatarPickerFlyout_Title}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                           Margin="0,0,0,2"/>
                                                                                <Button Content="{x:Static res:CharactersStrings.AvatarPickerFlyout_Upload}"
                                                                                        Command="{Binding OpenAvatarPickerCommand}"
                                                                                        HorizontalAlignment="Stretch"
                                                                                        Padding="8,4"/>
                                                                                <Button Content="{x:Static res:CharactersStrings.Button_DeleteAvatar}"
                                                                                        Command="{Binding RemoveAvatarCommand}"
                                                                                        HorizontalAlignment="Stretch"
                                                                                        Padding="8,4"/>
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                    <Panel>
                                                                        <Border Background="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
                                                                                CornerRadius="{Binding $parent[UserControl].DataContext.CardZoneCornerRadius}"/>
                                                                        <Border CornerRadius="{Binding $parent[UserControl].DataContext.CardZoneCornerRadius}"
                                                                                ClipToBounds="True"
                                                                                IsVisible="{Binding AvatarBitmap, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                            <Image Source="{Binding AvatarBitmap}" Stretch="UniformToFill"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding FallbackIcon}"
                                                                                   FontSize="{Binding $parent[UserControl].DataContext.CardIconFontSize, FallbackValue=30}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="White"
                                                                                   IsHitTestVisible="False"
                                                                                   IsVisible="{Binding AvatarBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                                    </Panel>
                                                                </Button>

                                                                <!-- Кружок без аватарки: клик сразу открывает выбор фото -->
                                                                <Button Classes="flat avatar-btn"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="0"
                                                                    ClipToBounds="False"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    ZIndex="2"
                                                                    Command="{Binding OpenAvatarPickerCommand}"
                                                                    IsVisible="{Binding ShowCircleNoPhoto}"
                                                                    ToolTip.Tip="{x:Static res:CharactersStrings.AvatarPickerFlyout_Upload}">
                                                                    <Panel>
                                                                        <Ellipse Width="{Binding $parent[UserControl].DataContext.CardAvatarSize, FallbackValue=48}"
                                                                                 Height="{Binding $parent[UserControl].DataContext.CardAvatarSize, FallbackValue=48}"
                                                                                 Fill="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>
                                                                        <TextBlock Text="{Binding FallbackIcon}"
                                                                                   FontSize="{Binding $parent[UserControl].DataContext.CardIconFontSize, FallbackValue=30}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="White"
                                                                                   IsHitTestVisible="False"/>
                                                                        <Border CornerRadius="999"
                                                                            BorderBrush="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
                                                                            BorderThickness="2"
                                                                            IsVisible="{Binding AvatarRing}"
                                                                            IsHitTestVisible="False"
                                                                            Width="{Binding $parent[UserControl].DataContext.CardRingSize, FallbackValue=56}"
                                                                            Height="{Binding $parent[UserControl].DataContext.CardRingSize, FallbackValue=56}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                                        <Border Classes="avatar-ring"
                                                                            CornerRadius="999"
                                                                            BorderBrush="White"
                                                                            BorderThickness="2"
                                                                            Opacity="0"
                                                                            IsHitTestVisible="False"
                                                                            Width="{Binding $parent[UserControl].DataContext.CardAvatarSize, FallbackValue=56}"
                                                                            Height="{Binding $parent[UserControl].DataContext.CardAvatarSize, FallbackValue=56}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                                    </Panel>
                                                                </Button>

                                                                <!-- Кружок с аватаркой: клик показывает меню Upload/Delete -->
                                                                <Button Classes="flat avatar-btn"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="0"
                                                                    ClipToBounds="False"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    ZIndex="2"
                                                                    IsVisible="{Binding ShowCirclePhoto}">
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="Bottom">
                                                                            <StackPanel Spacing="6" Margin="4" MinWidth="140">
                                                                                <TextBlock Text="{x:Static res:CharactersStrings.AvatarPickerFlyout_Title}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                           Margin="0,0,0,2"/>
                                                                                <Button Content="{x:Static res:CharactersStrings.AvatarPickerFlyout_Upload}"
                                                                                        Command="{Binding OpenAvatarPickerCommand}"
                                                                                        HorizontalAlignment="Stretch"
                                                                                        Padding="8,4"/>
                                                                                <Button Content="{x:Static res:CharactersStrings.Button_DeleteAvatar}"
                                                                                        Command="{Binding RemoveAvatarCommand}"
                                                                                        HorizontalAlignment="Stretch"
                                                                                        Padding="8,4"/>
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                    <Panel>
                                                                        <Ellipse Width="{Binding $parent[UserControl].DataContext.CardAvatarSize, FallbackValue=48}"
                                                                                 Height="{Binding $parent[UserControl].DataContext.CardAvatarSize, FallbackValue=48}"
                                                                                 Fill="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"/>
                                                                        <Ellipse Width="{Binding $parent[UserControl].DataContext.CardAvatarSize, FallbackValue=48}"
                                                                                 Height="{Binding $parent[UserControl].DataContext.CardAvatarSize, FallbackValue=48}">
                                                                            <Ellipse.Fill>
                                                                                <ImageBrush Source="{Binding AvatarBitmap}"
                                                                                            Stretch="UniformToFill"/>
                                                                            </Ellipse.Fill>
                                                                        </Ellipse>
                                                                        <Border CornerRadius="999"
                                                                            BorderBrush="{Binding Color, Converter={x:Static icv:ColorCodeToBrushConverter.Instance}}"
                                                                            BorderThickness="2"
                                                                            IsVisible="{Binding AvatarRing}"
                                                                            IsHitTestVisible="False"
                                                                            Width="{Binding $parent[UserControl].DataContext.CardRingSize, FallbackValue=56}"
                                                                            Height="{Binding $parent[UserControl].DataContext.CardRingSize, FallbackValue=56}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                                        <Border Classes="avatar-ring"
                                                                            CornerRadius="999"
                                                                            BorderBrush="White"
                                                                            BorderThickness="2"
                                                                            Opacity="0"
                                                                            IsHitTestVisible="False"
                                                                            Width="{Binding $parent[UserControl].DataContext.CardAvatarSize, FallbackValue=56}"
                                                                            Height="{Binding $parent[UserControl].DataContext.CardAvatarSize, FallbackValue=56}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                                    </Panel>
                                                                </Button>

                                                            </Panel>

                                                            <!-- зона имени: в строке списка прижимается влево и ограничена
                                                                 по ширине, в плитке — во всю ширину карточки -->
                                                            <Panel Height="{Binding $parent[UserControl].DataContext.CardNameHeight, FallbackValue=40}"
                                                                   MinWidth="{Binding $parent[UserControl].DataContext.CardNameMinWidth}"
                                                                   HorizontalAlignment="{Binding $parent[UserControl].DataContext.CardNamePanelAlignment}"
                                                                   MaxWidth="{Binding $parent[UserControl].DataContext.CardNameMaxWidth}">
                                                                <TextBox Text="{ReflectionBinding InlineName}"
                                                                         PlaceholderText="{x:Static loc:CharactersStrings.Character_NamePlaceholder}"
                                                                         FontSize="12" FontWeight="Medium"
                                                                         TextAlignment="{Binding $parent[UserControl].DataContext.CardNameAlignment}"
                                                                         Background="{DynamicResource BgPanelBrush}"
                                                                         BorderBrush="{DynamicResource AccentDefaultBrush}"
                                                                         BorderThickness="0,1,0,0"
                                                                         CornerRadius="0,0,8,8"
                                                                         Padding="8,0"
                                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                                         VerticalAlignment="Stretch"
                                                                         IsVisible="{Binding IsBeingNamed}"
                                                                         behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsBeingNamed}"/>
                                                                <TextBox Text="{ReflectionBinding PendingRename}"
                                                                         FontSize="12" FontWeight="Medium"
                                                                         TextAlignment="{Binding $parent[UserControl].DataContext.CardNameAlignment}"
                                                                         Background="{DynamicResource BgPanelBrush}"
                                                                         BorderBrush="{DynamicResource AccentDefaultBrush}"
                                                                         BorderThickness="0,1,0,0"
                                                                         CornerRadius="0,0,8,8"
                                                                         Padding="8,0"
                                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                                         VerticalAlignment="Stretch"
                                                                         IsVisible="{Binding IsRenaming}"
                                                                         behaviors:FocusOnVisibleBehavior.Enabled="{Binding IsRenaming}"/>
                                                                <Button Classes="flat"
                                                                        Command="{Binding StartRenameCommand}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="6,4"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch"
                                                                        HorizontalContentAlignment="{Binding $parent[UserControl].DataContext.CardNamePanelAlignment}"
                                                                        IsVisible="{Binding IsShowingNameDisplay}"
                                                                        ToolTip.Tip="{x:Static loc:CharactersStrings.Character_RenameTooltip}">
                                                                    <!-- Подпись карточки трогать нельзя: выравнивание
                                                                         задают HorizontalContentAlignment кнопки
                                                                         и TextAlignment самого текста, и любая обёртка
                                                                         между ними их отключает. Имя, по которому
                                                                         нашлась карточка при поиске, показывает
                                                                         боковой список редактора — там раскладка
                                                                         простая. -->
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="12" FontWeight="Medium"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextAlignment="{Binding $parent[UserControl].DataContext.CardNameAlignment}"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               ToolTip.Tip="{Binding Name}"
                                                                               ToolTip.ShowDelay="600"/>
                                                                </Button>
                                                            </Panel>

                                                        </DockPanel>

                                                        <!-- цветопикер, шестерёнка настроек и кнопки edit/delete живут на
                                                             уровне всей карточки (hover-only через opacity): в плитке это
                                                             углы цветной зоны, в строке списка — углы строки. -->
                                                        <StackPanel Orientation="{Binding $parent[UserControl].DataContext.CardControlsOrientation}"
                                                                    Spacing="3"
                                                                    HorizontalAlignment="{Binding $parent[UserControl].DataContext.CardPickerHAlign}"
                                                                    VerticalAlignment="{Binding $parent[UserControl].DataContext.CardControlsVAlign}"
                                                                    Margin="{Binding $parent[UserControl].DataContext.CardPickerMargin}"
                                                                    ZIndex="4">
                                                            <colorControls:ColorPickerButton
                                                                ShowCardPreview="True"
                                                                HexColor="{Binding Color, Mode=TwoWay}"
                                                                PreviewImage="{Binding AvatarBitmap}"
                                                                PreviewName="{Binding Name}"
                                                                PreviewFallback="{Binding FallbackIcon}"
                                                                RingEnabled="{Binding AvatarRing, Mode=TwoWay}"
                                                                PreviewIsGroup="{Binding IsCollective}"
                                                                BookmarkEnabled="{Binding GroupBookmark, Mode=TwoWay}"
                                                                ApplyRingToAllCommand="{Binding ApplyRingToAllCommand}"
                                                                Width="{Binding $parent[UserControl].DataContext.CardColorButtonSize, FallbackValue=20}"
                                                                Height="{Binding $parent[UserControl].DataContext.CardColorButtonSize, FallbackValue=20}"
                                                                ToolTip.Tip="{x:Static loc:CharactersStrings.ColorPicker_Tooltip}"/>

                                                            <!-- Настройки карточки: открывает окно по центру модуля
                                                                 (CardSettingsOverlay) — кольцо, закладка, толщина рамки. -->
                                                            <Button Classes="card-cfg"
                                                                    Width="{Binding $parent[UserControl].DataContext.CardColorButtonSize, FallbackValue=20}"
                                                                    Height="{Binding $parent[UserControl].DataContext.CardColorButtonSize, FallbackValue=20}"
                                                                    Padding="0" CornerRadius="999"
                                                                    Background="#88000000" BorderThickness="0"
                                                                    HorizontalContentAlignment="Center"
                                                                    VerticalContentAlignment="Center"
                                                                    Click="OnCardSettingsClick"
                                                                    ToolTip.Tip="Настройки карточки">
                                                                <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                                                                          Width="{Binding $parent[UserControl].DataContext.CardActionIconSize, FallbackValue=11}"
                                                                          Height="{Binding $parent[UserControl].DataContext.CardActionIconSize, FallbackValue=11}"
                                                                          Foreground="White"/>
                                                            </Button>
                                                        </StackPanel>

                                                        <StackPanel Classes="card-edit-btns"
                                                                    Orientation="{Binding $parent[UserControl].DataContext.CardControlsOrientation}"
                                                                    Spacing="2"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="{Binding $parent[UserControl].DataContext.CardControlsVAlign}"
                                                                    Margin="{Binding $parent[UserControl].DataContext.CardEditBtnsMargin}"
                                                                    ZIndex="4"
                                                                    IsVisible="{Binding IsShowingNameDisplay}">
                                                            <Button Command="{Binding RequestDeleteCommand}"
                                                                    Padding="4,3"
                                                                    Background="#88000000"
                                                                    BorderThickness="0" CornerRadius="4"
                                                                    ToolTip.Tip="{x:Static loc:CharactersStrings.Character_DeleteTooltip}">
                                                                <Button.Styles>
                                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                        <Setter Property="Background" Value="#BB660000"/>
                                                                    </Style>
                                                                </Button.Styles>
                                                                <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                                          Width="{Binding $parent[UserControl].DataContext.CardActionIconSize, FallbackValue=11}"
                                                                          Height="{Binding $parent[UserControl].DataContext.CardActionIconSize, FallbackValue=11}"
                                                                          Foreground="White"/>
                                                            </Button>
                                                            <Button Command="{ReflectionBinding $parent[UserControl].DataContext.EditCharacterCommand}"
                                                                    CommandParameter="{Binding Id}"
                                                                    Padding="4,3"
                                                                    Background="#88000000"
                                                                    BorderThickness="0" CornerRadius="4"
                                                                    ToolTip.Tip="{x:Static loc:CharactersStrings.Character_EditTooltip}">
                                                                <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                                          Width="{Binding $parent[UserControl].DataContext.CardActionIconSize, FallbackValue=11}"
                                                                          Height="{Binding $parent[UserControl].DataContext.CardActionIconSize, FallbackValue=11}"
                                                                          Foreground="White"/>
                                                            </Button>
                                                        </StackPanel>

                                                        </Panel>
                                                    </Border>

                                                </DataTemplate>
                                            </controls:PerfItemsRepeater.ItemTemplate>
                                        </controls:PerfItemsRepeater>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Оверлей загрузки -->
            <Border IsVisible="{Binding IsLoading}"
                    Background="{DynamicResource BgBaseBrush}"
                    Opacity="0.85">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12">
                    <TextBlock Text="{x:Static loc:CharactersStrings.Loading_Characters}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <!-- IsIndeterminate привязан к IsLoading, а не задан константой:
                         бесконечная анимация бегунка живёт по псевдоклассу
                         :indeterminate независимо от видимости и инвалидирует
                         раскладку каждый кадр всё время жизни модуля. -->
                    <ProgressBar IsIndeterminate="{Binding IsLoading}"
                                 Width="200"
                                 Height="4"/>
                </StackPanel>
            </Border>
        </Panel>

        <!-- кнопки создания -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid ColumnDefinitions="3*,*">
                <Button Grid.Column="0"
                        Command="{ReflectionBinding CreateCharacterCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Height="40" CornerRadius="8"
                        Background="{DynamicResource AccentDefaultBrush}"
                        Foreground="White" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                  Width="16" Height="16" Foreground="White"/>
                        <TextBlock Text="{x:Static loc:CharactersStrings.Button_CreateCharacter}"
                                   FontSize="13" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Command="{ReflectionBinding CreateCollectiveCharacterCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Height="40" CornerRadius="8"
                        Background="{DynamicResource AccentDefaultBrush}"
                        Foreground="White"
                        behaviours:TooltipBehavior.Tip="{x:Static loc:CharactersStrings.Button_CreateCollective}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                  Width="16" Height="16" Foreground="White"/>
                        <TextBlock Text="{x:Static loc:CharactersStrings.Button_CreateCollectiveShort}"
                                   FontSize="12" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- drag ghost — размеры берутся из VM напрямую (DataContext = CharactersViewModel) -->
        <Canvas x:Name="DragGhostCanvas"
                Grid.Row="0" Grid.RowSpan="3"
                IsHitTestVisible="False"
                IsVisible="False">
            <Border x:Name="DragGhostBorder"
                    Width="{Binding CardWidth, FallbackValue=148}"
                    CornerRadius="10"
                    Opacity="0.9"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="#888888"
                    BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" OffsetX="0" OffsetY="6" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel Orientation="Vertical">
                    <Panel Height="{Binding CardTopHeight, FallbackValue=60}">
                        <Panel Width="{Binding CardAvatarSize, FallbackValue=44}"
                               Height="{Binding CardAvatarSize, FallbackValue=44}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="DragGhostAvatarBg" CornerRadius="999"/>
                            <Border CornerRadius="999" ClipToBounds="True">
                                <Image x:Name="DragGhostAvatar" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock x:Name="DragGhostFallback" Text="?"
                                       Foreground="White"
                                       FontSize="{Binding CardIconFontSize, FallbackValue=28}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Panel>
                        <!-- Закладка группы — как на реальной карточке. -->
                        <Path x:Name="DragGhostBookmark"
                              IsVisible="False"
                              IsHitTestVisible="False"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,-1,12,0"
                              Data="M0,0 H14 V20 L7,14 L0,20 Z"/>
                    </Panel>
                    <Panel Height="{Binding CardNameHeight, FallbackValue=40}">
                        <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="0,0,8,8"/>
                        <TextBlock x:Name="DragGhostText"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0"/>
                    </Panel>
                </StackPanel>
            </Border>
        </Canvas>

    </Grid>
</UserControl>
