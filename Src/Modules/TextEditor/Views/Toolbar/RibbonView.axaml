<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.TextEditor.ViewModels.Toolbar"
             xmlns:tabs="using:Writersword.Modules.TextEditor.Views.Toolbar.Tabs"
             xmlns:loc="using:Writersword.Modules.TextEditor.Resources"
             x:Class="Writersword.Modules.TextEditor.Views.Toolbar.RibbonView"
             x:DataType="vm:RibbonViewModel">

	<UserControl.Styles>
		<!-- Кнопки ленты не забирают клавиатурный фокус. Горячие клавиши редактора
		     разбирает OnKeyDown канваса документа, и другого пути у них нет: стоит
		     фокусу уйти на кнопку, как Ctrl+Z и всё остальное перестают доходить до
		     редактора, а каретка пропадает с листа. Так же ведут себя панели Word:
		     нажатие кнопки выполняет команду, но точка ввода остаётся в тексте.
		     Поля ввода и списки не затронуты — им фокус нужен для набора значения. -->
		<Style Selector="Button">
			<Setter Property="Focusable" Value="False"/>
		</Style>
		<Style Selector="ToggleButton">
			<Setter Property="Focusable" Value="False"/>
		</Style>
		<Style Selector="RepeatButton">
			<Setter Property="Focusable" Value="False"/>
		</Style>
		<Style Selector="SplitButton">
			<Setter Property="Focusable" Value="False"/>
		</Style>
		<Style Selector="DropDownButton">
			<Setter Property="Focusable" Value="False"/>
		</Style>
	</UserControl.Styles>

	<UserControl.Resources>
		<!-- Высота тела ленты — одна на все вкладки. Подгонка вкладок друг под
		     друга по содержимому не работает: высоту набирают ещё и метрики
		     шрифта подписи, отступы группы и поведение DockPanel, и любая
		     правка внутри одной вкладки снова разводит их на пару пикселей.
		     Здесь высота фиксируется явно, и лента перестаёт прыгать при
		     переключении независимо от того, что лежит внутри вкладки.
		     Если какая-то группа окажется обрезана снизу — увеличивать нужно
		     это число, оно единственное. -->
		<x:Double x:Key="RibbonBodyHeight">88</x:Double>
	</UserControl.Resources>

	<Border Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="0 0 0 1">

		<TabControl SelectedIndex="{Binding SelectedTabIndex}"
                    Padding="0"
                    Background="Transparent">

			<TabControl.Styles>

				<!-- Базовый стиль вкладки -->
				<Style Selector="TabItem">
					<Setter Property="FontSize" Value="12"/>
					<Setter Property="Padding" Value="11 4"/>
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="BorderThickness" Value="0"/>
					<Setter Property="MinHeight" Value="0"/>
					<Setter Property="Height" Value="26"/>
					<Setter Property="Cursor" Value="Hand"/>
					<Setter Property="VerticalContentAlignment" Value="Center"/>
				</Style>

				<!-- Цвет текста в обычном состоянии -->
				<Style Selector="TabItem > TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource MenuBarItemForeground}"/>
					<Setter Property="FontSize" Value="12"/>
					<Setter Property="VerticalAlignment" Value="Center"/>
				</Style>

				<!-- При наведении — оранжевый фон, белый текст -->
				<Style Selector="TabItem:pointerover">
					<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
					<Setter Property="BorderThickness" Value="0"/>
				</Style>
				<Style Selector="TabItem:pointerover > TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource MenuBarItemForegroundPointerOver}"/>
				</Style>

				<!-- Выбранная вкладка -->
				<Style Selector="TabItem:selected">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="BorderThickness" Value="0 0 0 2"/>
					<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
				</Style>
				<Style Selector="TabItem:selected > TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
				</Style>

				<!-- Убираем FluentTheme-полоску -->
				<Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="IsVisible" Value="False"/>
				</Style>

				<!-- Контекстная вкладка «Таблица» — акцентный заголовок, как у «Формат» -->
				<!-- Акцентом горит только выбранная контекстная вкладка. Раньше заголовок -->
				<!-- красился всегда, и когда рядом оказывались обе — таблица и картинка — -->
				<!-- обе читались как включённые, хотя выбрана была одна.                   -->
				<Style Selector="TabItem.TableContextTab > TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
					<Setter Property="FontWeight" Value="Medium"/>
				</Style>
				<Style Selector="TabItem.TableContextTab:selected">
					<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
				</Style>
				<Style Selector="TabItem.TableContextTab:selected > TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
				</Style>
				<Style Selector="TabItem.TableContextTab:pointerover">
					<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
				</Style>

				<!-- Контекстная вкладка «Формат» (картинка) — заголовок оранжевый -->
				<Style Selector="TabItem.ImageContextTab > TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
					<Setter Property="FontWeight" Value="Medium"/>
				</Style>
				<Style Selector="TabItem.ImageContextTab:selected">
					<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
				</Style>
				<Style Selector="TabItem.ImageContextTab:selected > TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
				</Style>
				<Style Selector="TabItem.ImageContextTab:pointerover">
					<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
				</Style>

			</TabControl.Styles>

			<!-- ── Главная ──────────────────────────────────────────────── -->
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static loc:TextEditorStrings.Ribbon_Home}"/>
				</TabItem.Header>
				<Panel Height="{StaticResource RibbonBodyHeight}"
				       IsHitTestVisible="{Binding IsEditingEnabled}"
				       Opacity="{Binding ContentOpacity}">
					<tabs:RibbonHomeTab DataContext="{Binding Home}"/>
				</Panel>
			</TabItem>

			<!-- ── Вставка ──────────────────────────────────────────────── -->
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static loc:TextEditorStrings.Ribbon_Insert}"/>
				</TabItem.Header>
				<Panel Height="{StaticResource RibbonBodyHeight}"
				       IsHitTestVisible="{Binding IsEditingEnabled}"
				       Opacity="{Binding ContentOpacity}">
					<tabs:RibbonInsertTab DataContext="{Binding Insert}"/>
				</Panel>
			</TabItem>

			<!-- ── Макет ────────────────────────────────────────────────── -->
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static loc:TextEditorStrings.Ribbon_Layout}"/>
				</TabItem.Header>
				<Panel Height="{StaticResource RibbonBodyHeight}"
				       IsHitTestVisible="{Binding IsEditingEnabled}"
				       Opacity="{Binding ContentOpacity}">
					<tabs:RibbonLayoutTab DataContext="{Binding Layout}"/>
				</Panel>
			</TabItem>

			<!-- ── Ссылки ───────────────────────────────────────────────── -->
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static loc:TextEditorStrings.Ribbon_References}"/>
				</TabItem.Header>
				<Panel Height="{StaticResource RibbonBodyHeight}"
				       IsHitTestVisible="{Binding IsEditingEnabled}"
				       Opacity="{Binding ContentOpacity}">
					<tabs:RibbonReferencesTab DataContext="{Binding References}"/>
				</Panel>
			</TabItem>

			<!-- ── Работа с таблицей (КОНТЕКСТНАЯ) ─────────────────────── -->
			<!-- Видна только когда каретка находится внутри таблицы.       -->
			<!-- IsTableTabVisible управляется из TextEditorViewModel.       -->
			<TabItem Classes="TableContextTab"
                     IsVisible="{Binding IsTableTabVisible}">
				<TabItem.Header>
					<TextBlock Text="Работа с таблицами"/>
				</TabItem.Header>
				<Panel Height="{StaticResource RibbonBodyHeight}"
				       IsHitTestVisible="{Binding IsEditingEnabled}"
				       Opacity="{Binding ContentOpacity}">
					<tabs:RibbonTableTab DataContext="{Binding Table}"/>
				</Panel>
			</TabItem>

			<!-- ── Формат (КОНТЕКСТНАЯ, картинка) ───────────────────────── -->
			<!-- Видна только когда на канвасе выделено изображение.         -->
			<!-- IsImageTabVisible управляется из TextEditorViewModel.        -->
			<TabItem Classes="ImageContextTab"
                     IsVisible="{Binding IsImageTabVisible}">
				<TabItem.Header>
					<TextBlock Text="Формат"/>
				</TabItem.Header>
				<Panel Height="{StaticResource RibbonBodyHeight}"
				       IsHitTestVisible="{Binding IsEditingEnabled}"
				       Opacity="{Binding ContentOpacity}">
					<tabs:RibbonImageTab DataContext="{Binding Image}"/>
				</Panel>
			</TabItem>

		</TabControl>
	</Border>
</UserControl>
