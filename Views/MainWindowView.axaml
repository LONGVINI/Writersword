<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Writersword.ViewModels"
        xmlns:loc="using:Writersword.Resources.Localization"
        xmlns:converters="using:Writersword.Converters"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:components="using:Writersword.Views.Components"
        x:Class="Writersword.Views.MainWindowView"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1400"
        Height="900"
        WindowState="Maximized"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Grid Background="{DynamicResource BgAppBrush}"
          RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Строка заголовка -->
   <Grid Grid.Row="0"
              x:Name="TitleBarGrid"
              Background="{DynamicResource BgPanelBrush}"
              UseLayoutRounding="True">

            <DockPanel Margin="0,0,138,0" VerticalAlignment="Top">
                <Image DockPanel.Dock="Left"
                       Source="avares://Writersword/Resources/Images/icon.ico"
                       Width="16" Height="16"
                       Margin="10,8,8,0"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>

            <components:MenuBarView DataContext="{Binding MenuBar}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"/>
            </DockPanel>

            <StackPanel x:Name="WindowButtonsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Height="32"
                        Margin="0,2,0,0"
                        ZIndex="1">
                
                <Button x:Name="MinimizeButton" Width="46" Height="32" Padding="8,0,8,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Classes="TitleBarWindowButton" ToolTip.Tip="Свернуть">
                    <Canvas Width="10" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Line StartPoint="0,0.5" EndPoint="10,0.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1"/>
                    </Canvas>
                </Button>
                <Button x:Name="MaximizeButton" Width="46" Height="32" Padding="8,0,8,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Classes="TitleBarWindowButton" ToolTip.Tip="Развернуть">
                    <Panel Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle x:Name="MaximizeIcon" Width="10" Height="10" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Fill="Transparent"/>
                        <Canvas x:Name="RestoreIcon" Width="10" Height="10" IsVisible="False">
                            <Rectangle Width="8" Height="8" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Fill="Transparent" Canvas.Left="2" Canvas.Top="0"/>
                            <Rectangle x:Name="RestoreFrontRect" Width="8" Height="8" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Fill="{DynamicResource BgPanelBrush}" Canvas.Left="0" Canvas.Top="2"/>
                        </Canvas>
                    </Panel>
                </Button>
                <Button x:Name="CloseButton" Width="46" Height="32" Padding="8,0,8,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Classes="TitleBarWindowButton TitleBarCloseButton" ToolTip.Tip="Закрыть">
                    <Canvas Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Line StartPoint="0,0" EndPoint="10,10" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1"/>
                        <Line StartPoint="10,0" EndPoint="0,10" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1"/>
                    </Canvas>
                </Button>
            </StackPanel>
        </Grid>
        <!-- Панель вкладок -->
        <components:TabBarView Grid.Row="1"
                       x:Name="TabBarViewRoot"
                       DataContext="{Binding TabBar}"/>

        <!-- Панель WorkModes -->
        <components:WorkModeBarView Grid.Row="2"
                                    DataContext="{Binding WorkModeBar}"/>

        <!-- Баннер восстановления -->
        <ContentControl Grid.Row="3"
                        Content="{Binding TabBar.ActiveTab.RecoveryBanner, FallbackValue={x:Null}}"
                        IsVisible="{Binding TabBar.ActiveTab.HasRecoveryBanner}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:RecoveryBannerViewModel">
                    <components:RecoveryBannerView/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Главная область -->
        <Panel Grid.Row="4">
            <dock:DockControl Layout="{Binding DockLayout}"
                              Background="{DynamicResource BgSurfaceBrush}"/>
            <Panel Name="NotificationContainer"
                   ZIndex="1000"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"/>
        </Panel>

    

    </Grid>
</Window>