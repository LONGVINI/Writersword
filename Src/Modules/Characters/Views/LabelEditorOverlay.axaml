<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Writersword.Modules.Characters.Views"
             xmlns:conv="using:Writersword.Modules.Characters.Converters"
             xmlns:icv="using:Writersword.Infrastructure.Converters"
             xmlns:colorControls="using:Writersword.Styles.UserControls"
             xmlns:controls="using:Writersword.Modules.Characters.Controls"
             xmlns:behaviours="using:Writersword.Infrastructure.Behaviours"
             xmlns:infra="using:Writersword.Infrastructure.Controls"
             x:Class="Writersword.Modules.Characters.Views.LabelEditorOverlay"
             x:DataType="views:LabelEditorDraft"
             IsVisible="False">

	<!-- Редактор метки персонажа. Оформление и поведение — как у окна настроек
	     карточки: скрим на модуль (клик не закрывает), центральная панель со
	     скруглением и тенью. Правки живут в черновике (DataContext =
	     LabelEditorDraft) и применяются по OK; «Отмена»/крестик закрывают
	     без изменений.

	     Окно короткое намеренно. Раньше в нём подряд стояло восемь полей и
	     четыре галки, и метка — вещь на два слова и один значок — требовала
	     разбора настроек, которые трогают раз в жизни. Теперь наверху видно
	     саму метку и её имя, ниже — значок и цвета, а редкое (пояснение,
	     затемнение карточки, показ на карточке) убрано за знак пояснения
	     и «Ещё».

	     Подписей над полями нет там, где поле называет себя серым текстом
	     внутри. Подпись над заполненным полем повторяет то, что в нём
	     написано, и в коротком окне это лишняя строка на каждое поле.

	     Галки «Общая метка — применить ко всем персонажам» больше нет. Она
	     говорила не то, что делала: метку она никому не вешала, а делала
	     общим её вид. Теперь вид метки общий всегда — как у тега: правишь
	     «Ранен» здесь, он меняется у всех, у кого стоит. Нужен другой вид —
	     заводится вторая метка со своим именем. -->

	<UserControl.Styles>
		<!-- Кнопка-иконка из встроенного набора. Выбранная — акцентная рамка. -->
		<Style Selector="Button.iconOpt">
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.iconOpt:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
		</Style>
		<Style Selector="Button.iconOpt.selected">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="2"/>
		</Style>

		<Style Selector="TextBlock.fieldLabel">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="TextBox.field">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="8,6"/>
		</Style>

		<!-- Красная рамка обязательного поля живёт в общих стилях
		     (Styles/Controls/TextBox.axaml, класс invalid): пустое поле, без
		     которого не нажимается кнопка, встречается не только здесь, и
		     выглядеть оно должно везде одинаково. -->


		<!-- Строка «Ещё»: раскрывает редкие настройки. Стрелка поворачивается,
		     как у разделов инспектора. -->
		<Style Selector="Button.moreToggle">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0,2"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="Button.moreToggle:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="Path.moreChev">
			<Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="StrokeThickness" Value="1.4"/>
			<Setter Property="StrokeLineCap" Value="Round"/>
			<Setter Property="StrokeJoin" Value="Round"/>
			<Setter Property="Width" Value="8"/>
			<Setter Property="Height" Value="8"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="RenderTransformOrigin" Value="50%,50%"/>
		</Style>
	</UserControl.Styles>

	<Grid>
		<!-- Скрим: затемняет и блокирует модуль. Клик НЕ закрывает. -->
		<Border Background="#F2000000" PointerPressed="OnScrimPressed"/>

		<!-- Картинку можно просто бросить на окно: файл значка чаще всего уже
		     лежит открытой папкой рядом, и путь «кнопка → диалог → поиск того
		     же файла» здесь лишний. Приём висит на всей панели, а не на одной
		     плитке: попасть в плитку 36 точек броском тяжело. -->
		<Border x:Name="EditorPanel"
		        HorizontalAlignment="Center" VerticalAlignment="Center"
		        Margin="24" Width="420"
		        Background="{DynamicResource BgBaseBrush}"
		        BorderBrush="{DynamicResource BorderDefaultBrush}"
		        BorderThickness="1"
		        CornerRadius="16"
		        Padding="20"
		        DragDrop.AllowDrop="True"
		        DragDrop.DragEnter="OnIconDragOver"
		        DragDrop.DragOver="OnIconDragOver"
		        DragDrop.DragLeave="OnIconDragLeave"
		        DragDrop.Drop="OnIconDrop">
			<Border.Effect>
				<DropShadowEffect BlurRadius="32" OffsetX="0" OffsetY="12" Opacity="0.55" Color="#000000"/>
			</Border.Effect>

			<Panel>
				<StackPanel Spacing="14">

					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Grid.Column="0" Text="Метка"
						           FontSize="16" FontWeight="SemiBold"
						           Foreground="{DynamicResource TextPrimaryBrush}"
						           VerticalAlignment="Center"/>
						<Button Grid.Column="1" Content="✕" Click="OnCancelClick"
						        Background="Transparent" BorderThickness="0"
						        Foreground="{DynamicResource TextSecondaryBrush}"
						        FontSize="14" Padding="6,2"/>
					</Grid>

					<!-- Метка и её имя в одну строку: значок крупный, потому что
					     ради него сюда и заходят, а имя правится тут же, не
					     отдельным полем ниже. Рисуется значок тем же контролом,
					     что и на карточке, — показывает ровно то, что получится. -->
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
						<Border Grid.Column="0"
						        Width="64" Height="64"
						        CornerRadius="12"
						        Background="{DynamicResource BgSurfaceBrush}"
						        BorderBrush="{DynamicResource BorderSubtleBrush}"
						        BorderThickness="1">
							<controls:CharacterLabelIcon Label="{Binding Preview}" IconSize="52"
							                             HorizontalAlignment="Center"
							                             VerticalAlignment="Center"/>
						</Border>

						<!-- Подписи над полем нет: пустое поле называет себя само
						     серым текстом внутри, а как только в нём что-то есть,
						     подпись «Название» ничего уже не сообщает — над словом
						     «Ранен» и так написано «Ранен».

						     А вот пояснение, что это за имя и где оно потом
						     всплывёт, стоит прямо под полем обычной серой строкой —
						     так же, как под другими полями в программе. Читается оно
						     сразу, не требует ни наведения, ни нажатия, и занимает
						     ровно то место, на которое всё равно никто не смотрит.

						     Незаполненное поле краснеет по ОК, и строки «впишите
						     имя» под ним нет: красная рамка и курсор, прыгнувший
						     внутрь, говорят то же самое и говорят короче. -->
						<Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"
						      VerticalAlignment="Center">
							<TextBox Grid.Column="0"
							         x:Name="NameBox" Classes="field"
							         Text="{Binding Name, Mode=TwoWay}"
							         PlaceholderText="Название"
							         KeyDown="OnNameKeyDown"
							         TextChanged="OnNameChanged"/>

							<infra:HintMark Grid.Column="1" VerticalAlignment="Center"
							                behaviours:TooltipBehavior.Tip="Имя метки"
							                behaviours:TooltipBehavior.Description="Стоит под значком на карточке и в списке меток проекта. По нему метка ищется, когда её ставят другому персонажу."/>
						</Grid>
					</Grid>

					<StackPanel Spacing="6">
						<TextBlock Classes="fieldLabel" Text="Значок"/>

						<WrapPanel Orientation="Horizontal">

							<!-- Своя картинка: герб дома, эмблема клуба, стикер.
							     Плитка показывает то, что выбрано, а не слово
							     «Своя картинка», — по ней видно, что уже стоит.
							     Ключ встроенного значка при этом сохраняется:
							     убрал картинку — вернулся прежний значок. -->
							<Panel Margin="0,0,6,6">
								<!-- Плитка своей картинки стоит первой в том же ряду,
								     что и встроенные значки: своя картинка — такой
								     же выбор значка, а не отдельная настройка ниже,
								     к которой ещё надо додуматься. -->
								<Button Classes="iconOpt"
								        Classes.selected="{Binding HasCustomIcon}"
								        Click="OnPickIconImageClick"
								        behaviours:TooltipBehavior.Tip="Своя картинка"
								        behaviours:TooltipBehavior.Description="Выбрать файл на диске — PNG, JPG, WebP, GIF, BMP, ICO или SVG. Картинку можно и просто бросить в это окно. Дальше открывается та же обрезка, что у аватарок: из большой картинки или листа со спрайтами выбирается нужный кусок. Когда картинка уже стоит, эта плитка открывает обрезку заново; чтобы взять другую, сначала снимите крестиком">
									<Panel>
										<!-- Пусто — знак «положить картинку». -->
										<PathIcon Width="16" Height="16"
										          IsVisible="{Binding !HasCustomIcon}"
										          Foreground="{DynamicResource TextSecondaryBrush}"
										          Data="M19 7v2.99s-1.99.01-2 0V7h-3s.01-1.99 0-2h3V2h2v3h3v2h-3zm-3 4V8h-3V5H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-8h-3zM5 19l3-4 2 3 3-4 4 5H5z"/>
										<controls:CharacterLabelIcon
											IsVisible="{Binding HasCustomIcon}"
											Label="{Binding Preview}" IconSize="28"/>
									</Panel>
								</Button>

								<!-- Крестик поверх плитки: снять картинку, не
								     уходя из ряда значков. -->
								<Button Content="✕"
								        Click="OnClearIconImageClick"
								        IsVisible="{Binding HasCustomIcon}"
								        HorizontalAlignment="Right" VerticalAlignment="Top"
								        Margin="0,-4,-4,0"
								        Width="16" Height="16"
								        MinWidth="0" MinHeight="0"
								        Padding="0"
								        FontSize="9"
								        CornerRadius="8"
								        Background="{DynamicResource BgBaseBrush}"
								        BorderBrush="{DynamicResource BorderDefaultBrush}"
								        BorderThickness="1"
								        Foreground="{DynamicResource TextSecondaryBrush}"
								        behaviours:TooltipBehavior.Tip="Убрать картинку"
								        behaviours:TooltipBehavior.Description="Вернётся выбранный до неё встроенный значок"/>
							</Panel>

							<ItemsControl ItemsSource="{Binding Icons}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="views:LabelIconOption">
										<Button Classes="iconOpt"
										        Classes.selected="{Binding IsSelected}"
										        Margin="0,0,6,6"
										        Click="OnIconClick">
											<!-- Тот же контрол, что рисует метку на карточке:
											     иначе значок в наборе и значок на карточке
											     снова разъедутся, как это уже было. -->
											<controls:CharacterLabelIcon Label="{Binding Sample}" IconSize="18"/>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</WrapPanel>
					</StackPanel>

					<!-- Два цвета врозь: кружком метка отличается от соседних,
					     фигура остаётся читаемой на любом из них. Цвет фигуры
					     красит и встроенное очертание, и одноцветный вектор;
					     растровая картинка идёт как есть.

					     Обе кнопки и галка кружка — в одну строку: это три
					     части одного решения «как метка выглядит», и тремя
					     блоками подряд они читались как три разные темы. -->
					<Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
						<StackPanel Grid.Column="0" Spacing="4">
							<TextBlock Classes="fieldLabel" Text="Цвет кружка"/>
							<colorControls:ColorPickerButton Width="24" Height="24"
							        HorizontalAlignment="Left"
							        IsEnabled="{Binding ShowBackdrop}"
							        HexColor="{Binding Color, Mode=TwoWay}"/>
						</StackPanel>

						<StackPanel Grid.Column="1" Spacing="4">
							<TextBlock Classes="fieldLabel" Text="Цвет фигуры"/>
							<colorControls:ColorPickerButton Width="24" Height="24"
							        HorizontalAlignment="Left"
							        HexColor="{Binding IconColor, Mode=TwoWay}"/>
						</StackPanel>

						<!-- Без кружка остаётся одна фигура: так уместнее для
						     готовых эмблем и гербов, которым круглая подложка
						     только мешает. -->
						<CheckBox Grid.Column="2"
						          IsChecked="{Binding ShowBackdrop, Mode=TwoWay}"
						          Content="Кружок под значком"
						          VerticalAlignment="Bottom"
						          FontSize="12"
						          Foreground="{DynamicResource TextPrimaryBrush}"/>
					</Grid>

					<!-- Редкое — под «Ещё». Затемнение карточки трогают у одной
					     метки из десяти, показ значка на карточке — реже того,
					     а занимали они треть окна и создавали ощущение, что
					     метку надо настраивать. -->
					<StackPanel Spacing="8">
						<Button Classes="moreToggle" Click="OnToggleMoreClick">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<Path x:Name="MoreChev" Classes="moreChev" Data="M2,1 L5,4 L2,7"/>
								<TextBlock Text="Ещё" FontSize="12" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<StackPanel x:Name="MoreBody" Spacing="10" IsVisible="False">
							<!-- Пояснение метки — то, что всплывает при наведении
							     на её значок. Нужно оно редко: у метки «Ранен»
							     пояснять нечего, — поэтому лежит здесь, а не
							     строкой на виду. -->
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<TextBox Grid.Column="0" Classes="field"
								         Text="{Binding Description, Mode=TwoWay}"
								         PlaceholderText="Пояснение"/>
								<infra:HintMark Grid.Column="1" VerticalAlignment="Center"
								                behaviours:TooltipBehavior.Tip="Пояснение метки"
								                behaviours:TooltipBehavior.Description="Всплывает, когда наводят на значок метки — на карточке персонажа и в списках. Можно оставить пустым: у метки с говорящим именем пояснять нечего."/>
							</Grid>

							<CheckBox IsChecked="{Binding Dim, Mode=TwoWay}"
							          Content="Затемнять карточку (как у метки «Мёртв»)"
							          FontSize="12"
							          Foreground="{DynamicResource TextPrimaryBrush}"/>

							<CheckBox IsChecked="{Binding ShowOnCard, Mode=TwoWay}"
							          Content="Показывать значок на карточке в списках"
							          FontSize="12"
							          Foreground="{DynamicResource TextPrimaryBrush}"/>
						</StackPanel>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
						<Button Content="Отмена" Click="OnCancelClick"
						        FontSize="12" Padding="12,6" CornerRadius="6"
						        Background="{DynamicResource BgSurfaceBrush}"
						        Foreground="{DynamicResource TextPrimaryBrush}"
						        BorderBrush="{DynamicResource BorderDefaultBrush}"
						        BorderThickness="1"/>
						<Button Content="ОК" Click="OnOkClick"
						        FontSize="12" Padding="16,6" CornerRadius="6"
						        Background="{DynamicResource AccentDefaultBrush}"
						        Foreground="White"
						        BorderThickness="0"/>
					</StackPanel>

				</StackPanel>

				<!-- Подсветка приёма файла: рамка по всей панели. -->
				<Border x:Name="DropHint"
				        IsVisible="False"
				        IsHitTestVisible="False"
				        Margin="-20"
				        CornerRadius="16"
				        BorderThickness="2"
				        BorderBrush="{DynamicResource AccentDefaultBrush}"/>
			</Panel>
		</Border>
	</Grid>
</UserControl>
