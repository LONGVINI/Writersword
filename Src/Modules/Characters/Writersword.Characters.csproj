<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AssemblyName>Writersword.Characters</AssemblyName>
		<RootNamespace>Writersword.Src.Modules.Characters</RootNamespace>
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\*.resx" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Resources\Assets\Avatars\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Avatars\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Skia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
		<PackageReference Include="Serilog" Version="4.3.2-dev-02419" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
		<!-- Растеризация SVG для значков меток (Svg.Skia.SKSvg). Берётся сам
		     Svg.Skia, а не обёртка Avalonia.Svg.Skia: из обёртки нужен ровно
		     один тип, зато она тянет за собой Avalonia 11 в проект, собранный
		     под Avalonia 12. Версия та же, что приходит транзитивно в главный
		     проект, — общий граф зависимостей не расходится. -->
		<PackageReference Include="Svg.Skia" Version="3.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Writersword.Core.csproj" />
		<ProjectReference Include="..\..\..\Writersword.UI.Shared.csproj" />
	</ItemGroup>

</Project>