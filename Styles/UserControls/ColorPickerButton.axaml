<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cpp="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls.ColorPicker"
             xmlns:res="using:Writersword.Styles.UserControls"
             xmlns:conv="using:Writersword.Infrastructure.Converters"
             x:Class="Writersword.Styles.UserControls.ColorPickerButton"
             x:Name="Root"
             Width="20" Height="20">

	<Button x:Name="TriggerButton"
            Padding="0" CornerRadius="999"
            BorderThickness="1.5"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            Background="{Binding HexColor, ElementName=Root, Converter={x:Static conv:ColorCodeToBrushConverter.Instance}}"
            Tag="{Binding HexColor, ElementName=Root}"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">
		<Button.Styles>
			<!-- Подсказка навешивается стилем и только круглому варианту. Атрибутом
			     на кнопке она доставалась и прямоугольному, где подсказку задаёт
			     вызывающая сторона, — и над лентой всплывали сразу две.
			     Убрать её потом стилем было бы нельзя: атрибут — локальное значение,
			     оно сильнее стиля. -->
			<Style Selector="res|ColorPickerButton:not(.arrow) Button#TriggerButton">
				<Setter Property="ToolTip.Tip" Value="{x:Static res:SharedStrings.ColorPicker_ChangeColor}"/>
			</Style>

			<Style Selector="Button#TriggerButton">
				<Setter Property="Template">
					<ControlTemplate>
						<Panel>
							<Border Name="RoundRoot"
                                    CornerRadius="999"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
							<!-- Отсутствие цвета — прозрачная заливка, и пустой кружок ничем не
							     отличается от белого или от подложки под ним. Поверх ложится тот
							     же значок, что и в самой палитре: белый круг с красным крестом.
							     Код цвета берётся из Tag: внутри шаблона у кнопки своя область
							     имён, и до HexColor на UserControl отсюда не дотянуться. -->
							<Panel Name="NoColorMark" IsHitTestVisible="False"
							       IsVisible="{TemplateBinding Tag, Converter={x:Static conv:IsNoColorCodeConverter.Instance}}">
								<Ellipse Width="17" Height="17" Fill="White"
								         HorizontalAlignment="Center" VerticalAlignment="Center"/>
								<!-- Крест собран из двух повёрнутых полосок, а не из Line: у Line
								     точки заданы в абсолютных координатах, размер фигуры берётся по
								     границам этой геометрии, и раскладка ставит фигуру по своему
								     выравниванию — нарисованное уезжает от центра кружка.
								     Прямоугольник с заданными сторонами центрируется раскладкой, а
								     поворот идёт вокруг его середины (RenderTransformOrigin по
								     умолчанию — центр), поэтому крест стоит ровно. -->
								<Rectangle Width="12" Height="1.6" Fill="#E53935"
								           HorizontalAlignment="Center" VerticalAlignment="Center"
								           RenderTransform="rotate(45deg)"/>
								<Rectangle Width="12" Height="1.6" Fill="#E53935"
								           HorizontalAlignment="Center" VerticalAlignment="Center"
								           RenderTransform="rotate(-45deg)"/>
							</Panel>
						</Panel>
					</ControlTemplate>
				</Setter>
			</Style>
			<!-- Подсветка при наведении — ТОЛЬКО цветом рамки (отрисовка). Толщину
			     не трогаем: BorderThickness — свойство раскладки, его смена
			     инвалидирует measure и заставляет ItemsRepeater перемерять все
			     видимые карточки (77 мс, «мерцает всё окно»). Оставляем 1.5.
			     Селектор бьёт строго по имени круглой подложки: без имени он красил
			     бы и рамку прямоугольного варианта, объявленного ниже. -->
			<Style Selector="Button#TriggerButton:pointerover /template/ Border#RoundRoot">
				<Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
			</Style>

			<!-- ══ Вариант «только стрелка»: Classes="arrow" ═══════════════════════
			     Нужен там, где цвет уже показан соседней кнопкой-действием, а от
			     пикера требуется лишь список цветов — как у цвета шрифта в Word.
			     Стили лежат здесь, а не в UserControl.Styles: круглый шаблон выше
			     объявлен именно в этой коллекции, она ближе к кнопке и потому
			     сильнее — из UserControl.Styles прямоугольный шаблон не применялся
			     вовсе. Внутри коллекции решает порядок, поэтому блок идёт последним.
			     Размер круглого варианта задан на самом контроле, так что ширину и
			     высоту прямоугольного нужно указывать на месте использования. -->
			<Style Selector="res|ColorPickerButton.arrow Button#TriggerButton">
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Template">
					<ControlTemplate>
						<!-- Кисти и толщина заданы напрямую, без TemplateBinding: у кнопки
						     они проставлены атрибутами в разметке — заливка цветом и
						     круглая рамка 1.5 — и пришли бы сюда как есть.
						     Цвет рамки, наоборот, не задан вовсе: атрибут был бы локальным
						     значением и перебил бы стили наведения ниже. -->
						<!-- Рамка только слева. Остальные три грани легли бы точно на общую
						     рамку панели и дали бы двойную линию; левая же грань нужна и
						     сама по себе — она разделяет половины. -->
						<Border Name="ArrowRoot" Background="Transparent"
						        CornerRadius="0 2 2 0" BorderThickness="1 0 0 0">
							<!-- 12×6 — размер в пропорции значка (10:5) с чётными сторонами.
							     При нечётной стороне остаток от центрирования равен половине
							     пикселя, округление уводит его в одну сторону, и стрелка
							     встаёт заметно не по центру. -->
							<PathIcon Width="12" Height="6"
							          HorizontalAlignment="Center" VerticalAlignment="Center"
							          Data="M0 0L5 5L10 0Z"
							          Foreground="{DynamicResource TextSecondaryBrush}"/>
						</Border>
					</ControlTemplate>
				</Setter>
			</Style>
			<!-- В покое левая грань — обычный разделитель. Цвет задан стилем, а не
			     атрибутом: атрибут был бы локальным значением и перебил бы состояния
			     ниже. -->
			<Style Selector="res|ColorPickerButton.arrow Button#TriggerButton /template/ Border#ArrowRoot">
				<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			</Style>
			<!-- Наведение, нажатие и открытый список показывают контур, а не заливку:
			     рядом стоит кнопка-действие в общей рамке, и заливка стрелки читалась
			     бы как отдельный элемент. Пока список открыт, стрелка остаётся
			     подсвеченной — иначе непонятно, чей это попап висит на экране. -->
			<Style Selector="res|ColorPickerButton.arrow Button#TriggerButton:pointerover /template/ Border#ArrowRoot">
				<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
			</Style>
			<!-- Нажатие безопасно подсвечивать вместе с открытым списком: признак
			     IsMenuOpen поднимается уже в момент открытия, поэтому внешняя рамка
			     загорается одновременно с гранью, и одинокой полоски при уводе
			     курсора с зажатой кнопкой не остаётся. -->
			<Style Selector="res|ColorPickerButton.arrow Button#TriggerButton:pressed /template/ Border#ArrowRoot">
				<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
			</Style>
			<Style Selector="res|ColorPickerButton.arrow Button#TriggerButton:flyout-open /template/ Border#ArrowRoot">
				<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
			</Style>
			<Style Selector="res|ColorPickerButton.arrow Button#TriggerButton:pointerover /template/ PathIcon">
				<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
			</Style>
			<Style Selector="res|ColorPickerButton.arrow Button#TriggerButton:flyout-open /template/ PathIcon">
				<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
			</Style>
		</Button.Styles>
		<Button.Flyout>
			<Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard">
				<Flyout.FlyoutPresenterTheme>
					<ControlTheme TargetType="FlyoutPresenter">
						<Setter Property="Padding" Value="0"/>
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="CornerRadius" Value="8"/>
					</ControlTheme>
				</Flyout.FlyoutPresenterTheme>
				<Border Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8">

					<!-- Прозрачный фон/трек скроллбара (убираем тёмную подложку). -->
					<Border.Resources>
						<SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
						<SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent"/>
						<SolidColorBrush x:Key="ScrollBarBackgroundDisabled" Color="Transparent"/>
						<SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
						<SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
						<SolidColorBrush x:Key="ScrollBarPanningBackground" Color="Transparent"/>
					</Border.Resources>

					<!-- Стили образцов, крестиков, заголовков секций и бейджей.
					     Лежат внутри попапа флаута, потому что стили самого
					     UserControl в попап не попадают. -->
					<Border.Styles>
						<Style Selector="Button.swatch">
							<Setter Property="Width" Value="26"/>
							<Setter Property="Height" Value="26"/>
							<Setter Property="MinWidth" Value="0"/>
							<Setter Property="MinHeight" Value="0"/>
							<Setter Property="Margin" Value="0"/>
							<Setter Property="Padding" Value="0"/>
							<Setter Property="Template">
								<ControlTemplate>
									<Border CornerRadius="13"
                                            Background="{Binding Converter={x:Static conv:ColorCodeToBrushConverter.Instance}}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1.5"/>
								</ControlTemplate>
							</Setter>
						</Style>
						<Style Selector="Button.swatch:pointerover /template/ Border">
							<Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
							<Setter Property="BorderThickness" Value="2.5"/>
						</Style>

						<Style Selector="Button.removeBtn">
							<Setter Property="Width" Value="14"/>
							<Setter Property="Height" Value="14"/>
							<Setter Property="MinWidth" Value="0"/>
							<Setter Property="MinHeight" Value="0"/>
							<Setter Property="Padding" Value="0"/>
							<Setter Property="FontSize" Value="9"/>
							<Setter Property="CornerRadius" Value="7"/>
							<Setter Property="BorderThickness" Value="0"/>
							<Setter Property="Background" Value="#E6202020"/>
							<Setter Property="Foreground" Value="White"/>
							<Setter Property="HorizontalAlignment" Value="Right"/>
							<Setter Property="VerticalAlignment" Value="Top"/>
							<Setter Property="HorizontalContentAlignment" Value="Center"/>
							<Setter Property="VerticalContentAlignment" Value="Center"/>
							<Setter Property="Margin" Value="0,-4,-4,0"/>
							<Setter Property="Opacity" Value="0"/>
							<Setter Property="IsHitTestVisible" Value="False"/>
						</Style>
						<Style Selector="Panel.swatchCell:pointerover Button.removeBtn">
							<Setter Property="Opacity" Value="1"/>
							<Setter Property="IsHitTestVisible" Value="True"/>
						</Style>

						<Style Selector="Path.chev">
							<Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
							<Setter Property="StrokeThickness" Value="1.5"/>
							<Setter Property="VerticalAlignment" Value="Center"/>
						</Style>

						<Style Selector="Border.badge">
							<Setter Property="CornerRadius" Value="4"/>
							<Setter Property="Padding" Value="5,1"/>
							<Setter Property="VerticalAlignment" Value="Center"/>
						</Style>
						<Style Selector="Border.badge TextBlock">
							<Setter Property="FontSize" Value="9"/>
						</Style>

						<Style Selector="TextBlock.section">
							<Setter Property="FontSize" Value="12"/>
							<Setter Property="FontWeight" Value="SemiBold"/>
							<Setter Property="VerticalAlignment" Value="Center"/>
							<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
						</Style>

						<!-- Заголовок секции-«папки»: полоска с фоном. -->
						<Style Selector="Button.ghost.sechdr /template/ ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
							<Setter Property="CornerRadius" Value="8"/>
							<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
							<Setter Property="BorderThickness" Value="1"/>
						</Style>
						<!-- Убираем «сжатие» (scale при нажатии) у ВСЕХ кнопок попапа.
						     Перебиваем transform-operations единичной трансформацией и
						     убираем сам переход трансформа на ContentPresenter. -->
						<Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="RenderTransform" Value="scale(1)"/>
							<Setter Property="Transitions" Value="{x:Null}"/>
						</Style>
						<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="RenderTransform" Value="scale(1)"/>
						</Style>
						<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="RenderTransform" Value="scale(1)"/>
						</Style>
						<Style Selector="Button">
							<Setter Property="RenderTransform" Value="scale(1)"/>
						</Style>
						<Style Selector="Button:pressed">
							<Setter Property="RenderTransform" Value="scale(1)"/>
						</Style>
						<!-- Шапка секции: фон не мигает при нажатии. -->
						<Style Selector="Button.ghost.sechdr:pressed /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
						</Style>
						<Style Selector="Button.ghost.sechdr:pointerover /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
						</Style>

						<!-- Наведение на заголовки: подсветка текста и шеврона (кликабельно). -->
						<Style Selector="Button.ghost.sechdr:pointerover TextBlock.section">
							<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
						</Style>
						<Style Selector="Button.ghost.sechdr:pointerover Path.chev">
							<Setter Property="Stroke" Value="{DynamicResource AccentDefaultBrush}"/>
						</Style>
						<Style Selector="Button.ghost:pointerover TextBlock.palname">
							<Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
						</Style>
						<Style Selector="Button.ghost:pointerover Path.chev">
							<Setter Property="Stroke" Value="{DynamicResource AccentDefaultBrush}"/>
						</Style>
						<!-- Раскрытая секция: низ шапки срастается с блоком цветов. -->
						<Style Selector="Button.ghost.sechdr.open /template/ ContentPresenter">
							<Setter Property="CornerRadius" Value="8,8,0,0"/>
							<Setter Property="BorderThickness" Value="1,1,1,0"/>
						</Style>

						<!-- Тело секции под кнопкой-заголовком: блок с рамкой и лёгким фоном. -->
						<Style Selector="Border.secblock">
							<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
							<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
							<Setter Property="BorderThickness" Value="1,0,1,1"/>
							<Setter Property="CornerRadius" Value="0,0,8,8"/>
							<Setter Property="Padding" Value="6"/>
							<Setter Property="Margin" Value="0,0,0,0"/>
							<!-- Прижат к низу: при схлопывании уезжает вверх под шапку (а не обрезается снизу). -->
							<Setter Property="VerticalAlignment" Value="Bottom"/>
						</Style>

						<!-- Схлопыватель: контент обрезается по высоте (уезжает вверх под шапку,
						     не сжимаясь), список снизу плавно смещается. MaxHeight подобран
						     близко к реальной высоте (иначе «мёртвая зона» делает анимацию резкой):
						     collapser — секции цветов, collapserS — цвета одной палитры,
						     collapserL — список палитр (переменная высота). -->
						<Style Selector="Border.collapser, Border.collapserS, Border.collapserL">
							<Setter Property="MaxHeight" Value="0"/>
							<Setter Property="Transitions">
								<Transitions>
									<DoubleTransition Property="MaxHeight" Duration="0:0:0.32" Easing="CubicEaseInOut"/>
								</Transitions>
							</Setter>
						</Style>
						<Style Selector="Border.collapser.open">
							<Setter Property="MaxHeight" Value="170"/>
						</Style>
						<Style Selector="Border.collapserS.open">
							<Setter Property="MaxHeight" Value="140"/>
						</Style>
						<Style Selector="Border.collapserL.open">
							<Setter Property="MaxHeight" Value="1400"/>
						</Style>

						<!-- Палитра-блок: свёрнутая — плоская строка, раскрытая — блок чуть
						     темнее секции, со своей рамкой (видно, что открыта). -->
						<!-- Карточка палитры — лёгкий контейнер; вид задают шапка и блок цветов
						     (как у секций). Скругление/обрезка по краю — на самой карточке. -->
						<Style Selector="Border.palcard">
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderThickness" Value="0"/>
						</Style>

						<!-- Шапка палитры: тёмная полоска-кнопка на весь верх. -->
						<Style Selector="Button.ghost.palhdr /template/ ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource BgBaseBrush}"/>
							<Setter Property="CornerRadius" Value="7"/>
							<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
							<Setter Property="BorderThickness" Value="1"/>
						</Style>
						<Style Selector="Button.ghost.palhdr.open /template/ ContentPresenter">
							<Setter Property="CornerRadius" Value="7,7,0,0"/>
							<Setter Property="BorderThickness" Value="1,1,1,0"/>
						</Style>
						<!-- Блок цветов палитры: срастается с шапкой (как secblock у секций). -->
						<Style Selector="Border.palbody">
							<Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
							<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
							<Setter Property="BorderThickness" Value="1,0,1,1"/>
							<Setter Property="CornerRadius" Value="0,0,7,7"/>
							<Setter Property="Padding" Value="6,2,6,6"/>
							<Setter Property="VerticalAlignment" Value="Bottom"/>
						</Style>

						<!-- Скроллбар: всегда виден, без тёмной подложки-трека. -->
						<Style Selector="ScrollBar">
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderThickness" Value="0"/>
						</Style>
						<Style Selector="ScrollBar /template/ Border">
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Setter Property="BorderThickness" Value="0"/>
						</Style>
						<Style Selector="ScrollBar /template/ Grid">
							<Setter Property="Background" Value="Transparent"/>
						</Style>
						<!-- Стили мини-подборщика (ПКМ): свой градиентный ползунок вместо
						     сломанного встроенного «третьего ползунка» ColorSpectrum, свои
						     подписи полей, кнопки переключения RGB/HSL/HSV и иконка-кнопка
						     «пересобрать». Слайдер — тот же шаблон, что и в окне «Настроить
						     цвет» (Styles/UserControls/ColorEditorOverlay.axaml), просто своя
						     копия: стили UserControl.Styles во всплывашку флаута не попадают. -->
						<Style Selector="Slider.grad">
							<Setter Property="MinHeight" Value="20"/>
							<Setter Property="Height" Value="20"/>
							<Setter Property="VerticalAlignment" Value="Center"/>
							<Setter Property="Template">
								<ControlTemplate>
									<Grid VerticalAlignment="Center">
										<Border Height="7" CornerRadius="3.5" VerticalAlignment="Center"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"/>
										<Track Name="PART_Track" Orientation="Horizontal"
                                               Minimum="{TemplateBinding Minimum}"
                                               Maximum="{TemplateBinding Maximum}"
                                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
											<Track.DecreaseButton>
												<RepeatButton Name="PART_DecreaseButton" Focusable="False"
                                                              Background="Transparent" BorderThickness="0">
													<RepeatButton.Template>
														<ControlTemplate><Border Background="Transparent"/></ControlTemplate>
													</RepeatButton.Template>
												</RepeatButton>
											</Track.DecreaseButton>
											<Track.IncreaseButton>
												<RepeatButton Name="PART_IncreaseButton" Focusable="False"
                                                              Background="Transparent" BorderThickness="0">
													<RepeatButton.Template>
														<ControlTemplate><Border Background="Transparent"/></ControlTemplate>
													</RepeatButton.Template>
												</RepeatButton>
											</Track.IncreaseButton>
											<Thumb Width="14" Height="14" Padding="0">
												<Thumb.Template>
													<ControlTemplate>
														<Border Background="White" CornerRadius="7"
                                                                BorderBrush="#444444" BorderThickness="1">
															<Border.Effect>
																<DropShadowEffect BlurRadius="3" OffsetX="0" OffsetY="0"
                                                                                  Opacity="0.5" Color="#000000"/>
															</Border.Effect>
														</Border>
													</ControlTemplate>
												</Thumb.Template>
											</Thumb>
										</Track>
									</Grid>
								</ControlTemplate>
							</Setter>
						</Style>

						<!-- Вертикальный вариант того же ползунка: для колеса V
						     стоит сбоку, а шаблон Slider.grad жёстко горизонтальный —
						     у него и трек, и высота полосы заданы поперёк.
						     IsDirectionReversed берётся у самого Slider, а не
						     проставляется жёстко: Slider считает щелчок и перетаскивание
						     по своему свойству, и прибитое к треку True переворачивало
						     ход — вниз тянешь, значение растёт. -->
						<Style Selector="Slider.gradv">
							<Setter Property="MinWidth" Value="20"/>
							<Setter Property="Width" Value="20"/>
							<Setter Property="MinHeight" Value="0"/>
							<Setter Property="HorizontalAlignment" Value="Center"/>
							<Setter Property="VerticalAlignment" Value="Stretch"/>
							<Setter Property="Template">
								<ControlTemplate>
									<Grid HorizontalAlignment="Center">
										<Border Width="7" CornerRadius="3.5" HorizontalAlignment="Center"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"/>
										<Track Name="PART_Track" Orientation="Vertical"
                                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                               Minimum="{TemplateBinding Minimum}"
                                               Maximum="{TemplateBinding Maximum}"
                                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
											<Track.DecreaseButton>
												<RepeatButton Name="PART_DecreaseButton" Focusable="False"
                                                              Background="Transparent" BorderThickness="0">
													<RepeatButton.Template>
														<ControlTemplate><Border Background="Transparent"/></ControlTemplate>
													</RepeatButton.Template>
												</RepeatButton>
											</Track.DecreaseButton>
											<Track.IncreaseButton>
												<RepeatButton Name="PART_IncreaseButton" Focusable="False"
                                                              Background="Transparent" BorderThickness="0">
													<RepeatButton.Template>
														<ControlTemplate><Border Background="Transparent"/></ControlTemplate>
													</RepeatButton.Template>
												</RepeatButton>
											</Track.IncreaseButton>
											<Thumb Width="14" Height="14" Padding="0">
												<Thumb.Template>
													<ControlTemplate>
														<Border Background="White" CornerRadius="7"
                                                                BorderBrush="#444444" BorderThickness="1">
															<Border.Effect>
																<DropShadowEffect BlurRadius="3" OffsetX="0" OffsetY="0"
                                                                                  Opacity="0.5" Color="#000000"/>
															</Border.Effect>
														</Border>
													</ControlTemplate>
												</Thumb.Template>
											</Thumb>
										</Track>
									</Grid>
								</ControlTemplate>
							</Setter>
						</Style>

						<Style Selector="TextBlock.miniVLabel">
							<Setter Property="FontSize" Value="11"/>
							<Setter Property="HorizontalAlignment" Value="Center"/>
							<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
						</Style>

						<Style Selector="TextBlock.miniFieldLabel">
							<Setter Property="Width" Value="14"/>
							<Setter Property="FontSize" Value="11"/>
							<Setter Property="VerticalAlignment" Value="Center"/>
							<Setter Property="HorizontalAlignment" Value="Right"/>
							<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
						</Style>
						<Style Selector="TextBlock.miniValNum">
							<Setter Property="Width" Value="30"/>
							<Setter Property="FontSize" Value="11"/>
							<Setter Property="VerticalAlignment" Value="Center"/>
							<Setter Property="HorizontalAlignment" Value="Right"/>
							<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
						</Style>

						<!-- Переключатель RGB / HSL / HSV во «Значениях»: три маленькие
						     кнопки с подписями вместо непонятной кнопки-загадки сверху. -->
						<Style Selector="Button.valmode">
							<Setter Property="Padding" Value="0"/>
							<Setter Property="Margin" Value="0"/>
							<Setter Property="MinWidth" Value="0"/>
							<Setter Property="MinHeight" Value="0"/>
							<Setter Property="Width" Value="60"/>
							<Setter Property="Height" Value="22"/>
							<Setter Property="FontSize" Value="11"/>
							<Setter Property="CornerRadius" Value="6"/>
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
							<Setter Property="BorderThickness" Value="1"/>
							<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
							<Setter Property="HorizontalContentAlignment" Value="Center"/>
							<Setter Property="VerticalContentAlignment" Value="Center"/>
						</Style>
						<Style Selector="Button.valmode.active">
							<Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
							<Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}"/>
							<Setter Property="Foreground" Value="White"/>
						</Style>

						<!-- Круглая кнопка-иконка мини-подборщика (пересобрать шум и т.п.) —
						     тот же приём, что и Button.addtile в окне «Настроить цвет». -->
						<Style Selector="Button.miniIconBtn">
							<Setter Property="Width" Value="26"/>
							<Setter Property="Height" Value="26"/>
							<Setter Property="MinWidth" Value="0"/>
							<Setter Property="MinHeight" Value="0"/>
							<Setter Property="Margin" Value="0"/>
							<Setter Property="Padding" Value="0"/>
							<Setter Property="HorizontalContentAlignment" Value="Center"/>
							<Setter Property="VerticalContentAlignment" Value="Center"/>
							<Setter Property="CornerRadius" Value="999"/>
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
							<Setter Property="BorderThickness" Value="1.5"/>
							<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
						</Style>
					</Border.Styles>

					<Grid Width="280" RowDefinitions="Auto,*,Auto">

					<!-- Мини-подборщик. Показывается вместо заготовок, когда
					     правой кнопкой выбран квадрат, колесо, соты, шум или
					     значения: цвет меняется прямо здесь и уходит наружу на
					     каждое движение, без открытия большого окна.

					     Спектр здесь — примитив ColorSpectrum, а не целый
					     ColorView. У ColorView шаблон — это TabControl с
					     полосой вкладок и жёсткой шириной 350: даже с
					     погашенными вкладками полоса оставалась висеть над
					     спектром непонятной плашкой, а сам спектр растягивало
					     в прямоугольник. Примитиву задаются равные Width и
					     Height, и он квадратный (в режиме колеса — круглый и
					     целиком видимый), а третью составляющую даёт свой
					     ползунок V ниже, с нормальным градиентом на треке. -->
					<StackPanel Grid.Row="0" x:Name="MiniPickerHost"
					            IsVisible="False"
					            Margin="8,4,8,0" Spacing="8">
						<!-- Квадрат и колесо. Одна и та же поверхность, вид
						     переключается в коде через Shape. Размер задан
						     стороной, а не растяжением: у спектра нет своего
						     желаемого размера, и без явных Width/Height он
						     занимал бы всю доступную ширину всплывашки. -->
						<StackPanel x:Name="SpectrumHost" IsVisible="False" Spacing="8">
							<Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10"
							      HorizontalAlignment="Center">
								<!-- Колесо (HueSaturation) рисуется у Avalonia всегда при
								     полной яркости: V там жёстко равно единице, и от
								     ползунка картинка не менялась. Яркость даёт чёрный
								     слой поверх с прозрачностью 1 - V — ровно так же,
								     как WheelDim у колеса в окне «Настроить цвет».
								     Квадрату слой не нужен: у него V — это сама ось. -->
								<Panel Grid.Column="0" Width="212" Height="212">
									<cpp:ColorSpectrum x:Name="MiniSpectrum"
									                   Width="212" Height="212"
									                   MinWidth="0" MinHeight="0"
									                   Components="HueSaturation"
									                   Shape="Box"/>
									<Ellipse x:Name="SpectrumDimRing" Fill="Black" Opacity="0"
									         IsVisible="False" IsHitTestVisible="False"/>
								</Panel>

								<!-- Третья составляющая стоит вплотную сбоку и во всю
								     высоту спектра. Под спектром эта полоса читалась
								     как оторванная от него деталь, а места справа всё
								     равно пусто.

								     У колеса третья составляющая — яркость, у квадрата
								     (насыщенность × яркость) — оттенок, ровно как в
								     окне «Настроить цвет»: там рядом с квадратом стоит
								     радужная полоса HueBar. Полосы две, показывается
								     та, что подходит виду. -->
								<Grid x:Name="SpectrumVColumn" Grid.Column="1" IsVisible="False"
								      RowDefinitions="Auto,*,Auto" RowSpacing="4">
									<TextBlock Grid.Row="0" Text="V" Classes="miniVLabel"/>
									<Slider Grid.Row="1" x:Name="MiniSlVv" Classes="gradv"
									        Orientation="Vertical"
									        Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
									        ValueChanged="OnMiniValueChanged"/>
									<TextBlock Grid.Row="2" Classes="miniVLabel"
									           Text="{Binding Value, ElementName=MiniSlVv, StringFormat={}{0:F0}}"/>
								</Grid>

								<!-- Оттенок: ноль сверху, как у полосы в окне «Настроить
								     цвет», поэтому ход перевёрнут. Радуга задана прямо
								     здесь — она не зависит от выбранного цвета и в коде
								     ей делать нечего. -->
								<Grid x:Name="SpectrumHColumn" Grid.Column="1" IsVisible="False"
								      RowDefinitions="Auto,*,Auto" RowSpacing="4">
									<TextBlock Grid.Row="0" Text="H" Classes="miniVLabel"/>
									<Slider Grid.Row="1" x:Name="MiniSlH" Classes="gradv"
									        Orientation="Vertical" IsDirectionReversed="True"
									        Minimum="0" Maximum="360" SmallChange="1" LargeChange="15"
									        ValueChanged="OnMiniHueChanged">
										<Slider.Background>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
												<GradientStop Offset="0" Color="#FF0000"/>
												<GradientStop Offset="0.1667" Color="#FFFF00"/>
												<GradientStop Offset="0.3333" Color="#00FF00"/>
												<GradientStop Offset="0.5" Color="#00FFFF"/>
												<GradientStop Offset="0.6667" Color="#0000FF"/>
												<GradientStop Offset="0.8333" Color="#FF00FF"/>
												<GradientStop Offset="1" Color="#FF0000"/>
											</LinearGradientBrush>
										</Slider.Background>
									</Slider>
									<TextBlock Grid.Row="2" Classes="miniVLabel"
									           Text="{Binding Value, ElementName=MiniSlH, StringFormat={}{0:F0}}"/>
								</Grid>
							</Grid>
						</StackPanel>

						<!-- Соты: своя сетка, ColorView их не умеет. -->
						<Border x:Name="HoneycombHost" IsVisible="False"
						        HorizontalAlignment="Center">
							<res:HoneycombPicker x:Name="MiniHoneycomb" CellRadius="9"/>
						</Border>

						<!-- Шум: поле случайных цветов, набор сверху, пересбор
						     значком. При выборе цвета — приближение к точке клика
						     (см. Styles/UserControls/NoisePicker.cs), а не
						     мгновенная отдача цвета: иначе легко промахнуться и
						     не увидеть, какой цвет вообще был взят. Наезд тот же,
						     что и в окне «Настроить цвет», и вторым значком поле
						     возвращается к общему виду. -->
						<StackPanel x:Name="NoiseHost" IsVisible="False" Spacing="6">
							<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
								<ComboBox Grid.Column="0" x:Name="MiniNoisePreset"
								          HorizontalAlignment="Stretch"
								          FontSize="11"
								          SelectedIndex="0"
								          SelectionChanged="OnMiniNoisePreset">
									<ComboBoxItem Tag="rainbow" Content="Радуга"/>
									<ComboBoxItem Tag="skin" Content="Кожа"/>
									<ComboBoxItem Tag="pastel" Content="Пастель"/>
									<ComboBoxItem Tag="gray" Content="Серое"/>
									<ComboBoxItem Tag="neon" Content="Неон"/>
								</ComboBox>
								<Button Grid.Column="1" Classes="miniIconBtn" Click="OnMiniNoiseRegen"
								        ToolTip.Tip="Пересобрать поле">
									<PathIcon Width="12" Height="12"
									          Data="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
								</Button>
								<Button Grid.Column="2" Classes="miniIconBtn" Click="OnMiniNoiseReset"
								        ToolTip.Tip="Вернуть общий вид поля">
									<PathIcon Width="12" Height="12"
									          Data="M15 3l2.3 2.3-2.89 2.87 1.42 1.42L18.7 6.7 21 9V3h-6zM3 9l2.3-2.3 2.87 2.89 1.42-1.42L6.7 5.3 9 3H3v6zm6 12l-2.3-2.3 2.89-2.87-1.42-1.42L5.3 17.3 3 15v6h6zm12-6l-2.3 2.3-2.87-2.89-1.42 1.42 2.89 2.87L15 21h6v-6z"/>
								</Button>
							</Grid>
							<res:NoisePicker x:Name="MiniNoise"
							                 Width="212" Height="212" Resolution="64"
							                 CornerRadius="6" ClipToBounds="True"
							                 HorizontalAlignment="Center"/>
						</StackPanel>

						<!-- Квадрат / колесо / соты: строки RGB под спектром —
						     раньше их не было вовсе. -->
						<ScrollViewer x:Name="RgbRowsHost" IsVisible="False" MaxHeight="110"
						              HorizontalScrollBarVisibility="Disabled"
						              VerticalScrollBarVisibility="Auto">
							<Grid ColumnDefinitions="14,*,30" RowDefinitions="Auto,Auto,Auto"
							      ColumnSpacing="6" RowSpacing="5">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="R" Classes="miniFieldLabel"/>
								<Slider Grid.Row="0" Grid.Column="1" x:Name="MiniSlR" Classes="grad"
								        Minimum="0" Maximum="255" ValueChanged="OnMiniRgbChanged"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=MiniSlR, StringFormat={}{0:F0}}"/>
								<TextBlock Grid.Row="1" Grid.Column="0" Text="G" Classes="miniFieldLabel"/>
								<Slider Grid.Row="1" Grid.Column="1" x:Name="MiniSlG" Classes="grad"
								        Minimum="0" Maximum="255" ValueChanged="OnMiniRgbChanged"/>
								<TextBlock Grid.Row="1" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=MiniSlG, StringFormat={}{0:F0}}"/>
								<TextBlock Grid.Row="2" Grid.Column="0" Text="B" Classes="miniFieldLabel"/>
								<Slider Grid.Row="2" Grid.Column="1" x:Name="MiniSlB" Classes="grad"
								        Minimum="0" Maximum="255" ValueChanged="OnMiniRgbChanged"/>
								<TextBlock Grid.Row="2" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=MiniSlB, StringFormat={}{0:F0}}"/>
							</Grid>
						</ScrollViewer>

						<!-- Значения: переключатель RGB / HSL / HSV тремя маленькими
						     подписанными кнопками вместо непонятной кнопки-загадки. -->
						<StackPanel x:Name="ValuesHost" IsVisible="False" Spacing="6">
							<StackPanel Orientation="Horizontal" Spacing="4">
								<Button x:Name="ValModeRgbBtn" Classes="valmode active" Tag="rgb"
								        Content="RGB" Click="OnValModeClick"/>
								<Button x:Name="ValModeHslBtn" Classes="valmode" Tag="hsl"
								        Content="HSL" Click="OnValModeClick"/>
								<Button x:Name="ValModeHsvBtn" Classes="valmode" Tag="hsv"
								        Content="HSV" Click="OnValModeClick"/>
							</StackPanel>

							<Grid x:Name="ValRgbRows" ColumnDefinitions="14,*,30" RowDefinitions="Auto,Auto,Auto"
							      ColumnSpacing="6" RowSpacing="5">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="R" Classes="miniFieldLabel"/>
								<Slider Grid.Row="0" Grid.Column="1" x:Name="ValSlR" Classes="grad"
								        Minimum="0" Maximum="255" ValueChanged="OnValRgbChanged"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=ValSlR, StringFormat={}{0:F0}}"/>
								<TextBlock Grid.Row="1" Grid.Column="0" Text="G" Classes="miniFieldLabel"/>
								<Slider Grid.Row="1" Grid.Column="1" x:Name="ValSlG" Classes="grad"
								        Minimum="0" Maximum="255" ValueChanged="OnValRgbChanged"/>
								<TextBlock Grid.Row="1" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=ValSlG, StringFormat={}{0:F0}}"/>
								<TextBlock Grid.Row="2" Grid.Column="0" Text="B" Classes="miniFieldLabel"/>
								<Slider Grid.Row="2" Grid.Column="1" x:Name="ValSlB" Classes="grad"
								        Minimum="0" Maximum="255" ValueChanged="OnValRgbChanged"/>
								<TextBlock Grid.Row="2" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=ValSlB, StringFormat={}{0:F0}}"/>
							</Grid>

							<Grid x:Name="ValHslRows" IsVisible="False"
							      ColumnDefinitions="14,*,30" RowDefinitions="Auto,Auto,Auto"
							      ColumnSpacing="6" RowSpacing="5">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="H" Classes="miniFieldLabel"/>
								<Slider Grid.Row="0" Grid.Column="1" x:Name="ValSlHslH" Classes="grad"
								        Minimum="0" Maximum="360" ValueChanged="OnValHslChanged"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=ValSlHslH, StringFormat={}{0:F0}}"/>
								<TextBlock Grid.Row="1" Grid.Column="0" Text="S" Classes="miniFieldLabel"/>
								<Slider Grid.Row="1" Grid.Column="1" x:Name="ValSlHslS" Classes="grad"
								        Minimum="0" Maximum="100" ValueChanged="OnValHslChanged"/>
								<TextBlock Grid.Row="1" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=ValSlHslS, StringFormat={}{0:F0}}"/>
								<TextBlock Grid.Row="2" Grid.Column="0" Text="L" Classes="miniFieldLabel"/>
								<Slider Grid.Row="2" Grid.Column="1" x:Name="ValSlHslL" Classes="grad"
								        Minimum="0" Maximum="100" ValueChanged="OnValHslChanged"/>
								<TextBlock Grid.Row="2" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=ValSlHslL, StringFormat={}{0:F0}}"/>
							</Grid>

							<Grid x:Name="ValHsvRows" IsVisible="False"
							      ColumnDefinitions="14,*,30" RowDefinitions="Auto,Auto,Auto"
							      ColumnSpacing="6" RowSpacing="5">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="H" Classes="miniFieldLabel"/>
								<Slider Grid.Row="0" Grid.Column="1" x:Name="ValSlHsvH" Classes="grad"
								        Minimum="0" Maximum="360" ValueChanged="OnValHsvChanged"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=ValSlHsvH, StringFormat={}{0:F0}}"/>
								<TextBlock Grid.Row="1" Grid.Column="0" Text="S" Classes="miniFieldLabel"/>
								<Slider Grid.Row="1" Grid.Column="1" x:Name="ValSlHsvS" Classes="grad"
								        Minimum="0" Maximum="100" ValueChanged="OnValHsvChanged"/>
								<TextBlock Grid.Row="1" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=ValSlHsvS, StringFormat={}{0:F0}}"/>
								<TextBlock Grid.Row="2" Grid.Column="0" Text="V" Classes="miniFieldLabel"/>
								<Slider Grid.Row="2" Grid.Column="1" x:Name="ValSlHsvV" Classes="grad"
								        Minimum="0" Maximum="100" ValueChanged="OnValHsvChanged"/>
								<TextBlock Grid.Row="2" Grid.Column="2" Classes="miniValNum"
								           Text="{Binding Value, ElementName=ValSlHsvV, StringFormat={}{0:F0}}"/>
							</Grid>
						</StackPanel>

						<!-- Альфа: одна на все виды мини-подборщика, всегда видна —
						     раньше её не было ни в одном из режимов ПКМ. -->
						<Grid ColumnDefinitions="14,*,30" ColumnSpacing="6">
							<TextBlock Grid.Column="0" Text="A" Classes="miniFieldLabel"/>
							<Slider Grid.Column="1" x:Name="MiniSlA" Classes="grad"
							        Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
							        ValueChanged="OnMiniAlphaChanged"/>
							<TextBlock Grid.Column="2" Classes="miniValNum"
							           Text="{Binding Value, ElementName=MiniSlA, StringFormat={}{0:F0}}"/>
						</Grid>
					</StackPanel>

					<ScrollViewer Grid.Row="1" x:Name="PresetsScroll" MaxHeight="520" AllowAutoHide="False"
					              HorizontalScrollBarVisibility="Disabled"
					              VerticalScrollBarVisibility="Auto">
					<StackPanel Spacing="6" Margin="8,0,8,0">

						<!-- Основные -->
						<StackPanel Spacing="6">
							<Button Classes="ghost sechdr" Classes.open="{Binding BasicExpanded, ElementName=Root}" Tag="pp.basic" Click="OnSectionHeader"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="6,4">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Classes="section"
                                               Text="{x:Static res:SharedStrings.ColorPicker_BasicColors}"/>
									<Path Grid.Column="1" Classes="chev" Data="M0,0 L5,5 L10,0"
                                          IsVisible="{Binding BasicExpanded, ElementName=Root}"/>
									<Path Grid.Column="1" Classes="chev" Data="M0,0 L5,5 L0,10"
                                          IsVisible="{Binding BasicExpanded, ElementName=Root, Converter={x:Static res:PaletteConverters.Not}}"/>
								</Grid>
							</Button>
							<LayoutTransformControl ClipToBounds="True" Margin="0,-6,0,0">
								<LayoutTransformControl.LayoutTransform>
									<!-- Переход ScaleY навешивается кодом после показа попапа
									     (SetCollapseTransitions): объявленный в разметке, он проигрывал
									     анимацию сворачивания прямо при построении содержимого. -->
									<ScaleTransform ScaleY="{Binding BasicExpanded, ElementName=Root, Converter={x:Static res:PaletteConverters.Scale}}"/>
								</LayoutTransformControl.LayoutTransform>
								<Border Classes="secblock">
								<ItemsControl ItemsSource="{Binding PresetColors, ElementName=Root}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Width="26" Height="26" Margin="2">
											<Panel>
												<Button Classes="swatch"
                                                        Command="{Binding SelectPresetCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"/>
												<!-- «Без цвета»: белый кружок с полным крестом (как лампочка
												     в схемотехнике) поверх прозрачного образца; клики проходят
												     в кнопку. -->
												<Panel IsHitTestVisible="False"
												       IsVisible="{Binding Converter={x:Static res:PaletteConverters.IsNoColor}}">
													<Ellipse Width="22" Height="22" Fill="White"
													         HorizontalAlignment="Center" VerticalAlignment="Center"/>
													<Line StartPoint="6,20" EndPoint="20,6"
													      Stroke="#E53935" StrokeThickness="2"/>
													<Line StartPoint="6,6" EndPoint="20,20"
													      Stroke="#E53935" StrokeThickness="2"/>
												</Panel>
											</Panel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							</Border>
							</LayoutTransformControl>
						</StackPanel>

						<!-- Мои цвета (закреплённые проекта) -->
						<StackPanel Spacing="6" IsVisible="{Binding HasPinnedColors, ElementName=Root}">
							<Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,2"/>
							<Button Classes="ghost sechdr" Classes.open="{Binding MineExpanded, ElementName=Root}" Tag="pp.mine" Click="OnSectionHeader"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="6,4">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Classes="section"
                                               Text="{x:Static res:SharedStrings.ColorEditor_MyColors}"/>
									<Path Grid.Column="1" Classes="chev" Data="M0,0 L5,5 L10,0"
                                          IsVisible="{Binding MineExpanded, ElementName=Root}"/>
									<Path Grid.Column="1" Classes="chev" Data="M0,0 L5,5 L0,10"
                                          IsVisible="{Binding MineExpanded, ElementName=Root, Converter={x:Static res:PaletteConverters.Not}}"/>
								</Grid>
							</Button>
							<LayoutTransformControl ClipToBounds="True" Margin="0,-6,0,0">
								<LayoutTransformControl.LayoutTransform>
									<ScaleTransform ScaleY="{Binding MineExpanded, ElementName=Root, Converter={x:Static res:PaletteConverters.Scale}}"/>
								</LayoutTransformControl.LayoutTransform>
								<Border Classes="secblock">
								<ItemsControl ItemsSource="{Binding PinnedColors, ElementName=Root}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Width="26" Height="26" Margin="2">
											<Panel>
												<Button Classes="swatch"
                                                        Command="{Binding SelectPresetCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"/>
												<!-- «Без цвета»: белый кружок с полным крестом (как лампочка
												     в схемотехнике) поверх прозрачного образца; клики проходят
												     в кнопку. -->
												<Panel IsHitTestVisible="False"
												       IsVisible="{Binding Converter={x:Static res:PaletteConverters.IsNoColor}}">
													<Ellipse Width="22" Height="22" Fill="White"
													         HorizontalAlignment="Center" VerticalAlignment="Center"/>
													<Line StartPoint="6,20" EndPoint="20,6"
													      Stroke="#E53935" StrokeThickness="2"/>
													<Line StartPoint="6,6" EndPoint="20,20"
													      Stroke="#E53935" StrokeThickness="2"/>
												</Panel>
											</Panel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							</Border>
							</LayoutTransformControl>
						</StackPanel>

						<!-- Недавние -->
						<StackPanel Spacing="6" IsVisible="{Binding HasRecentColors, ElementName=Root}">
							<Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,2"/>
							<Button Classes="ghost sechdr" Classes.open="{Binding RecentExpanded, ElementName=Root}" Tag="pp.recent" Click="OnSectionHeader"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="6,4">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Classes="section"
                                               Text="{x:Static res:SharedStrings.ColorPicker_Recent}"/>
									<Path Grid.Column="1" Classes="chev" Data="M0,0 L5,5 L10,0"
                                          IsVisible="{Binding RecentExpanded, ElementName=Root}"/>
									<Path Grid.Column="1" Classes="chev" Data="M0,0 L5,5 L0,10"
                                          IsVisible="{Binding RecentExpanded, ElementName=Root, Converter={x:Static res:PaletteConverters.Not}}"/>
								</Grid>
							</Button>
							<LayoutTransformControl ClipToBounds="True" Margin="0,-6,0,0">
								<LayoutTransformControl.LayoutTransform>
									<ScaleTransform ScaleY="{Binding RecentExpanded, ElementName=Root, Converter={x:Static res:PaletteConverters.Scale}}"/>
								</LayoutTransformControl.LayoutTransform>
								<Border Classes="secblock">
								<ItemsControl ItemsSource="{Binding RecentColors, ElementName=Root}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Panel Classes="swatchCell" Width="26" Height="26" Margin="2">
											<Button Classes="swatch"
                                                    Command="{Binding SelectPresetCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"/>
											<Button Classes="removeBtn" Content="✕"
                                                    Command="{Binding RemoveRecentCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{x:Static res:SharedStrings.ColorPicker_RemoveFromPalette}"/>
										</Panel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							</Border>
							</LayoutTransformControl>
						</StackPanel>

						<!-- Палитры (видимые) -->
						<StackPanel Spacing="6" IsVisible="{Binding HasPalettes, ElementName=Root}">
							<Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,2"/>
							<Button Classes="ghost sechdr" Classes.open="{Binding PalettesExpanded, ElementName=Root}" Tag="pp.palettes" Click="OnSectionHeader"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="6,4">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Classes="section"
                                               Text="{x:Static res:SharedStrings.Palette_Palettes}"/>
									<Path Grid.Column="1" Classes="chev" Data="M0,0 L5,5 L10,0"
                                          IsVisible="{Binding PalettesExpanded, ElementName=Root}"/>
									<Path Grid.Column="1" Classes="chev" Data="M0,0 L5,5 L0,10"
                                          IsVisible="{Binding PalettesExpanded, ElementName=Root, Converter={x:Static res:PaletteConverters.Not}}"/>
								</Grid>
							</Button>
							<LayoutTransformControl ClipToBounds="True" Margin="0,-6,0,0">
								<LayoutTransformControl.LayoutTransform>
									<ScaleTransform ScaleY="{Binding PalettesExpanded, ElementName=Root, Converter={x:Static res:PaletteConverters.Scale}}"/>
								</LayoutTransformControl.LayoutTransform>
								<Border Classes="secblock">
								<ItemsControl ItemsSource="{Binding PopupPalettes, ElementName=Root}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Classes="palcard" Classes.open="{Binding Expanded}"
													        Margin="0,3" Padding="0" CornerRadius="8">
												<StackPanel Spacing="0">
											<Button Classes="ghost palhdr" Classes.open="{Binding Expanded}" Click="OnPalettePopupHeader"
													        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,5">
													<Grid ColumnDefinitions="*,Auto">
													<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
												<TextBlock Classes="palname" Text="{Binding DisplayName}" FontSize="11" FontWeight="Medium"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
												<Border Classes="badge" IsVisible="{Binding IsGlobal}"
                                                        Background="{DynamicResource SectionGlobalBgBrush}">
													<TextBlock Text="{x:Static res:SharedStrings.Palette_Global}"
                                                               Foreground="{DynamicResource SectionGlobalFgBrush}"/>
												</Border>
												<Border Classes="badge" IsVisible="{Binding IsLocal}"
                                                        Background="{DynamicResource SectionProjectBgBrush}">
													<TextBlock Text="{x:Static res:SharedStrings.Palette_Local}"
                                                               Foreground="{DynamicResource SectionProjectFgBrush}"/>
												</Border>
											</StackPanel>
											<Path Grid.Column="1" Classes="chev" Data="M0,0 L5,5 L10,0"
													      IsVisible="{Binding Expanded}"/>
												<Path Grid.Column="1" Classes="chev" Data="M0,0 L5,5 L0,10"
													      IsVisible="{Binding Expanded, Converter={x:Static res:PaletteConverters.Not}}"/>
												</Grid>
												</Button>
												<LayoutTransformControl ClipToBounds="True">
												<LayoutTransformControl.LayoutTransform>
													<ScaleTransform ScaleY="{Binding Expanded, Converter={x:Static res:PaletteConverters.Scale}}"/>
												</LayoutTransformControl.LayoutTransform>
												<Border Classes="palbody">
												<ItemsControl ItemsSource="{Binding Palette.Colors}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border Width="26" Height="26" Margin="2">
															<Button Classes="swatch"
                                                                    Command="{Binding SelectPresetCommand, ElementName=Root}"
                                                                    CommandParameter="{Binding}"/>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
												</Border>
											</LayoutTransformControl>
										</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							</Border>
							</LayoutTransformControl>
						</StackPanel>

						</StackPanel>
					</ScrollViewer>

					<StackPanel Grid.Row="2" Spacing="6" Margin="8,6,8,0">
						<Button Content="{x:Static res:SharedStrings.ColorPicker_Configure}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontSize="11" Padding="8,6" CornerRadius="6"
                                Background="{DynamicResource AccentDefaultBrush}" Foreground="White"
                                Click="OnConfigureClick"/>

					</StackPanel>
					</Grid>
				</Border>
			</Flyout>
		</Button.Flyout>
	</Button>

</UserControl>
