<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AssemblyName>Writersword.Characters</AssemblyName>
		<RootNamespace>Writersword.Src.Modules.Characters</RootNamespace>
		<!-- SDK Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё РІРєР»СЋС‡Р°РµС‚ РІСЃРµ *.cs Рё *.axaml РёР· РїР°РїРєРё РїСЂРѕРµРєС‚Р° -->
		<!-- РЇРІРЅС‹Рµ Include РЅРµ РЅСѓР¶РЅС‹ вЂ” РѕРЅРё СЃРѕР·РґР°СЋС‚ РґСѓР±Р»РёРєР°С‚С‹ (NETSDK1022) -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\*.resx" />
	</ItemGroup>

	<!-- Р’СЃС‚СЂРѕРµРЅРЅС‹Рµ РїР°РєРё Р°РІР°С‚Р°СЂРѕРє вЂ” РєРѕРїРёСЂСѓСЋС‚СЃСЏ РІ Avatars/ СЂСЏРґРѕРј СЃ DLL -->
	<ItemGroup>
		<Content Include="Resources\Assets\Avatars\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Avatars\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.3" />
		<PackageReference Include="Avalonia.Skia" Version="12.0.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
		<PackageReference Include="Serilog" Version="4.3.2-dev-02419" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Core Р»РµР¶РёС‚ РІ Src/ вЂ” РґРІР° СѓСЂРѕРІРЅСЏ РІРІРµСЂС… РѕС‚ Src/Modules/Characters/ -->
		<ProjectReference Include="..\..\Writersword.Core.csproj" />
		<ProjectReference Include="..\..\..\Writersword.UI.Shared.csproj" />
	</ItemGroup>

</Project>