<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.ViewModels.Components"
             xmlns:converters="using:Writersword.Converters"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:behaviors="using:Writersword.Behaviors"
             x:Class="Writersword.Views.Components.WorkModeBarView"
             x:DataType="vm:WorkModeBarViewModel"
             x:Name="WorkModeBarViewRoot">

	<UserControl.Resources>
		<converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
	</UserControl.Resources>

	<Border Background="#2D2D30"
            BorderBrush="#3F3F46"
            BorderThickness="0,0,0,1"
            Padding="10,5">

		<ItemsControl ItemsSource="{Binding WorkModes}">

			<i:Interaction.Behaviors>
				<behaviors:WorkModeDragDropBehavior />
			</i:Interaction.Behaviors>

			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" Spacing="5"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Button Content="{Binding Title}"
                            Command="{Binding #WorkModeBarViewRoot.DataContext.SwitchWorkModeCommand}"
                            CommandParameter="{Binding}"
                            Padding="10,4"
                            FontSize="12">

						<!-- TranslateTransform для drag-and-drop анимации -->
						<Button.RenderTransform>
							<TranslateTransform X="0" Y="0" />
						</Button.RenderTransform>

						<!-- Стили -->
						<Button.Styles>
							<Style Selector="Button">
								<Setter Property="Background" Value="#3E3E42"/>
								<Setter Property="Foreground" Value="White"/>
							</Style>
							<Style Selector="Button:pointerover">
								<Setter Property="Background" Value="#4A4A4C"/>
							</Style>
						</Button.Styles>

						<!-- Динамический цвет по IsActive -->
						<Button.Background>
							<SolidColorBrush Color="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"/>
						</Button.Background>

					</Button>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

	</Border>

</UserControl>