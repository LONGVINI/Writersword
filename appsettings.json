{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Avalonia": "Warning",
        "Writersword.Modules.Characters": "Debug",
        "Writersword.Modules.TextEditor": "Debug",
        "Writersword.Infrastructure.Rendering": "Debug",

        "Writersword.Program": "Debug",
        "Writersword.App": "Debug",
        "Writersword.Infrastructure.Services.DataComparisonService": "Debug",
        "Writersword.Infrastructure.Services.Project.ProjectWorkflow": "Debug",

        "Writersword.Infrastructure.Services.Storage.ProjectService": "Debug",

        "Writersword.Infrastructure.Services.Storage": "Debug",
        "Writersword.Infrastructure.Services.Storage.LocalSettingsStorageService": "Debug",
        "Writersword.Infrastructure.Services.Modules.ModuleStateCollectorService": "Debug",
        "Writersword.Infrastructure.Services.Project.AutoSaveService": "Debug",
        "Writersword.ViewModels": "Debug",
        "Writersword.Infrastructure.Dock": "Debug",
        "Writersword.Infrastructure.WorkFlows": "Debug",

        "Writersword.Infrastructure.Controls": "Debug"

      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{ShortSourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "path": "logs/writersword-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [{ShortSourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithShortSourceContext" ]
  }
}