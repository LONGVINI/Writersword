<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:img="using:AnimatedImage.Avalonia"
             x:Class="Writersword.Styles.UserControls.TooltipView"
             Background="Transparent"
             MinWidth="160"
             MaxWidth="320">

	<UserControl.Styles>
		<Style Selector="PopupRoot">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
	</UserControl.Styles>

	<StackPanel Background="Transparent">

		<!-- Треугольник сверху (подсказка под кнопкой) -->
		<Path IsVisible="{Binding !ArrowAtBottom, RelativeSource={RelativeSource AncestorType=UserControl}}"
              HorizontalAlignment="Left"
              Fill="{Binding TooltipBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Stroke="{Binding TooltipBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
              StrokeThickness="1"
              Data="M 0,6 L 6,0 L 12,6 Z"
              Margin="0 0 0 -1">
			<Path.RenderTransform>
				<TranslateTransform X="{Binding ArrowHorizontalOffset, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
			</Path.RenderTransform>
		</Path>

		<!-- Основной блок -->
		<Border Background="{Binding TooltipBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="{Binding TooltipBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12 10"
                BoxShadow="0 4 16 0 #44000000">

			<StackPanel Spacing="0">

				<!-- Картинка/гифка -->
				<Border IsVisible="{Binding PreviewPath, RelativeSource={RelativeSource AncestorType=UserControl},
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Margin="0 0 0 8"
                        CornerRadius="4"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">
					<Image img:ImageBehavior.AnimatedSource="{Binding PreviewPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           MaxWidth="280"
                           MaxHeight="160"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
				</Border>

				<!-- Разделитель между картинкой и текстом -->
				<Separator IsVisible="{Binding PreviewPath, RelativeSource={RelativeSource AncestorType=UserControl},
                                      Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Height="1"
                           Background="{Binding TooltipBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Margin="0 0 0 8"
                           Opacity="0.4"/>

				<!-- Заголовок -->
				<TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding TooltipForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

				<!-- Описание -->
				<TextBlock IsVisible="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl},
                                      Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding TooltipForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="11"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Margin="0 4 0 0"/>

				<!-- Горячая клавиша -->
				<Border IsVisible="{Binding HotKey, RelativeSource={RelativeSource AncestorType=UserControl},
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        HorizontalAlignment="Right"
                        Margin="0 8 0 0"
                        Background="Transparent"
                        BorderBrush="{Binding TooltipBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5 2">
					<TextBlock Text="{Binding HotKey, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{Binding TooltipForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="11"
                               Opacity="0.75"
                               FontFamily="Consolas, Courier New, monospace"/>
				</Border>

			</StackPanel>
		</Border>

		<!-- Треугольник снизу (подсказка над кнопкой) -->
		<Path IsVisible="{Binding ArrowAtBottom, RelativeSource={RelativeSource AncestorType=UserControl}}"
              HorizontalAlignment="Left"
              Fill="{Binding TooltipBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Stroke="{Binding TooltipBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
              StrokeThickness="1"
              Data="M 0,0 L 6,6 L 12,0 Z"
              Margin="0 -1 0 0">
			<Path.RenderTransform>
				<TranslateTransform X="{Binding ArrowHorizontalOffset, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
			</Path.RenderTransform>
		</Path>

	</StackPanel>

</UserControl>