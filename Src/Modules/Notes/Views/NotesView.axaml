<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Writersword.Modules.Notes.ViewModels"
             xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="Writersword.Modules.Notes.Views.NotesView"
             x:DataType="vm:NotesViewModel"
             Background="{DynamicResource BgSurfaceBrush}"
             Tag="Notes">
    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Общий проект пока не задаёт checked-состояние для ToggleButton.
             Локально добавляется только активное состояние форматирования. -->
        <Style Selector="ToggleButton.notesToggle:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}" />
        </Style>
        <Style Selector="ToggleButton.notesToggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentDefaultBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <WrapPanel Orientation="Horizontal">
                <Button Width="30" Height="28" Padding="6" Margin="0,0,4,0"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Focusable="False"
                        ToolTip.Tip="Показать или скрыть страницы"
                        Click="OnTogglePagesClick">
                    <PathIcon Width="14" Height="14"
                              Data="M3 3h6v18H3V3zm8 0h10v18H11V3zM5 5v14h2V5H5zm8 0v14h6V5h-6z" />
                </Button>

                <Button Height="28" Padding="8,4" Margin="0,0,8,0"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Focusable="False"
                        ToolTip.Tip="Добавить страницу"
                        IsEnabled="{Binding !IsReadOnly}"
                        Click="OnAddPageClick">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Width="14" Height="14"
                                  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm1 2.5L17.5 7H15V4.5zM11 10h2v3h3v2h-3v3h-2v-3H8v-2h3v-3z" />
                        <TextBlock Text="Новая страница"
                                   FontSize="{DynamicResource FontSizeS}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ComboBox Width="150" Height="28" Margin="0,0,8,0" Padding="8,3"
                          IsVisible="{Binding IsCompactHeaderVisible}"
                          ItemsSource="{Binding Pages}"
                          SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Title}" />

                <ToggleButton Classes="notesToggle" Width="34" Height="28" Padding="5" Margin="0,0,3,0"
                              Background="{DynamicResource BgSurfaceBrush}"
                              BorderBrush="{DynamicResource BorderDefaultBrush}"
                              BorderThickness="1" CornerRadius="4" Focusable="False"
                              IsChecked="{Binding IsParagraphSelected, Mode=OneWay}"
                              Tag="Paragraph" ToolTip.Tip="Обычный текст"
                              IsEnabled="{Binding !IsReadOnly}" Click="OnBlockTypeClick">
                    <PathIcon Width="14" Height="14" Data="M4 5h16v2H4V5zm0 5h16v2H4v-2zm0 5h11v2H4v-2z" />
                </ToggleButton>
                <ToggleButton Classes="notesToggle" Width="34" Height="28" Padding="5" Margin="0,0,3,0"
                              Background="{DynamicResource BgSurfaceBrush}"
                              BorderBrush="{DynamicResource BorderDefaultBrush}"
                              BorderThickness="1" CornerRadius="4" Focusable="False"
                              IsChecked="{Binding IsHeading1Selected, Mode=OneWay}"
                              Tag="Heading1" ToolTip.Tip="Заголовок первого уровня"
                              IsEnabled="{Binding !IsReadOnly}" Click="OnBlockTypeClick">
                    <TextBlock Text="H1" FontSize="12" FontWeight="SemiBold" />
                </ToggleButton>
                <ToggleButton Classes="notesToggle" Width="34" Height="28" Padding="5" Margin="0,0,8,0"
                              Background="{DynamicResource BgSurfaceBrush}"
                              BorderBrush="{DynamicResource BorderDefaultBrush}"
                              BorderThickness="1" CornerRadius="4" Focusable="False"
                              IsChecked="{Binding IsHeading2Selected, Mode=OneWay}"
                              Tag="Heading2" ToolTip.Tip="Заголовок второго уровня"
                              IsEnabled="{Binding !IsReadOnly}" Click="OnBlockTypeClick">
                    <TextBlock Text="H2" FontSize="11" FontWeight="SemiBold" />
                </ToggleButton>

                <ToggleButton Classes="notesToggle" Width="34" Height="28" Padding="5" Margin="0,0,3,0"
                              Background="{DynamicResource BgSurfaceBrush}"
                              BorderBrush="{DynamicResource BorderDefaultBrush}"
                              BorderThickness="1" CornerRadius="4" Focusable="False"
                              IsChecked="{Binding IsBulletSelected, Mode=OneWay}"
                              Tag="Bullet" ToolTip.Tip="Маркированный список"
                              IsEnabled="{Binding !IsReadOnly}" Click="OnBlockTypeClick">
                    <PathIcon Width="14" Height="14"
                              Data="M4 5h2v2H4V5zm4 0h12v2H8V5zM4 11h2v2H4v-2zm4 0h12v2H8v-2zM4 17h2v2H4v-2zm4 0h12v2H8v-2z" />
                </ToggleButton>
                <ToggleButton Classes="notesToggle" Width="34" Height="28" Padding="5" Margin="0,0,3,0"
                              Background="{DynamicResource BgSurfaceBrush}"
                              BorderBrush="{DynamicResource BorderDefaultBrush}"
                              BorderThickness="1" CornerRadius="4" Focusable="False"
                              IsChecked="{Binding IsChecklistSelected, Mode=OneWay}"
                              Tag="Checklist" ToolTip.Tip="Список задач"
                              IsEnabled="{Binding !IsReadOnly}" Click="OnBlockTypeClick">
                    <PathIcon Width="14" Height="14"
                              Data="M3 4h7v7H3V4zm2 2v3h3V6H5zm7 0h9v2h-9V6zM3 14h7v7H3v-7zm2 2v3h3v-3H5zm7 0h9v2h-9v-2z" />
                </ToggleButton>
                <ToggleButton Classes="notesToggle" Width="34" Height="28" Padding="5" Margin="0,0,3,0"
                              Background="{DynamicResource BgSurfaceBrush}"
                              BorderBrush="{DynamicResource BorderDefaultBrush}"
                              BorderThickness="1" CornerRadius="4" Focusable="False"
                              IsChecked="{Binding IsQuoteSelected, Mode=OneWay}"
                              Tag="Quote" ToolTip.Tip="Цитата"
                              IsEnabled="{Binding !IsReadOnly}" Click="OnBlockTypeClick">
                    <PathIcon Width="14" Height="14"
                              Data="M6 7h5v5H8v5H4v-6c0-2.2.7-3.7 2-4zm9 0h5v5h-3v5h-4v-6c0-2.2.7-3.7 2-4z" />
                </ToggleButton>
                <Button Width="34" Height="28" Padding="5" Margin="0,0,8,0"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Focusable="False"
                        Tag="Divider" ToolTip.Tip="Разделитель"
                        IsEnabled="{Binding !IsReadOnly}" Click="OnBlockTypeClick">
                    <PathIcon Width="14" Height="14" Data="M3 11h18v2H3z" />
                </Button>

                <ToggleButton Classes="notesToggle" Width="34" Height="28" Padding="5" Margin="0,0,3,0"
                              Background="{DynamicResource BgSurfaceBrush}"
                              BorderBrush="{DynamicResource BorderDefaultBrush}"
                              BorderThickness="1" CornerRadius="4" Focusable="False"
                              IsChecked="{Binding IsStrikeSelected, Mode=OneWay}"
                              ToolTip.Tip="Зачеркнуть строку"
                              IsEnabled="{Binding !IsReadOnly}" Click="OnStrikeClick">
                    <Grid Width="14" Height="14">
                        <TextBlock Text="S" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Height="1" VerticalAlignment="Center"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Grid>
                </ToggleButton>
                <ToggleButton Classes="notesToggle" Width="34" Height="28" Padding="5"
                              Background="{DynamicResource BgSurfaceBrush}"
                              BorderBrush="{DynamicResource BorderDefaultBrush}"
                              BorderThickness="1" CornerRadius="4" Focusable="False"
                              IsChecked="{Binding IsHighlightSelected, Mode=OneWay}"
                              ToolTip.Tip="Выделить строку"
                              IsEnabled="{Binding !IsReadOnly}" Click="OnHighlightClick">
                    <PathIcon Width="14" Height="14"
                              Data="M17.75 7L14 3.25 4 13.25V17h3.75L17.75 7zM3 19h18v2H3v-2zm12.9-13.9l1-1a1 1 0 0 1 1.4 0l1.6 1.6a1 1 0 0 1 0 1.4l-1 1-4-4z" />
                </ToggleButton>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Width="220"
                    IsVisible="{Binding IsWidePagePanelVisible}"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,0,1,0" Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Margin="6,4,6,8" Text="Страницы"
                               FontSize="{DynamicResource FontSizeS}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NotePageViewModel">
                                <Grid ColumnDefinitions="Auto,*" Margin="2">
                                    <PathIcon Width="13" Height="13" Margin="0,0,7,0"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextMutedBrush}"
                                              Data="M6 2h8l6 6v14H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm7 2H6v16h12V9h-5V4zm2 1.5V7h1.5L15 5.5z" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                               FontSize="{DynamicResource FontSizeS}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="20" RowDefinitions="Auto,*">
                <TextBox Text="{Binding SelectedPage.Title, Mode=TwoWay}"
                         PlaceholderText="Название страницы"
                         FontSize="{DynamicResource FontSizeXXL}"
                         FontWeight="SemiBold"
                         Padding="8,4"
                         IsEnabled="{Binding !IsReadOnly}" />

                <Border Grid.Row="1" Margin="0,10,0,0" Padding="12"
                        Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <avaloniaEdit:TextEditor x:Name="Editor"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontSize="{DynamicResource FontSizeM}"
                                             ShowLineNumbers="False"
                                             WordWrap="True"
                                             HorizontalScrollBarVisibility="Disabled"
                                             VerticalScrollBarVisibility="Auto"
                                             IsReadOnly="{Binding IsReadOnly}"
                                             KeyDown="OnEditorKeyDown"
                                             PointerReleased="OnEditorPointerReleased" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
